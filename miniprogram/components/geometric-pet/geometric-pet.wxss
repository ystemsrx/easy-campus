:host {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.geometric-pet,
.pet-engine-viewport,
.pet-engine-image,
.pet-halo,
.pet-shadow,
.pet-badge {
  box-sizing: border-box;
}

.geometric-pet {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: visible;
}

/*
 * The supplied engine grows its viewBox for effects that paint outside the
 * body. The native image receives its measured negative top inline because
 * moving a regular WXML wrapper does not move Skyline's decoded image layer.
 */
.pet-engine-viewport {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  overflow: visible;
  pointer-events: none;
}

.pet-engine-image {
  position: absolute;
  left: 0;
  display: block;
  flex: none;
  overflow: visible;
  pointer-events: none;
}

/* Exact wrapper proportions from the supplied preview, scaled with the host. */
.pet-halo {
  position: absolute;
  top: 11%;
  right: 11%;
  bottom: 11%;
  left: 11%;
  z-index: 0;
  border-radius: 50%;
  background-color: var(--pet-halo);
  box-shadow: 0 0 14rpx 12rpx var(--pet-halo);
  transform: scale(1.24);
}

.pet-shadow {
  position: absolute;
  bottom: 4%;
  left: 21%;
  z-index: 1;
  width: 58%;
  height: 10%;
  border-radius: 50%;
  background-color: rgba(33, 31, 25, 0.18);
  box-shadow: 0 0 9rpx 7rpx rgba(33, 31, 25, 0.11);
}

.pet-badge {
  position: absolute;
  top: -3%;
  right: -3%;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 42%;
  height: 42%;
  padding: 0 9%;
  border: 4rpx solid #fff;
  border-radius: 999rpx;
  color: #fff;
  background-color: #d93d35;
  box-shadow: 0 8rpx 20rpx rgba(192, 48, 42, 0.34);
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1;
  white-space: nowrap;
  animation-name: pet-badge-arrive;
  animation-duration: 720ms;
  animation-fill-mode: both;
  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes pet-badge-arrive {
  0% { opacity: 0; transform: scale(0.45); }
  58% { opacity: 1; transform: scale(1.12); }
  100% { opacity: 1; transform: scale(1); }
}

.motion-reduced .pet-badge {
  animation-duration: 1ms;
}
