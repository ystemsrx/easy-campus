.nav-spacer { width: 100%; }

.nav-shell {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 800;
  color: #16161a;
  transition: background-color 260ms ease, box-shadow 260ms ease;
}

.nav-shell--dark { color: #f7f3e9; }
.nav-shell--transparent { background: transparent; }

.nav-shell--material {
  background: rgba(247, 245, 239, 0.88);
  box-shadow: 0 14rpx 38rpx -26rpx rgba(20, 20, 30, 0.32);
  backdrop-filter: blur(20px) saturate(1.45);
}

.nav-shell--dark.nav-shell--material { background: rgba(23, 22, 19, 0.9); }

.nav-content {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  padding: 0 28rpx;
}

.nav-side {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
}

.nav-side--left { justify-content: flex-start; }
.nav-side--right { justify-content: flex-end; }

.back-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #2b2620;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(20, 20, 30, 0.04),
    0 14rpx 40rpx -12rpx rgba(20, 20, 30, 0.14);
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

.nav-shell--dark .back-button {
  color: #f7f3e9;
  background: #2d2a24;
}

.nav-button--pressed { transform: scale(0.93); opacity: 0.82; }

.nav-title-wrap {
  position: absolute;
  top: 0;
  right: 178rpx;
  bottom: 0;
  left: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
}

.nav-title {
  max-width: 100%;
  color: currentColor;
  font-family: Georgia, "Times New Roman", "Songti SC", SimSun, serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -1rpx;
}

.nav-subtitle {
  max-width: 100%;
  margin-bottom: 2rpx;
  color: #9a9aa3;
  font-size: 20rpx;
  font-weight: 550;
  line-height: 1.1;
}
