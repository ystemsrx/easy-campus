.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 440rpx;
  padding: 64rpx 48rpx;
  text-align: center;
}

.empty--compact {
  min-height: 280rpx;
  padding: 36rpx 32rpx;
}

.empty-glyph {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 26rpx;
  border-radius: 30rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  font-size: 38rpx;
  font-weight: 700;
}

.empty-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.3;
}

.empty-description {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-action {
  margin-top: 26rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  font-size: 25rpx;
  font-weight: 600;
  transform: scale(1);
  transition: transform 100ms ease-out, opacity 100ms ease-out;
}

.empty-action--pressed {
  opacity: 0.75;
  transform: scale(0.94);
}
