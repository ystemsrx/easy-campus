.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 50rpx 34rpx;
  text-align: center;
}

.empty--compact { min-height: 230rpx; padding: 34rpx 24rpx; }

.empty-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 32rpx;
  color: var(--visual-component-primary, #b85c38);
  background-color: var(--visual-component-primary-soft, #f9eae2);
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-title {
  margin-top: 24rpx;
  color: var(--color-text, #16161a);
  font-size: 30rpx;
  font-weight: 700;
}

.empty-description {
  max-width: 490rpx;
  margin-top: 8rpx;
  color: var(--color-text-tertiary, #9a9aa3);
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-action {
  margin-top: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  color: var(--visual-component-primary, #b85c38);
  background-color: var(--visual-component-primary-soft, #f9eae2);
  font-size: 24rpx;
  font-weight: 700;
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

.empty-action--pressed { transform: scale(0.95); opacity: 0.78; }
