<view wx:if="{{statistics}}" class="pass-rate-card {{theme === 'dark' ? 'pass-rate-card--dark' : ''}} pass-rate-card--{{visualTheme}} card">
  <view class="statistics-overview">
    <view class="pass-ring">
      <image class="pass-ring-image" src="{{passRingSource}}" mode="aspectFit"></image>
      <view class="pass-ring-inner">
        <view class="pass-ring-value"><text class="tnum">{{statistics.passRate}}</text><text>%</text></view>
        <text class="pass-ring-label">通过率</text>
      </view>
    </view>
    <view class="outcome-stack">
      <view class="outcome-row outcome-row--pass"><text>通过</text><text class="tnum">{{passedLabel}}</text></view>
      <view class="outcome-row outcome-row--fail"><text>未通过</text><text class="tnum">{{failedLabel}}</text></view>
    </view>
  </view>

  <view class="band-chart">
    <view wx:for="{{distribution}}" wx:key="band" class="band-column {{item.mine ? 'band-column--mine' : ''}}">
      <text class="band-count tnum">{{item.valueLabel}}</text>
      <view class="band-track"><view class="band-fill" style="height: {{item.height}}%;"></view></view>
      <text class="band-label tnum">{{item.band}}</text>
    </view>
  </view>

  <view class="exact-section">
    <text class="exact-title">全部分数分布</text>
    <view class="exact-chart-layout">
      <view class="exact-y-axis">
        <view wx:for="{{scoreAxisTicks}}" wx:key="value" class="exact-axis-tick"><text class="exact-axis-label tnum">{{item.label}}</text></view>
      </view>
      <scroll-view class="exact-scroll" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
        <view class="exact-chart" style="width: {{scoreChartWidth}}rpx;">
          <view class="exact-grid" aria-hidden="true">
            <view wx:for="{{scoreAxisTicks}}" wx:key="value" class="exact-grid-line"></view>
          </view>
          <view class="exact-columns">
            <view wx:for="{{scoreEntries}}" wx:key="score" class="exact-column {{item.mine ? 'exact-column--mine' : ''}}" style="width: {{scoreBarWidth}}rpx;">
              <view class="exact-track"><view class="exact-fill" style="height: {{item.height}}%;"></view></view>
              <text class="exact-label tnum">{{item.score}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  <view wx:if="{{showOwnScore}}" class="own-score-note">
    <lucide-icon name="sparkles" tone="{{visualTheme === 'minimal' ? (theme === 'dark' ? 'white' : 'ink') : 'coral'}}" size="{{23}}"></lucide-icon>
    <text>你的成绩为 <text class="own-score-value tnum">{{displayScore}}</text>，图中高亮为对应区间</text>
  </view>
</view>
