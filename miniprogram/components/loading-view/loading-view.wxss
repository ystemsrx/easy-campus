.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 330rpx;
  padding: 42rpx 30rpx;
}

.loading-wrap--compact { min-height: 210rpx; padding: 28rpx; }

.loading-orb {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #f1d4c5;
  border-top-color: #d97757;
  border-radius: 50%;
  animation-name: loading-spin;
  animation-duration: 760ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.loading-label {
  margin-top: 18rpx;
  color: var(--color-text-tertiary, #9a9aa3);
  font-size: 24rpx;
}

.skeleton-list { width: 100%; max-width: 500rpx; margin-top: 28rpx; }

.skeleton-row {
  width: 100%;
  height: 18rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ede9df, #f8f5ee, #ede9df);
  background-size: 200% 100%;
}

.skeleton-row--short { width: 68%; }
.skeleton-shimmer {
  animation-name: shimmer;
  animation-duration: 1.5s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

@keyframes loading-spin { to { transform: rotate(360deg); } }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
