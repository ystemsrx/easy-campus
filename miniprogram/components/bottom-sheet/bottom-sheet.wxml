<view wx:if="{{mounted}}" class="motion-layer {{visible ? 'motion-layer--active' : ''}} {{reducedMotion ? 'motion-reduced' : ''}} sheet-layer sheet-layer--{{theme}}">
  <view
    class="motion-scrim {{active ? 'motion-scrim--active' : ''}} sheet-scrim"
    bindtap="onMaskTap"
    catchtouchmove="noop"
  ></view>
  <view class="motion-sheet {{active ? 'motion-sheet--active' : ''}} sheet-card {{expanded ? 'sheet-card--expanded' : ''}} {{compactHeader ? 'sheet-card--compact-header' : ''}} {{safeArea ? '' : 'sheet-card--no-safe-area'}}" style="{{expanded ? 'height:' + expandedHeight + 'vh;' : ''}}">
    <view class="sheet-handle"></view>
    <view class="sheet-header">
      <view class="sheet-title-wrap">
        <text class="sheet-title">{{title}}</text>
        <slot name="subtitle"></slot>
      </view>
      <view
        class="sheet-close"
        bindtap="onClose"
        hover-class="sheet-close--pressed"
        hover-stay-time="90"
        aria-role="button"
        aria-label="关闭"
      >
        <lucide-icon name="x" tone="muted" size="{{30}}" label="关闭"></lucide-icon>
      </view>
    </view>
    <view class="sheet-content sheet-content--static">
      <slot></slot>
    </view>
    <view class="sheet-footer">
      <slot name="footer"></slot>
    </view>
  </view>
</view>
