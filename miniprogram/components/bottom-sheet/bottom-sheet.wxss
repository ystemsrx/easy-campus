.sheet-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: #16161a;
}

.sheet-layer--dark { color: #f7f3e9; }

.sheet-scrim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0;
  background: rgba(24, 21, 18, 0.36);
  transition: opacity 300ms ease;
}

.sheet-scrim--active { opacity: 1; }

.sheet-card {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  border-radius: 56rpx 56rpx 0 0;
  background: #fbf9f4;
  box-shadow: 0 -22rpx 80rpx rgba(20, 20, 30, 0.18);
  transform: translateY(105%);
  transition: transform 380ms cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet-layer--dark .sheet-card { background: #211f1b; }
.sheet-card--active { transform: translateY(0); }

.sheet-handle {
  position: absolute;
  top: 14rpx;
  left: 50%;
  z-index: 3;
  width: 70rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(43, 38, 32, 0.15);
  transform: translateX(-50%);
}

.sheet-header {
  position: relative;
  z-index: 2;
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 30rpx 38rpx 12rpx 44rpx;
  background: rgba(251, 249, 244, 0.92);
  backdrop-filter: blur(16px);
}

.sheet-layer--dark .sheet-header { background: rgba(33, 31, 27, 0.92); }

.sheet-title-wrap { min-width: 0; }

.sheet-title {
  display: block;
  color: currentColor;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.2;
}

.sheet-close {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(43, 38, 32, 0.06);
  transition: transform 110ms ease-out, opacity 110ms ease-out;
}

.sheet-layer--dark .sheet-close { background: rgba(255, 255, 255, 0.08); }
.sheet-close--pressed { transform: scale(0.9); opacity: 0.72; }

.sheet-close-line {
  position: absolute;
  top: 29rpx;
  left: 19rpx;
  width: 22rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #8b8578;
}

.sheet-close-line--a { transform: rotate(45deg); }
.sheet-close-line--b { transform: rotate(-45deg); }

.sheet-content {
  flex: 1;
  min-height: 0;
  padding: 6rpx 40rpx 24rpx;
}

.sheet-footer {
  flex: none;
  padding: 16rpx 40rpx 28rpx;
}

.sheet-footer:empty { display: none; }

.motion-reduced .sheet-scrim,
.motion-reduced .sheet-card { transition-duration: 1ms; }
