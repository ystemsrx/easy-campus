<view class="page login-page {{themeClass}} {{motionClass}}">
  <scroll-view class="page-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="login-stage">
      <view class="ambient ambient--one"></view>
      <view class="ambient ambient--two"></view>
      <navigation-bar transparent theme="{{theme}}"></navigation-bar>

      <view class="login-content page-enter">
        <view class="brand-block">
          <view class="brand-mark"><text>易</text></view>
          <text class="brand-name">Easy SWU</text>
          <text class="brand-tagline">把教务信息，整理得更简单。</text>
        </view>

        <form class="login-card material-card" bindsubmit="onSubmit">
          <view class="form-heading">
            <text class="form-title">欢迎回来</text>
            <text class="form-subtitle">使用西南大学统一身份认证登录</text>
          </view>

          <view class="field {{accountFocused ? 'field--focus' : ''}}">
            <text class="field-label">学号</text>
            <input
              class="field-input"
              value="{{account}}"
              type="text"
              maxlength="64"
              placeholder="请输入学号"
              placeholder-class="field-placeholder"
              bindinput="onAccountInput"
              bindfocus="onAccountFocus"
              bindblur="onAccountBlur"
              confirm-type="next"
              aria-label="学号"
            />
          </view>

          <view class="field {{passwordFocused ? 'field--focus' : ''}}">
            <text class="field-label">密码</text>
            <input
              class="field-input"
              value="{{password}}"
              password="{{!passwordVisible}}"
              maxlength="255"
              placeholder="请输入密码"
              placeholder-class="field-placeholder"
              bindinput="onPasswordInput"
              bindfocus="onPasswordFocus"
              bindblur="onPasswordBlur"
              bindconfirm="onSubmit"
              confirm-type="done"
              aria-label="统一身份认证密码"
            />
            <view
              class="password-toggle"
              bindtap="togglePassword"
              hover-class="password-toggle--pressed"
              aria-role="button"
              aria-label="{{passwordVisible ? '隐藏密码' : '显示密码'}}"
            >
              <text>{{passwordVisible ? '隐藏' : '显示'}}</text>
            </view>
          </view>

          <view wx:if="{{errorMessage}}" class="inline-error" aria-role="alert">
            <view class="error-dot"></view>
            <text>{{errorMessage}}</text>
          </view>

          <button
            class="primary-button login-button {{loading ? 'primary-button--disabled' : ''}}"
            form-type="submit"
            disabled="{{loading}}"
            hover-class="button-pressed"
            loading="{{loading}}"
          >
            {{loading ? '正在安全连接…' : '登录'}}
          </button>

          <view class="privacy-note">
            <view class="privacy-glyph"><text>i</text></view>
            <view class="privacy-copy"><text>{{privacyNotice}}</text></view>
          </view>
        </form>

        <text class="session-note">登录会话 90 天滑动有效 · 每次使用自动续期</text>
      </view>
    </view>
  </scroll-view>
</view>
