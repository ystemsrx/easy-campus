<view class="page login-page {{themeClass}} {{motionClass}}">
  <scroll-view class="page-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="login-stage">
      <view class="ambient-blob login-blob login-blob--one"></view>
      <view class="ambient-blob login-blob login-blob--two"></view>
      <view class="ambient-blob login-blob login-blob--three"></view>
      <navigation-bar transparent theme="{{theme}}"></navigation-bar>

      <view class="brand-block page-enter">
        <view class="brand-mark">
          <view class="ambient-blob brand-blob"></view>
          <lucide-icon name="calendar-days" tone="white" size="{{80}}"></lucide-icon>
        </view>
        <text class="brand-name display-title">校园通</text>
        <text class="brand-tagline">课表 · 成绩 · 日程 · 空教室，一应俱全</text>
      </view>

      <view class="login-panel">
        <form class="login-card" bindsubmit="onSubmit">
          <view class="field {{accountFocused ? 'field--focus' : ''}}">
            <view class="field-icon"><lucide-icon name="user-round" tone="muted" size="{{36}}"></lucide-icon></view>
            <input
              class="field-input"
              value="{{account}}"
              type="text"
              maxlength="64"
              placeholder="学号 / 用户名"
              placeholder-class="field-placeholder"
              bindinput="onAccountInput"
              bindfocus="onAccountFocus"
              bindblur="onAccountBlur"
              confirm-type="next"
              aria-label="学号"
            />
          </view>

          <view class="field {{passwordFocused ? 'field--focus' : ''}}">
            <view class="field-icon"><lucide-icon name="lock-keyhole" tone="muted" size="{{36}}"></lucide-icon></view>
            <input
              class="field-input field-input--password"
              value="{{password}}"
              password="{{!passwordVisible}}"
              maxlength="255"
              placeholder="密码"
              placeholder-class="field-placeholder"
              bindinput="onPasswordInput"
              bindfocus="onPasswordFocus"
              bindblur="onPasswordBlur"
              bindconfirm="onSubmit"
              confirm-type="done"
              aria-label="统一身份认证密码"
            />
            <view class="password-toggle pressable" bindtap="togglePassword" hover-class="pressing" aria-role="button" aria-label="{{passwordVisible ? '隐藏密码' : '显示密码'}}">
              <lucide-icon name="{{passwordVisible ? 'eye-off' : 'eye'}}" tone="muted" size="{{32}}"></lucide-icon>
            </view>
          </view>

          <view wx:if="{{errorMessage}}" class="inline-error" aria-role="alert"><lucide-icon name="circle-alert" tone="danger" size="{{24}}"></lucide-icon><text>{{errorMessage}}</text></view>

          <button class="login-button {{loading ? 'login-button--loading' : ''}}" form-type="submit" disabled="{{loading}}" hover-class="login-button--pressed">
            <view wx:if="{{loading}}" class="login-spinner"></view>
            <text>{{loading ? '正在进入…' : '登录'}}</text>
          </button>

          <view class="privacy-note"><view class="privacy-glyph"><lucide-icon name="shield-check" tone="muted" size="{{25}}"></lucide-icon></view><text>{{privacyNotice}}</text></view>
        </form>

        <text class="session-note">登录会话 90 天滑动有效 · 每次使用自动续期</text>
        <text class="agreement-note">登录即代表你已了解账号凭据的保存与使用方式</text>
      </view>
    </view>
  </scroll-view>
</view>
