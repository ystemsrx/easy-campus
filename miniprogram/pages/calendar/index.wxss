.calendar-content { padding-top: 20rpx; }
.calendar-hero { position: relative; min-height: 270rpx; padding: 38rpx; overflow: hidden; border-radius: 56rpx; color: #fff; background: linear-gradient(145deg, #7d8f6e, #acbe97); box-shadow: var(--shadow-pop); }
.calendar-blob { background: rgba(255, 255, 255, 0.15); }.calendar-blob--one { top: -90rpx; right: -70rpx; width: 300rpx; height: 270rpx; }.calendar-blob--two { bottom: -115rpx; left: -65rpx; width: 240rpx; height: 215rpx; background: rgba(0, 0, 0, 0.06); animation-delay: -4s; }
.calendar-kicker { position: relative; display: block; color: rgba(255, 255, 255, 0.72); font-size: 20rpx; font-weight: 750; letter-spacing: 4rpx; }
.calendar-title { position: relative; display: block; max-width: 500rpx; margin-top: 12rpx; font-size: 50rpx; font-weight: 700; line-height: 1.3; }
.calendar-caption { position: relative; display: block; margin-top: 10rpx; color: rgba(255, 255, 255, 0.8); font-size: 22rpx; }
.calendar-symbol { position: absolute; right: 35rpx; bottom: 30rpx; display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border: 3rpx solid rgba(255, 255, 255, 0.75); border-radius: 26rpx; background: rgba(255, 255, 255, 0.16); font-family: Georgia, "Songti SC", serif; font-size: 28rpx; font-weight: 750; backdrop-filter: blur(8px); }
.calendar-meta { display: flex; flex-direction: row; align-items: center; margin-top: 22rpx; padding: 24rpx 18rpx; }
.calendar-meta > view:not(.meta-divider) { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; }
.calendar-meta > view > text:first-child { max-width: 100%; color: var(--color-text); font-size: 23rpx; font-weight: 750; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.calendar-meta > view > text:last-child { margin-top: 3rpx; color: #b5b0a3; font-size: 18rpx; }
.meta-divider { width: 1rpx; height: 50rpx; background-color: var(--color-separator); }
.year-switch { display: flex; flex-direction: row; align-items: center; gap: 20rpx; margin-top: 18rpx; padding: 22rpx 26rpx; }
.year-switch-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; background: #edf1e6; }
.year-switch > view:nth-child(2) { flex: 1; min-width: 0; }.year-switch > view:nth-child(2) text:first-child { display: block; color: #a39e92; font-size: 19rpx; }.year-switch > view:nth-child(2) text:last-child { display: block; margin-top: 2rpx; color: var(--color-text); font-size: 25rpx; font-weight: 700; }
.year-switch-action { display: flex; flex-direction: row; align-items: center; gap: 4rpx; color: #5f7350; font-size: 21rpx; font-weight: 700; }
.calendar-image-card { margin-top: 28rpx; padding: 20rpx; }
.image-toolbar { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 20rpx; padding: 4rpx 4rpx 18rpx; }
.image-status { display: flex; flex-direction: row; align-items: center; gap: 9rpx; color: #5f7350; font-size: 20rpx; font-weight: 700; }
.image-actions { display: flex; flex-direction: row; gap: 10rpx; }.image-action { display: flex; flex-direction: row; align-items: center; gap: 7rpx; padding: 10rpx 18rpx; border-radius: 999rpx; color: #8b8578; background: #f6f3ec; font-size: 20rpx; font-weight: 700; }.image-action--primary { color: #fff; background: #7d8f6e; }
.calendar-image-wrap { position: relative; overflow: hidden; border-radius: 34rpx; background: #f1eee6; transition: transform 150ms ease, opacity 150ms ease; }.image-pressing { transform: scale(0.99); opacity: 0.88; }
.calendar-image { display: block; width: 100%; }
.zoom-hint { position: absolute; right: 18rpx; bottom: 18rpx; display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; border-radius: 999rpx; color: #fff; background: rgba(43, 38, 32, 0.62); font-size: 18rpx; font-weight: 700; backdrop-filter: blur(8px); }
.calendar-note { display: flex; flex-direction: row; align-items: flex-start; gap: 14rpx; margin: 26rpx 8rpx 0; color: #a39e92; font-size: 20rpx; line-height: 1.6; }.calendar-note-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; margin-top: 1rpx; }
.calendar-year-options { display: flex; flex-direction: column; gap: 12rpx; padding-top: 8rpx; }
.calendar-year-option { display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 22rpx 26rpx; border-radius: 32rpx; color: #8b8b94; background: rgba(43, 38, 32, 0.045); transition: transform 120ms ease, background-color 220ms ease; }.calendar-year-option--active { color: #5f7350; background: #edf1e6; }.calendar-year-option--pressed { transform: scale(0.98); }
.year-radio { display: flex; flex: none; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border: 3rpx solid currentColor; border-radius: 50%; }.year-radio view { width: 18rpx; height: 18rpx; border-radius: 50%; background: currentColor; }
.year-option-title { display: block; font-size: 25rpx; font-weight: 750; }.year-option-caption { display: block; margin-top: 2rpx; font-size: 20rpx; opacity: 0.68; }.calendar-apply { background: linear-gradient(135deg, #7d8f6e, #acbe97); box-shadow: 0 18rpx 44rpx rgba(95, 115, 80, 0.24); }
