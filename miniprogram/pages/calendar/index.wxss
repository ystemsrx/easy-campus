.calendar-content {
  padding-top: 26rpx;
}

.calendar-heading {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  padding: 8rpx 6rpx 28rpx;
}

.calendar-eyebrow {
  display: block;
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2.2rpx;
}

.calendar-title {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 50rpx;
  font-weight: 750;
  line-height: 1.1;
  letter-spacing: -1.5rpx;
}

.calendar-caption {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.calendar-year-button {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  min-height: 62rpx;
  margin-left: 22rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 20rpx;
  color: var(--color-primary);
  background-color: var(--color-bg-elevated);
  font-size: 23rpx;
  font-weight: 620;
}

.year-chevron {
  margin-left: 7rpx;
  font-size: 24rpx;
}

.calendar-meta-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 110rpx;
  padding: 18rpx 12rpx;
}

.calendar-meta-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.calendar-meta-label {
  color: var(--color-text-tertiary);
  font-size: 18rpx;
}

.calendar-meta-value {
  margin-top: 5rpx;
  color: var(--color-text);
  font-size: 21rpx;
  font-weight: 620;
  line-height: 1.35;
  text-align: center;
}

.calendar-meta-divider {
  width: 1rpx;
  height: 44rpx;
  background-color: var(--color-separator);
}

.calendar-image-card {
  margin-top: 22rpx;
  padding: 18rpx;
}

.image-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
  padding: 0 4rpx 16rpx;
}

.image-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.image-status-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background-color: var(--color-success);
}

.image-actions {
  display: flex;
  flex-direction: row;
}

.image-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  margin-left: 10rpx;
  padding: 9rpx 16rpx;
  border-radius: 17rpx;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-subtle);
  font-size: 20rpx;
  font-weight: 600;
}

.image-action--primary {
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
}

.calendar-image-wrap {
  position: relative;
  width: 100%;
  min-height: 400rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background-color: var(--color-bg-subtle);
  transition: transform 140ms ease-out, opacity 140ms ease-out;
}

.image-pressing {
  opacity: 0.86;
  transform: scale(0.992);
}

.calendar-image {
  display: block;
  width: 100%;
  background: #ffffff;
}

.zoom-hint {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(18, 28, 45, 0.58);
  font-size: 18rpx;
  backdrop-filter: blur(12px);
}

.zoom-glyph {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.zoom-glyph::after {
  position: absolute;
  right: -7rpx;
  bottom: -4rpx;
  width: 8rpx;
  height: 2rpx;
  background: currentColor;
  content: "";
  transform: rotate(45deg);
}

.calendar-note {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 24rpx 6rpx 8rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.6;
}

.calendar-note-icon {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin: 1rpx 12rpx 0 0;
  border: 2rpx solid var(--color-text-tertiary);
  border-radius: 50%;
  font-size: 17rpx;
  font-weight: 700;
}

.calendar-year-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 92rpx;
  margin-bottom: 14rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 23rpx;
  background-color: var(--color-bg-elevated);
  transform: scale(1);
  transition: transform 100ms ease-out, background-color 180ms ease;
}

.calendar-year-option--active {
  border-color: rgba(22, 119, 255, 0.28);
  background-color: var(--color-primary-soft);
}

.calendar-year-option--pressed { transform: scale(0.97); }

.year-radio {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 18rpx;
  border: 3rpx solid var(--color-text-tertiary);
  border-radius: 50%;
}

.calendar-year-option--active .year-radio { border-color: var(--color-primary); }

.year-radio-core {
  width: 19rpx;
  height: 19rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
}

.year-option-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.year-option-title {
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 620;
}

.year-option-caption {
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
}
