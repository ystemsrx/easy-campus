.notice-detail-content {
  padding-top: 24rpx;
}

.notice-heading {
  padding: 34rpx 32rpx 32rpx;
}

.notice-heading::before {
  position: absolute;
  top: 0;
  right: 34rpx;
  left: 34rpx;
  height: 5rpx;
  border-radius: 0 0 999rpx 999rpx;
  background: linear-gradient(90deg, #1677ff, #65adff);
  content: "";
}

.notice-heading-topline,
.notice-meta,
.notice-source,
.notice-kind,
.notice-copy-link,
.inline-refresh-error {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.notice-heading-topline {
  justify-content: space-between;
}

.notice-kind {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 680;
  letter-spacing: 1rpx;
}

.notice-kind-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 11rpx;
  border: 4rpx solid var(--color-primary-soft);
  border-radius: 50%;
  background-color: var(--color-primary);
}

.cache-label {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: var(--color-text-tertiary);
  background-color: var(--color-bg-subtle);
  font-size: 19rpx;
  font-weight: 600;
}

.notice-heading-title {
  display: block;
  margin-top: 22rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 720;
  line-height: 1.48;
  letter-spacing: -0.7rpx;
}

.notice-meta {
  flex-wrap: wrap;
  margin-top: 20rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.notice-meta-dot {
  width: 6rpx;
  height: 6rpx;
  margin: 0 13rpx;
  border-radius: 50%;
  background-color: currentColor;
}

.notice-article {
  margin-top: 22rpx;
  padding: 34rpx 31rpx 30rpx;
  color: var(--color-text-secondary);
}

.notice-rich-text {
  display: block;
  width: 100%;
  color: inherit;
  font-size: 29rpx;
  line-height: 1.8;
  word-break: break-all;
}

.notice-skeleton {
  min-height: 610rpx;
  overflow: hidden;
}

.notice-skeleton::after {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 48%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.72), transparent);
  transform: translateX(-160%);
  animation-name: notice-skeleton-sweep;
  animation-duration: 1.45s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  content: "";
}

.theme-dark .notice-skeleton::after {
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.07), transparent);
}

.skeleton-line,
.skeleton-section {
  height: 24rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background-color: var(--color-bg-subtle);
}

.skeleton-line:first-child {
  margin-top: 0;
}

.skeleton-line--wide {
  width: 96%;
}

.skeleton-line--medium {
  width: 72%;
}

.skeleton-line--short {
  width: 45%;
}

.skeleton-section {
  width: 38%;
  height: 32rpx;
  margin-top: 48rpx;
}

.skeleton-section--small {
  width: 30%;
}

.notice-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 22rpx;
  padding: 52rpx 34rpx 40rpx;
  text-align: center;
}

.notice-error-glyph {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: var(--color-warning);
  background-color: var(--color-warning-soft);
  font-size: 36rpx;
  font-weight: 750;
}

.notice-error-title {
  margin-top: 22rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 680;
}

.notice-error-copy {
  max-width: 550rpx;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.65;
}

.notice-retry {
  width: 280rpx;
  min-height: 78rpx;
  margin-top: 28rpx;
  border-radius: 23rpx;
  font-size: 26rpx;
}

.inline-refresh-error {
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  color: var(--color-warning);
  background-color: var(--color-warning-soft);
  font-size: 22rpx;
}

.inline-refresh-action {
  flex: none;
  margin-left: 20rpx;
  font-weight: 700;
}

.notice-source {
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 25rpx 26rpx;
}

.notice-source-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.notice-source-label {
  color: var(--color-text-tertiary);
  font-size: 19rpx;
  font-weight: 620;
}

.notice-source-domain {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 610;
}

.notice-copy-link {
  flex: none;
  justify-content: center;
  min-height: 62rpx;
  margin-left: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 19rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  font-size: 22rpx;
  font-weight: 660;
}

.notice-footnote {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 26rpx 8rpx 8rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.6;
}

.notice-footnote-line {
  flex: none;
  width: 18rpx;
  height: 4rpx;
  margin: 13rpx 12rpx 0 0;
  border-radius: 999rpx;
  background-color: var(--color-primary);
}

.motion-reduced .notice-skeleton::after {
  animation-name: none;
}

@keyframes notice-skeleton-sweep {
  from {
    transform: translateX(-160%);
  }
  to {
    transform: translateX(310%);
  }
}
