<view class="page timetable-page {{themeClass}} {{motionClass}}">
  <scroll-view class="page-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}" bindscroll="onScroll">
    <navigation-bar title="完整课表" subtitle="{{weekLabel}} · {{semesterLabel}}" back transparent scrolled="{{headerScrolled}}" theme="{{theme}}"></navigation-bar>
    <view class="timetable-content page-content page-enter">
      <view class="timetable-status">
        <view class="status-dot"></view>
        <text>{{statusCaption}}</text>
        <view class="status-refresh pressable" bindtap="onRefresh" hover-class="pressing" aria-role="button" aria-label="刷新课表">
          <lucide-icon name="refresh-cw" tone="muted" size="{{26}}"></lucide-icon>
        </view>
      </view>

      <scroll-view wx:if="{{semesters.length}}" class="semester-scroll" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
        <view class="semester-row">
          <view wx:for="{{semesters}}" wx:key="id" class="semester-chip pressable {{semesterId === item.id ? 'semester-chip--active' : ''}}" data-semester="{{item.id}}" bindtap="selectSemester" hover-class="pressing"><text>{{item.label}}</text></view>
        </view>
      </scroll-view>

      <view class="week-navigator card">
        <view class="week-step pressable {{canPreviousWeek ? '' : 'week-step--disabled'}}" data-delta="-1" bindtap="changeWeek" hover-class="pressing"><lucide-icon name="arrow-left" tone="muted" size="{{27}}"></lucide-icon></view>
        <view class="week-copy"><text class="week-title">{{weekLabel}}</text><text class="week-caption">{{courseCount}} 项课程安排</text></view>
        <view class="week-step pressable {{canNextWeek ? '' : 'week-step--disabled'}}" data-delta="{{1}}" bindtap="changeWeek" hover-class="pressing"><lucide-icon name="chevron-right" tone="muted" size="{{27}}"></lucide-icon></view>
      </view>

      <scroll-view class="week-grid-scroll" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
        <view class="week-grid card">
          <view class="week-grid-head">
            <view class="time-head"></view>
            <view wx:for="{{gridDays}}" wx:key="weekday" class="grid-day-head {{item.isToday ? 'grid-day-head--today' : ''}}"><text>周{{item.shortLabel}}</text><view class="grid-day-date"><text>{{item.dateLabel}}</text></view></view>
          </view>
          <view class="week-grid-body" style="height: {{gridHeight}}rpx;">
            <view class="time-scale">
              <view wx:for="{{timeMarks}}" wx:key="label" class="time-mark" style="top: {{item.top}}rpx;"><text>{{item.label}}</text></view>
            </view>
            <view class="grid-days">
              <view wx:for="{{gridDays}}" wx:key="weekday" class="grid-day-column" style="height: {{gridHeight}}rpx;">
                <view wx:for="{{timeMarks}}" wx:key="label" class="grid-line" style="top: {{item.top}}rpx;"></view>
                <view wx:for="{{item.courses}}" wx:for-item="course" wx:key="id" class="grid-course grid-course--{{course.tone}} pressable stagger-item" style="top: {{course.top}}rpx; height: {{course.height}}rpx;" data-id="{{course.id}}" bindtap="openCourse" hover-class="pressing"><text class="grid-course-name" overflow="ellipsis" max-lines="2">{{course.name}}</text><text class="grid-course-room" overflow="ellipsis" max-lines="1">{{course.location}}</text></view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <text class="grid-caption">共 {{totalCourseCount}} 门课 · 左右滑动查看整周 · 点击色块查看详情</text>

      <view class="selected-heading"><view><text class="selected-title">{{selectedDateLabel}}</text><text class="selected-caption">当前时间 {{currentTime}} · 用户所在时区</text></view><view class="today-button pressable" bindtap="goToday" hover-class="pressing"><text>今天</text></view></view>
      <view wx:if="{{courses.length}}" class="course-list card">
        <view wx:for="{{courses}}" wx:key="id" class="course-row pressable {{index < courses.length - 1 ? 'course-row--divided' : ''}}" data-id="{{item.id}}" bindtap="openCourse" hover-class="pressing">
          <view class="course-accent course-accent--{{item.tone}}"></view>
          <view class="course-copy"><text class="course-name" overflow="ellipsis" max-lines="1">{{item.name}}</text><text class="course-meta">{{item.displayTimeLabel}} · {{item.teacher}} · {{item.location}}</text></view>
          <text class="course-state course-state--{{item.state}}">{{item.stateLabel}}</text>
        </view>
      </view>
      <empty-state wx:else icon="calendar-check" icon-tone="coral" title="这一天没有课程" description="{{emptyDescription}}" action-text="回到今天" bindaction="goToday"></empty-state>
    </view>
  </scroll-view>

  <bottom-sheet visible="{{courseSheetVisible}}" title="课程详情" theme="{{theme}}" bindclose="closeCourse">
    <view wx:if="{{selectedCourse}}" class="course-sheet">
      <view class="course-sheet-hero course-sheet-hero--{{selectedCourse.tone}}"><view class="ambient-blob course-sheet-blob"></view><text class="course-sheet-kicker">{{selectedCourse.periodLabel}} · {{selectedCourse.weekText}}</text><text class="course-sheet-title display-title">{{selectedCourse.name}}</text><text class="course-sheet-teacher">{{selectedCourse.teacher}} · {{selectedCourse.activityTypeLabel}}</text></view>
      <view class="course-sheet-info card">
        <view class="course-sheet-row"><text>上课地点</text><text>{{selectedCourse.location}}</text></view>
        <view class="course-sheet-row"><text>上课时间</text><text>{{selectedCourse.displayTimeLabel}}{{selectedCourse.localized ? ' · 用户所在时区' : ''}}</text></view>
        <view class="course-sheet-row"><text>教学周次</text><text>{{selectedCourse.weekText}}</text></view>
        <view wx:if="{{selectedCourse.credits !== null}}" class="course-sheet-row"><text>学分</text><text>{{selectedCourse.credits}}</text></view>
        <view wx:if="{{selectedCourse.teachingClass}}" class="course-sheet-row"><text>教学班</text><text>{{selectedCourse.teachingClass}}</text></view>
        <view wx:if="{{selectedCourse.nature}}" class="course-sheet-row"><text>课程性质</text><text>{{selectedCourse.nature}}</text></view>
        <view wx:if="{{selectedCourse.assessmentMethod}}" class="course-sheet-row"><text>考核方式</text><text>{{selectedCourse.assessmentMethod}}</text></view>
      </view>
    </view>
  </bottom-sheet>
</view>
