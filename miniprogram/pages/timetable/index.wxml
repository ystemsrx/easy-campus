<view
  class="page timetable-page timetable-theme--{{timetableThemeId}} {{themeClass}} {{motionClass}}"
  style="background-color: {{backgroundColor}}; {{themeStyle}}"
  bindtouchstart="updateCompanionGaze"
  bindtouchmove="updateCompanionGaze"
  bindtouchend="clearCompanionGaze"
  bindtouchcancel="clearCompanionGaze"
  bindtap="onTimetableInteraction"
>
  <image
    wx:if="{{backgroundImage}}"
    class="timetable-background"
    src="{{backgroundImage}}"
    mode="{{backgroundImageMode}}"
    style="{{timetableThemeId === 'default' ? imageStyle : ''}}"
    fade-in="{{false}}"
    draggable="{{false}}"
    aria-hidden="true"
  ></image>
  <view class="background-shade"></view>

  <view wx:if="{{timetableThemeId === 'clawd'}}" class="clawd-ambient-layer" aria-hidden="true">
    <block wx:if="{{motionClass !== 'motion-reduced'}}">
      <image
        class="clawd-ambient clawd-ambient--walking"
        src="/assets/images/timetable-theme-clawd-walking.gif"
        mode="aspectFit"
        fade-in="{{false}}"
        draggable="{{false}}"
      ></image>
      <image
        class="clawd-ambient clawd-ambient--lurking"
        src="/assets/images/timetable-theme-clawd-lurking.gif"
        mode="aspectFit"
        fade-in="{{false}}"
        draggable="{{false}}"
      ></image>
    </block>
    <image
      wx:else
      class="clawd-ambient clawd-ambient--still"
      src="/assets/images/timetable-theme-clawd-idle.svg"
      mode="aspectFit"
      fade-in="{{false}}"
      draggable="{{false}}"
    ></image>
  </view>

  <view wx:if="{{timetableThemeId === 'companion' && petVisible}}" class="timetable-companion-layer">
    <view class="timetable-companion-frame">
      <geometric-pet
        id="timetable-companion"
        shape="{{petShape}}"
        color="{{petColor}}"
        enhanced="{{petEnhanced}}"
        state="idle"
        reduced-motion="{{petReducedMotion}}"
        auto-cycle="{{true}}"
        cycle-offset="{{4}}"
        preview-scale="{{0.92}}"
        label="课表背景中的校园伙伴"
      ></geometric-pet>
    </view>
  </view>

  <view class="timetable-header" style="height: {{headerHeight}}px; padding-top: {{headerTop}}px;">
    <view class="header-left">
      <view class="header-button pressable" style="width: {{headerControlSize}}px; height: {{headerControlSize}}px;" bindtap="goBack" hover-class="header-button--pressed" aria-role="button" aria-label="返回">
        <lucide-icon name="arrow-left" tone="{{headerIconTone}}" size="{{29}}"></lucide-icon>
      </view>
      <view class="header-button pressable" style="width: {{headerControlSize}}px; height: {{headerControlSize}}px;" bindtap="toggleMenu" hover-class="header-button--pressed" aria-role="button" aria-label="课表菜单">
        <view class="menu-glyph {{menuOpen ? 'menu-glyph--open' : ''}}"><view></view><view></view><view></view></view>
      </view>
    </view>

    <view
      class="header-week pressable {{weekMenuOpen ? 'header-week--open' : ''}}"
      style="top: {{headerControlCenter}}px; height: {{headerControlSize}}px;"
      bindtap="toggleWeekMenu"
      hover-class="header-week--pressed"
      aria-role="button"
      aria-label="切换教学周，当前{{weekLabel}}"
      aria-expanded="{{weekMenuOpen}}"
    >
      <text class="tnum">{{weekLabel}}</text>
      <view class="week-chevron"><lucide-icon name="chevron-right" tone="{{headerIconTone}}" size="{{16}}"></lucide-icon></view>
    </view>

  </view>

  <swiper
    wx:if="{{weekPages.length}}"
    class="week-swiper"
    current="{{weekIndex}}"
    duration="320"
    easing-function="easeOutCubic"
    bindchange="onWeekChange"
    cache-extent="1"
  >
    <swiper-item wx:for="{{weekPages}}" wx:for-item="weekPage" wx:key="weekNumber">
      <view wx:if="{{weekPage.ready}}" class="week-page">
        <view class="week-grid-head">
          <view class="month-head">
            <text class="month-number tnum">{{weekPage.monthNumber}}</text>
            <text class="month-unit">月</text>
          </view>
          <view
            wx:for="{{weekPage.days}}"
            wx:for-item="day"
            wx:key="weekday"
            class="grid-day-head {{day.isToday ? 'grid-day-head--today' : ''}}"
          >
            <text class="weekday-label">{{day.shortLabel}}</text>
            <view class="grid-day-date"><text class="tnum">{{day.dateLabel}}</text></view>
          </view>
        </view>

        <view class="week-grid-body">
          <view class="time-scale">
            <view wx:for="{{periodRows}}" wx:for-item="period" wx:key="period" class="period-row">
              <text class="period-number tnum">{{period.period}}</text>
              <text class="period-time tnum">{{period.startTime}}</text>
              <text class="period-time tnum">{{period.endTime}}</text>
            </view>
          </view>

          <view class="grid-days">
            <view wx:for="{{weekPage.gridDays}}" wx:for-item="day" wx:key="weekday" class="grid-day-column">
              <view wx:for="{{periodRows}}" wx:for-item="period" wx:key="period" class="period-grid-line"></view>
              <view
                wx:for="{{day.courses}}"
                wx:for-item="course"
                wx:key="id"
                class="grid-course-slot"
                style="top: {{course.topPercent}}%; height: {{course.heightPercent}}%; padding-top: {{course.topInsetPx}}px;"
              >
                <view
                  class="grid-course grid-course--{{course.tone}} pressable"
                  data-id="{{course.id}}"
                  bindtap="openCourse"
                  hover-class="grid-course--pressed"
                  aria-role="button"
                  aria-label="{{course.name}}，{{course.location}}"
                >
                  <view class="grid-course-name" style="{{course.nameStyle}}">
                    <text wx:for="{{course.nameRows}}" wx:for-item="row" wx:key="key" class="grid-course-text-line">{{row.text}}</text>
                  </view>
                  <view wx:if="{{course.locationRows.length}}" class="grid-course-room" style="{{course.locationStyle}}">
                    <text wx:for="{{course.locationRows}}" wx:for-item="row" wx:key="key" class="grid-course-text-line">{{row.text}}</text>
                  </view>
                  <view wx:if="{{course.teacherRows.length}}" class="grid-course-teacher" style="{{course.teacherStyle}}">
                    <text wx:for="{{course.teacherRows}}" wx:for-item="row" wx:key="key" class="grid-course-text-line">{{row.text}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

      </view>
    </swiper-item>
  </swiper>

  <view wx:else class="timetable-empty">
    <block wx:if="{{hasHydrated}}"><text>暂无本地课表</text><text>可从左上角菜单手动刷新</text></block>
  </view>

  <view wx:if="{{weekMenuMounted}}" class="week-popover-layer {{weekMenuOpen ? 'week-popover-layer--open' : ''}}">
    <view class="week-popover-dismiss" catchtap="closeWeekMenu"></view>
    <view class="week-popover" style="top: {{weekMenuTop}}px;" catchtap="stopPropagation">
      <view class="week-popover-header">
        <text>选择周次</text>
        <text>{{semesterShortLabel}}</text>
      </view>
      <scroll-view
        class="week-option-scroll"
        style="height: {{weekMenuListHeight}}rpx;"
        type="list"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-into-view="{{weekScrollIntoView}}"
      >
        <view class="week-options-top-space"></view>
        <view
          wx:for="{{weekMenuRows}}"
          wx:for-item="weekRow"
          wx:key="id"
          id="{{weekRow.id}}"
          class="week-option-row"
        >
          <view
            wx:for="{{weekRow.weeks}}"
            wx:for-item="week"
            wx:key="weekNumber"
            class="week-option pressable {{currentWeekNumber === week.weekNumber ? 'week-option--current' : ''}} {{weekNumber === week.weekNumber ? 'week-option--active' : ''}}"
            data-week="{{week.weekNumber}}"
            bindtap="selectWeek"
            hover-class="week-option--pressed"
            aria-role="button"
            aria-label="第{{week.weekNumber}}周，{{week.startDateLabel}}开始"
          >
            <view class="week-option-number tnum">{{week.weekNumber}}</view>
            <view class="week-option-date tnum">{{week.startDateLabel}}</view>
          </view>
        </view>
        <view class="week-options-bottom-space"></view>
      </scroll-view>
    </view>
  </view>

  <view
    wx:if="{{refreshToastMounted}}"
    class="refresh-confirmation {{refreshToastVisible ? 'refresh-confirmation--visible' : ''}}"
    aria-role="status"
  >
    <text>已刷新</text>
  </view>

  <view wx:if="{{menuOpen}}" class="popover-dismiss" catchtap="closeMenus"></view>

  <view
    wx:if="{{menuOpen}}"
    class="timetable-menu popover-enter {{semesterOpen ? 'timetable-menu--submenu' : ''}}"
    style="top: {{menuTop}}px; height: {{menuHeight}}rpx;"
    catchtap="stopPropagation"
  >
    <view class="menu-panel menu-panel--main">
      <text class="menu-label">课表主题</text>
      <view class="theme-options">
        <view
          wx:for="{{timetableThemes}}"
          wx:key="id"
          class="theme-option pressable {{timetableThemeId === item.id ? 'theme-option--active' : ''}}"
          data-theme="{{item.id}}"
          bindtap="selectTheme"
          hover-class="pressing"
          aria-role="button"
          aria-label="{{item.label}}主题"
        >
          <view class="theme-swatch theme-swatch--{{item.id}}">
          </view>
          <text class="theme-option-label">{{item.label}}</text>
        </view>
      </view>
      <view class="menu-separator"></view>
      <view class="menu-action pressable" bindtap="openSemesterMenu" hover-class="pressing">
        <view class="menu-action-icon menu-action-icon--semester"><lucide-icon name="calendar-days" tone="coral" size="{{25}}"></lucide-icon></view>
        <text class="menu-action-label">选择学期</text>
        <text class="menu-action-value">{{semesterShortLabel}}</text>
        <lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon>
      </view>
      <view class="menu-action pressable" bindtap="openCalendar" hover-class="pressing">
        <view class="menu-action-icon"><lucide-icon name="calendar-range" tone="coral" size="{{25}}"></lucide-icon></view>
        <text class="menu-action-label">查看校历</text>
        <lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon>
      </view>
      <view class="menu-action pressable" bindtap="goToday" hover-class="pressing">
        <view class="menu-action-icon menu-action-icon--blue"><lucide-icon name="calendar-check" tone="sage" size="{{25}}"></lucide-icon></view>
        <text class="menu-action-label">回到本周</text>
        <lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon>
      </view>
      <view class="menu-action pressable" bindtap="onRefresh" hover-class="pressing">
        <view class="menu-action-icon menu-action-icon--amber"><lucide-icon name="refresh-cw" tone="amber" size="{{25}}"></lucide-icon></view>
        <text class="menu-action-label">刷新课表</text>
        <lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon>
      </view>
    </view>
    <view class="menu-panel menu-panel--semester">
      <view class="submenu-header">
        <view class="submenu-back pressable" bindtap="backToMainMenu" hover-class="pressing" aria-role="button" aria-label="返回课表菜单">
          <lucide-icon name="arrow-left" tone="ink" size="{{24}}"></lucide-icon>
        </view>
        <text>选择学期</text>
      </view>
      <scroll-view class="semester-list" type="list" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{semesters}}"
          wx:key="id"
          class="semester-option pressable {{semesterId === item.id ? 'semester-option--active' : ''}}"
          data-semester="{{item.id}}"
          bindtap="selectSemester"
          hover-class="pressing"
        >
          <text>{{item.displayLabel}}</text>
          <lucide-icon wx:if="{{semesterId === item.id}}" name="check" tone="coral" size="{{23}}"></lucide-icon>
        </view>
      </scroll-view>
    </view>
  </view>

  <bottom-sheet visible="{{courseSheetVisible}}" expanded="{{true}}" scrollable="{{false}}" expanded-height="{{courseSheetHeight}}" title="课程详情" theme="{{theme}}" bindclose="closeCourse">
    <scroll-view class="course-sheet-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}" bounces>
      <view wx:if="{{selectedCourse}}" class="course-sheet">
        <view class="course-sheet-hero course-sheet-hero--{{selectedCourse.tone}}">
          <view class="ambient-blob course-sheet-blob"></view>
          <view class="course-sheet-hero-main">
            <view class="course-sheet-hero-copy">
              <text class="course-sheet-kicker" overflow="ellipsis" max-lines="1">{{selectedCourse.periodLabel}} · {{selectedCourse.weekText}}</text>
              <text class="course-sheet-title display-title">{{selectedCourse.name}}</text>
              <text class="course-sheet-teacher" overflow="ellipsis" max-lines="1">{{selectedCourse.teacher}} · {{selectedCourse.activityTypeLabel}}</text>
            </view>
            <view class="course-pass-rate-action pressable" bindtap="openCoursePassRate" hover-class="course-pass-rate-action--pressed" aria-role="button" aria-label="查看{{selectedCourse.name}}通过率">
              <text>查看通过率</text>
              <lucide-icon name="chevron-right" tone="white" size="{{28}}"></lucide-icon>
            </view>
          </view>
        </view>
        <view class="course-sheet-info card">
          <view class="course-sheet-row"><text>上课地点</text><text>{{selectedCourse.location}}</text></view>
          <view class="course-sheet-row"><text>上课时间</text><text>{{selectedCourse.displayTimeLabel}}</text></view>
          <view class="course-sheet-row"><text>教学周次</text><text>{{selectedCourse.weekText}}</text></view>
          <view wx:if="{{selectedCourse.credits !== null}}" class="course-sheet-row"><text>学分</text><text>{{selectedCourse.credits}}</text></view>
          <view wx:if="{{selectedCourse.teachingClass}}" class="course-sheet-row"><text>教学班</text><text>{{selectedCourse.teachingClass}}</text></view>
          <view wx:if="{{selectedCourse.nature}}" class="course-sheet-row"><text>课程性质</text><text>{{selectedCourse.nature}}</text></view>
          <view wx:if="{{selectedCourse.assessmentMethod}}" class="course-sheet-row"><text>考核方式</text><text>{{selectedCourse.assessmentMethod}}</text></view>
        </view>
      </view>
      <view class="course-sheet-bottom-space"></view>
    </scroll-view>
  </bottom-sheet>

  <bottom-sheet visible="{{passRateSheetVisible}}" expanded="{{true}}" expanded-height="{{passRateSheetHeight}}" compact-header="{{true}}" scrollable="{{false}}" title="课程通过率" theme="{{theme}}" bindclose="closeCoursePassRate">
    <scroll-view class="course-pass-rate-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}" bounces>
      <view class="course-pass-rate-content">
        <loading-view wx:if="{{passRateLoading}}" label="正在加载通过率"></loading-view>
        <empty-state wx:elif="{{passRateErrorMessage}}" compact icon="circle-alert" icon-tone="danger" title="通过率加载失败" description="{{passRateErrorMessage}}" action-text="重试" bindaction="openCoursePassRate"></empty-state>
        <block wx:elif="{{passRateCourse}}">
          <view class="course-pass-rate-heading">
            <text class="course-pass-rate-name" overflow="ellipsis" max-lines="2">{{passRateCourse.courseName || passRateCourseName}}</text>
            <text class="course-pass-rate-meta">通过率 · 得分分布{{passRateCohortLabel ? ' · ' + passRateCohortLabel : ''}}</text>
          </view>
          <pass-rate-card wx:if="{{passRateStatus === 'ready' && passRateStatistics}}" statistics="{{passRateStatistics}}" own-score="{{passRateOwnScore}}" display-score="{{passRateDisplayScore}}" show-own-score="{{passRateCourse.hasOwnGrade && passRateOwnScore >= 0}}" theme="{{theme}}"></pass-rate-card>
          <view wx:else class="course-pass-rate-collecting card">
            <view class="course-pass-rate-collecting-icon"><lucide-icon name="chart-no-axes-column-increasing" tone="amber" size="{{40}}"></lucide-icon></view>
            <text>{{passRateMessage}}</text>
          </view>
        </block>
      </view>
      <view class="course-pass-rate-bottom-space"></view>
    </scroll-view>
  </bottom-sheet>
</view>
