<view class="page timetable-page {{themeClass}} {{motionClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bindscroll="onScroll"
  >
    <navigation-bar title="课表" subtitle="占位数据" back transparent scrolled="{{headerScrolled}}" theme="{{theme}}"></navigation-bar>
    <view class="timetable-content page-content page-enter">
      <view class="demo-banner">
        <view class="demo-dot"></view>
        <text>当前为界面占位数据，不会请求后端</text>
      </view>

      <view class="week-heading">
        <view>
          <text class="week-title">本周课程</text>
          <text class="week-caption">当前时间 {{currentTime}} · 用户所在时区</text>
        </view>
        <view class="today-button pressable" bindtap="goToday" hover-class="pressing" aria-role="button"><text>今天</text></view>
      </view>

      <view class="week-strip card">
        <view
          wx:for="{{days}}"
          wx:key="weekday"
          class="day-option {{selectedWeekday === item.weekday ? 'day-option--active' : ''}}"
          data-weekday="{{item.weekday}}"
          bindtap="selectDay"
          hover-class="day-option--pressed"
          aria-role="button"
          aria-label="周{{item.shortLabel}} {{item.dateLabel}}日"
        >
          <text class="day-name">{{item.isToday ? '今' : item.shortLabel}}</text>
          <text class="day-date">{{item.dateLabel}}</text>
          <view wx:if="{{item.hasCourses}}" class="day-course-dot"></view>
        </view>
      </view>

      <view class="schedule-heading">
        <view>
          <text class="schedule-date">{{selectedDateLabel}}</text>
          <text class="schedule-count">{{courseCount ? courseCount + ' 门课程' : '没有课程'}}</text>
        </view>
      </view>

      <view wx:if="{{courses.length}}" class="course-timeline">
        <view
          wx:for="{{courses}}"
          wx:key="id"
          class="course-timeline-row stagger-item {{item.state === 'finished' ? 'course-timeline-row--finished' : ''}}"
          style="animation-delay: {{index < 6 ? index * 35 : 0}}ms;"
        >
          <view class="course-time-column">
            <text class="course-start">{{item.startTime}}</text>
            <text class="course-end">{{item.endTime}}</text>
          </view>
          <view class="timeline-rail">
            <view class="timeline-dot timeline-dot--{{item.tone}} {{item.state === 'current' ? 'timeline-dot--current' : ''}}"></view>
            <view wx:if="{{index < courses.length - 1}}" class="timeline-line"></view>
          </view>
          <view class="course-card card course-card--{{item.tone}}">
            <view class="course-card-head">
              <text class="course-name" overflow="ellipsis" max-lines="2">{{item.name}}</text>
              <text class="course-state course-state--{{item.state}}">{{item.stateLabel}}</text>
            </view>
            <view class="course-location-row">
              <view class="course-pin"><view class="course-pin-core"></view></view>
              <text class="course-location" overflow="ellipsis" max-lines="1">{{item.location}}</text>
            </view>
            <text class="course-teacher">{{item.teacher}} · {{item.periodLabel}}</text>
          </view>
        </view>
      </view>

      <empty-state
        wx:else
        glyph="休"
        title="今天没有课程"
        description="可以切换到其他日期查看占位课表"
        action-text="回到今天"
        bindaction="goToday"
      ></empty-state>

      <view class="placeholder-note">
        <view class="placeholder-note-dot"></view>
        <text>这里只用于预览课表布局与交互，不代表当前账号的真实课程安排。</text>
      </view>
    </view>
  </scroll-view>
</view>
