.timetable-page {
  --timetable-chrome: #fff;
  --timetable-chrome-muted: rgba(255, 255, 255, 0.78);
  --timetable-chrome-subtle: rgba(255, 255, 255, 0.56);
  --timetable-chrome-faint: rgba(255, 255, 255, 0.52);
  --timetable-header-border: rgba(255, 255, 255, 0.16);
  --timetable-header-surface: rgba(255, 255, 255, 0.14);
  --timetable-header-surface-pressed: rgba(255, 255, 255, 0.2);
  --timetable-header-shadow: rgba(0, 32, 84, 0.14);
  --timetable-week-shadow: rgba(0, 32, 84, 0.12);
  --timetable-today-background: #fff;
  --timetable-today-text: #075ca8;
  --timetable-today-shadow: rgba(0, 31, 78, 0.18);
  --timetable-course-blue: #0862ad;
  --timetable-course-cyan: #0862ad;
  --timetable-course-purple: #0862ad;
  --timetable-course-green: #0862ad;
  --timetable-course-orange: #0862ad;
  --timetable-course-rose: #0862ad;
  --timetable-course-yellow: #0862ad;
  --timetable-course-mint: #0862ad;
  --timetable-course-blue-text: #ffffff;
  --timetable-course-cyan-text: #ffffff;
  --timetable-course-purple-text: #ffffff;
  --timetable-course-green-text: #ffffff;
  --timetable-course-orange-text: #ffffff;
  --timetable-course-rose-text: #ffffff;
  --timetable-course-yellow-text: #ffffff;
  --timetable-course-mint-text: #ffffff;
  --timetable-course-border: #fff;
  --timetable-course-blue-border: var(--timetable-course-border);
  --timetable-course-cyan-border: var(--timetable-course-border);
  --timetable-course-purple-border: var(--timetable-course-border);
  --timetable-course-green-border: var(--timetable-course-border);
  --timetable-course-orange-border: var(--timetable-course-border);
  --timetable-course-rose-border: var(--timetable-course-border);
  --timetable-course-yellow-border: var(--timetable-course-border);
  --timetable-course-mint-border: var(--timetable-course-border);
  --timetable-course-shadow: rgba(0, 31, 75, 0.17);

  display: flex;
  flex-direction: column;
  color: var(--timetable-chrome);
  background: #0862ad;
  transition:
    color 300ms ease,
    background-color 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

.timetable-theme--companion,
.timetable-theme--clawd,
.timetable-theme--snack,
.timetable-theme--vivid {
  --timetable-chrome: #34302b;
  --timetable-chrome-muted: rgba(52, 48, 43, 0.75);
  --timetable-chrome-subtle: rgba(52, 48, 43, 0.56);
  --timetable-chrome-faint: rgba(52, 48, 43, 0.5);
  --timetable-header-border: rgba(62, 53, 45, 0.08);
  --timetable-header-surface: rgba(255, 255, 255, 0.62);
  --timetable-header-surface-pressed: rgba(255, 255, 255, 0.86);
  --timetable-header-shadow: rgba(88, 69, 52, 0.11);
  --timetable-week-shadow: rgba(88, 69, 52, 0.1);
  --timetable-today-background: #34302b;
  --timetable-today-text: #fffdf8;
  --timetable-today-shadow: rgba(88, 69, 52, 0.14);
  --timetable-course-border: rgba(255, 255, 255, 0.88);
  --timetable-course-shadow: rgba(62, 48, 37, 0.13);
}

.timetable-background {
  position: absolute;
  z-index: 0;
  display: block;
  transform-origin: center top;
}

.timetable-theme--clawd .timetable-background {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.86;
}

.background-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 43, 104, 0.12),
    rgba(0, 48, 111, 0.25)
  );
  pointer-events: none;
}

.timetable-theme--companion .background-shade {
  background-image:
    radial-gradient(circle at 84% 78%, var(--companion-wash), transparent 42%),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.16),
      rgba(255, 235, 209, 0.08)
    );
}

.timetable-theme--companion.timetable-companion-background--plain
  .background-shade {
  background: none;
}

.timetable-theme--clawd .background-shade {
  background: linear-gradient(
    180deg,
    rgba(248, 247, 242, 0.08),
    rgba(248, 247, 242, 0.34)
  );
}

.timetable-theme--snack .background-shade {
  background: linear-gradient(
    180deg,
    rgba(255, 253, 250, 0.04),
    rgba(241, 237, 244, 0.42)
  );
}

.timetable-theme--vivid .background-shade {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.38),
    rgba(232, 230, 237, 0.24)
  );
}

.clawd-ambient-layer,
.timetable-companion-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  overflow: hidden;
  pointer-events: none;
}

.clawd-scene-stage {
  position: absolute;
  top: 42%;
  left: 195rpx;
  display: block;
  flex: none;
  width: 360rpx;
  height: 242rpx;
  opacity: 0;
  pointer-events: none;
}

.clawd-scene-media {
  display: block;
  width: 100%;
  height: 100%;
}

.clawd-scene-media--mirrored {
  transform: scaleX(-1);
}

.clawd-scene-motion--anchored {
  opacity: 0.44;
}

.clawd-scene-motion--emerge-from-left,
.clawd-scene-motion--emerge-from-right,
.clawd-scene-motion--walk-exit-left,
.clawd-scene-motion--walk-exit-right {
  animation-duration: 1940ms;
  animation-timing-function: linear;
  animation-fill-mode: both;
}

.clawd-scene-motion--lurk-from-left,
.clawd-scene-motion--lurk-from-right {
  animation-duration: 5580ms;
  animation-timing-function: linear;
  animation-fill-mode: both;
}

.clawd-scene-motion--emerge-from-left {
  animation-name: clawd-emerge-from-left;
}

.clawd-scene-motion--emerge-from-right {
  animation-name: clawd-emerge-from-right;
}

.clawd-scene-motion--walk-exit-left {
  animation-name: clawd-walk-exit-left;
}

.clawd-scene-motion--walk-exit-right {
  animation-name: clawd-walk-exit-right;
}

.clawd-scene-motion--lurk-from-left {
  animation-name: clawd-lurk-from-left;
}

.clawd-scene-motion--lurk-from-right {
  animation-name: clawd-lurk-from-right;
}

.clawd-scene-motion--race-enter-left,
.clawd-scene-motion--race-enter-right,
.clawd-scene-motion--race-bridge-exit-left,
.clawd-scene-motion--race-bridge-exit-right {
  animation-duration: 4090ms;
  animation-timing-function: linear;
  animation-fill-mode: both;
}

.clawd-scene-motion--race-exit-left,
.clawd-scene-motion--race-exit-right {
  animation-duration: 4090ms;
  animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
  animation-fill-mode: both;
}

.clawd-scene-motion--race-enter-left {
  animation-name: clawd-race-enter-left;
}

.clawd-scene-motion--race-enter-right {
  animation-name: clawd-race-enter-right;
}

.clawd-scene-motion--race-bridge-exit-left {
  animation-name: clawd-race-bridge-exit-left;
}

.clawd-scene-motion--race-bridge-exit-right {
  animation-name: clawd-race-bridge-exit-right;
}

.clawd-scene-motion--race-exit-left {
  animation-name: clawd-race-exit-left;
}

.clawd-scene-motion--race-exit-right {
  animation-name: clawd-race-exit-right;
}

.clawd-scene-motion--row-enter-left,
.clawd-scene-motion--row-enter-right,
.clawd-scene-motion--row-exit-left,
.clawd-scene-motion--row-exit-right {
  animation-duration: 1840ms;
  animation-timing-function: linear;
  animation-fill-mode: both;
}

.clawd-scene-motion--row-enter-left {
  animation-name: clawd-row-enter-left;
}

.clawd-scene-motion--row-enter-right {
  animation-name: clawd-row-enter-right;
}

.clawd-scene-motion--row-exit-left {
  animation-name: clawd-row-exit-left;
}

.clawd-scene-motion--row-exit-right {
  animation-name: clawd-row-exit-right;
}

.clawd-scene {
  position: absolute;
  display: block;
  flex: none;
}

.clawd-scene--still {
  right: 28rpx;
  bottom: 10%;
  width: 112rpx;
  height: 90rpx;
  opacity: 0.3;
}

.timetable-companion-frame {
  position: absolute;
  right: 4%;
  bottom: 6%;
  width: 188rpx;
  height: 188rpx;
  opacity: 0.62;
  transform-origin: center bottom;
  animation-name: companion-wander;
  animation-duration: 22s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.timetable-header {
  position: relative;
  z-index: 100;
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  width: 100%;
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.header-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid var(--timetable-header-border);
  border-radius: 50%;
  background-color: var(--timetable-header-surface);
  box-shadow: 0 12rpx 34rpx var(--timetable-header-shadow);
  backdrop-filter: blur(18px) saturate(1.35);
  transition:
    opacity 120ms ease,
    transform 120ms ease;
}

.header-button--pressed {
  transform: scale(0.92);
  opacity: 0.82;
}

.menu-glyph {
  position: relative;
  width: 27rpx;
  height: 25rpx;
  transform: translateY(-2rpx);
}

.menu-glyph > view {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 3rpx;
  margin-top: -1.5rpx;
  border-radius: 999rpx;
  background-color: var(--timetable-chrome);
  transition:
    opacity 180ms ease,
    transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
}

.menu-glyph > view:nth-child(1) {
  transform: translateY(-8rpx);
}
.menu-glyph > view:nth-child(2) {
  transform: translateY(0);
}
.menu-glyph > view:nth-child(3) {
  transform: translateY(8rpx);
}
.menu-glyph--open > view:nth-child(1) {
  transform: rotate(45deg);
}
.menu-glyph--open > view:nth-child(2) {
  opacity: 0;
  transform: scaleX(0.2);
}
.menu-glyph--open > view:nth-child(3) {
  transform: rotate(-45deg);
}

.header-week {
  position: absolute;
  left: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  min-width: 146rpx;
  max-width: 176rpx;
  padding: 0 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--timetable-header-border);
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 780;
  letter-spacing: -0.5rpx;
  background-color: var(--timetable-header-surface);
  box-shadow: 0 10rpx 30rpx var(--timetable-week-shadow);
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translate(-50%, -50%);
  transform-origin: center;
  backdrop-filter: blur(18px) saturate(1.35);
  transition:
    background-color 180ms ease,
    transform 180ms ease;
}

.header-week--pressed {
  background-color: var(--timetable-header-surface-pressed);
  transform: translate(-50%, -50%) scale(0.94);
}

.week-chevron {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 18rpx;
  height: 18rpx;
  opacity: 0.72;
  transform: rotate(90deg);
  transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.header-week--open .week-chevron {
  transform: rotate(-90deg);
}

.week-swiper {
  position: relative;
  z-index: 2;
  flex: 1;
  width: 100%;
  min-height: 0;
}

.week-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 6rpx 10rpx 0;
}

.week-grid-head {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: flex-end;
  min-height: 78rpx;
  padding-bottom: 6rpx;
}

.month-head {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  color: var(--timetable-chrome-muted);
  font-weight: 760;
}

.month-number,
.weekday-label {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 24rpx;
  line-height: 24rpx;
}

.month-number {
  font-size: 28rpx;
  font-weight: 820;
  letter-spacing: -1rpx;
}

.month-unit {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 43rpx;
  height: 43rpx;
  margin-top: 5rpx;
  font-size: 25rpx;
  font-weight: 780;
  line-height: 43rpx;
}

.grid-day-head {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: var(--timetable-chrome-subtle);
}

.weekday-label {
  font-size: 20rpx;
  font-weight: 650;
}

.grid-day-date {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 43rpx;
  height: 43rpx;
  margin-top: 5rpx;
  border-radius: 50%;
  color: var(--timetable-chrome-muted);
  font-size: 20rpx;
  font-weight: 800;
}

.grid-day-head--today {
  color: var(--timetable-chrome);
}
.grid-day-head--today .grid-day-date {
  color: var(--timetable-today-text);
  background-color: var(--timetable-today-background);
  box-shadow: 0 8rpx 24rpx var(--timetable-today-shadow);
}

.week-grid-body {
  display: flex;
  flex: 1;
  flex-direction: row;
  min-height: 0;
}

.time-scale {
  display: flex;
  flex: none;
  flex-direction: column;
  width: 64rpx;
}

.period-row {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

.period-number {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
}

.period-time {
  display: block;
  margin-top: 5rpx;
  color: var(--timetable-chrome-faint);
  font-size: 16rpx;
  font-weight: 620;
  line-height: 1;
  white-space: nowrap;
}

.grid-days {
  display: flex;
  flex: 1;
  flex-direction: row;
  min-width: 0;
}

.grid-day-column {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.period-grid-line {
  flex: 1;
  min-height: 0;
}

.grid-course-slot {
  position: absolute;
  right: 0;
  left: 0;
  z-index: 3;
  padding: 2rpx;
}

.grid-course {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
  align-items: flex-start;
  padding: 4rpx;
  overflow: hidden;
  border: 3rpx solid var(--timetable-course-border);
  border-radius: 13rpx;
  color: var(--timetable-course-blue-text);
  background-color: var(--timetable-course-blue);
  box-shadow: 0 8rpx 18rpx var(--timetable-course-shadow);
}

.grid-course--blue {
  border-color: var(--timetable-course-blue-border);
  color: var(--timetable-course-blue-text);
  background-color: var(--timetable-course-blue);
}

.grid-course--cyan {
  border-color: var(--timetable-course-cyan-border);
  color: var(--timetable-course-cyan-text);
  background-color: var(--timetable-course-cyan);
}

.grid-course--purple {
  border-color: var(--timetable-course-purple-border);
  color: var(--timetable-course-purple-text);
  background-color: var(--timetable-course-purple);
}

.grid-course--green {
  border-color: var(--timetable-course-green-border);
  color: var(--timetable-course-green-text);
  background-color: var(--timetable-course-green);
}

.grid-course--orange {
  border-color: var(--timetable-course-orange-border);
  color: var(--timetable-course-orange-text);
  background-color: var(--timetable-course-orange);
}

.grid-course--rose {
  border-color: var(--timetable-course-rose-border);
  color: var(--timetable-course-rose-text);
  background-color: var(--timetable-course-rose);
}

.grid-course--yellow {
  border-color: var(--timetable-course-yellow-border);
  color: var(--timetable-course-yellow-text);
  background-color: var(--timetable-course-yellow);
}

.grid-course--mint {
  border-color: var(--timetable-course-mint-border);
  color: var(--timetable-course-mint-text);
  background-color: var(--timetable-course-mint);
}

.timetable-theme--snack .grid-course,
.timetable-theme--vivid .grid-course {
  border: 0;
}

.grid-course--pressed {
  transform: scale(0.94);
}

.grid-course-name {
  display: block;
  flex: none;
  flex-shrink: 0;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: 0;
}

.grid-course-room,
.grid-course-teacher {
  display: block;
  flex: none;
  flex-shrink: 0;
  width: 100%;
  min-width: 0;
  margin-top: 3rpx;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 680;
  line-height: 1.08;
  letter-spacing: 0;
}

.grid-course-text-line {
  display: block;
  width: 100%;
  overflow: hidden;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  text-overflow: clip;
  white-space: nowrap;
}

.timetable-empty {
  position: relative;
  z-index: 2;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--timetable-chrome-muted);
  font-size: 27rpx;
  font-weight: 700;
}

.timetable-empty text + text {
  margin-top: 7rpx;
  color: var(--timetable-chrome-faint);
  font-size: 21rpx;
  font-weight: 550;
}

.popover-dismiss {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 70;
  pointer-events: none;
}

.popover-dismiss--open {
  pointer-events: auto;
}

.week-popover-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease;
}

.week-popover-layer--open {
  opacity: 1;
  pointer-events: auto;
}

.week-popover-dismiss {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.week-popover {
  position: absolute;
  left: 50%;
  width: 520rpx;
  max-width: calc(100% - 48rpx);
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 34rpx;
  color: #17171b;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 34rpx 90rpx -16rpx rgba(0, 31, 78, 0.34);
  opacity: 0;
  transform: translateX(-50%) translateY(-12rpx) scale(0.9);
  transform-origin: top center;
  backdrop-filter: blur(24px) saturate(1.4);
  transition:
    opacity 220ms ease,
    transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
}

.week-popover-layer--open .week-popover {
  opacity: 1;
  transform: translateX(-50%) translateY(0) scale(1);
}

.week-popover-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 25rpx 28rpx 12rpx;
}

.week-popover-header text:first-child {
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.week-popover-header text:last-child {
  max-width: 250rpx;
  overflow: hidden;
  color: #9a958b;
  font-size: 18rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-option-scroll {
  max-height: 448rpx;
}

.week-options-top-space {
  width: 100%;
  height: 8rpx;
}

.week-options-bottom-space {
  width: 100%;
  height: 24rpx;
}

.week-option-row {
  display: flex;
  flex: none;
  flex-direction: row;
  gap: 10rpx;
  width: 100%;
  height: 86rpx;
  padding: 0 20rpx 10rpx;
}

.week-option {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 0;
  min-width: 0;
  height: 76rpx;
  border: 3rpx solid transparent;
  border-radius: 999rpx;
  color: #817b70;
  background: #f3f1eb;
  transition:
    color 180ms ease,
    background-color 180ms ease,
    transform 120ms ease;
}

.week-option--pressed {
  transform: scale(0.94);
}

.week-option--current {
  border-color: #0862ad;
  color: #0862ad;
}

.week-option--active {
  border-color: #0862ad;
  color: #fff;
  background: #0862ad;
  box-shadow: 0 10rpx 24rpx rgba(8, 98, 173, 0.22);
}

.week-option-number {
  display: block;
  flex: none;
  width: 100%;
  font-size: 24rpx;
