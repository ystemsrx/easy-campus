.timetable-page {
  display: flex;
  flex-direction: column;
  color: #fff;
  background: #0862ad;
  transition: background-color 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

.timetable-background {
  position: absolute;
  z-index: 0;
  display: block;
  transform-origin: center top;
}

.background-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  background: linear-gradient(180deg, rgba(0, 43, 104, 0.12), rgba(0, 48, 111, 0.25));
  pointer-events: none;
}

.timetable-header {
  position: relative;
  z-index: 30;
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  width: 100%;
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.header-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.header-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  box-shadow: 0 12rpx 34rpx rgba(0, 32, 84, 0.14);
  backdrop-filter: blur(18px) saturate(1.35);
}

.header-button--pressed,
.semester-trigger--pressed {
  transform: scale(0.92);
  opacity: 0.82;
}

.menu-glyph {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 27rpx;
}

.menu-glyph > view {
  width: 100%;
  height: 3rpx;
  border-radius: 999rpx;
  background: #fff;
}

.header-week {
  position: absolute;
  top: 50%;
  left: 50%;
  max-width: 150rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 780;
  letter-spacing: -0.5rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translate(-50%, -50%);
}

.semester-trigger {
  position: absolute;
  top: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5rpx;
  max-width: 154rpx;
  min-height: 58rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  box-shadow: 0 12rpx 34rpx rgba(0, 32, 84, 0.12);
  font-size: 21rpx;
  font-weight: 760;
  white-space: nowrap;
  transform: translateY(-50%);
  backdrop-filter: blur(18px) saturate(1.35);
}

.semester-trigger > text {
  display: block;
  flex: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.semester-chevron {
  display: flex;
  flex: none;
  transform: rotate(90deg);
  transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
}

.semester-chevron--open { transform: rotate(-90deg); }

.week-swiper {
  position: relative;
  z-index: 2;
  flex: 1;
  width: 100%;
  min-height: 0;
}

.week-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 6rpx 10rpx calc(4rpx + env(safe-area-inset-bottom));
}

.week-grid-head {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: flex-end;
  min-height: 78rpx;
  padding-bottom: 6rpx;
}

.month-head {
  display: flex;
  flex: none;
  align-items: flex-end;
  justify-content: center;
  width: 56rpx;
  padding-bottom: 7rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 19rpx;
  font-weight: 760;
}

.grid-day-head {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  color: rgba(255, 255, 255, 0.56);
}

.weekday-label {
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1;
}

.grid-day-date {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 43rpx;
  height: 43rpx;
  margin-top: 5rpx;
  border-radius: 50%;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 800;
}

.grid-day-head--today { color: #fff; }
.grid-day-head--today .grid-day-date {
  color: #075ca8;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 31, 78, 0.18);
}

.week-grid-body {
  display: flex;
  flex: 1;
  flex-direction: row;
  min-height: 0;
}

.time-scale {
  display: flex;
  flex: none;
  flex-direction: column;
  width: 56rpx;
}

.period-row {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

.period-number {
  display: block;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.period-time {
  display: block;
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 11rpx;
  font-weight: 560;
  line-height: 1;
  white-space: nowrap;
}

.grid-days {
  display: flex;
  flex: 1;
  flex-direction: row;
  min-width: 0;
}

.grid-day-column {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  border-left: 1rpx solid rgba(255, 255, 255, 0.09);
}

.period-grid-line {
  flex: 1;
  min-height: 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.grid-course-slot {
  position: absolute;
  right: 0;
  left: 0;
  z-index: 3;
  padding: 3rpx;
}

.grid-course {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
  padding: 9rpx 7rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 15rpx;
  color: #703d2f;
  background: #f3c4b4;
  box-shadow: 0 8rpx 18rpx rgba(0, 31, 75, 0.17);
}

.grid-course--cyan { color: #315f59; background: #b9ddd7; }
.grid-course--purple { color: #554569; background: #d8cae5; }
.grid-course--green { color: #4e623f; background: #ceddbc; }
.grid-course--orange { color: #815a1d; background: #efd49d; }
.grid-course--pressed { transform: scale(0.94); opacity: 0.86; }

.grid-course-name {
  display: block;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.25;
  word-break: break-all;
}

.grid-course-room,
.grid-course-teacher {
  display: block;
  margin-top: auto;
  font-size: 14rpx;
  font-weight: 680;
  line-height: 1.2;
  opacity: 0.78;
  word-break: break-all;
}

.grid-course-teacher {
  margin-top: 3rpx;
  opacity: 0.66;
}

.week-footer {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  min-height: 35rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 17rpx;
  font-weight: 560;
}

.footer-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
}

.timetable-empty {
  position: relative;
  z-index: 2;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
  font-weight: 700;
}

.timetable-empty text + text {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.46);
  font-size: 21rpx;
  font-weight: 550;
}

.popover-dismiss {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 70;
}

.timetable-menu,
.semester-popover {
  position: absolute;
  z-index: 80;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 38rpx;
  color: #16161a;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 38rpx 110rpx -18rpx rgba(0, 30, 72, 0.36);
  backdrop-filter: blur(24px) saturate(1.4);
  transform-origin: top left;
}

.timetable-menu {
  left: 88rpx;
  width: 450rpx;
  padding: 25rpx 22rpx 18rpx;
}

.semester-popover {
  width: 380rpx;
  padding: 20rpx 14rpx 14rpx;
  transform-origin: top right;
}

.popover-enter {
  animation-name: popover-materialize;
  animation-duration: 300ms;
  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  animation-fill-mode: both;
}

.menu-label {
  display: block;
  padding: 0 9rpx 16rpx;
  color: #a39e92;
  font-size: 19rpx;
  font-weight: 760;
  letter-spacing: 2rpx;
}

.theme-options {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 5rpx;
}

.theme-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border: 4rpx solid transparent;
  border-radius: 50%;
}

.theme-option--active { border-color: rgba(184, 92, 56, 0.24); }

.theme-swatch {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  overflow: hidden;
  border-radius: 50%;
}

.theme-swatch > image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.theme-swatch > lucide-icon { position: relative; }

.menu-separator {
  height: 1rpx;
  margin: 18rpx 6rpx 8rpx;
  background: rgba(43, 38, 32, 0.07);
}

.menu-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 15rpx;
  min-height: 72rpx;
  padding: 7rpx 8rpx;
  border-radius: 22rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.menu-action > text { flex: 1; }

.menu-action-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 17rpx;
  background: #f9eae2;
}

.menu-action-icon--blue { background: #edf1e6; }
.menu-action-icon--amber { background: #f8eedd; }

.semester-list {
  max-height: 520rpx;
}

.semester-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
  min-height: 78rpx;
  padding: 12rpx 20rpx;
  border-radius: 26rpx;
  color: #8b8578;
  font-size: 22rpx;
  font-weight: 650;
}

.semester-option > text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.semester-option--active {
  color: #16161a;
  background: #f6f3ec;
  font-weight: 760;
}

.course-sheet-hero {
  position: relative;
  padding: 34rpx;
  overflow: hidden;
  border-radius: 46rpx;
  color: #fff;
  background: linear-gradient(140deg, #d97757, #eba97f);
}

.course-sheet-hero--cyan { background: linear-gradient(140deg, #70a89d, #a7ccc4); }
.course-sheet-hero--purple { background: linear-gradient(140deg, #8b70a5, #bca9cd); }
.course-sheet-hero--green { background: linear-gradient(140deg, #7d8f6e, #acbe97); }
.course-sheet-hero--orange { background: linear-gradient(140deg, #c98a2d, #e5b86e); }
.course-sheet-blob { top: -60rpx; right: -50rpx; width: 210rpx; height: 190rpx; background: rgba(255, 255, 255, 0.16); }
.course-sheet-kicker { position: relative; display: block; color: rgba(255, 255, 255, 0.72); font-size: 21rpx; font-weight: 750; letter-spacing: 2rpx; }
.course-sheet-title { position: relative; display: block; margin-top: 6rpx; font-size: 43rpx; font-weight: 700; line-height: 1.3; }
.course-sheet-teacher { position: relative; display: block; margin-top: 7rpx; color: rgba(255, 255, 255, 0.8); font-size: 22rpx; }
.course-sheet-info { margin-top: 22rpx; overflow: hidden; }
.course-sheet-row { display: flex; flex-direction: row; justify-content: space-between; gap: 30rpx; padding: 23rpx 28rpx; border-bottom: 1rpx solid var(--color-separator); }
.course-sheet-row:last-child { border-bottom: 0; }
.course-sheet-row text:first-child { flex: none; color: #9a9aa3; font-size: 22rpx; }
.course-sheet-row text:last-child { color: var(--color-text); font-size: 23rpx; font-weight: 650; text-align: right; }

@keyframes popover-materialize {
  0% { opacity: 0; transform: scale(0.72); }
  100% { opacity: 1; transform: scale(1); }
}

.motion-reduced .popover-enter { animation-duration: 1ms; }
