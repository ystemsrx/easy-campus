.timetable-page {
  background-color: var(--color-bg);
}

.timetable-content {
  padding-top: 22rpx;
}

.demo-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 19rpx 22rpx;
  border-radius: 22rpx;
  color: var(--color-warning);
  background-color: var(--color-warning-soft);
  font-size: 21rpx;
  font-weight: 550;
}

.demo-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin-right: 13rpx;
  border-radius: 50%;
  background-color: var(--color-warning);
}

.week-heading,
.schedule-heading {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}

.week-heading {
  margin: 34rpx 4rpx 20rpx;
}

.week-title,
.schedule-date {
  display: block;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 720;
  line-height: 1.2;
  letter-spacing: -0.6rpx;
}

.week-caption,
.schedule-count {
  display: block;
  margin-top: 7rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
}

.today-button {
  padding: 12rpx 21rpx;
  border-radius: 999rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  font-size: 21rpx;
  font-weight: 650;
}

.week-strip {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 14rpx;
}

.day-option {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 112rpx;
  border-radius: 25rpx;
  color: var(--color-text-tertiary);
  transform: scale(1);
  transition: transform 100ms ease-out, color 180ms ease, background-color 240ms ease;
}

.day-option--active {
  color: #ffffff;
  background-color: var(--color-primary);
  box-shadow: 0 13rpx 28rpx rgba(22, 119, 255, 0.22);
}

.day-option--pressed {
  transform: scale(0.93);
}

.day-name {
  font-size: 19rpx;
  font-weight: 620;
}

.day-date {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 690;
}

.day-course-dot {
  position: absolute;
  bottom: 9rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
}

.day-option--active .day-course-dot {
  background-color: rgba(255, 255, 255, 0.82);
}

.schedule-heading {
  margin: 38rpx 4rpx 22rpx;
}

.course-timeline-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 194rpx;
}

.course-timeline-row--finished {
  opacity: 0.48;
}

.course-time-column {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  width: 88rpx;
  padding-top: 24rpx;
}

.course-start {
  color: var(--color-text);
  font-size: 23rpx;
  font-weight: 660;
}

.course-end {
  margin-top: 7rpx;
  color: var(--color-text-tertiary);
  font-size: 18rpx;
}

.timeline-rail {
  position: relative;
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  width: 54rpx;
}

.timeline-dot {
  z-index: 1;
  width: 18rpx;
  height: 18rpx;
  margin-top: 29rpx;
  border: 5rpx solid var(--color-bg);
  border-radius: 50%;
  background-color: var(--color-primary);
  box-shadow: 0 0 0 2rpx var(--color-primary-soft);
}

.timeline-dot--cyan { background-color: #0797a8; box-shadow: 0 0 0 2rpx #dff7f9; }
.timeline-dot--purple { background-color: #7258d6; box-shadow: 0 0 0 2rpx #eee9ff; }
.timeline-dot--green { background-color: var(--color-success); box-shadow: 0 0 0 2rpx var(--color-success-soft); }
.timeline-dot--orange { background-color: var(--color-warning); box-shadow: 0 0 0 2rpx var(--color-warning-soft); }

.timeline-dot--current {
  width: 22rpx;
  height: 22rpx;
  margin-top: 27rpx;
  box-shadow: 0 0 0 9rpx var(--color-primary-soft);
}

.timeline-line {
  position: absolute;
  top: 48rpx;
  bottom: -29rpx;
  left: 26rpx;
  width: 2rpx;
  background-color: var(--color-separator-strong);
}

.course-card {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 166rpx;
  margin-bottom: 28rpx;
  padding: 25rpx 26rpx;
  overflow: hidden;
}

.course-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  border-radius: 7rpx;
  background-color: var(--color-primary);
  content: "";
}

.course-card--cyan::before { background-color: #0797a8; }
.course-card--purple::before { background-color: #7258d6; }
.course-card--green::before { background-color: var(--color-success); }
.course-card--orange::before { background-color: var(--color-warning); }

.course-card-head,
.course-location-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.course-card-head {
  justify-content: space-between;
}

.course-name {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 680;
  line-height: 1.3;
}

.course-state {
  flex: none;
  margin-left: 18rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-subtle);
  font-size: 18rpx;
  font-weight: 620;
}

.course-state--current {
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
}

.course-location-row {
  margin-top: 20rpx;
}

.course-pin {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 22rpx;
  height: 22rpx;
  margin-right: 10rpx;
  border: 3rpx solid var(--color-primary);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.course-pin-core {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
}

.course-location {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.course-teacher {
  display: block;
  margin-top: 11rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
}

.placeholder-note {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 18rpx 6rpx 0;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.6;
}

.placeholder-note-dot {
  flex: none;
  width: 9rpx;
  height: 9rpx;
  margin: 11rpx 12rpx 0 0;
  border-radius: 50%;
  background-color: var(--color-primary);
}

.motion-reduced .day-option {
  transition-duration: 1ms;
}
