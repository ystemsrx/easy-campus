<view class="page exams-page {{themeClass}} {{motionClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-default-style="none"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="loadMore"
    bindscroll="onScroll"
    lower-threshold="180"
  >
    <navigation-bar title="考试安排" subtitle="实时查询" back transparent scrolled="{{headerScrolled}}" theme="{{theme}}">
      <view slot="right" class="exam-nav-refresh" bindtap="onRefresh" hover-class="exam-nav-refresh--pressed" aria-role="button" aria-label="刷新考试安排">
        <text>↻</text>
      </view>
    </navigation-bar>

    <view class="exams-content page-content page-enter">
      <view class="exam-hero">
        <view class="exam-hero-orbit"></view>
        <view class="exam-hero-copy">
          <text class="exam-hero-eyebrow">EXAM SCHEDULE</text>
          <text class="exam-hero-title">{{filterLabel}}</text>
          <text class="exam-hero-caption">{{summaryLabel}}</text>
        </view>
        <view class="exam-hero-symbol"><view class="symbol-top"></view><text>考</text></view>
      </view>

      <view class="exam-semester-picker card pressable" bindtap="openFilter" hover-class="pressing" aria-role="button" aria-label="选择考试学期">
        <view class="semester-picker-icon"><view></view><view></view><view></view></view>
        <view class="semester-picker-copy">
          <text class="semester-picker-caption">查询学期</text>
          <text class="semester-picker-value" overflow="ellipsis" max-lines="1">{{filterLabel}}</text>
        </view>
        <text class="semester-picker-chevron">›</text>
      </view>

      <view class="exam-result-heading">
        <view>
          <text class="exam-result-title">考试日程</text>
          <text class="exam-result-caption">按实际考试时间从早到晚排列</text>
        </view>
        <view class="realtime-pill"><view class="realtime-dot"></view><text>实时</text></view>
      </view>

      <loading-view wx:if="{{loading}}" label="正在读取考试安排"></loading-view>

      <view wx:elif="{{examItems.length}}" class="exam-list">
        <view
          wx:for="{{examItems}}"
          wx:key="id"
          class="exam-card exam-card--{{item.arrangementType}} card pressable stagger-item"
          style="animation-delay: {{index < 7 ? index * 32 : 0}}ms;"
          data-id="{{item.id}}"
          bindtap="openExam"
          hover-class="pressing"
          aria-role="button"
          aria-label="{{item.arrangementTypeLabel}}，{{item.course.name}}，{{item.dateLabel}} {{item.timeLabel}}"
        >
          <view class="exam-date-block exam-date-block--{{item.arrangementType}}">
            <text class="exam-date-label">{{item.dateLabel}}</text>
            <text class="exam-time-label">{{item.timeLabel}}</text>
          </view>
          <view class="exam-main">
            <view class="exam-name-row">
              <text class="exam-type exam-type--{{item.arrangementType}}">{{item.arrangementTypeLabel}}</text>
              <text wx:if="{{item.method}}" class="exam-method">{{item.method}}</text>
            </view>
            <text class="exam-course-name" overflow="ellipsis" max-lines="2">{{item.course.name}}</text>
            <view class="exam-location-row">
              <view class="location-pin"><view class="location-pin-core"></view></view>
              <text class="exam-location" overflow="ellipsis" max-lines="1">{{item.locationLabel}}</text>
            </view>
          </view>
          <view class="exam-seat">
            <text class="exam-seat-value">{{item.seatLabel}}</text>
            <text class="exam-seat-label">座位</text>
          </view>
          <text class="exam-chevron">›</text>
        </view>

        <view wx:if="{{loadingMore}}" class="exam-load-more"><text>正在载入更多…</text></view>
        <text wx:elif="{{page >= totalPages}}" class="exam-end">以上是全部考试安排</text>
      </view>

      <empty-state
        wx:elif="{{!errorMessage}}"
        glyph="考"
        title="本学期暂无考试"
        description="考试安排由教务系统实时提供，可切换其他已有学期查看"
        action-text="选择学期"
        bindaction="openFilter"
      ></empty-state>

      <empty-state
        wx:else
        glyph="!"
        title="考试信息加载失败"
        description="{{errorMessage}}"
        action-text="重新加载"
        bindaction="onRefresh"
      ></empty-state>
    </view>
  </scroll-view>

  <bottom-sheet visible="{{filterVisible}}" title="选择学期" theme="{{theme}}" bindclose="closeFilter">
    <scroll-view class="exam-filter-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
      <text class="exam-filter-hint">仅显示教务系统中与你有关的学期；第三学期有实际记录时才会出现。</text>
      <view class="semester-options">
        <view
          wx:for="{{semesters}}"
          wx:key="id"
          class="semester-option {{draftSemesterId === item.id ? 'semester-option--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectDraftSemester"
          hover-class="semester-option--pressed"
        >
          <view class="semester-option-copy">
            <text class="semester-option-year">{{item.academicYearLabel}}</text>
            <text class="semester-option-term">第 {{item.term}} 学期</text>
          </view>
          <view class="semester-check"><view wx:if="{{draftSemesterId === item.id}}" class="semester-check-core"></view></view>
        </view>
      </view>
    </scroll-view>

    <view slot="footer" class="exam-filter-actions">
      <button class="secondary-button exam-reset" hover-class="button-pressed" bindtap="resetFilter">最新学期</button>
      <button class="primary-button exam-apply" hover-class="button-pressed" bindtap="applyFilter">查看安排</button>
    </view>
  </bottom-sheet>

  <bottom-sheet
    visible="{{selectedExamVisible}}"
    title="{{selectedExam.title || '考试详情'}}"
    theme="{{theme}}"
    bindclose="closeExam"
  >
    <scroll-view wx:if="{{selectedExam}}" class="exam-detail-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="exam-detail-card">
        <view
          wx:for="{{selectedExam.rows}}"
          wx:key="label"
          class="exam-detail-row {{index < selectedExam.rows.length - 1 ? 'exam-detail-row--divided' : ''}}"
        >
          <text class="exam-detail-label">{{item.label}}</text>
          <text class="exam-detail-value" overflow="ellipsis" max-lines="4">{{item.value}}</text>
        </view>
      </view>
      <view wx:if="{{selectedExam.note}}" class="exam-note">
        <text class="exam-note-title">备注</text>
        <text class="exam-note-value">{{selectedExam.note}}</text>
      </view>
    </scroll-view>
  </bottom-sheet>
</view>
