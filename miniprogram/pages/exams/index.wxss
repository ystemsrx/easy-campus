.exams-content {
  padding-top: 24rpx;
}

.exam-nav-refresh {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  color: #7258d6;
  font-size: 38rpx;
  transform: scale(1) rotate(0);
  transition: transform 120ms ease-out, background-color 140ms ease;
}

.exam-nav-refresh--pressed {
  background-color: #f0ebff;
  transform: scale(0.9) rotate(-28deg);
}

.exam-hero {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 238rpx;
  padding: 32rpx;
  overflow: hidden;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #4c3da6 0%, #7159d7 58%, #9a81ef 100%);
  box-shadow: 0 24rpx 58rpx rgba(89, 68, 183, 0.23);
}

.exam-hero-orbit {
  position: absolute;
  top: -150rpx;
  right: -110rpx;
  width: 360rpx;
  height: 360rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.exam-hero-copy {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding-right: 24rpx;
}

.exam-hero-eyebrow {
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2.1rpx;
}

.exam-hero-title {
  margin-top: 13rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -0.4rpx;
}

.exam-hero-caption {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  line-height: 1.5;
}

.exam-hero-symbol {
  position: relative;
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 126rpx;
  padding-top: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12px);
  font-size: 43rpx;
  font-weight: 720;
}

.symbol-top {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 27rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.26);
  background: rgba(255, 255, 255, 0.08);
}

.exam-semester-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
}

.semester-picker-icon {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #f0ebff;
}

.theme-dark .semester-picker-icon {
  background: #2c2544;
}

.semester-picker-icon view {
  width: 25rpx;
  height: 3rpx;
  margin: 2.5rpx 0;
  border-radius: 3rpx;
  background: #7258d6;
}

.semester-picker-icon view:nth-child(2) {
  width: 18rpx;
}

.semester-picker-icon view:nth-child(3) {
  width: 11rpx;
}

.semester-picker-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.semester-picker-caption {
  color: var(--color-text-tertiary);
  font-size: 18rpx;
}

.semester-picker-value {
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 650;
}

.semester-picker-chevron,
.exam-chevron {
  flex: none;
  color: var(--color-text-tertiary);
  font-size: 40rpx;
  font-weight: 300;
}

.exam-result-heading {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin: 38rpx 4rpx 20rpx;
}

.exam-result-title {
  display: block;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.exam-result-caption {
  display: block;
  margin-top: 6rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
}

.realtime-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: var(--color-success);
  background-color: var(--color-success-soft);
  font-size: 19rpx;
  font-weight: 600;
}

.realtime-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background-color: var(--color-success);
}

.exam-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 190rpx;
  margin-bottom: 19rpx;
  padding: 22rpx;
  border: 1rpx solid transparent;
  transition: transform 120ms ease-out;
}

.exam-card--makeup,
.exam-card--deferred,
.exam-card--makeup_deferred {
  border-color: rgba(217, 133, 22, 0.2);
}

.exam-date-block {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  padding: 16rpx 10rpx;
  border-radius: 26rpx;
  color: #7258d6;
  background: #f0ebff;
  text-align: center;
}

.exam-date-block--makeup {
  color: #c87513;
  background: #fff2dc;
}

.exam-date-block--deferred {
  color: #3475c2;
  background: #eaf3ff;
}

.exam-date-block--makeup_deferred {
  color: #cb5b45;
  background: #fff0ec;
}

.theme-dark .exam-date-block {
  background: #2c2544;
}

.theme-dark .exam-date-block--makeup,
.theme-dark .exam-date-block--makeup_deferred {
  background: #3a2d18;
}

.theme-dark .exam-date-block--deferred {
  background: #172b48;
}

.exam-date-label {
  font-size: 24rpx;
  font-weight: 670;
  line-height: 1.4;
}

.exam-time-label {
  margin-top: 10rpx;
  font-size: 18rpx;
  font-weight: 570;
  line-height: 1.35;
  opacity: 0.78;
}

.exam-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  margin-left: 22rpx;
}

.exam-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.exam-type {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: #7258d6;
  background: #f0ebff;
  font-size: 18rpx;
  font-weight: 650;
}

.exam-type--makeup {
  color: #c87513;
  background: #fff2dc;
}

.exam-type--deferred {
  color: #3475c2;
  background: #eaf3ff;
}

.exam-type--makeup_deferred {
  color: #cb5b45;
  background: #fff0ec;
}

.theme-dark .exam-type {
  background: #2c2544;
}

.theme-dark .exam-type--makeup,
.theme-dark .exam-type--makeup_deferred {
  background: #3a2d18;
}

.theme-dark .exam-type--deferred {
  background: #172b48;
}

.exam-method {
  margin-left: 10rpx;
  color: var(--color-text-tertiary);
  font-size: 18rpx;
}

.exam-course-name {
  margin-top: 9rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 660;
  line-height: 1.42;
}

.exam-location-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10rpx;
}

.location-pin {
  position: relative;
  flex: none;
  width: 20rpx;
  height: 24rpx;
  margin-right: 8rpx;
  border: 2rpx solid var(--color-text-tertiary);
  border-radius: 50% 50% 50% 4rpx;
  transform: rotate(-45deg);
}

.location-pin-core {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background-color: var(--color-text-tertiary);
}

.exam-location {
  flex: 1;
  min-width: 0;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
}

.exam-seat {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 70rpx;
  margin-left: 14rpx;
}

.exam-seat-value {
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 680;
}

.exam-seat-label {
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: 17rpx;
}

.exam-load-more,
.exam-end {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 8rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  text-align: center;
}

.exam-filter-scroll {
  width: 100%;
  height: 52vh;
}

.exam-filter-hint {
  display: block;
  margin-bottom: 20rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.55;
}

.semester-options {
  display: flex;
  flex-direction: column;
}

.semester-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 90rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 22rpx;
  background-color: var(--color-bg-elevated);
  transform: scale(1);
  transition: transform 110ms ease-out;
}

.semester-option--active {
  border-color: rgba(114, 88, 214, 0.36);
  background-color: #f4f0ff;
}

.theme-dark .semester-option--active {
  background-color: #2c2544;
}

.semester-option--pressed {
  transform: scale(0.98);
}

.semester-option-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.semester-option-year {
  color: var(--color-text);
  font-size: 23rpx;
  font-weight: 640;
}

.semester-option-term {
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: 19rpx;
}

.semester-check {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid var(--color-separator-strong);
  border-radius: 50%;
}

.semester-option--active .semester-check {
  border-color: #7258d6;
}

.semester-check-core {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #7258d6;
}

.exam-filter-actions {
  display: flex;
  flex-direction: row;
}

.exam-reset {
  flex: 0 0 34%;
  margin-right: 16rpx;
}

.exam-apply {
  flex: 1;
}

.exam-detail-scroll {
  width: 100%;
  height: 55vh;
}

.exam-detail-card {
  padding: 0 22rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 24rpx;
  background-color: var(--color-bg-elevated);
}

.exam-detail-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 16rpx 0;
}

.exam-detail-row--divided {
  border-bottom: 1rpx solid var(--color-separator);
}

.exam-detail-label {
  flex: none;
  width: 150rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.exam-detail-value {
  flex: 1;
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 550;
  line-height: 1.5;
  text-align: right;
}

.exam-note {
  display: flex;
  flex-direction: column;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  color: var(--color-warning);
  background-color: var(--color-warning-soft);
}

.exam-note-title {
  font-size: 21rpx;
  font-weight: 650;
}

.exam-note-value {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.55;
}
