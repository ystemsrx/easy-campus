<view class="page profile-page {{themeClass}} {{motionClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-default-style="none"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscroll="onScroll"
  >
    <navigation-bar title="我的" transparent scrolled="{{headerScrolled}}" theme="{{theme}}"></navigation-bar>
    <view class="profile-content page-content page-content--tab page-enter">
      <view class="identity-card">
        <view class="identity-glow"></view>
        <view class="avatar"><text>{{avatarText}}</text></view>
        <view class="identity-copy">
          <text class="identity-name">{{userName}}</text>
          <text class="identity-school">{{organizationName}}</text>
          <text wx:if="{{majorName}}" class="identity-major">{{majorName}}</text>
        </view>
        <view class="verified-pill"><view class="verified-dot"></view><text>已认证</text></view>
      </view>

      <view wx:if="{{loading}}" class="profile-card card">
        <loading-view compact label="正在读取个人资料"></loading-view>
      </view>

      <view wx:else class="profile-card card">
        <view class="card-heading-row">
          <text class="card-heading">学籍资料</text>
          <text class="card-caption">精简展示</text>
        </view>
        <view class="profile-account pressable" bindtap="copyAccount" hover-class="pressing">
          <text class="profile-label">学号</text>
          <view class="profile-value-wrap">
            <text class="profile-value">{{account || '—'}}</text>
            <text class="copy-hint">复制</text>
          </view>
        </view>
        <view
          wx:for="{{profileRows}}"
          wx:key="label"
          class="profile-row {{index < profileRows.length - 1 ? 'profile-row--divided' : ''}}"
        >
          <text class="profile-label">{{item.label}}</text>
          <text class="profile-value" overflow="ellipsis" max-lines="2">{{item.value}}</text>
        </view>
      </view>

      <view class="section-header">
        <view>
          <text class="section-title">界面与反馈</text>
          <text class="section-caption">按你的习惯调整</text>
        </view>
      </view>

      <view class="settings-card card">
        <view class="setting-row pressable setting-row--divided" bindtap="openThemeSheet" hover-class="pressing">
          <view class="setting-symbol setting-symbol--appearance"><view class="appearance-half"></view></view>
          <view class="setting-copy">
            <text class="setting-title">外观</text>
            <text class="setting-caption">{{themePreferenceLabel}}</text>
          </view>
          <text class="setting-chevron">›</text>
        </view>

        <view class="setting-row setting-row--divided">
          <view class="setting-symbol setting-symbol--motion"><view class="motion-line"></view></view>
          <view class="setting-copy">
            <text class="setting-title">减少动态效果</text>
            <text class="setting-caption">改用更轻柔的淡入切换</text>
          </view>
          <switch
            checked="{{reducedMotion}}"
            color="#1677ff"
            bindchange="onReducedMotionChange"
            aria-label="减少动态效果"
          />
        </view>

        <view class="setting-row">
          <view class="setting-symbol setting-symbol--haptic"><view class="haptic-core"></view></view>
          <view class="setting-copy">
            <text class="setting-title">触感反馈</text>
            <text class="setting-caption">在关键操作完成时轻触提醒</text>
          </view>
          <switch checked="{{haptics}}" color="#1677ff" bindchange="onHapticsChange" aria-label="触感反馈" />
        </view>
      </view>

      <view class="section-header">
        <view>
          <text class="section-title">会话与服务</text>
          <text class="section-caption">当前设备的连接信息</text>
        </view>
      </view>

      <view class="settings-card card">
        <view class="setting-row pressable setting-row--divided" bindtap="showSessionInfo" hover-class="pressing">
          <view class="setting-symbol setting-symbol--session"><view class="session-ring"></view></view>
          <view class="setting-copy">
            <text class="setting-title">90 天滑动会话</text>
            <text class="setting-caption">访问成功后自动续期</text>
          </view>
          <text class="setting-chevron">›</text>
        </view>

        <view class="setting-row setting-row--divided">
          <view class="setting-symbol setting-symbol--timezone"><view class="timezone-clock"><view class="timezone-hand"></view></view></view>
          <view class="setting-copy">
            <text class="setting-title">时间显示</text>
            <text class="setting-caption">设备所在时区 · {{timeZoneLabel}}</text>
          </view>
        </view>

        <view class="setting-row pressable" bindtap="copyApiOrigin" hover-class="pressing">
          <view class="setting-symbol setting-symbol--server"><view class="server-line"></view></view>
          <view class="setting-copy">
            <text class="setting-title">后端服务</text>
            <text class="setting-caption" overflow="ellipsis" max-lines="1">{{apiOrigin}}</text>
          </view>
          <text class="copy-hint">复制</text>
        </view>
      </view>

      <view wx:if="{{errorMessage}}" class="profile-error" bindtap="onRefresh" hover-class="profile-error--pressed">
        <text>{{errorMessage}}</text>
        <text class="profile-error-action">点击重试</text>
      </view>

      <button class="danger-button logout-button" hover-class="button-pressed" bindtap="logout">退出登录</button>

      <view class="about-copy">
        <text>Easy SWU · TypeScript + Skyline</text>
        <text>所有教务数据均来自学校相关系统</text>
      </view>
    </view>
  </scroll-view>

  <bottom-sheet visible="{{themeSheetVisible}}" title="选择外观" theme="{{theme}}" bindclose="closeThemeSheet">
    <view class="theme-options">
      <view
        wx:for="{{themeOptions}}"
        wx:key="value"
        class="theme-option {{themePreference === item.value ? 'theme-option--active' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectTheme"
        hover-class="theme-option--pressed"
      >
        <view class="theme-preview theme-preview--{{item.value}}">
          <view class="preview-panel"></view>
          <view class="preview-line"></view>
        </view>
        <view class="theme-option-copy">
          <text class="theme-option-title">{{item.label}}</text>
          <text class="theme-option-caption">{{item.caption}}</text>
        </view>
        <view wx:if="{{themePreference === item.value}}" class="theme-check"><text>✓</text></view>
      </view>
    </view>
  </bottom-sheet>
</view>
