<view class="page profile-page {{themeClass}} {{motionClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-default-style="none"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscroll="onScroll"
  >
    <navigation-bar transparent scrolled="{{headerScrolled}}" theme="{{theme}}"></navigation-bar>
    <view class="profile-content page-content page-content--tab page-enter">
      <view class="profile-header">
        <text class="profile-eyebrow">个人中心</text>
        <text class="profile-title display-title">我的</text>
      </view>

      <view class="identity-card stagger-item stagger-1">
        <view class="ambient-blob identity-blob identity-blob--one"></view>
        <view class="ambient-blob identity-blob identity-blob--two"></view>
        <view class="identity-main">
          <view class="avatar"><text>{{avatarText}}</text></view>
          <view class="identity-copy"><text class="identity-name display-title">{{userName}}</text><text class="identity-account tnum">{{account || '—'}}</text></view>
          <view class="verified-pill"><view class="verified-dot"></view><text>已认证</text></view>
        </view>
        <text class="identity-school">{{organizationName}}</text>
        <text wx:if="{{majorName}}" class="identity-major">{{majorName}}</text>
      </view>

      <view wx:if="{{loading}}" class="profile-card card"><loading-view compact label="正在读取个人资料"></loading-view></view>
      <view wx:else class="profile-card card stagger-item stagger-2">
        <view class="profile-row pressable profile-row--divided" bindtap="copyAccount" hover-class="pressing">
          <text class="profile-label">学号</text><view class="profile-value-wrap"><text class="profile-value tnum">{{account || '—'}}</text><text class="copy-hint">复制</text></view>
        </view>
        <view wx:for="{{profileRows}}" wx:key="label" class="profile-row {{index < profileRows.length - 1 ? 'profile-row--divided' : ''}}">
          <text class="profile-label">{{item.label}}</text><text class="profile-value" overflow="ellipsis" max-lines="2">{{item.value}}</text>
        </view>
      </view>

      <view class="section-header"><view><text class="section-title">设置</text></view></view>
      <view class="settings-card card stagger-item">
        <view class="appearance-setting">
          <text class="setting-title">外观</text>
          <view class="appearance-control">
            <view class="appearance-indicator appearance-indicator--{{themePreference}}"></view>
            <view wx:for="{{themeOptions}}" wx:key="value" class="appearance-option {{themePreference === item.value ? 'appearance-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectTheme"><text>{{item.label}}</text></view>
          </view>
        </view>
        <view class="setting-row setting-row--divided">
          <view class="setting-copy"><text class="setting-title">减少动态效果</text><text class="setting-caption">降低页面过渡与漂浮动画</text></view>
          <switch class="setting-switch" checked="{{reducedMotion}}" color="#7d8f6e" bindchange="onReducedMotionChange" aria-label="减少动态效果" />
        </view>
        <view class="setting-row">
          <view class="setting-copy"><text class="setting-title">触感反馈</text><text class="setting-caption">开关切换与操作时轻微震动</text></view>
          <switch class="setting-switch" checked="{{haptics}}" color="#7d8f6e" bindchange="onHapticsChange" aria-label="触感反馈" />
        </view>
      </view>

      <view class="section-header"><view><text class="section-title">会话与服务</text></view></view>
      <view class="settings-card card stagger-item">
        <view class="service-row pressable setting-row--divided" bindtap="showSessionInfo" hover-class="pressing"><view class="service-icon service-icon--session"><view class="session-ring"></view></view><view class="setting-copy"><text class="setting-title">90 天滑动会话</text><text class="setting-caption">访问成功后自动续期</text></view><text class="service-chevron">›</text></view>
        <view class="service-row setting-row--divided"><view class="service-icon service-icon--time"><view class="clock-face"><view></view></view></view><view class="setting-copy"><text class="setting-title">时间显示</text><text class="setting-caption">设备所在时区 · {{timeZoneLabel}}</text></view></view>
        <view class="service-row pressable" bindtap="copyApiOrigin" hover-class="pressing"><view class="service-icon service-icon--server"><view class="server-bars"><view></view><view></view></view></view><view class="setting-copy"><text class="setting-title">后端服务</text><text class="setting-caption" overflow="ellipsis" max-lines="1">{{apiOrigin}}</text></view><text class="copy-hint">复制</text></view>
      </view>

      <view class="section-header"><view><text class="section-title">成为开发者</text></view></view>
      <view class="developer-card card stagger-item">
        <text class="developer-copy">本项目开源，欢迎参与共建。克隆仓库开始开发：</text>
        <view class="terminal-card">
          <view class="terminal-head"><view class="terminal-dot terminal-dot--red"></view><view class="terminal-dot terminal-dot--yellow"></view><view class="terminal-dot terminal-dot--green"></view><text>bash</text></view>
          <text class="terminal-code" selectable user-select>git clone --depth 1 git@github.com:ystemsrx/easy-swu.git</text>
        </view>
      </view>

      <view wx:if="{{errorMessage}}" class="profile-error pressable" bindtap="onRefresh" hover-class="pressing"><text>{{errorMessage}}</text><text>点击重试</text></view>
      <button class="danger-button logout-button" hover-class="button-pressed" bindtap="logout">退出登录</button>
      <view class="about-copy"><text>Easy SWU · TypeScript + Skyline</text><text>所有教务数据均来自学校相关系统</text></view>
    </view>
  </scroll-view>
</view>
