<rate-limit-toast id="rate-limit-toast"></rate-limit-toast>
<view class="page profile-page {{themeClass}} {{motionClass}} {{authenticationExitClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <navigation-bar transparent theme="{{theme}}"></navigation-bar>
    <view class="profile-content page-content page-content--tab page-enter">
      <view class="profile-header">
        <text class="profile-eyebrow">个人中心</text>
        <text class="profile-title display-title">我的</text>
      </view>

      <view class="identity-card stagger-item stagger-1">
        <view class="ambient-blob identity-blob identity-blob--one"></view>
        <view class="ambient-blob identity-blob identity-blob--two"></view>
        <view class="identity-main">
          <view wx:if="{{petVisible}}" class="identity-pet-frame">
            <geometric-pet
              shape="{{petShape}}"
              color="{{petColor}}"
              enhanced="{{petEnhanced}}"
              state="happy"
              reduced-motion="{{reducedMotion}}"
              auto-cycle="{{true}}"
              label="点击和校园伙伴互动"
            ></geometric-pet>
          </view>
          <view wx:else class="avatar"><text>{{avatarText}}</text></view>
          <view class="identity-copy"><text class="identity-name display-title">{{userName}}</text><text class="identity-account tnum">{{account || '—'}}</text></view>
        </view>
        <text class="identity-school">{{organizationName}}</text>
        <view class="identity-details">
          <text class="identity-class" overflow="ellipsis" max-lines="1">{{classLabel || '—'}}</text>
          <view class="identity-enrollment"><text class="identity-enrollment-label">入学</text><text class="identity-enrollment-date tnum">{{enrollmentDate || '—'}}</text></view>
        </view>
      </view>

      <view class="section-header"><view><text class="section-title">设置</text></view></view>
      <view class="settings-card card stagger-item">
        <view class="setting-row setting-row--divided setting-row--action pressable" bindtap="openPetSetup" hover-class="setting-row--pressed" aria-role="button" aria-label="设置校园伙伴">
          <view class="setting-copy"><text class="setting-title">校园伙伴</text><text class="setting-caption">{{petSelected ? (petEnabled ? '已开启' : '已关闭') : '未选择'}}</text></view>
          <view class="pet-setting-value"><view wx:if="{{petSelected}}" class="pet-color-dot" style="background: {{petColor}};"></view><text>设置</text><lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon></view>
        </view>
        <view class="appearance-setting">
          <text class="setting-title">外观</text>
          <view class="appearance-control">
            <view class="appearance-indicator appearance-indicator--{{themePreference}}"></view>
            <view wx:for="{{themeOptions}}" wx:key="value" class="appearance-option {{themePreference === item.value ? 'appearance-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectTheme"><text>{{item.label}}</text></view>
          </view>
        </view>
        <view class="setting-row setting-row--divided">
          <view class="setting-copy"><text class="setting-title">减少动态效果</text><text class="setting-caption">降低页面过渡与漂浮动画</text></view>
          <switch class="setting-switch" checked="{{reducedMotion}}" color="#7d8f6e" bindchange="onReducedMotionChange" aria-label="减少动态效果" />
        </view>
        <view class="setting-row">
          <view class="setting-copy"><text class="setting-title">触感反馈</text><text class="setting-caption">开关切换与操作时轻微震动</text></view>
          <switch class="setting-switch" checked="{{haptics}}" color="#7d8f6e" bindchange="onHapticsChange" aria-label="触感反馈" />
        </view>
      </view>

      <view class="section-header"><view><text class="section-title">协议与隐私</text></view></view>
      <view class="settings-card card stagger-item">
        <view class="setting-row setting-row--divided setting-row--action pressable" data-document="terms" bindtap="openLegalDocument" hover-class="setting-row--pressed" aria-role="link" aria-label="查看用户协议">
          <view class="setting-copy"><text class="setting-title">用户协议</text><text class="setting-caption">服务规则与使用约定</text></view>
          <view class="legal-setting-value"><text>查看</text><lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon></view>
        </view>
        <view class="setting-row setting-row--action pressable" data-document="privacy" bindtap="openLegalDocument" hover-class="setting-row--pressed" aria-role="link" aria-label="查看隐私政策">
          <view class="setting-copy"><text class="setting-title">隐私政策</text><text class="setting-caption">个人信息处理与权利</text></view>
          <view class="legal-setting-value"><text>查看</text><lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon></view>
        </view>
      </view>

      <view class="section-header"><view><text class="section-title">成为开发者</text></view></view>
      <view class="developer-card card stagger-item">
        <text class="developer-copy">克隆仓库开始开发：</text>
        <view class="terminal-card">
          <view class="terminal-head"><view class="terminal-dot terminal-dot--red"></view><view class="terminal-dot terminal-dot--yellow"></view><view class="terminal-dot terminal-dot--green"></view><text>bash</text></view>
          <scroll-view class="terminal-code-scroll" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}"><view class="terminal-code-line"><text class="terminal-token terminal-token--git" selectable user-select>git</text><text class="terminal-token terminal-token--action" selectable user-select>clone</text><text class="terminal-token terminal-token--option" selectable user-select>--depth</text><text class="terminal-token terminal-token--number" selectable user-select>1</text><text class="terminal-token terminal-token--repository" selectable user-select>git@github.com:ystemsrx/easy-campus.git</text></view></scroll-view>
        </view>
      </view>

      <view wx:if="{{errorMessage}}" class="profile-error pressable" bindtap="retryLoadUser" hover-class="pressing"><text>{{errorMessage}}</text><text>点击重试</text></view>
      <button class="danger-button logout-button" hover-class="button-pressed" bindtap="logout" disabled="{{loggingOut}}" aria-busy="{{loggingOut}}"><lucide-icon name="log-out" tone="danger" size="{{28}}"></lucide-icon><text>{{loggingOut ? '退出中' : '退出登录'}}</text></button>
    </view>
  </scroll-view>

  <view wx:if="{{authenticationExitClass}}" class="profile-auth-login-backdrop" aria-hidden="true">
    <view class="profile-auth-login-stage">
      <view class="ambient-blob profile-auth-login-blob profile-auth-login-blob--one"></view>
      <view class="ambient-blob profile-auth-login-blob profile-auth-login-blob--two"></view>
      <view class="ambient-blob profile-auth-login-blob profile-auth-login-blob--three"></view>
      <navigation-bar cover="{{false}}" transparent theme="{{theme}}"></navigation-bar>
      <view class="profile-auth-login-hero">
        <view class="profile-auth-login-heading">
          <text class="profile-auth-login-title display-title">Hello!</text>
          <text class="profile-auth-login-subtitle">欢迎来到{{appName}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
