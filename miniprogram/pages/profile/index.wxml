<import src="./content.wxml"/>
<rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}" reduced-motion="{{motionClass === 'motion-reduced'}}"></rate-limit-toast>
<view class="page profile-page {{themeClass}} {{visualThemeClass}} {{motionClass}} {{liquidGlassClass}} {{authenticationExitClass}}">
  <scroll-view
    id="capsule-scroll-source"
    worklet:onscrollupdate="onGlassBackdropScroll"
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <navigation-bar transparent theme="{{theme}}"></navigation-bar>
    <template is="profile-content" data="{{account:account,appName:appName,autoDormCheckStatusLabel:autoDormCheckStatusLabel,autoDormCheckStatusTone:autoDormCheckStatusTone,autoDormCheckTitle:autoDormCheckTitle,autoDormCheckVisible:autoDormCheckVisible,avatarText:avatarText,classLabel:classLabel,enrollmentDate:enrollmentDate,errorMessage:errorMessage,identityCardTone:identityCardTone,loggingOut:loggingOut,openingSetting:openingSetting,organizationName:organizationName,petColor:petColor,petEnabled:petEnabled,petEnhanced:petEnhanced,petShape:petShape,petVisible:petVisible,reducedMotion:reducedMotion,userName:userName,capsuleReplica:false}}"/>
  </scroll-view>

  <view wx:if="{{authenticationExitClass}}" class="profile-auth-login-backdrop" aria-hidden="true">
    <view class="profile-auth-login-stage">
      <view class="ambient-blob profile-auth-login-blob profile-auth-login-blob--one"></view>
      <view class="ambient-blob profile-auth-login-blob profile-auth-login-blob--two"></view>
      <view class="ambient-blob profile-auth-login-blob profile-auth-login-blob--three"></view>
      <navigation-bar cover="{{false}}" transparent theme="{{theme}}"></navigation-bar>
      <view class="profile-auth-login-hero">
        <view class="profile-auth-login-heading">
          <text class="profile-auth-login-title display-title">Hello!</text>
          <text class="profile-auth-login-subtitle">欢迎来到{{appName}}</text>
        </view>
      </view>
    </view>
  </view>

  <bottom-sheet visible="{{feedbackVisible}}" scrollable="{{false}}" title="反馈" theme="{{theme}}" close-on-mask="{{!feedbackSubmitting}}" bindclose="closeFeedback" reduced-motion="{{motionClass === 'motion-reduced'}}">
    <view class="feedback-form">
      <view class="feedback-label-line"><text class="feedback-label">类型</text><text class="feedback-required" aria-hidden="true">*</text></view>
      <view class="feedback-type-grid" aria-label="选择反馈类型">
        <view wx:for="{{feedbackTypes}}" wx:key="value" class="feedback-type-option {{item.selected ? 'feedback-type-option--active' : 'feedback-type-option--inactive'}}" data-type="{{item.value}}" bindtap="selectFeedbackType" aria-role="button" aria-label="{{item.label}}" aria-pressed="{{item.selected}}">
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="feedback-content-head"><view class="feedback-label-line"><text class="feedback-label">具体内容</text><text class="feedback-required" aria-hidden="true">*</text></view><text class="feedback-character-count tnum">{{feedbackCharacterCount}}/500</text></view>
      <textarea class="feedback-textarea" value="{{feedbackContent}}" maxlength="500" placeholder="请描述你遇到的问题或建议" placeholder-class="feedback-placeholder" auto-height="{{false}}" disabled="{{feedbackSubmitting}}" bindinput="onFeedbackContentInput" aria-label="反馈具体内容"></textarea>
      <text wx:if="{{feedbackErrorMessage}}" class="feedback-error">{{feedbackErrorMessage}}</text>
    </view>
    <view slot="footer" class="feedback-footer">
      <button class="primary-button feedback-submit {{feedbackCanSubmit ? '' : 'feedback-submit--disabled'}}" hover-class="button-pressed" bindtap="submitFeedback" disabled="{{!feedbackCanSubmit || feedbackSubmitting}}" aria-busy="{{feedbackSubmitting}}">{{feedbackSubmitting ? '提交中' : '提交反馈'}}</button>
    </view>
  </bottom-sheet>
  <include src="./live-glass.wxml"/>
</view>
<screen-watermark></screen-watermark>
