<view class="page profile-page {{themeClass}} {{motionClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <navigation-bar transparent theme="{{theme}}"></navigation-bar>
    <view class="profile-content page-content page-content--tab page-enter">
      <view class="profile-header">
        <text class="profile-eyebrow">个人中心</text>
        <text class="profile-title display-title">我的</text>
      </view>

      <view class="identity-card stagger-item stagger-1">
        <view class="ambient-blob identity-blob identity-blob--one"></view>
        <view class="ambient-blob identity-blob identity-blob--two"></view>
        <view class="identity-main">
          <view class="avatar"><text>{{avatarText}}</text></view>
          <view class="identity-copy"><text class="identity-name display-title">{{userName}}</text><text class="identity-account tnum">{{account || '—'}}</text></view>
        </view>
        <text class="identity-school">{{organizationName}}</text>
        <view class="identity-details">
          <text class="identity-class" overflow="ellipsis" max-lines="1">{{classLabel || '—'}}</text>
          <view class="identity-enrollment"><text class="identity-enrollment-label">入学</text><text class="identity-enrollment-date tnum">{{enrollmentDate || '—'}}</text></view>
        </view>
      </view>

      <view class="section-header"><view><text class="section-title">设置</text></view></view>
      <view class="settings-card card stagger-item">
        <view class="appearance-setting">
          <text class="setting-title">外观</text>
          <view class="appearance-control">
            <view class="appearance-indicator appearance-indicator--{{themePreference}}"></view>
            <view wx:for="{{themeOptions}}" wx:key="value" class="appearance-option {{themePreference === item.value ? 'appearance-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectTheme"><text>{{item.label}}</text></view>
          </view>
        </view>
        <view class="setting-row setting-row--divided">
          <view class="setting-copy"><text class="setting-title">减少动态效果</text><text class="setting-caption">降低页面过渡与漂浮动画</text></view>
          <switch class="setting-switch" checked="{{reducedMotion}}" color="#7d8f6e" bindchange="onReducedMotionChange" aria-label="减少动态效果" />
        </view>
        <view class="setting-row">
          <view class="setting-copy"><text class="setting-title">触感反馈</text><text class="setting-caption">开关切换与操作时轻微震动</text></view>
          <switch class="setting-switch" checked="{{haptics}}" color="#7d8f6e" bindchange="onHapticsChange" aria-label="触感反馈" />
        </view>
      </view>

      <view class="section-header"><view><text class="section-title">成为开发者</text></view></view>
      <view class="developer-card card stagger-item">
        <text class="developer-copy">克隆仓库开始开发：</text>
        <view class="terminal-card">
          <view class="terminal-head"><view class="terminal-dot terminal-dot--red"></view><view class="terminal-dot terminal-dot--yellow"></view><view class="terminal-dot terminal-dot--green"></view><text>bash</text></view>
          <scroll-view class="terminal-code-scroll" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}"><view class="terminal-code-line"><text class="terminal-token terminal-token--git" selectable user-select>git</text><text class="terminal-token terminal-token--action" selectable user-select>clone</text><text class="terminal-token terminal-token--option" selectable user-select>--depth</text><text class="terminal-token terminal-token--number" selectable user-select>1</text><text class="terminal-token terminal-token--repository" selectable user-select>git@github.com:ystemsrx/easy-swu.git</text></view></scroll-view>
        </view>
      </view>

      <view wx:if="{{errorMessage}}" class="profile-error pressable" bindtap="retryLoadUser" hover-class="pressing"><text>{{errorMessage}}</text><text>点击重试</text></view>
      <button class="danger-button logout-button" hover-class="button-pressed" bindtap="logout"><lucide-icon name="log-out" tone="danger" size="{{28}}"></lucide-icon><text>退出登录</text></button>
    </view>
  </scroll-view>
</view>
