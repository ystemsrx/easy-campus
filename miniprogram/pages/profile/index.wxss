.profile-content { padding-top: 20rpx; }
.profile-header { padding: 0 8rpx; }
.profile-eyebrow { display: block; color: var(--color-text-tertiary); font-size: 25rpx; font-weight: 550; }
.profile-title { display: block; margin-top: 2rpx; color: var(--color-text); font-size: 68rpx; font-weight: 700; line-height: 1.15; }

.identity-card { position: relative; margin-top: 38rpx; padding: 38rpx; overflow: hidden; border-radius: 56rpx; color: #fff; background: linear-gradient(140deg, #d97757, #eba97f); box-shadow: var(--shadow-pop); }
.identity-blob { background: rgba(255, 255, 255, 0.15); }
.identity-blob--one { top: -92rpx; right: -72rpx; width: 300rpx; height: 270rpx; }
.identity-blob--two { bottom: -120rpx; left: -60rpx; width: 230rpx; height: 210rpx; background: rgba(0, 0, 0, 0.07); animation-delay: -4s; }
.identity-main { position: relative; display: flex; flex-direction: row; align-items: center; gap: 24rpx; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.24); backdrop-filter: blur(10px); font-family: Georgia, "Songti SC", serif; font-size: 42rpx; font-weight: 700; }
.identity-copy { flex: 1; min-width: 0; }
.identity-name { display: block; font-size: 43rpx; font-weight: 700; line-height: 1.2; }
.identity-account { display: block; margin-top: 4rpx; color: rgba(255, 255, 255, 0.8); font-size: 23rpx; }
.verified-pill { display: flex; flex: none; flex-direction: row; align-items: center; gap: 8rpx; padding: 9rpx 16rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.18); font-size: 19rpx; font-weight: 700; }
.verified-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #fff; }
.identity-school { position: relative; display: block; margin-top: 26rpx; color: rgba(255, 255, 255, 0.9); font-size: 24rpx; font-weight: 650; }
.identity-major { position: relative; display: block; margin-top: 4rpx; color: rgba(255, 255, 255, 0.7); font-size: 22rpx; }

.profile-card { margin-top: 22rpx; overflow: hidden; }
.profile-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 32rpx; min-height: 92rpx; padding: 22rpx 34rpx; }
.profile-row--divided { border-bottom: 1rpx solid var(--color-separator); }
.profile-label { flex: none; color: var(--color-text-tertiary); font-size: 25rpx; font-weight: 550; }
.profile-value-wrap { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 14rpx; min-width: 0; }
.profile-value { min-width: 0; color: var(--color-text); font-size: 26rpx; font-weight: 650; text-align: right; }
.copy-hint { flex: none; color: #b85c38; font-size: 20rpx; font-weight: 700; }

.settings-card { overflow: hidden; }
.appearance-setting { padding: 28rpx 34rpx 30rpx; border-bottom: 1rpx solid var(--color-separator); }
.setting-title { display: block; color: var(--color-text); font-size: 26rpx; font-weight: 700; }
.setting-caption { display: block; margin-top: 3rpx; color: #b5b0a3; font-size: 21rpx; line-height: 1.45; }
.appearance-control { position: relative; display: flex; flex-direction: row; margin-top: 20rpx; padding: 7rpx; border-radius: 999rpx; background: rgba(43, 38, 32, 0.045); }
.appearance-indicator { position: absolute; top: 7rpx; bottom: 7rpx; left: 7rpx; width: calc((100% - 14rpx) / 3); border-radius: 999rpx; background: #fff; box-shadow: var(--shadow-card); transform: translateX(0); transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1); }
.appearance-indicator--light { transform: translateX(100%); }
.appearance-indicator--dark { transform: translateX(200%); }
.appearance-option { position: relative; z-index: 1; display: flex; flex: 1; align-items: center; justify-content: center; min-height: 62rpx; color: #8b8b94; font-size: 22rpx; font-weight: 700; }
.appearance-option--active { color: #16161a; }
.setting-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 104rpx; padding: 22rpx 34rpx; }
.setting-row--divided { border-bottom: 1rpx solid var(--color-separator); }
.setting-copy { flex: 1; min-width: 0; }
.setting-switch { flex: none; transform: scale(0.82); transform-origin: right center; }

.service-row { display: flex; flex-direction: row; align-items: center; gap: 22rpx; min-height: 108rpx; padding: 21rpx 30rpx; }
.service-icon { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 22rpx; }
.service-icon--session { color: #b85c38; background: #f9eae2; }
.service-icon--time { color: #a66f1f; background: #f8eedd; }
.service-icon--server { color: #5f7350; background: #edf1e6; }
.session-ring { width: 27rpx; height: 27rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.session-ring::after { display: block; width: 8rpx; height: 8rpx; margin: 7rpx; border-radius: 50%; background: currentColor; content: ""; }
.clock-face { position: relative; width: 29rpx; height: 29rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.clock-face view { position: absolute; top: 6rpx; left: 12rpx; width: 3rpx; height: 10rpx; border-radius: 3rpx; background: currentColor; transform-origin: bottom; transform: rotate(-25deg); }
.server-bars { width: 31rpx; }
.server-bars view { height: 7rpx; margin-top: 5rpx; border: 3rpx solid currentColor; border-radius: 5rpx; }
.service-chevron { flex: none; color: #c9c5b8; font-size: 36rpx; }

.developer-card { padding: 30rpx; }
.developer-copy { display: block; padding: 0 2rpx; color: #8b8578; font-size: 23rpx; line-height: 1.65; }
.terminal-card { margin-top: 20rpx; padding: 26rpx; border-radius: 32rpx; background: #2b2620; }
.terminal-head { display: flex; flex-direction: row; align-items: center; gap: 9rpx; padding-bottom: 20rpx; }
.terminal-head text { margin-left: auto; color: rgba(255, 255, 255, 0.4); font-family: monospace; font-size: 18rpx; }
.terminal-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.terminal-dot--red { background: #c2767a; }
.terminal-dot--yellow { background: #e5b86e; }
.terminal-dot--green { background: #7d8f6e; }
.terminal-code { display: block; color: #e8e2d5; font-family: monospace; font-size: 21rpx; line-height: 1.6; word-break: break-all; }
.profile-error { display: flex; flex-direction: row; justify-content: space-between; gap: 20rpx; margin-top: 28rpx; padding: 20rpx 24rpx; border-radius: 28rpx; color: #c0452d; background: #f9e7e0; font-size: 22rpx; }
.logout-button { margin-top: 48rpx; }
.about-copy { display: flex; flex-direction: column; align-items: center; gap: 4rpx; margin-top: 28rpx; color: #b5b0a3; font-size: 19rpx; text-align: center; }

.theme-dark .appearance-control { background: rgba(255, 255, 255, 0.06); }
.theme-dark .appearance-indicator { background: #3a3730; }
.theme-dark .appearance-option--active { color: #f7f3e9; }
