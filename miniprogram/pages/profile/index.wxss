.profile-content { padding-top: 20rpx; }

.profile-page .page-enter {
  animation-name: profile-page-settle;
  animation-duration: 220ms;
}

.profile-page .stagger-item {
  animation-name: profile-item-settle;
  animation-duration: 260ms;
}

.profile-page.motion-reduced .page-enter,
.profile-page.motion-reduced .stagger-item,
.profile-page.motion-reduced.profile-page--leaving .page-scroll {
  animation-duration: 1ms;
  animation-delay: 0ms;
}

.profile-page--leaving .page-scroll {
  animation-name: profile-auth-exit;
  animation-duration: 180ms;
  animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
  animation-fill-mode: both;
  pointer-events: none;
}

.profile-auth-login-backdrop {
  position: absolute;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background-color: var(--color-bg);
  animation-name: profile-auth-login-backdrop-in;
  animation-duration: 180ms;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
  pointer-events: auto;
}

.profile-auth-login-stage {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: var(--color-bg);
}

.profile-auth-login-blob--one {
  top: -120rpx;
  left: -135rpx;
  width: 470rpx;
  height: 430rpx;
  background: #f9eae2;
}

.profile-auth-login-blob--two {
  top: 37%;
  right: -170rpx;
  width: 410rpx;
  height: 380rpx;
  background: #f8eedd;
  animation-delay: -3s;
}

.profile-auth-login-blob--three {
  bottom: -170rpx;
  left: -90rpx;
  width: 430rpx;
  height: 390rpx;
  background: #edf1e6;
  animation-delay: -5s;
}

.profile-auth-login-hero {
  position: relative;
  height: calc(100vh - 720rpx);
  min-height: 390rpx;
}

.profile-auth-login-heading {
  position: absolute;
  right: 48rpx;
  bottom: 164rpx;
  left: 48rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.profile-auth-login-title {
  display: block;
  color: #16161a;
  font-size: 78rpx;
  font-weight: 700;
  line-height: 1.05;
  white-space: nowrap;
}

.profile-auth-login-subtitle {
  display: block;
  max-width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: #8c867a;
  font-size: 30rpx;
  font-weight: 550;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-dark .profile-auth-login-title {
  color: #f7f3e9;
}

.theme-dark .profile-auth-login-subtitle {
  color: #c6bdad;
}

.motion-reduced .profile-auth-login-backdrop {
  animation-duration: 1ms;
}

.profile-header { padding: 0 8rpx; }
.profile-eyebrow { display: block; color: var(--color-text-tertiary); font-size: 25rpx; font-weight: 550; }
.profile-title { display: block; margin-top: 2rpx; color: var(--color-text); font-size: 68rpx; font-weight: 700; line-height: 1.15; }

.identity-card { --identity-ink: #45443f; --identity-secondary: rgba(69, 68, 63, 0.74); --identity-tertiary: rgba(69, 68, 63, 0.58); --identity-faint: rgba(69, 68, 63, 0.45); --identity-blob: rgba(136, 132, 120, 0.08); position: relative; margin-top: 38rpx; padding: 38rpx; overflow: hidden; border-radius: 56rpx; color: var(--identity-ink); background: linear-gradient(140deg, #fbfaf7, #f3f1eb); box-shadow: var(--shadow-pop); }
.identity-card--male { --identity-ink: #2f485f; --identity-secondary: rgba(47, 72, 95, 0.74); --identity-tertiary: rgba(47, 72, 95, 0.58); --identity-faint: rgba(47, 72, 95, 0.45); --identity-blob: rgba(79, 117, 166, 0.09); background: #e3eff8; }
.identity-card--female { --identity-ink: #51435f; --identity-secondary: rgba(81, 67, 95, 0.74); --identity-tertiary: rgba(81, 67, 95, 0.58); --identity-faint: rgba(81, 67, 95, 0.45); --identity-blob: rgba(126, 94, 158, 0.09); background: #ece4f5; }
.identity-blob { background: rgba(255, 255, 255, 0.5); }
.identity-blob--one { top: -92rpx; right: -72rpx; width: 300rpx; height: 270rpx; }
.identity-blob--two { bottom: -120rpx; left: -60rpx; width: 230rpx; height: 210rpx; background-color: var(--identity-blob); animation-delay: -4s; }
.identity-main { position: relative; display: flex; flex-direction: row; align-items: center; gap: 24rpx; }
.identity-pet-frame { display: block; flex: none; width: 122rpx; height: 122rpx; overflow: visible; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.62); backdrop-filter: blur(10px); font-family: Georgia, "Songti SC", serif; font-size: 42rpx; font-weight: 700; }
.identity-copy { flex: 1; min-width: 0; }
.identity-name { display: block; font-size: 43rpx; font-weight: 700; line-height: 1.2; }
.identity-account { display: block; margin-top: 4rpx; color: var(--identity-secondary); font-size: 23rpx; }
.identity-school { position: relative; display: block; margin-top: 26rpx; color: var(--identity-secondary); font-size: 24rpx; font-weight: 650; }
.identity-details { position: relative; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 5rpx; color: var(--identity-tertiary); font-size: 22rpx; }
.identity-class { flex: 1; min-width: 0; }
.identity-enrollment { display: flex; flex: none; flex-direction: column; align-items: flex-end; white-space: nowrap; }
.identity-enrollment-label { color: var(--identity-faint); font-size: 17rpx; font-weight: 650; line-height: 1.15; }
.identity-enrollment-date { margin-top: 4rpx; color: var(--identity-secondary); font-size: 21rpx; line-height: 1.15; }

.settings-card { overflow: hidden; }
.setting-title { display: block; color: var(--color-text); font-size: 26rpx; font-weight: 700; }
.setting-caption { display: block; margin-top: 3rpx; color: #b5b0a3; font-size: 21rpx; line-height: 1.45; }
.setting-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 104rpx; padding: 22rpx 34rpx; }
.setting-row--divided { border-bottom: 1rpx solid var(--color-separator); }
.setting-row--action { background-color: transparent; }
.setting-row--pressed { background-color: var(--color-bg-subtle); }
.setting-copy { flex: 1; min-width: 0; }
.pet-setting-value,
.course-assistant-setting-value,
.auto-dorm-check-setting-value,
.grade-setting-value,
.personalization-setting-value,
.legal-setting-value,
.feedback-setting-value { display: flex; flex: none; flex-direction: row; align-items: center; gap: 7rpx; color: var(--color-text-tertiary); font-size: 22rpx; font-weight: 650; white-space: nowrap; }
.pet-color-dot { flex: none; width: 22rpx; height: 22rpx; margin-right: 2rpx; border: 3rpx solid rgba(255, 255, 255, 0.76); border-radius: 50%; box-shadow: 0 2rpx 8rpx rgba(20, 20, 30, 0.18); }
.auto-dorm-check-setting-dot { flex: none; width: 14rpx; height: 14rpx; border-radius: 50%; }
.auto-dorm-check-setting-dot--success { background: #69a25c; }
.auto-dorm-check-setting-dot--warning { background: #e5b86e; }
.auto-dorm-check-setting-dot--danger { background: #c2767a; }
.auto-dorm-check-setting-dot--muted { background: #b5b0a3; }

.developer-card { padding: 30rpx; }
.developer-copy { display: block; padding: 0 2rpx; color: #8b8578; font-size: 23rpx; line-height: 1.65; }
.terminal-card { margin-top: 20rpx; padding: 26rpx; border-radius: 32rpx; background: #2b2620; }
.terminal-head { display: flex; flex-direction: row; align-items: center; gap: 0; padding-bottom: 20rpx; }
.terminal-head text { margin-left: auto; color: rgba(255, 255, 255, 0.4); font-family: monospace; font-size: 18rpx; }
.terminal-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.terminal-dot + .terminal-dot { margin-left: 14rpx; }
.terminal-dot--red { background: #c2767a; }
.terminal-dot--yellow { background: #e5b86e; }
.terminal-dot--green { background: #7d8f6e; }
.terminal-code-scroll { width: 100%; height: 46rpx; }
.terminal-code-line { display: flex; flex-direction: row; align-items: center; width: 900rpx; height: 46rpx; }
.terminal-token { display: block; flex: none; font-family: monospace; font-size: 22rpx; font-weight: 650; line-height: 1.4; white-space: nowrap; }
.terminal-token + .terminal-token { margin-left: 14rpx; }
.terminal-token--git { color: #e5b86e; }
.terminal-token--action { color: #f7f3e9; }
.terminal-token--option { color: #86b7d5; }
.terminal-token--number { color: #d79a9d; }
.terminal-token--repository { color: #9fe3c1; }
.profile-error { display: flex; flex-direction: row; justify-content: space-between; gap: 20rpx; margin-top: 28rpx; padding: 20rpx 24rpx; border-radius: 28rpx; color: #c0452d; background: #f9e7e0; font-size: 22rpx; }
.logout-button { gap: 12rpx; margin-top: 48rpx; }

.feedback-form { width: 100%; padding-top: 8rpx; }
.feedback-label-line { display: flex; flex: none; flex-direction: row; align-items: center; gap: 4rpx; }
.feedback-label { display: block; color: var(--color-text-tertiary); font-size: 23rpx; font-weight: 700; }
.feedback-required { display: block; flex: none; color: #d9534f; font-size: 23rpx; font-weight: 750; line-height: 1; }
.feedback-type-grid { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; width: 100%; margin-top: 16rpx; }
.feedback-type-option { display: flex; flex: none; align-items: center; justify-content: center; width: calc(50% - 8rpx); min-height: 76rpx; margin-bottom: 16rpx; border: 2rpx solid var(--color-separator); border-radius: 25rpx; color: var(--color-text-secondary); background-color: var(--color-bg-elevated); font-size: 23rpx; font-weight: 650; transition: transform 120ms ease, background-color 120ms ease; }
.feedback-type-option--inactive { border-color: var(--color-separator); color: var(--color-text-secondary); background-color: var(--color-bg-elevated); }
.feedback-type-option--active { border-color: #d97757; color: #9d4e35; background-color: #f9e8df; }
.feedback-content-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.feedback-character-count { display: block; flex: none; color: var(--color-text-tertiary); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 19rpx; white-space: nowrap; }
.feedback-textarea { display: block; box-sizing: border-box; width: 100%; max-width: 100%; min-width: 0; height: 220rpx; min-height: 220rpx; margin-top: 14rpx; padding: 22rpx 25rpx; border: 2rpx solid var(--color-separator); border-radius: 29rpx; color: var(--color-text); background-color: var(--color-bg-elevated); font-size: 25rpx; line-height: 1.65; }
.feedback-placeholder { color: #b5b0a3; }
.feedback-error { display: block; margin-top: 12rpx; color: #c0452d; font-size: 21rpx; }
.feedback-footer { width: 100%; }
.primary-button.feedback-submit { width: 100%; margin: 0; background-color: #d97757; }
.primary-button.feedback-submit--disabled { color: #f4f1ea; background-color: #aaa69c; opacity: 1; box-shadow: none; }
.theme-dark .feedback-type-option--active { border-color: #e29a79; color: #f0b89b; background-color: rgba(217, 119, 87, 0.16); }
.motion-reduced .feedback-type-option { transition-duration: 1ms; }

@keyframes profile-auth-exit {
  from {
    transform: translateY(0);
    opacity: 1;
  }
  to {
    transform: translateY(32rpx);
    opacity: 0;
  }
}

@keyframes profile-auth-login-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes profile-page-settle {
  from { transform: translateY(10rpx); }
  to { transform: translateY(0); }
}

@keyframes profile-item-settle {
  from { transform: translateY(8rpx); }
  to { transform: translateY(0); }
}
