<import src="./day-content.wxml"/><rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}" reduced-motion="{{motionClass==='motion-reduced'}}"></rate-limit-toast><view class="page schedule-page {{themeClass}} {{visualThemeClass}} {{motionClass}} {{liquidGlassClass}}"><navigation-bar back="{{homeRemoved}}" transparent theme="{{theme}}"></navigation-bar><view class="schedule-top page-content {{foldDragging?'calendar-dragging':''}}"><view class="schedule-header"><view class="schedule-header-copy"><text class="schedule-eyebrow" overflow="ellipsis" max-lines="1">{{teachingWeekLabel?teachingWeekLabel+' · ':''}}{{monthLabel}}</text><text class="schedule-title display-title">日程</text></view><view class="schedule-header-actions"><view class="calendar-view-switch" aria-label="日历视图"><view class="view-thumb {{monthOpen?'view-thumb--month':''}}"></view><view class="calendar-view-option {{!monthOpen?'calendar-view-option--active':''}}" data-mode="week" bindtap="setCalendarMode" aria-role="button" aria-label="周视图">周</view><view class="calendar-view-option {{monthOpen?'calendar-view-option--active':''}}" data-mode="month" bindtap="setCalendarMode" aria-role="button" aria-label="月视图">月</view></view><view class="round-action round-action--dark pressable" bindtap="openCreator" hover-class="pressing" aria-role="button" aria-label="添加待办"><lucide-icon name="plus" tone="{{liquidGlass?(theme==='dark'?'white':'ink'):(visualTheme==='minimal'?(theme==='dark'?'white':'ink'):'white')}}" size="{{32}}"></lucide-icon></view></view></view><view class="month-toolbar {{monthOpen?'month-toolbar--open':''}}" style="height:{{76 * foldProgress}}rpx;opacity:{{foldProgress}};"><view class="month-title"><text class="month-title-main">{{monthTitle}}</text><text class="month-title-year">{{yearTitle}}</text></view><view class="month-navigation"><view class="month-navigation-button" bindtap="previousCalendarMonth" aria-role="button" aria-label="上个月"><view class="month-navigation-icon--previous"><lucide-icon name="chevron-right" tone="muted" size="{{26}}"></lucide-icon></view></view><view class="month-navigation-button" bindtap="nextCalendarMonth" aria-role="button" aria-label="下个月"><lucide-icon name="chevron-right" tone="muted" size="{{26}}"></lucide-icon></view></view></view><view class="calendar-stage {{monthOpen||foldDragging?'calendar-stage--month':''}} {{motionClass}}" style="height: {{128+(monthHeight-128) * foldProgress}}rpx;"><view class="week-viewport" style="opacity:{{1-foldProgress}};"><view class="week-track {{headerMotionReady?'week-track--ready':''}}"><view wx:for="{{weekPages}}" wx:for-item="week" wx:key="slot" class="week-strip week-strip-slot-{{week.slot}}"><view class="week-selection week-selection-slot-{{week.slot}}"><view class="week-selection-circle"></view></view><view
          wx:for="{{week.days}}"
          wx:key="weekday"
          class="week-day"
          data-date="{{item.date}}" aria-role="button" aria-label="{{item.date}}" aria-pressed="{{selectedDate===item.date}}"
          bindtap="selectDay"
        ><text class="week-day-name">{{item.isToday?'今':item.shortLabel}}</text><view class="week-day-number"><view wx:if="{{item.isToday}}" class="week-day-today-ring"></view><view class="week-day-date-layer week-date-{{week.slot}}-{{item.weekday}}-normal"><text class="week-day-date tnum">{{item.dateLabel}}</text></view><view class="week-day-date-layer week-day-date-layer--selected week-date-{{week.slot}}-{{item.weekday}}-selected" aria-hidden="{{true}}"><text class="week-day-date week-day-date--selected tnum">{{item.dateLabel}}</text></view></view><view class="week-day-marks"><view wx:if="{{item.hasCourse}}" class="week-day-dot week-day-dot--course"></view><view wx:if="{{item.hasPlan}}" class="week-day-dot"></view></view></view></view></view></view><view class="month-calendar {{monthOpen||foldDragging?'month-calendar--open':''}} {{swiping?'month-drag':''}} {{selectionVisible?'msv':''}}" bindtouchstart="monthStart" bindtouchmove="monthMove" bindtouchend="monthEnd" bindtouchcancel="monthEnd" style="opacity:{{foldProgress}};"><view class="month-track" style="transform:translateX({{mx}}px);"><view class="month-drag-layer"><view class="orb-slot" style="transform:translateX({{monthOffset*100}}%);opacity:{{selectionVisible?1:0}};"><view class="orb orb-live"></view></view><view wx:for="{{monthPanels}}" wx:for-item="panel" wx:for-index="panelIndex" wx:key="id" class="mp" style="left:{{panel.slot*100}}%;"><view class="month-weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view wx:for="{{panel.monthRows}}" wx:for-item="row" wx:key="row" class="month-week"><view wx:for="{{row.days}}" wx:key="weekday" class="month-day {{item.outside?'month-day--outside':''}} {{panel.monthSelected&&!item.outside&&item.date===selectedDate?'mdy':''}}" data-date="{{item.date}}" bindtap="selectDay" aria-role="button" aria-label="{{item.date}}" aria-pressed="{{panel.monthSelected&&!item.outside&&item.date===selectedDate}}"><view class="month-day-number"><view wx:if="{{item.isToday}}" class="month-day-today-ring"></view><view class="month-date-base {{panelIndex===1?'md-'+row.row+'-'+item.weekday+'-normal':''}}"><text class="month-date-label">{{item.dateLabel}}</text></view><view wx:if="{{panelIndex===1||panel.monthSelected&&!item.outside&&item.date===selectedDate}}" class="month-date month-date--selected {{panelIndex===1?'md-'+row.row+'-'+item.weekday+'-selected':''}}" aria-hidden="{{true}}"><text class="month-date-label month-date-label--selected">{{item.dateLabel}}</text></view></view><view class="month-day-marks"><view wx:if="{{item.hasCourse}}" class="month-day-dot month-day-dot--course"></view><view wx:if="{{item.hasPlan}}" class="month-day-dot month-day-dot--plan"></view></view></view></view></view></view></view></view></view><view class="calendar-fold" bindtap="toggleCalendarMode" bindtouchstart="onCalendarFoldStart" catchtouchmove="onCalendarFoldMove" bindtouchend="onCalendarFoldEnd" bindtouchcancel="onCalendarFoldEnd" aria-role="button" aria-label="{{monthOpen?'收起月历':'展开月历'}}"><view class="calendar-fold-line"></view></view></view><swiper id="capsule-scroll-source" class="day-swiper day-in-{{daySlide}}" current="{{dayCurrent}}" data-window-start="{{dayPages[0].selectedDate}}" scroll-with-animation="{{dayAnimated}}" duration="{{!dayAnimated||motionClass==='motion-reduced'?0:240}}" easing-function="easeOutCubic" cache-extent="1" bindchange="onDayChange" worklet:onscrollstart="onDayScrollStart" worklet:onscrollupdate="onDayScrollUpdate" worklet:onscrollend="onDayScrollEnd"><swiper-item wx:for="{{dayPages}}" wx:for-item="day" wx:key="selectedDate"><scroll-view class="day-scroll" data-slot="{{day.slot}}" worklet:onscrollupdate="onGlassDayScroll" type="list" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{dayScrollTops[day.slot]}}" scroll-into-view="{{day.selectedDate===selectedDate&&focusedPlanId?'entry-'+day.slot+'-'+focusedPlanId:''}}" data-date="{{day.selectedDate}}" bindscroll="onDayVerticalScroll"><template is="schedule-day-content" data="{{day:day,timelineHeight:timelineHeight,capsuleReplica:false}}"/></scroll-view></swiper-item></swiper><bottom-sheet visible="{{creating}}" expanded="{{true}}" expanded-height="{{creatorSheetHeight}}" animate-height="{{true}}" scrollable="{{false}}" title="{{editingPlanId ? '编辑日程' : editingCourseId ? '编辑课程' : creatorMode === 'course' ? '添加课程' : '添加待办'}}" theme="{{theme}}" bindclose="closeCreator" reduced-motion="{{motionClass === 'motion-reduced'}}"><view wx:if="{{!editingPlanId && !editingCourseId}}" class="creator-switch"><view class="creator-switch-indicator {{creatorMode === 'course' ? 'creator-switch-indicator--course' : ''}}"></view><view class="creator-switch-option" data-mode="plan" bindtap="switchCreatorMode">日程</view><view class="creator-switch-option" data-mode="course" bindtap="switchCreatorMode">课程</view></view><scroll-view wx:if="{{creatorMode === 'course'}}" class="creator-course-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}"><view class="creator-form creator-course-form"><text class="creator-label">课程名 <text class="creator-required">*</text></text><input class="creator-title" value="{{title}}" placeholder="课程名" placeholder-class="creator-placeholder" maxlength="80" bindinput="onTitleInput" /><view class="creator-optional-row"><view class="creator-optional-field"><text class="creator-label">地点 <text class="creator-optional">（可选）</text></text><input class="creator-title" value="{{courseLocation}}" placeholder="上课地点" placeholder-class="creator-placeholder" maxlength="80" bindinput="onCourseLocationInput" /></view><view class="creator-optional-field"><text class="creator-label">教师 <text class="creator-optional">（可选）</text></text><input class="creator-title" value="{{courseTeacher}}" placeholder="授课教师" placeholder-class="creator-placeholder" maxlength="80" bindinput="onCourseTeacherInput" /></view></view><view class="creator-collapse-heading" bindtap="toggleCourseTime"><text>上课时间 <text class="creator-required">*</text></text><text class="creator-collapse-summary">{{courseWeekdays.length && coursePeriods.length ? '已选 ' + courseWeekdays.length + ' 天 · ' + coursePeriods.length + ' 节' : '请选择'}}</text><view class="creator-collapse-chevron {{courseTimeOpen ? 'creator-collapse-chevron--open' : ''}}"><lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon></view></view><view class="creator-collapse-body" style="max-height: {{courseTimeOpen ? courseTimeExpandHeight : 0}}rpx;"><view class="creator-weekdays"><view wx:for="{{courseWeekdayOptions}}" wx:key="weekday" class="creator-weekday {{item.selected ? 'creator-weekday--active' : ''}}" data-weekday="{{item.weekday}}" bindtap="selectCourseWeekday">{{item.label}}</view></view><view class="creator-periods"><view wx:for="{{coursePeriodOptions}}" wx:key="period" class="creator-pill creator-period-pill {{item.selected ? 'creator-pill--active' : ''}}" data-period="{{item.period}}" bindtap="toggleCoursePeriod"><text>第 {{item.period}} 节</text><text class="creator-period-time">{{item.time}}</text></view></view></view><view class="creator-collapse-heading" bindtap="toggleCourseWeeks"><text>选择周次 <text class="creator-required">*</text></text><text class="creator-collapse-summary">{{courseWeeks.length ? '已选 ' + courseWeeks.length + ' 周' : '请选择'}}</text><view class="creator-collapse-chevron {{courseWeeksOpen ? 'creator-collapse-chevron--open' : ''}}"><lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon></view></view><view class="creator-collapse-body" style="max-height: {{courseWeeksOpen ? courseWeeksExpandHeight : 0}}rpx;"><view class="creator-weeks"><view wx:for="{{courseWeekOptions}}" wx:key="week" class="creator-week-option {{item.selected ? 'creator-week-option--active' : ''}}" data-week="{{item.week}}" bindtap="toggleCourseWeek"><text class="creator-week-number">{{item.week}} 周</text><text class="creator-week-date">{{item.dateLabel}}</text></view></view></view></view></scroll-view><block wx:else><view class="creator-form"><input class="creator-title" value="{{title}}" placeholder="要做什么？" placeholder-class="creator-placeholder" maxlength="80" bindinput="onTitleInput" /><text class="creator-label">开始</text><view class="creator-grid"><picker mode="date" value="{{startDate}}" bindchange="onStartDateChange"><view class="creator-value tnum"><text>{{startDate}}</text></view></picker><picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange"><view class="creator-value tnum"><text>{{startTime}}</text></view></picker></view><text class="creator-label">结束</text><view class="creator-grid"><picker mode="date" value="{{endDate}}" bindchange="onEndDateChange"><view class="creator-value tnum"><text>{{endDate}}</text></view></picker><picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange"><view class="creator-value tnum"><text>{{endTime}}</text></view></picker></view></view></block><view slot="footer" class="creator-footer"><button wx:if="{{editingPlanId}}" class="danger-button creator-delete" hover-class="button-pressed" bindtap="deletePlan">删除</button><button wx:if="{{editingCourseId}}" class="danger-button creator-delete" hover-class="button-pressed" disabled="{{savingCourse}}" bindtap="showDeleteCourseActions">删除</button><button wx:if="{{creatorMode === 'course'}}" class="primary-button creator-submit" hover-class="button-pressed" disabled="{{savingCourse}}" bindtap="saveCourse">{{savingCourse ? '保存中' : editingCourseId ? '保存' : '添加课程'}}</button><button wx:else class="primary-button creator-submit" hover-class="button-pressed" bindtap="savePlan">{{editingPlanId ? '保存' : '添加到日程'}}</button></view></bottom-sheet><include src="./live-glass.wxml"/></view><screen-watermark></screen-watermark>
