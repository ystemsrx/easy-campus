.grades-content { padding-top: 20rpx; }
.nav-refresh { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; color: #8b8578; background: #fff; box-shadow: var(--shadow-card); font-size: 36rpx; }
.semester-scroll { width: calc(100% + 80rpx); margin-left: -40rpx; }
.semester-row { display: flex; flex-direction: row; gap: 14rpx; padding: 8rpx 40rpx 18rpx; }
.semester-chip { flex: none; padding: 14rpx 25rpx; border-radius: 999rpx; color: #8b8b94; background: #fff; box-shadow: var(--shadow-card); font-size: 22rpx; font-weight: 700; }
.semester-chip--active { color: #fff; background: linear-gradient(135deg, #c98a2d, #e5b86e); }

.grade-overview { position: relative; margin-top: 18rpx; padding: 36rpx; overflow: hidden; border-radius: 56rpx; color: #fff; background: linear-gradient(140deg, #c98a2d, #e5b86e); box-shadow: var(--shadow-pop); }
.grade-blob { background: rgba(255, 255, 255, 0.15); }
.grade-blob--one { top: -94rpx; left: -74rpx; width: 300rpx; height: 270rpx; }
.grade-blob--two { right: -60rpx; bottom: -105rpx; width: 250rpx; height: 220rpx; background: rgba(0, 0, 0, 0.06); animation-delay: -4s; }
.grade-overview-main { position: relative; display: flex; flex-direction: row; align-items: center; gap: 34rpx; }
.average-ring { display: flex; flex: none; align-items: center; justify-content: center; width: 190rpx; height: 190rpx; border: 17rpx solid rgba(255, 255, 255, 0.92); border-radius: 50%; }
.average-inner { display: flex; flex-direction: column; align-items: center; }
.average-value { max-width: 145rpx; font-size: 48rpx; font-weight: 800; line-height: 1; text-align: center; }
.average-unit { margin-top: 7rpx; color: rgba(255, 255, 255, 0.72); font-size: 18rpx; }
.overview-stats { display: flex; flex: 1; flex-direction: column; gap: 14rpx; min-width: 0; }
.overview-stat { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 12rpx 19rpx; border-radius: 22rpx; background: rgba(255, 255, 255, 0.14); backdrop-filter: blur(8px); }
.overview-stat text:first-child { color: rgba(255, 255, 255, 0.82); font-size: 21rpx; }
.overview-stat text:last-child { font-size: 28rpx; font-weight: 800; }
.overview-foot { position: relative; display: flex; flex-direction: row; justify-content: space-between; gap: 18rpx; margin-top: 24rpx; color: rgba(255, 255, 255, 0.7); font-size: 19rpx; }

.grade-tools { display: flex; flex-direction: row; gap: 14rpx; margin-top: 28rpx; }
.grade-search { flex: 1; min-width: 0; }
.grade-placeholder { color: #b5b0a3; }
.grade-clear { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 50%; color: #9a9aa3; background: rgba(43, 38, 32, 0.05); font-size: 30rpx; }
.grade-filter-button { display: flex; flex: none; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 30rpx; color: #8b8578; background: #fff; box-shadow: var(--shadow-card); }
.filter-lines { display: flex; flex-direction: column; gap: 6rpx; width: 31rpx; }
.filter-lines view { height: 3rpx; border-radius: 3rpx; background: currentColor; }
.filter-lines view:nth-child(2) { width: 22rpx; }
.filter-lines view:nth-child(3) { width: 13rpx; }
.result-heading { display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; margin: 48rpx 2rpx 22rpx; }
.result-title { display: block; color: var(--color-text); font-size: 38rpx; font-weight: 750; }
.result-count { display: block; margin-top: 5rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.result-sort { color: #b5b0a3; font-size: 21rpx; }

.grade-list { display: flex; flex-direction: column; gap: 18rpx; }
.grade-card { display: flex; flex-direction: row; align-items: center; gap: 22rpx; padding: 26rpx; }
.score-tile { display: flex; flex: none; align-items: center; justify-content: center; width: 98rpx; height: 98rpx; border-radius: 34rpx; color: #b85c38; background: linear-gradient(135deg, #f9eae2, #f2d7ca); }
.score-tile--great,
.score-tile--good { color: #5f7350; background: linear-gradient(135deg, #edf1e6, #dde6d1); }
.score-tile--warning { color: #a66f1f; background: linear-gradient(135deg, #f8eedd, #f0dfbd); }
.score-tile--text { color: #a55357; background: linear-gradient(135deg, #f7e9e8, #efd6d5); }
.score-tile--muted { color: #8b8b94; background: #f1f1f3; }
.score-tile--text { width: 110rpx; padding: 10rpx; }
.score-value { max-width: 100%; font-size: 33rpx; font-weight: 800; line-height: 1.15; text-align: center; }
.score-tile--text .score-value { font-size: 22rpx; }
.course-copy { flex: 1; min-width: 0; }
.course-title-line { display: flex; flex-direction: row; align-items: flex-start; gap: 12rpx; }
.course-name { flex: 1; min-width: 0; color: var(--color-text); font-size: 27rpx; font-weight: 750; line-height: 1.4; }
.course-tag { flex: none; padding: 5rpx 12rpx; border-radius: 999rpx; color: #8b8b94; background: rgba(43, 38, 32, 0.05); font-size: 17rpx; font-weight: 700; }
.course-term { display: block; margin-top: 6rpx; color: var(--color-text-tertiary); font-size: 20rpx; }
.component-preview { display: flex; flex-direction: row; flex-wrap: wrap; gap: 7rpx; margin-top: 12rpx; }
.component-preview text { padding: 5rpx 11rpx; border-radius: 999rpx; color: #8b8578; background: #f6f3ec; font-size: 17rpx; font-weight: 650; }
.grade-remark { display: flex; flex-direction: row; align-items: center; gap: 8rpx; margin-top: 10rpx; color: #c0452d; font-size: 19rpx; }
.grade-remark view { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.grade-chevron { flex: none; color: #d3d0c7; font-size: 34rpx; }
.grade-load-more,
.grade-end { display: block; padding: 26rpx; color: #b5b0a3; font-size: 21rpx; text-align: center; }

.grade-filter-section { margin-top: 28rpx; }
.grade-filter-section:first-child { margin-top: 8rpx; }
.grade-filter-title { display: block; margin: 0 4rpx 14rpx; color: #9a9aa3; font-size: 23rpx; font-weight: 750; }
.filter-wrap { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.filter-chip,
.term-option,
.sort-option { display: flex; align-items: center; justify-content: center; min-height: 68rpx; padding: 0 22rpx; border-radius: 999rpx; color: #8b8b94; background: rgba(43, 38, 32, 0.045); font-size: 22rpx; font-weight: 700; transition: transform 120ms ease, color 220ms ease, background-color 220ms ease; }
.filter-chip--active,
.term-option--active,
.sort-option--active { color: #fff; background: linear-gradient(135deg, #c98a2d, #e5b86e); }
.filter-chip--pressed,
.term-option--pressed,
.sort-option--pressed { transform: scale(0.95); }
.term-grid,
.sort-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.order-control { position: relative; display: flex; flex-direction: row; margin-top: 16rpx; padding: 7rpx; border-radius: 999rpx; background: rgba(43, 38, 32, 0.045); }
.order-indicator { position: absolute; top: 7rpx; bottom: 7rpx; left: 7rpx; width: calc((100% - 14rpx) / 2); border-radius: 999rpx; background: #fff; box-shadow: var(--shadow-card); transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1); }
.order-indicator--asc { transform: translateX(100%); }
.order-item { position: relative; z-index: 1; display: flex; flex: 1; align-items: center; justify-content: center; min-height: 62rpx; color: #8b8b94; font-size: 22rpx; font-weight: 700; }
.order-item--active { color: #16161a; }
.grade-filter-actions { display: flex; flex-direction: row; gap: 16rpx; }
.grade-filter-actions .secondary-button { flex: 2; }
.grade-filter-actions .primary-button { flex: 3; }
