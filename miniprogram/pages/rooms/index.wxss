.rooms-content { padding-top: 20rpx; }
.source-banner { display: flex; flex-direction: row; align-items: flex-start; gap: 16rpx; margin-bottom: 22rpx; padding: 19rpx 24rpx; border-radius: 30rpx; color: #8b8578; background: #f8eedd; }
.source-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-top: 1rpx; border: 2rpx solid #a66f1f; border-radius: 50%; color: #a66f1f; font-family: Georgia, serif; font-size: 20rpx; font-weight: 700; }
.source-title { display: block; color: #a66f1f; font-size: 22rpx; font-weight: 750; }
.source-caption { display: block; margin-top: 2rpx; font-size: 19rpx; }
.rooms-loading { margin-top: 20rpx; }
.query-card { padding: 36rpx; border-radius: 56rpx; }
.query-label { display: block; color: #9a9aa3; font-size: 22rpx; font-weight: 750; }
.query-label--spaced { margin-top: 34rpx; }
.query-hint { color: #c9c5b8; font-weight: 550; }
.campus-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.choice-pill { flex: 1; min-width: 150rpx; padding: 14rpx 20rpx; border-radius: 999rpx; color: #8b8b94; background: #f4f3f0; font-size: 23rpx; font-weight: 700; text-align: center; }
.choice-pill--active { color: #fff; background: linear-gradient(135deg, #7d8f6e, #acbe97); box-shadow: 0 13rpx 32rpx rgba(95, 115, 80, 0.2); }
.building-scroll { max-height: 300rpx; margin-top: 14rpx; }
.building-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; padding-bottom: 2rpx; }
.building-pill { position: relative; display: flex; align-items: center; justify-content: center; width: calc((100% - 24rpx) / 3); min-height: 70rpx; padding: 10rpx 14rpx; border-radius: 25rpx; color: #8b8b94; background: #f4f3f0; font-size: 21rpx; font-weight: 650; text-align: center; }
.building-pill--active { color: #fff; background: linear-gradient(145deg, #7d8f6e, #acbe97); }
.building-check { position: absolute; top: -4rpx; right: -3rpx; display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border: 3rpx solid #fff; border-radius: 50%; color: #5f7350; background: #edf1e6; font-size: 16rpx; font-weight: 800; }
.inline-placeholder { margin-top: 14rpx; padding: 28rpx; border-radius: 26rpx; color: #b5b0a3; background: #f6f3ec; font-size: 22rpx; text-align: center; }
.date-choice { display: flex; flex-direction: row; align-items: center; gap: 20rpx; margin-top: 14rpx; padding: 16rpx 20rpx; border-radius: 30rpx; background: #f4f3f0; }
.date-icon { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border: 3rpx solid #7d8f6e; border-radius: 20rpx; color: #5f7350; }
.date-copy { flex: 1; min-width: 0; }
.date-copy text:first-child { display: block; color: var(--color-text); font-size: 25rpx; font-weight: 700; }
.date-copy text:last-child { display: block; margin-top: 2rpx; color: #b5b0a3; font-size: 19rpx; }
.date-chevron { color: #c9c5b8; font-size: 36rpx; }
.period-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.period-pill { display: flex; flex-direction: column; align-items: center; justify-content: center; width: calc((100% - 24rpx) / 3); min-height: 82rpx; padding: 10rpx 6rpx; border-radius: 26rpx; color: #8b8b94; background: #f4f3f0; }
.period-pill--active { color: #fff; background: linear-gradient(145deg, #7d8f6e, #acbe97); }
.period-number { font-size: 25rpx; font-weight: 800; line-height: 1.1; }
.period-time { margin-top: 3rpx; font-size: 15rpx; font-weight: 550; opacity: 0.78; }
.room-query-button { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 14rpx; width: 100%; min-height: 94rpx; margin-top: 36rpx; border: 0; border-radius: 999rpx; color: #fff; background: linear-gradient(135deg, #7d8f6e, #acbe97); box-shadow: 0 17rpx 42rpx rgba(95, 115, 80, 0.24); font-size: 28rpx; font-weight: 750; transition: transform 140ms ease, opacity 140ms ease; }
.room-query-button::after { display: none; }
.room-query-button--disabled { opacity: 0.55; box-shadow: none; }
.room-query-button--pressed { transform: scale(0.97); opacity: 0.86; }
.query-spinner { width: 28rpx; height: 28rpx; border: 4rpx solid rgba(255, 255, 255, 0.38); border-top-color: #fff; border-radius: 50%; animation-name: rooms-spin; animation-duration: 760ms; animation-timing-function: linear; animation-iteration-count: infinite; }

.room-results-heading { margin: 50rpx 2rpx 20rpx; }
.room-results-title { display: block; color: var(--color-text); font-size: 38rpx; font-weight: 750; }
.room-results-title text { color: #5f7350; font-size: 31rpx; }
.room-results-caption { display: block; margin-top: 5rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.building-summary-scroll { width: calc(100% + 80rpx); margin-left: -40rpx; margin-bottom: 18rpx; }
.building-summary-row { display: flex; flex-direction: row; gap: 12rpx; padding: 2rpx 40rpx 12rpx; }
.building-summary-chip { display: flex; flex: none; flex-direction: row; align-items: center; gap: 10rpx; padding: 11rpx 18rpx; border-radius: 999rpx; color: #5f7350; background: #edf1e6; font-size: 20rpx; font-weight: 700; }
.building-summary-chip text:last-child { display: flex; align-items: center; justify-content: center; min-width: 30rpx; height: 30rpx; padding: 0 6rpx; border-radius: 999rpx; color: #fff; background: #7d8f6e; font-size: 17rpx; }
.room-list { display: flex; flex-direction: column; gap: 18rpx; }
.room-card { display: flex; flex-direction: row; align-items: center; gap: 22rpx; padding: 26rpx; }
.room-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 98rpx; height: 98rpx; border-radius: 34rpx; color: #5f7350; background: linear-gradient(135deg, #edf1e6, #dee7d2); }
.room-copy { flex: 1; min-width: 0; }
.room-name { display: block; color: var(--color-text); font-size: 28rpx; font-weight: 750; }
.room-location { display: block; margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.room-meta { display: block; margin-top: 3rpx; color: #b5b0a3; font-size: 19rpx; }
.capacity-block { display: flex; flex: none; flex-direction: column; align-items: flex-end; }
.capacity-value { color: #5f7350; font-size: 34rpx; font-weight: 800; }
.capacity-label { color: #b5b0a3; font-size: 18rpx; }
.rooms-load-more,
.rooms-end { display: block; padding: 26rpx; color: #b5b0a3; font-size: 21rpx; text-align: center; }
@keyframes rooms-spin { to { transform: rotate(360deg); } }
