.home-page {
  background-color: var(--color-bg);
}

.home-content {
  padding-top: 28rpx;
}

.welcome-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 6rpx 34rpx;
}

.welcome-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.eyebrow {
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.welcome-name {
  margin-top: 6rpx;
  color: var(--color-text);
  font-size: 54rpx;
  font-weight: 760;
  line-height: 1.1;
  letter-spacing: -1.8rpx;
}

.welcome-date {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.publication-bell {
  position: relative;
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-left: 24rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 50%;
  color: var(--color-text);
  background-color: var(--color-bg-elevated);
  box-shadow: 0 12rpx 32rpx rgba(42, 57, 84, 0.1);
}

.publication-bell--pressed {
  opacity: 0.72;
  transform: scale(0.92);
}

.bell-glyph {
  position: relative;
  width: 33rpx;
  height: 38rpx;
}

.bell-dome {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  width: 25rpx;
  height: 27rpx;
  border: 4rpx solid currentColor;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  border-bottom: 0;
}

.bell-dome::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  left: -8rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background-color: currentColor;
  content: "";
}

.bell-clapper {
  position: absolute;
  bottom: 0;
  left: 14rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background-color: currentColor;
}

.publication-badge {
  position: absolute;
  top: -7rpx;
  right: -9rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 33rpx;
  height: 33rpx;
  padding: 0 8rpx;
  border: 4rpx solid var(--color-bg);
  border-radius: 18rpx;
  color: #ffffff;
  background-color: #ef4f5f;
  font-size: 18rpx;
  font-weight: 720;
  line-height: 1;
  animation-name: badge-arrive;
  animation-duration: 340ms;
  animation-timing-function: cubic-bezier(0.2, 0.9, 0.25, 1.25);
  animation-fill-mode: both;
}

.hero-card {
  position: relative;
  min-height: 390rpx;
  padding: 31rpx 31rpx 25rpx;
  overflow: hidden;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #176ee8 0%, #2f8cff 58%, #55afff 100%);
  box-shadow: 0 26rpx 60rpx rgba(22, 119, 255, 0.24);
}

.hero-card--pressed {
  opacity: 0.92;
  transform: scale(0.985);
}

.hero-glow {
  position: absolute;
  top: -150rpx;
  right: -100rpx;
  width: 360rpx;
  height: 360rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.hero-topline,
.hero-clock,
.hero-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hero-topline {
  position: relative;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.75);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2.6rpx;
}

.hero-clock {
  justify-content: center;
  min-width: 116rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.13);
  font-size: 27rpx;
  font-weight: 710;
  letter-spacing: 0.6rpx;
  backdrop-filter: blur(12px);
}

.hero-title {
  position: relative;
  display: block;
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 740;
  line-height: 1.12;
  letter-spacing: -1.2rpx;
}

.hero-course-list,
.hero-course-empty {
  position: relative;
  margin-top: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 27rpx;
  background: rgba(10, 65, 150, 0.17);
  backdrop-filter: blur(14px);
}

.hero-course-list {
  padding: 2rpx 21rpx;
}

.hero-course-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 103rpx;
}

.hero-course-row--divided {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.13);
}

.hero-course-status {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 127rpx;
  margin-right: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  font-weight: 580;
}

.hero-course-status--current {
  color: #b8ffdc;
  font-weight: 680;
}

.hero-current-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background-color: #a7ffd3;
  box-shadow: 0 0 0 6rpx rgba(167, 255, 211, 0.13);
}

.hero-course-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.hero-course-name {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.3;
}

.hero-course-location {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
}

.hero-course-chevron {
  flex: none;
  margin-left: 12rpx;
  color: rgba(255, 255, 255, 0.54);
  font-size: 33rpx;
  font-weight: 300;
}

.hero-course-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 150rpx;
}

.hero-course-empty-title {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 650;
}

.hero-course-empty-caption {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
}

.hero-foot {
  position: relative;
  justify-content: space-between;
  margin-top: 21rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
}

.hero-foot-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: rgba(255, 255, 255, 0.88);
  font-weight: 620;
}

.hero-arrow {
  margin-left: 6rpx;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 1;
}

.quick-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.quick-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: calc(50% - 9rpx);
  min-height: 146rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 18rpx 24rpx 22rpx;
}

.quick-glyph {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-right: 16rpx;
  border-radius: 23rpx;
  font-size: 27rpx;
  font-weight: 720;
}

.quick-glyph--blue { color: #1677ff; background: #e7f1ff; }
.quick-glyph--cyan { color: #0797a8; background: #e3f8fa; }
.quick-glyph--purple { color: #7258d6; background: #f0ebff; }
.quick-glyph--green { color: #159461; background: #e7f7ef; }
.quick-glyph--orange { color: #d77b0b; background: #fff2de; }
.quick-glyph--pink { color: #d94b78; background: #ffebf1; }

.theme-dark .quick-glyph--blue { background: #172b48; }
.theme-dark .quick-glyph--cyan { background: #143239; }
.theme-dark .quick-glyph--purple { background: #2c2544; }
.theme-dark .quick-glyph--green { background: #173528; }
.theme-dark .quick-glyph--orange { background: #3a2d18; }
.theme-dark .quick-glyph--pink { background: #3b222d; }

.quick-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.quick-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.25;
}

.quick-caption {
  margin-top: 5rpx;
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  line-height: 1.3;
}

.quick-chevron,
.notice-chevron {
  flex: none;
  margin-left: 6rpx;
  color: var(--color-text-tertiary);
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.feed-card,
.notice-card {
  padding: 8rpx 24rpx;
}

.feed-row,
.notice-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 126rpx;
  padding: 20rpx 2rpx;
}

.feed-row--divided,
.notice-row--divided {
  border-bottom: 1rpx solid var(--color-separator);
}

.feed-badge {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border-radius: 17rpx;
  font-size: 20rpx;
  font-weight: 650;
}

.feed-badge--blue { color: var(--color-primary); background-color: var(--color-primary-soft); }
.feed-badge--green { color: var(--color-success); background-color: var(--color-success-soft); }
.feed-badge--orange { color: var(--color-warning); background-color: var(--color-warning-soft); }
.feed-badge--gray { color: var(--color-text-secondary); background-color: var(--color-bg-subtle); }

.feed-copy,
.notice-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.feed-title,
.notice-title {
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 620;
  line-height: 1.35;
}

.feed-subtitle,
.notice-time {
  margin-top: 6rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  line-height: 1.35;
}

.feed-time {
  flex: none;
  max-width: 130rpx;
  margin-left: 14rpx;
  color: var(--color-text-tertiary);
  font-size: 18rpx;
  line-height: 1.3;
  text-align: right;
}

.notice-dot {
  flex: none;
  width: 13rpx;
  height: 13rpx;
  margin: 0 22rpx 0 6rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  box-shadow: 0 0 0 9rpx var(--color-primary-soft);
}

.publication-popover-layer,
.announcement-modal-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 80;
  visibility: hidden;
  pointer-events: none;
}

.publication-popover-layer--open,
.announcement-modal-layer--open {
  visibility: visible;
  pointer-events: auto;
}

.publication-popover-dismiss,
.announcement-modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.publication-popover-dismiss {
  background-color: rgba(18, 26, 40, 0.01);
}

.publication-popover {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 132rpx);
  right: 26rpx;
  display: flex;
  flex-direction: column;
  width: calc(100% - 52rpx);
  height: 64vh;
  max-height: 720rpx;
  overflow: hidden;
  border: 1rpx solid rgba(23, 32, 51, 0.08);
  border-radius: 34rpx;
  color: #172033;
  background-color: #ffffff;
  box-shadow: 0 34rpx 92rpx rgba(23, 32, 51, 0.2);
  opacity: 0;
  transform: translateY(-18rpx) scale(0.94);
  transform-origin: 92% 0;
  transition: opacity 220ms ease-out,
    transform 320ms cubic-bezier(0.2, 0.84, 0.24, 1);
}

.publication-popover-layer--open .publication-popover {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.publication-popover-header {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 124rpx;
  padding: 23rpx 27rpx 20rpx;
  border-bottom: 1rpx solid rgba(23, 32, 51, 0.07);
}

.publication-popover-header > view:first-child {
  display: flex;
  flex-direction: column;
}

.publication-popover-eyebrow {
  color: #8a94a6;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2.4rpx;
}

.publication-popover-title {
  margin-top: 3rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 720;
  letter-spacing: -0.4rpx;
}

.publication-unread-summary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 8rpx 16rpx;
  border-radius: 18rpx;
  color: #e14356;
  background-color: #ffedf0;
  font-size: 20rpx;
  font-weight: 620;
}

.publication-unread-summary--clear {
  color: #638072;
  background-color: #edf8f2;
}

.publication-popover-scroll {
  flex: 1;
  min-height: 0;
  background-color: #f6f8fb;
}

.publication-group {
  padding: 24rpx 22rpx 0;
}

.publication-group:last-child {
  padding-bottom: 24rpx;
}

.publication-group-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 7rpx 12rpx;
  color: #7f899c;
  font-size: 21rpx;
  font-weight: 650;
}

.publication-group-header text:last-child {
  min-width: 38rpx;
  text-align: right;
}

.publication-group-card {
  overflow: hidden;
  border: 1rpx solid rgba(23, 32, 51, 0.07);
  border-radius: 25rpx;
  background-color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(34, 48, 73, 0.05);
}

.platform-announcement-row {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 106rpx;
  padding: 19rpx 19rpx 19rpx 20rpx;
  background-color: #ffffff;
}

.publication-row--unread {
  background-color: #fbfdff;
}

.publication-row--divided {
  border-bottom: 1rpx solid rgba(23, 32, 51, 0.07);
}

.publication-row--pressed {
  opacity: 0.76;
  transform: scale(0.985);
}

.publication-tone,
.announcement-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
}

.publication-tone {
  margin-right: 17rpx;
}

.publication-tone--default {
  color: #1677ff;
  background-color: #e9f2ff;
}

.publication-tone--warning {
  color: #d98516;
  background-color: #fff3df;
}

.publication-tone--success {
  color: #159461;
  background-color: #e7f7ef;
}

.publication-tone--info {
  color: #7258d6;
  background-color: #f0ebff;
}

.mini-megaphone {
  position: relative;
  width: 31rpx;
  height: 28rpx;
}

.mini-megaphone::before {
  position: absolute;
  top: 5rpx;
  left: 2rpx;
  width: 17rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
  content: "";
}

.mini-megaphone::after {
  position: absolute;
  top: 0;
  right: 1rpx;
  width: 4rpx;
  height: 27rpx;
  border-radius: 3rpx;
  background-color: currentColor;
  content: "";
  transform: rotate(12deg);
}

.mini-megaphone > view {
  position: absolute;
  bottom: -2rpx;
  left: 8rpx;
  width: 5rpx;
  height: 10rpx;
  border-radius: 0 0 3rpx 3rpx;
  background-color: currentColor;
  transform: rotate(-16deg);
}

.mini-bell {
  position: relative;
  width: 29rpx;
  height: 31rpx;
}

.mini-bell::before {
  position: absolute;
  top: 2rpx;
  left: 3rpx;
  width: 21rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-top-left-radius: 15rpx;
  border-top-right-radius: 15rpx;
  content: "";
}

.mini-bell::after {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  left: 0;
  height: 4rpx;
  border-radius: 3rpx;
  background-color: currentColor;
  content: "";
}

.mini-bell > view {
  position: absolute;
  bottom: 0;
  left: 12rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: currentColor;
}

.platform-announcement-title {
  flex: 1;
  min-width: 0;
  color: #263247;
  font-size: 25rpx;
  font-weight: 620;
  line-height: 1.42;
}

.publication-unread-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background-color: #1677ff;
  box-shadow: 0 0 0 6rpx rgba(22, 119, 255, 0.1);
}

.publication-row-chevron {
  flex: none;
  margin-left: 13rpx;
  color: #a4acb9;
  font-size: 34rpx;
  font-weight: 300;
}

.platform-notification-row {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 21rpx 20rpx 19rpx;
  background-color: #ffffff;
}

.platform-notification-head,
.platform-notification-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.platform-notification-head {
  width: 100%;
}

.platform-notification-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.platform-notification-title-row {
  justify-content: space-between;
}

.platform-notification-title {
  flex: 1;
  min-width: 0;
  color: #263247;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.35;
}

.platform-notification-time {
  margin-top: 3rpx;
  color: #99a2b2;
  font-size: 18rpx;
}

.platform-notification-body {
  width: 100%;
  margin-top: 14rpx;
  padding-left: 79rpx;
  color: #657086;
  font-size: 22rpx;
  line-height: 1.58;
}

.platform-notification-body--expanded {
  animation-name: notification-expand;
  animation-duration: 260ms;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}

.platform-notification-expand {
  align-self: flex-end;
  margin-top: 8rpx;
  color: #1677ff;
  font-size: 20rpx;
  font-weight: 600;
}

.publication-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 430rpx;
  padding: 50rpx;
  text-align: center;
}

.publication-empty-bell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 31rpx;
  color: #8c98aa;
  background-color: #edf1f6;
}

.publication-empty-title {
  margin-top: 24rpx;
  color: #39455a;
  font-size: 27rpx;
  font-weight: 650;
}

.publication-empty-caption {
  margin-top: 8rpx;
  color: #929cad;
  font-size: 21rpx;
}

.announcement-modal-layer {
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(env(safe-area-inset-top) + 36rpx) 34rpx
    calc(env(safe-area-inset-bottom) + 36rpx);
}

.announcement-modal-backdrop {
  background-color: rgba(15, 21, 32, 0.46);
  opacity: 0;
  transition: opacity 250ms ease;
}

.announcement-modal-layer--open .announcement-modal-backdrop {
  opacity: 1;
}

.announcement-modal {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 38rpx;
  color: #172033;
  background-color: #ffffff;
  box-shadow: 0 44rpx 120rpx rgba(8, 14, 25, 0.34);
  opacity: 0;
  transform: translateY(42rpx) scale(0.96);
  transition: opacity 220ms ease-out,
    transform 360ms cubic-bezier(0.2, 0.84, 0.24, 1);
}

.announcement-modal-layer--open .announcement-modal {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.announcement-accent {
  flex: none;
  width: 100%;
  height: 8rpx;
}

.announcement-header {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: flex-start;
  padding: 29rpx 28rpx 22rpx;
}

.announcement-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 19rpx;
  border-radius: 23rpx;
}

.announcement-heading {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.announcement-label {
  color: #8a94a6;
  font-size: 19rpx;
  font-weight: 650;
}

.announcement-title {
  margin-top: 3rpx;
  color: #172033;
  font-size: 33rpx;
  font-weight: 720;
  line-height: 1.33;
  letter-spacing: -0.4rpx;
}

.announcement-time {
  margin-top: 8rpx;
  color: #98a1b1;
  font-size: 20rpx;
}

.announcement-close {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: -5rpx -4rpx 0 14rpx;
  border-radius: 50%;
  color: #657086;
  background-color: #f0f3f7;
  font-size: 39rpx;
  font-weight: 300;
  line-height: 1;
}

.announcement-close--pressed {
  opacity: 0.7;
  transform: scale(0.9);
}

.announcement-content {
  flex: 1;
  min-height: 160rpx;
  padding: 0 30rpx 8rpx;
}

.announcement-footer {
  flex: none;
  padding: 20rpx 28rpx 28rpx;
  border-top: 1rpx solid rgba(23, 32, 51, 0.07);
}

.announcement-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  border-radius: 25rpx;
  color: #ffffff;
  background-color: #1677ff;
  box-shadow: 0 14rpx 32rpx rgba(22, 119, 255, 0.2);
  font-size: 27rpx;
  font-weight: 650;
}

.announcement-confirm--pressed {
  opacity: 0.86;
  transform: scale(0.975);
}

.dashboard-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  color: var(--color-danger);
  background-color: var(--color-danger-soft);
  font-size: 23rpx;
  text-align: center;
  transition: opacity 100ms ease;
}

.dashboard-error--pressed {
  opacity: 0.7;
}

.retry-text {
  margin-top: 8rpx;
  font-weight: 650;
}

.motion-reduced .publication-popover,
.motion-reduced .announcement-modal,
.motion-reduced .announcement-modal-backdrop {
  transition-duration: 1ms;
}

.motion-reduced .publication-badge,
.motion-reduced .platform-notification-body--expanded {
  animation-duration: 1ms;
}

@keyframes badge-arrive {
  from {
    opacity: 0;
    transform: scale(0.55);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes notification-expand {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
