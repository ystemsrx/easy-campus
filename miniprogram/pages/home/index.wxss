.publication-row { display: flex; flex-direction: row; align-items: flex-start; gap: 20rpx; padding: 20rpx; border-bottom: 1rpx solid rgba(43, 38, 32, 0.05); }
.publication-row:last-child { border-bottom: 0; }
.publication-icon { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 28rpx; }
.publication-icon--announcement { color: #a66f1f; background: #f8eedd; }
.publication-icon--notification { color: #b85c38; background: #f9eae2; }
.publication-dot { position: absolute; top: -3rpx; right: -3rpx; width: 18rpx; height: 18rpx; border: 4rpx solid #fff; border-radius: 50%; background: #c0452d; }
.publication-copy { flex: 1; min-width: 0; }
.publication-title-line { display: flex; flex-direction: row; align-items: baseline; gap: 12rpx; }
.publication-title { flex: 1; min-width: 0; color: #16161a; font-size: 25rpx; font-weight: 750; }
.publication-time { flex: none; max-width: 128rpx; color: #b5b0a3; font-size: 17rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.publication-preview { display: block; margin-top: 5rpx; color: #8b8578; font-size: 21rpx; line-height: 1.55; }
.publication-body { position: relative; display: block; max-height: 30rpx; margin-top: 5rpx; overflow: hidden; color: #8b8578; font-size: 20rpx; line-height: 1.5; transition: max-height 280ms cubic-bezier(0.22, 1, 0.36, 1); }
.publication-body--expanded { max-height: 300rpx; transition-duration: 460ms; transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1); }
.publication-body-preview { position: absolute; z-index: 1; top: 0; right: 0; left: 0; display: block; opacity: 1; transition: opacity 100ms ease 180ms; }
.publication-body-content { opacity: 0; transition: opacity 100ms ease 180ms; }
.publication-body--expanded .publication-body-preview { opacity: 0; pointer-events: none; transition: opacity 140ms ease; }
.publication-body--expanded .publication-body-content { opacity: 1; transition: opacity 220ms ease 90ms; }
.publication-type { display: block; margin-top: 6rpx; color: #b85c38; font-size: 18rpx; font-weight: 700; }
.publication-empty { display: flex; flex-direction: column; align-items: center; padding: 62rpx 20rpx; }
.publication-empty-bell { display: flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; border-radius: 30rpx; color: #a39e92; background: #f6f3ec; }
.publication-empty-title { margin-top: 18rpx; color: #16161a; font-size: 26rpx; font-weight: 750; }

.home-page.theme-style-minimal .publication-bell--plain,
.home-page.theme-style-minimal .publication-icon,
.home-page.theme-style-minimal .publication-empty-bell {
  border: 0;
  border-radius: 0;
  color: var(--color-text);
  background: transparent;
  box-shadow: none;
}

.home-page.theme-style-minimal .publication-popover-frame {
  position: relative;
  flex: 1;
  min-height: 0;
}

.home-page.theme-style-minimal .publication-popover-viewport {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  bottom: 28rpx;
  left: 20rpx;
  width: auto;
  height: auto;
  overflow: hidden;
  border-radius: var(--radius-card);
  background-color: var(--color-bg);
}

.home-page.theme-style-minimal .publication-popover-outline {
  box-sizing: border-box;
  position: absolute;
  z-index: 5;
  top: 16rpx;
  right: 20rpx;
  bottom: 28rpx;
  left: 20rpx;
  display: block;
  border: 2rpx solid var(--color-text);
  border-radius: var(--radius-card);
  pointer-events: none;
}

.home-page.theme-style-minimal .publication-popover-content {
  padding: 2rpx;
}

.home-page.theme-style-minimal .publication-list {
  margin-top: 0;
}

.home-page.theme-style-minimal .publication-list-card {
  border: 0;
  border-radius: 0;
}

.announcement-modal-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1300; display: flex; align-items: flex-end; justify-content: center; color: #16161a; opacity: 0; transition: opacity 280ms ease; pointer-events: none; }
.announcement-modal-layer--open { opacity: 1; pointer-events: auto; }
.announcement-modal-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(32, 28, 24, 0.36); }
.announcement-modal { position: relative; z-index: 1; display: flex; flex-direction: column; width: 100%; max-height: 86vh; padding-bottom: env(safe-area-inset-bottom); overflow: hidden; border-radius: 56rpx 56rpx 0 0; background: #fbf9f4; box-shadow: 0 -24rpx 90rpx rgba(20, 20, 30, 0.2); transform: translateY(104%); transition: transform 380ms cubic-bezier(0.32, 0.72, 0, 1); }
.announcement-modal-layer--open .announcement-modal { transform: translateY(0); }
.announcement-handle { position: absolute; top: 14rpx; left: 50%; width: 70rpx; height: 8rpx; border-radius: 999rpx; background: rgba(43, 38, 32, 0.15); transform: translateX(-50%); }
.announcement-header { display: flex; flex: none; flex-direction: row; align-items: flex-start; gap: 20rpx; padding: 40rpx 40rpx 18rpx; }
.announcement-heading { flex: 1; min-width: 0; }
.announcement-label { display: block; color: #a66f1f; font-size: 21rpx; font-weight: 750; }
.announcement-title { display: block; margin-top: 5rpx; color: #16161a; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.announcement-time { display: block; margin-top: 8rpx; color: #a39e92; font-size: 21rpx; }
.announcement-close { display: flex; flex: none; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin-top: 8rpx; border-radius: 50%; color: #8b8578; background: rgba(43, 38, 32, 0.06); font-size: 36rpx; }
.announcement-close--pressed { transform: scale(0.9); opacity: 0.75; }
.announcement-content { box-sizing: border-box; flex: none; width: 100%; min-height: 0; padding: 0 40rpx; transition: height 220ms ease; }
.announcement-content-body { width: 100%; }
.announcement-article { padding: 34rpx; border-radius: 44rpx; color: #3a352d; background: #fff; box-shadow: var(--shadow-card); font-size: 26rpx; line-height: 1.75; }
.markdown-code-block { width: 100%; margin: 22rpx 0; overflow: hidden; border: 1rpx solid #e2ddd3; border-radius: 24rpx; background: #f2efe9; }
.markdown-code-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 68rpx; padding: 8rpx 12rpx 8rpx 24rpx; border-bottom: 1rpx solid rgba(94, 84, 70, 0.1); }
.markdown-code-language { flex: 1; min-width: 0; color: #7b7368; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 20rpx; font-weight: 750; line-height: 1; white-space: nowrap; }
.markdown-code-copy { display: flex; flex: none; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; color: #756d62; background: rgba(255, 255, 255, 0.74); box-shadow: 0 4rpx 12rpx rgba(58, 51, 43, 0.08); transition: transform 120ms ease-out, opacity 120ms ease-out; }
.markdown-code-copy--pressed { opacity: 0.72; transform: scale(0.9); }
.markdown-code-copy-icon { position: relative; width: 27rpx; height: 27rpx; }
.markdown-code-copy-square { position: absolute; box-sizing: border-box; width: 20rpx; height: 20rpx; border: 2rpx solid currentColor; border-radius: 6rpx; }
.markdown-code-copy-square--back { top: 0; left: 0; opacity: 0.58; }
.markdown-code-copy-square--front { right: 0; bottom: 0; background: #fbf9f4; }
.markdown-code-scroll { box-sizing: border-box; width: 100%; }
.markdown-code-lines { display: flex; box-sizing: border-box; flex-direction: column; align-items: flex-start; min-width: 100%; padding: 22rpx 24rpx 26rpx; }
.markdown-code-content { display: block; flex: none; min-width: 100%; color: #403a33; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 22rpx; line-height: 1.65; }
.markdown-code-block--compact { margin: 12rpx 0; border-radius: 18rpx; }
.markdown-code-block--compact .markdown-code-header { min-height: 58rpx; padding-left: 18rpx; }
.markdown-code-block--compact .markdown-code-lines { padding: 18rpx; }
.markdown-code-block--compact .markdown-code-content { font-size: 20rpx; }
.announcement-content-end { width: 100%; height: 24rpx; }
.announcement-footer { flex: none; padding: 24rpx 40rpx 26rpx; }
.announcement-confirm { display: flex; align-items: center; justify-content: center; min-height: 90rpx; border-radius: 999rpx; color: #fff; background: linear-gradient(135deg, #d97757, #eba97f); font-size: 28rpx; font-weight: 750; box-shadow: 0 16rpx 38rpx rgba(185, 92, 56, 0.24); }
.announcement-confirm--pressed { transform: scale(0.97); opacity: 0.86; }

@keyframes home-page-settle {
  from { transform: translateY(12rpx); }
  to { transform: translateY(0); }
}

@keyframes home-item-settle {
  from { transform: translateY(10rpx); }
  to { transform: translateY(0); }
}

@keyframes plan-row-enter {
  from { opacity: 0; transform: translateY(20rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes plan-empty-enter {
  from { opacity: 0; }
  to { opacity: 1; }
}

.theme-dark .publication-popover,
.theme-dark .publication-list-card { background: #23211d; }
.theme-dark .publication-popover-title,
.theme-dark .publication-title { color: #f7f3e9; }
.announcement-modal-layer--dark { color: #f7f3e9; }
.announcement-modal-layer--dark .announcement-modal { background: #211f1b; }
.announcement-modal-layer--dark .announcement-title { color: #f7f3e9; }
.announcement-modal-layer--dark .announcement-article { color: #ddd5c7; background: #2d2a24; }
.theme-dark .markdown-code-block,
.announcement-modal-layer--dark .markdown-code-block { border-color: #4a453d; background: #39352e; }
.theme-dark .markdown-code-header,
.announcement-modal-layer--dark .markdown-code-header { border-bottom-color: rgba(255, 255, 255, 0.08); }
.theme-dark .markdown-code-language,
.announcement-modal-layer--dark .markdown-code-language { color: #b8ae9e; }
.theme-dark .markdown-code-copy,
.announcement-modal-layer--dark .markdown-code-copy { color: #d3c8b8; background: rgba(255, 255, 255, 0.08); box-shadow: none; }
.theme-dark .markdown-code-copy-square--front,
.announcement-modal-layer--dark .markdown-code-copy-square--front { background: #39352e; }

.announcement-modal-layer.theme-style-soft {
  filter: saturate(0.9);
}
.announcement-modal-layer.theme-style-soft .announcement-modal { background: #f7fcf8; }
.announcement-modal-layer.theme-style-soft .announcement-article { color: #20312a; background: #fff; }
.announcement-modal-layer.theme-style-soft .announcement-confirm { background: #cf806d; box-shadow: none; }
.announcement-modal-layer--dark.theme-style-soft .announcement-modal { background: #16201b; }
.announcement-modal-layer--dark.theme-style-soft .announcement-article { color: #f1f8f3; background: #1f2c25; }

.announcement-modal-layer.theme-style-minimal { --minimal-accent: #b6543e; --minimal-on-accent: #fff; }
.announcement-modal-layer.theme-style-minimal .announcement-modal { border-top: 2rpx solid #000; border-radius: 0; background: #fff; box-shadow: none; }
.announcement-modal-layer.theme-style-minimal .announcement-handle { border-radius: 0; background: #000; }
.announcement-modal-layer.theme-style-minimal .announcement-close,
.announcement-modal-layer.theme-style-minimal .announcement-article,
.announcement-modal-layer.theme-style-minimal .markdown-code-block { border: 1rpx solid #000; border-radius: 4rpx; color: #000; background: #fff; box-shadow: none; }
.announcement-modal-layer.theme-style-minimal .announcement-label { color: var(--minimal-accent); }
.announcement-modal-layer.theme-style-minimal .announcement-confirm { border: 2rpx solid var(--minimal-accent); border-radius: 4rpx; color: var(--minimal-on-accent); background-color: var(--minimal-accent); box-shadow: none; }
.announcement-modal-layer--dark.theme-style-minimal .announcement-modal { border-color: #f5f5f0; background: #0f1010; }
.announcement-modal-layer--dark.theme-style-minimal .announcement-handle { background: #f5f5f0; }
.announcement-modal-layer--dark.theme-style-minimal .announcement-close,
.announcement-modal-layer--dark.theme-style-minimal .announcement-article,
.announcement-modal-layer--dark.theme-style-minimal .markdown-code-block { border-color: #f5f5f0; color: #f5f5f0; background: #171817; }
.announcement-modal-layer--dark.theme-style-minimal { --minimal-accent: #e0927e; --minimal-on-accent: #151515; }
.theme-dark .markdown-code-content,
.announcement-modal-layer--dark .markdown-code-content { color: #eee7da; }
