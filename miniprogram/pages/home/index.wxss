.exam-badge { display: flex; flex: none; flex-direction: column; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 21rpx; color: #a55357; background: #f7e9e8; line-height: 1; }
.exam-badge--current { color: #d97757; }
.exam-badge--future { color: #a66f1f; background: #f8eedd; }
.exam-badge--past { color: #a39e92; background: #efede6; }
.exam-badge--pending { color: #a66f1f; background: #f8eedd; }
.exam-badge-value { max-width: 58rpx; font-size: 24rpx; font-weight: 800; text-align: center; }
.exam-badge-current-grid { box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; width: 100%; height: 100%; padding: 9rpx 10rpx; color: #d97757; font-size: 21rpx; font-weight: 850; line-height: 1; }
.exam-badge-current-grid > view { display: flex; flex-direction: row; justify-content: space-between; width: 100%; }
.exam-badge-current-grid text { display: block; flex: none; line-height: 1; text-align: center; }
.exam-badge-sub { margin-top: 4rpx; font-size: 14rpx; font-weight: 700; opacity: 0.78; }
.exam-preview-copy { flex: 1; min-width: 0; }
.exam-course-line { display: flex; flex-direction: row; align-items: center; gap: 7rpx; min-width: 0; }
.exam-course-name { flex: 1; min-width: 0; color: var(--color-text); font-size: 22rpx; font-weight: 760; }
.exam-type { flex: none; padding: 3rpx 8rpx; border-radius: 999rpx; color: #a66f1f; background: #f8eedd; font-size: 14rpx; font-weight: 750; }
.exam-location { display: flex; flex-direction: row; align-items: center; gap: 5rpx; min-width: 0; margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 19rpx; }
.exam-location > text { flex: 1; min-width: 0; }
.exam-time { display: flex; flex: none; flex-direction: column; align-items: flex-end; max-width: 130rpx; }
.exam-date { color: var(--color-text); font-size: 20rpx; font-weight: 750; white-space: nowrap; }
.exam-clock { max-width: 142rpx; margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exam-empty { display: flex; align-items: center; justify-content: center; min-height: 192rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.side-actions { display: flex; flex: none; flex-direction: column; gap: 18rpx; width: 156rpx; }
.side-action { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; min-height: 0; padding: 14rpx 8rpx; color: var(--color-text); font-size: 19rpx; font-weight: 760; }
.side-action-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; }
.side-action-icon--pass-rate { background: #edf1e6; }
.side-action-icon--rooms { background: #f9eae2; }

.plan-card { min-height: 224rpx; overflow: hidden; }
.plan-list { display: flex; flex-direction: column; justify-content: center; min-height: 224rpx; }
.plan-row { display: flex; flex-direction: row; align-items: center; gap: 22rpx; min-height: 104rpx; padding: 20rpx 28rpx; }
.plan-row--divided { border-bottom: 1rpx solid var(--color-separator); }
.plan-circle { flex: none; width: 37rpx; height: 37rpx; border: 3rpx solid #c9c9d2; border-radius: 50%; }
.plan-copy { flex: 1; min-width: 0; }
.plan-title { display: block; color: var(--color-text); font-size: 27rpx; font-weight: 700; }
.plan-time { display: block; margin-top: 3rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.plan-tag { flex: none; padding: 7rpx 16rpx; border-radius: 999rpx; color: #a55357; background: #f7e9e8; font-size: 19rpx; font-weight: 700; }
.plan-empty { display: flex; flex-direction: row; align-items: center; justify-content: center; box-sizing: border-box; gap: 10rpx; min-height: 224rpx; padding: 42rpx 28rpx; color: var(--color-text-tertiary); font-size: 24rpx; text-align: center; }

.campus-stack { display: flex; flex-direction: column; gap: 30rpx; }
.campus-group { display: flex; flex-direction: column; gap: 16rpx; }
.campus-open-container { display: block; border-radius: 44rpx; }
.campus-card { position: relative; padding: 30rpx; }
.campus-blob { width: 190rpx; height: 170rpx; opacity: 0.72; }
.campus-blob--notice { top: -70rpx; right: -54rpx; background: #f9eae2; }
.campus-blob--message { bottom: -76rpx; left: -58rpx; background: #f8eedd; }
.campus-card-head { position: relative; display: flex; flex-direction: row; align-items: center; gap: 22rpx; min-height: 50rpx; padding: 0 8rpx; color: var(--color-text); font-size: 26rpx; font-weight: 750; }
.campus-card-title { flex: none; }
.campus-icon { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; border-radius: 18rpx; }
.campus-icon--notice { color: #b85c38; background: #f9eae2; }
.campus-icon--message { color: #a66f1f; background: #f8eedd; }
.campus-dot { width: 14rpx; height: 14rpx; margin-left: auto; border-radius: 50%; background: #c0452d; }
.campus-list { position: relative; display: flex; flex-direction: column; gap: 16rpx; }
.campus-line { display: flex; flex-direction: row; align-items: baseline; gap: 14rpx; min-width: 0; }
.campus-bullet { flex: none; width: 7rpx; height: 7rpx; margin-top: 8rpx; border-radius: 50%; background: #d97757; }
.campus-line-title { flex: 1; min-width: 0; color: var(--color-text-secondary); font-size: 23rpx; font-weight: 600; }
.campus-line-time { flex: none; max-width: 150rpx; color: #b5b0a3; font-size: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.campus-line-schedule { flex: none; color: #b5b0a3; font-size: 18rpx; white-space: nowrap; }
.message-kind { flex: none; padding: 4rpx 13rpx; border-radius: 999rpx; color: #8b8b94; background: #f1f1f3; font-size: 18rpx; font-weight: 750; }
.message-kind--blue { color: #a66f1f; background: #f8eedd; }
.message-kind--green { color: #5f7350; background: #edf1e6; }
.message-kind--orange { color: #c0452d; background: #f9e7e0; }
.campus-empty-copy { position: relative; display: block; color: var(--color-text-tertiary); font-size: 23rpx; }
.dashboard-error { display: flex; flex-direction: row; justify-content: space-between; gap: 20rpx; margin-top: 26rpx; padding: 20rpx 24rpx; border-radius: 28rpx; color: #c0452d; background: #f9e7e0; font-size: 22rpx; }

.publication-popover-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; opacity: 0; transition: opacity 260ms ease; pointer-events: none; }
.publication-popover-layer--open { opacity: 1; pointer-events: auto; }
.publication-popover-dismiss { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: transparent; }
.publication-popover { position: absolute; right: 24rpx; left: 24rpx; max-height: 62vh; overflow: hidden; border-radius: 52rpx; background: #fff; box-shadow: var(--shadow-pop); transform: scale(0.6); transform-origin: calc(100% - 44rpx) 0; transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
.publication-popover-layer--open .publication-popover { transform: scale(1); }
.publication-popover-header { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; padding: 30rpx 34rpx 8rpx; }
.publication-popover-title { color: #16161a; font-size: 34rpx; font-weight: 700; }
.publication-summary { color: #a39e92; font-size: 20rpx; }
.publication-popover-scroll { max-height: calc(62vh - 82rpx); padding: 0 20rpx 28rpx; }
.publication-group { margin-top: 16rpx; }
.publication-group-header { display: flex; flex-direction: row; justify-content: space-between; padding: 0 12rpx 8rpx; color: #a39e92; font-size: 20rpx; font-weight: 700; }
.publication-group-card { overflow: hidden; border-radius: 38rpx; background: #fff; }
.publication-row { display: flex; flex-direction: row; align-items: flex-start; gap: 20rpx; padding: 20rpx; border-bottom: 1rpx solid rgba(43, 38, 32, 0.05); border-radius: 34rpx; }
.publication-row:last-child { border-bottom: 0; }
.publication-row--unread { background: #fdfbf6; }
.publication-row--pressed { transform: scale(0.98); background: #faf8f3; }
.publication-icon { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 28rpx; }
.publication-icon--announcement { color: #a66f1f; background: #f8eedd; }
.publication-icon--notification { color: #b85c38; background: #f9eae2; }
.publication-dot { position: absolute; top: -3rpx; right: -3rpx; width: 18rpx; height: 18rpx; border: 4rpx solid #fff; border-radius: 50%; background: #c0452d; }
.publication-copy { flex: 1; min-width: 0; }
.publication-title-line { display: flex; flex-direction: row; align-items: baseline; gap: 12rpx; }
.publication-title { flex: 1; min-width: 0; color: #16161a; font-size: 25rpx; font-weight: 750; }
.publication-time { flex: none; max-width: 128rpx; color: #b5b0a3; font-size: 17rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.publication-preview,
.publication-body { display: block; margin-top: 5rpx; color: #8b8578; font-size: 21rpx; line-height: 1.55; }
.publication-body--expanded { max-height: 300rpx; overflow: hidden; }
.publication-type { display: block; margin-top: 6rpx; color: #b85c38; font-size: 18rpx; font-weight: 700; }
.publication-empty { display: flex; flex-direction: column; align-items: center; padding: 62rpx 20rpx; }
.publication-empty-bell { display: flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; border-radius: 30rpx; color: #a39e92; background: #f6f3ec; }
.publication-empty-title { margin-top: 18rpx; color: #16161a; font-size: 26rpx; font-weight: 750; }

.announcement-modal-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1100; display: flex; align-items: flex-end; justify-content: center; opacity: 0; transition: opacity 280ms ease; pointer-events: none; }
.announcement-modal-layer--open { opacity: 1; pointer-events: auto; }
.announcement-modal-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(32, 28, 24, 0.36); }
.announcement-modal { position: relative; z-index: 1; display: flex; flex-direction: column; width: 100%; max-height: 86vh; padding-bottom: env(safe-area-inset-bottom); border-radius: 56rpx 56rpx 0 0; background: #fbf9f4; box-shadow: 0 -24rpx 90rpx rgba(20, 20, 30, 0.2); transform: translateY(104%); transition: transform 380ms cubic-bezier(0.32, 0.72, 0, 1); }
.announcement-modal-layer--open .announcement-modal { transform: translateY(0); }
.announcement-handle { position: absolute; top: 14rpx; left: 50%; width: 70rpx; height: 8rpx; border-radius: 999rpx; background: rgba(43, 38, 32, 0.15); transform: translateX(-50%); }
.announcement-header { display: flex; flex: none; flex-direction: row; align-items: flex-start; gap: 20rpx; padding: 40rpx 40rpx 18rpx; }
.announcement-heading { flex: 1; min-width: 0; }
.announcement-label { display: block; color: #a66f1f; font-size: 21rpx; font-weight: 750; }
.announcement-title { display: block; margin-top: 5rpx; color: #16161a; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.announcement-time { display: block; margin-top: 8rpx; color: #a39e92; font-size: 21rpx; }
.announcement-close { display: flex; flex: none; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin-top: 8rpx; border-radius: 50%; color: #8b8578; background: rgba(43, 38, 32, 0.06); font-size: 36rpx; }
.announcement-close--pressed { transform: scale(0.9); opacity: 0.75; }
.announcement-content { flex: 1; min-height: 0; padding: 0 40rpx; }
.announcement-article { padding: 34rpx; border-radius: 44rpx; color: #3a352d; background: #fff; box-shadow: var(--shadow-card); font-size: 26rpx; line-height: 1.75; }
.announcement-footer { flex: none; padding: 24rpx 40rpx 26rpx; }
.announcement-confirm { display: flex; align-items: center; justify-content: center; min-height: 90rpx; border-radius: 999rpx; color: #fff; background: linear-gradient(135deg, #d97757, #eba97f); font-size: 28rpx; font-weight: 750; box-shadow: 0 16rpx 38rpx rgba(185, 92, 56, 0.24); }
.announcement-confirm--pressed { transform: scale(0.97); opacity: 0.86; }

.theme-dark .publication-popover,
.theme-dark .publication-group-card { background: #23211d; }
.theme-dark .publication-popover-title,
.theme-dark .publication-title { color: #f7f3e9; }
.theme-dark .announcement-modal { background: #211f1b; }
.theme-dark .announcement-title { color: #f7f3e9; }
.theme-dark .announcement-article { color: #ddd5c7; background: #2d2a24; }
