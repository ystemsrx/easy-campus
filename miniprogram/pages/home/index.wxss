.feature-grid { display: flex; flex-direction: row; gap: 20rpx; margin-top: 24rpx; }
.feature-open-container { display: block; flex: 1; flex-basis: 0; min-width: 0; border-radius: 48rpx; }
.feature-card { position: relative; display: flex; flex: 1; flex-basis: 0; flex-direction: column; min-width: 0; min-height: 320rpx; padding: 30rpx; overflow: hidden; border-radius: 48rpx; color: #fff; box-shadow: var(--shadow-card); transition: transform 150ms ease, opacity 150ms ease; }
.feature-open-container .feature-card { box-sizing: border-box; width: 100%; }
.feature-card--pressed { transform: scale(0.97); opacity: 0.88; }
.feature-card--grades { background: linear-gradient(160deg, #c98a2d, #e5b86e); }
.feature-card--utility { background: linear-gradient(160deg, #7d8f6e, #acbe97); }
.feature-blob { top: -54rpx; right: -55rpx; width: 210rpx; height: 190rpx; background: rgba(255, 255, 255, 0.17); }
.feature-blob--utility { top: auto; bottom: -74rpx; right: -55rpx; }
.feature-kicker { position: relative; color: rgba(255, 255, 255, 0.76); font-size: 21rpx; font-weight: 750; letter-spacing: 3rpx; }
