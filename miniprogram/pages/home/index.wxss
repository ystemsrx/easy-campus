.timetable-pill { display: flex; flex: none; flex-direction: row; align-items: center; gap: 6rpx; margin-top: 2rpx; padding: 15rpx 24rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); font-size: 23rpx; font-weight: 700; white-space: nowrap; }
.timetable-pill > text { flex: none; white-space: nowrap; }
.today-course-list { margin-top: 26rpx; }
.today-course-row { display: flex; flex-direction: row; align-items: center; gap: 20rpx; min-height: 104rpx; margin-top: 14rpx; padding: 15rpx 20rpx; border-radius: 32rpx; background: rgba(255, 255, 255, 0.14); backdrop-filter: blur(8px); }
.course-slot { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 126rpx; min-height: 64rpx; padding: 8rpx 12rpx; border: 1rpx solid rgba(255, 255, 255, 0.3); border-radius: 999rpx; color: #fff; background: rgba(255, 242, 232, 0.3); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.24); }
.course-slot-value { display: block; flex: none; font-size: 26rpx; font-weight: 800; letter-spacing: 3rpx; line-height: 1; text-align: center; white-space: nowrap; }
.today-course-copy { flex: 1; min-width: 0; }
.today-course-name { display: block; font-size: 28rpx; font-weight: 700; }
.today-course-meta { display: flex; flex-direction: row; align-items: center; gap: 7rpx; margin-top: 4rpx; color: rgba(255, 255, 255, 0.72); font-size: 23rpx; }
.course-status { flex: none; max-width: 110rpx; color: rgba(255, 255, 255, 0.68); font-size: 18rpx; font-weight: 650; text-align: right; }
