.today-card--pressed { transform: scale(0.98); opacity: 0.9; }
.today-blob { background: rgba(255, 255, 255, 0.16); }
.today-blob--one { top: -100rpx; right: -74rpx; width: 330rpx; height: 300rpx; }
.today-blob--two { bottom: -130rpx; left: -80rpx; width: 280rpx; height: 250rpx; background: rgba(0, 0, 0, 0.07); animation-delay: -4s; }
.today-content { position: relative; z-index: 1; }
.today-head { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; }
