.feature-caption { position: relative; margin-top: auto; padding-top: 16rpx; color: rgba(255, 255, 255, 0.82); font-size: 22rpx; font-weight: 600; text-align: center; }
.utility-balance { position: relative; display: flex; flex-direction: row; align-items: flex-start; margin-top: 24rpx; }
.utility-currency { margin-top: 2rpx; font-size: 25rpx; font-weight: 750; }
.utility-value { margin-left: 3rpx; font-size: 55rpx; font-weight: 800; line-height: 1; }
.utility-unbound { position: relative; display: block; margin-top: 26rpx; font-size: 46rpx; font-weight: 800; line-height: 1; }
.utility-caption { position: relative; display: block; margin-top: 9rpx; color: rgba(255, 255, 255, 0.78); font-size: 21rpx; }
.utility-pill { position: relative; display: flex; align-self: flex-start; align-items: center; max-width: 100%; margin-top: auto; padding: 11rpx 17rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.2); font-size: 18rpx; font-weight: 700; backdrop-filter: blur(10px); }
.utility-pill > text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.home-page .section-action { flex: none; white-space: nowrap; }
.home-page .section-action > text { display: block; flex: none; white-space: nowrap; }

.exam-layout { display: flex; flex-direction: row; gap: 20rpx; margin-top: 20rpx; }
.exam-card { flex: 1; min-width: 0; min-height: 294rpx; padding: 26rpx; }
.exam-card-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.exam-card-title { display: flex; flex: none; flex-direction: row; align-items: center; gap: 10rpx; color: var(--color-text); font-size: 23rpx; font-weight: 780; white-space: nowrap; }
.exam-card-title > text { display: block; flex: none; white-space: nowrap; }
.exam-preview-list { margin-top: 18rpx; }
.exam-preview-row { display: flex; flex-direction: row; align-items: center; gap: 16rpx; min-height: 90rpx; }
