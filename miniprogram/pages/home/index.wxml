<view class="page home-page {{themeClass}} {{motionClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <navigation-bar transparent theme="{{theme}}"></navigation-bar>
    <view class="home-content page-content page-content--tab page-enter">
      <view class="welcome-row">
        <view class="welcome-copy">
          <text class="welcome-date">{{dateLabel}}</text>
          <view class="welcome-title-row">
            <text class="welcome-title display-title">{{greeting}}，</text>
            <text class="welcome-name display-title">{{userName}}</text>
          </view>
        </view>
        <view
          class="publication-bell pressable"
          bindtap="togglePublicationPanel"
          hover-class="publication-bell--pressed"
          aria-role="button"
          aria-label="公告与通知，{{publicationUnreadCount}} 条未读"
        >
          <lucide-icon name="bell" tone="{{theme === 'dark' ? 'white' : 'ink'}}" size="{{40}}"></lucide-icon>
          <view wx:if="{{publicationUnreadCount}}" class="publication-badge"><text>{{publicationUnreadLabel}}</text></view>
        </view>
      </view>

      <open-container
        id="timetable-open-container"
        class="timetable-open-container"
        closed-color="#d97757"
        middle-color="{{theme === 'dark' ? '#8c5948' : '#eba97f'}}"
        open-color="{{theme === 'dark' ? '#171613' : '#f7f5ef'}}"
        closed-elevation="{{0}}"
        closed-border-radius="{{timetableCardRadius}}"
        open-elevation="{{0}}"
        open-border-radius="{{0}}"
        transition-type="fadeThrough"
        transition-duration="{{380}}"
        bind:tap="openTimetable"
        aria-role="button"
        aria-label="展开完整课表"
      >
        <view class="today-card pressable stagger-item stagger-1" hover-class="today-card--pressed">
          <view class="ambient-blob today-blob today-blob--one"></view>
          <view class="ambient-blob today-blob today-blob--two"></view>
          <view class="today-content">
            <view class="today-head">
              <view>
                <text class="today-kicker">今日课程</text>
                <view class="today-count-row"><text class="today-count tnum">{{todayCourses.length}}</text><text class="today-unit">节课</text></view>
              </view>
              <view class="timetable-pill"><text>完整课表</text><lucide-icon name="chevron-right" tone="white" size="{{24}}"></lucide-icon></view>
            </view>
            <view wx:if="{{todayCourses.length}}" class="today-course-list">
              <view wx:for="{{todayCourses}}" wx:key="id" class="today-course-row stagger-item" style="animation-delay: {{index * 70}}ms;">
                <view class="course-slot"><text class="course-slot-value tnum">{{item.periodLabel}}</text></view>
                <view class="today-course-copy">
                  <text class="today-course-name" overflow="ellipsis" max-lines="1">{{item.name}}</text>
                  <view class="today-course-meta"><lucide-icon name="map-pin" tone="white" size="{{17}}"></lucide-icon><text overflow="ellipsis" max-lines="1">{{item.location}} · {{item.teacher}}</text></view>
                </view>
                <view class="course-status {{item.current ? 'course-status--current' : ''}}"><text>{{item.statusLabel}}</text></view>
              </view>
            </view>
            <view wx:else class="today-empty">
              <text class="today-empty-title">今日无课</text>
            </view>
          </view>
        </view>
      </open-container>

      <view class="feature-grid stagger-item stagger-2">
        <open-container
          class="feature-open-container"
          closed-color="#c98a2d"
          middle-color="{{theme === 'dark' ? '#966c36' : '#e5b86e'}}"
          open-color="{{theme === 'dark' ? '#171613' : '#f7f5ef'}}"
          closed-elevation="{{0}}"
          closed-border-radius="{{gradeCardRadius}}"
          open-elevation="{{0}}"
          open-border-radius="{{0}}"
          transition-type="fadeThrough"
          transition-duration="{{380}}"
          bind:tap="openGrades"
          aria-role="button"
          aria-label="展开成绩页"
        >
          <view class="feature-card feature-card--grades pressable" hover-class="feature-card--pressed">
            <view class="ambient-blob feature-blob"></view>
            <text class="feature-kicker">平均绩点</text>
            <view class="score-ring"><image class="score-ring-image" src="{{gradeRingSource}}" mode="aspectFit"></image><text class="score-ring-value tnum">{{gradePointAverageLabel}}</text></view>
            <text class="feature-caption">{{gradeCourseCount ? gradeCourseCount + ' 门课程 · 均分 ' + gradeAverageLabel : '查看成绩明细'}}</text>
          </view>
        </open-container>
        <open-container
          class="feature-open-container"
          closed-color="#7d8f6e"
          middle-color="{{theme === 'dark' ? '#66735b' : '#acbe97'}}"
          open-color="{{theme === 'dark' ? '#171613' : '#f7f5ef'}}"
          closed-elevation="{{0}}"
          closed-border-radius="{{electricityCardRadius}}"
          open-elevation="{{0}}"
          open-border-radius="{{0}}"
          transition-type="fadeThrough"
          transition-duration="{{380}}"
          bind:tap="openElectricity"
          aria-role="button"
          aria-label="展开寝室电费"
        >
          <view class="feature-card feature-card--utility pressable" hover-class="feature-card--pressed">
            <view class="ambient-blob feature-blob feature-blob--utility"></view>
            <view class="feature-kicker feature-kicker--icon"><lucide-icon name="zap" tone="white" size="{{21}}"></lucide-icon><text>寝室电费</text></view>
            <view wx:if="{{electricityBound}}" class="utility-balance"><text class="utility-currency">¥</text><text class="utility-value tnum">{{electricityBalanceLabel}}</text></view>
            <text wx:else class="utility-unbound">未绑定</text>
            <text class="utility-caption">{{electricityBound ? '剩余金额' : '选择宿舍与寝室号'}}</text>
            <view class="utility-pill"><text>{{electricityUsageLabel}}</text></view>
          </view>
        </open-container>
      </view>

      <view class="exam-layout stagger-item stagger-2">
        <open-container
          class="exam-open-container"
          closed-color="{{theme === 'dark' ? '#2d2a24' : '#ffffff'}}"
          middle-color="{{theme === 'dark' ? '#39352e' : '#f1eee6'}}"
          open-color="{{theme === 'dark' ? '#171613' : '#f7f5ef'}}"
          closed-elevation="{{0}}"
          closed-border-radius="{{examCardRadius}}"
          open-elevation="{{0}}"
          open-border-radius="{{0}}"
          transition-type="fadeThrough"
          transition-duration="{{380}}"
          bind:tap="openExams"
          aria-role="button"
          aria-label="展开考试安排"
        >
          <view class="exam-card card pressable" hover-class="pressing">
          <view class="exam-card-head"><view class="exam-card-title"><lucide-icon name="clock-3" tone="rose" size="{{23}}"></lucide-icon><text>考试安排</text></view><lucide-icon name="chevron-right" tone="muted" size="{{22}}"></lucide-icon></view>
          <view wx:if="{{examPreviews.length}}" class="exam-preview-list">
            <view wx:for="{{examPreviews}}" wx:key="id" class="exam-preview-row {{index ? 'exam-preview-row--divided' : ''}}">
              <view class="exam-badge exam-badge--{{item.badgeTone}}">
                <view wx:if="{{item.badgeTone === 'current'}}" class="exam-badge-current-grid" aria-label="逢考必过"><view><text>逢</text><text>考</text></view><view><text>必</text><text>过</text></view></view>
                <text wx:else class="exam-badge-value tnum">{{item.badgeText}}</text>
              </view>
              <view class="exam-preview-copy"><view class="exam-course-line"><text class="exam-course-name" overflow="ellipsis" max-lines="1">{{item.courseName}}</text><text wx:if="{{item.typeLabel !== '正常考试'}}" class="exam-type">{{item.typeLabel}}</text></view><view class="exam-location"><lucide-icon name="map-pin" tone="muted" size="{{16}}"></lucide-icon><text overflow="ellipsis" max-lines="1">{{item.location}}</text></view></view>
              <view class="exam-time"><text class="exam-date tnum">{{item.dateLabel}}</text><text class="exam-clock tnum">{{item.timeLabel}}</text></view>
            </view>
          </view>
          <view wx:else class="exam-empty"><text>{{examEmptyLabel}}</text></view>
          </view>
        </open-container>
        <view class="side-actions">
          <view class="side-action card pressable" data-route="/pages/pass-rates/index" bindtap="onQuickAction" hover-class="pressing"><view class="side-action-icon side-action-icon--pass-rate"><lucide-icon name="chart-no-axes-column-increasing" tone="sage" size="{{27}}"></lucide-icon></view><text>通过率</text></view>
          <view class="side-action card pressable" data-route="/pages/rooms/index" bindtap="onQuickAction" hover-class="pressing"><view class="side-action-icon side-action-icon--rooms"><lucide-icon name="door-open" tone="coral" size="{{27}}"></lucide-icon></view><text>空教室</text></view>
        </view>
      </view>

      <view class="section-header stagger-item stagger-3">
        <view><text class="section-title">接下来</text></view>
        <view class="section-action pressable" bindtap="openSchedule" hover-class="pressing"><text>全部日程</text><lucide-icon name="chevron-right" tone="muted" size="{{23}}"></lucide-icon></view>
      </view>
      <view class="plan-card card stagger-item stagger-3">
        <view wx:if="{{plans.length}}" class="plan-list">
          <view wx:for="{{plans}}" wx:key="id" class="plan-row {{index < plans.length - 1 ? 'plan-row--divided' : ''}}">
            <view class="plan-circle"></view>
            <view class="plan-copy"><text class="plan-title" overflow="ellipsis" max-lines="1">{{item.title}}</text><text class="plan-time tnum">{{item.dateLabel}} · {{item.timeLabel}}</text></view>
            <text class="plan-tag">日程</text>
          </view>
        </view>
        <view wx:else class="plan-empty pressable" bindtap="openSchedule" hover-class="pressing"><text>还没有待办，给今天留一点计划</text><lucide-icon name="sparkles" tone="rose" size="{{24}}"></lucide-icon></view>
      </view>

      <view class="section-header stagger-item stagger-4">
        <view><text class="section-title">校园消息</text></view>
        <view class="section-action pressable" bindtap="openMessages" hover-class="pressing"><text>查看全部</text><lucide-icon name="chevron-right" tone="muted" size="{{23}}"></lucide-icon></view>
      </view>
      <view class="campus-stack stagger-item stagger-4">
        <view class="campus-group">
          <view class="campus-card-head pressable" bindtap="openMessages" hover-class="pressing">
            <view class="campus-icon campus-icon--message"><lucide-icon name="calendar-clock" tone="amber" size="{{29}}"></lucide-icon></view>
            <text class="campus-card-title">教务消息</text>
            <view wx:if="{{messages.length}}" class="campus-dot"></view>
          </view>
          <open-container class="campus-open-container" closed-color="{{theme === 'dark' ? '#2d2a24' : '#ffffff'}}" middle-color="{{theme === 'dark' ? '#39352e' : '#f1eee6'}}" open-color="{{theme === 'dark' ? '#171613' : '#f7f5ef'}}" closed-elevation="{{0}}" closed-border-radius="{{campusCardRadius}}" open-elevation="{{0}}" open-border-radius="{{0}}" transition-type="fadeThrough" transition-duration="{{380}}" bind:tap="openMessagesFromCard" aria-role="button" aria-label="从卡片展开教务消息">
            <view class="campus-card card pressable" hover-class="pressing">
              <view class="ambient-blob campus-blob campus-blob--message"></view>
              <view wx:if="{{messages.length}}" class="campus-list">
                <view wx:for="{{messages}}" wx:key="id" class="campus-line"><text class="message-kind message-kind--{{item.tone}}">{{item.label}}</text><text class="campus-line-title" overflow="ellipsis" max-lines="1">{{item.title}}</text><text wx:if="{{item.dateLabel}}" class="campus-line-schedule">{{item.dateLabel}}</text></view>
              </view>
              <text wx:else class="campus-empty-copy">暂时没有新消息</text>
            </view>
          </open-container>
        </view>
        <view class="campus-group">
          <view class="campus-card-head pressable" bindtap="openNotices" hover-class="pressing">
            <view class="campus-icon campus-icon--notice"><lucide-icon name="megaphone" tone="coral" size="{{29}}"></lucide-icon></view>
            <text class="campus-card-title">学校通知</text>
            <view wx:if="{{notices.length}}" class="campus-dot"></view>
          </view>
          <open-container class="campus-open-container" closed-color="{{theme === 'dark' ? '#2d2a24' : '#ffffff'}}" middle-color="{{theme === 'dark' ? '#39352e' : '#f1eee6'}}" open-color="{{theme === 'dark' ? '#171613' : '#f7f5ef'}}" closed-elevation="{{0}}" closed-border-radius="{{campusCardRadius}}" open-elevation="{{0}}" open-border-radius="{{0}}" transition-type="fadeThrough" transition-duration="{{380}}" bind:tap="openNoticesFromCard" aria-role="button" aria-label="从卡片展开学校通知">
            <view class="campus-card card pressable" hover-class="pressing">
              <view class="ambient-blob campus-blob campus-blob--notice"></view>
              <view wx:if="{{notices.length}}" class="campus-list">
                <view wx:for="{{notices}}" wx:key="id" class="campus-line"><view class="campus-bullet"></view><text class="campus-line-title" overflow="ellipsis" max-lines="1">{{item.title}}</text><text class="campus-line-time">{{item.time}}</text></view>
              </view>
              <text wx:else class="campus-empty-copy">暂时没有新通知</text>
            </view>
          </open-container>
        </view>
      </view>

      <view wx:if="{{errorMessage}}" class="dashboard-error pressable" bindtap="retryDashboard" hover-class="pressing"><text>{{errorMessage}}</text><text>重新加载</text></view>
    </view>
  </scroll-view>

  <view wx:if="{{publicationPanelMounted}}" class="publication-popover-layer {{publicationPanelOpen ? 'publication-popover-layer--open' : ''}}">
    <view class="publication-popover-dismiss" catchtap="closePublicationPanel"></view>
    <view class="publication-popover {{!announcements.length && !platformNotifications.length ? 'publication-popover--empty' : ''}}" style="top: {{publicationPanelTop}}px; transform-origin: {{publicationPanelTransformOrigin}};" catchtap="stopPropagation">
      <view class="publication-popover-header">
        <text class="publication-popover-title display-title">消息</text>
        <text class="publication-summary">{{publicationUnreadCount ? publicationUnreadCount + ' 条未读' : '已全部读完'}}</text>
      </view>
      <scroll-view class="publication-popover-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{announcements.length}}" class="publication-group">
          <view class="publication-group-header"><text>公告</text><text>{{announcements.length}}</text></view>
          <view class="publication-group-card">
            <view wx:for="{{announcements}}" wx:key="id" class="publication-row pressable {{!item.isRead ? 'publication-row--unread' : ''}}" data-id="{{item.id}}" catchtap="onAnnouncementTap" hover-class="publication-row--pressed">
              <view class="publication-icon publication-icon--announcement"><lucide-icon name="megaphone" tone="amber" size="{{31}}"></lucide-icon><view wx:if="{{!item.isRead}}" class="publication-dot"></view></view>
              <view class="publication-copy"><view class="publication-title-line"><text class="publication-title" overflow="ellipsis" max-lines="1">{{item.title}}</text><text class="publication-time">{{item.timeLabel}}</text></view><text class="publication-preview" overflow="ellipsis" max-lines="1">{{item.previewText}}</text><text class="publication-type">公告 · 点击查看全文</text></view>
            </view>
          </view>
        </view>
        <view wx:if="{{platformNotifications.length}}" class="publication-group">
          <view class="publication-group-header"><text>通知</text><text>{{platformNotifications.length}}</text></view>
          <view class="publication-group-card">
            <view wx:for="{{platformNotifications}}" wx:key="id" class="publication-row pressable {{!item.isRead ? 'publication-row--unread' : ''}}" data-id="{{item.id}}" catchtap="onPlatformNotificationTap" hover-class="publication-row--pressed">
              <view class="publication-icon publication-icon--notification"><lucide-icon name="bell" tone="coral" size="{{31}}"></lucide-icon><view wx:if="{{!item.isRead}}" class="publication-dot"></view></view>
              <view class="publication-copy"><view class="publication-title-line"><text class="publication-title" overflow="ellipsis" max-lines="1">{{item.title}}</text><text class="publication-time">{{item.timeLabel}}</text></view><view class="publication-body {{item.expanded ? 'publication-body--expanded' : ''}}"><rich-text wx:if="{{item.expanded}}" nodes="{{item.contentHtml}}"></rich-text><text wx:else overflow="ellipsis" max-lines="1">{{item.previewText}}</text></view><text class="publication-type">{{item.isLong ? (item.expanded ? '收起' : '通知 · 点击展开') : '通知'}}</text></view>
            </view>
          </view>
        </view>
        <view wx:if="{{!announcements.length && !platformNotifications.length}}" class="publication-empty"><view class="publication-empty-bell"><lucide-icon name="bell" tone="muted" size="{{38}}"></lucide-icon></view><text class="publication-empty-title">暂时没有新内容</text></view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{announcementModalMounted && activeAnnouncement}}" class="announcement-modal-layer {{announcementModalOpen ? 'announcement-modal-layer--open' : ''}}">
    <view class="announcement-modal-backdrop" catchtap="closeAnnouncementModal"></view>
    <view class="announcement-modal" catchtap="stopPropagation">
      <view class="announcement-handle"></view>
      <view class="announcement-header"><view class="announcement-heading"><text class="announcement-label">公告</text><text class="announcement-title display-title">{{activeAnnouncement.title}}</text><text class="announcement-time">{{activeAnnouncement.timeLabel}}</text></view><view class="announcement-close pressable" catchtap="closeAnnouncementModal" hover-class="announcement-close--pressed"><lucide-icon name="x" tone="muted" size="{{30}}"></lucide-icon></view></view>
      <scroll-view class="announcement-content" type="list" scroll-y enhanced show-scrollbar="{{false}}"><view class="announcement-article"><rich-text nodes="{{activeAnnouncement.contentHtml}}"></rich-text></view></scroll-view>
      <view class="announcement-footer"><view class="announcement-confirm pressable" catchtap="closeAnnouncementModal" hover-class="announcement-confirm--pressed"><text>知道了</text></view></view>
    </view>
  </view>
</view>
