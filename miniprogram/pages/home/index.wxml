<import src="./content.wxml"/>
<rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}" reduced-motion="{{motionClass === 'motion-reduced'}}"></rate-limit-toast>
<view class="page home-page {{themeClass}} {{visualThemeClass}} {{motionClass}} {{liquidGlassClass}}">
  <scroll-view
    id="capsule-scroll-source"
    class="page-scroll home-framework {{authenticated ? '' : 'home-framework--guarded'}}"
    type="list"
    scroll-y="{{!petSetupDrawerOpen}}"
    enhanced
    show-scrollbar="{{false}}"
    aria-hidden="{{!authenticated}}"
    worklet:onscrollupdate="onGlassBackdropScroll"
  >
    <navigation-bar transparent theme="{{theme}}"></navigation-bar>
    <template is="home-content" data="{{campusCardRadius:campusCardRadius,dateLabel:dateLabel,electricityBalanceLabel:electricityBalanceLabel,electricityBound:electricityBound,electricityCardRadius:electricityCardRadius,electricityUsageLabel:electricityUsageLabel,errorMessage:errorMessage,examCardRadius:examCardRadius,examEmptyLabel:examEmptyLabel,examPreviews:examPreviews,gradeAverageLabel:gradeAverageLabel,gradeCardRadius:gradeCardRadius,gradeCourseCount:gradeCourseCount,gradePointAverageLabel:gradePointAverageLabel,gradeRingSource:gradeRingSource,greeting:greeting,hiddenGradeRingSource:hiddenGradeRingSource,messages:messages,motionClass:motionClass,notices:notices,petColor:petColor,petEnhanced:petEnhanced,petReducedMotion:petReducedMotion,petShape:petShape,petVisible:petVisible,planCardHeight:planCardHeight,planCompletion:planCompletion,plans:plans,publicationUnreadCount:publicationUnreadCount,publicationUnreadLabel:publicationUnreadLabel,showGradesOnHome:showGradesOnHome,theme:theme,timetableCardRadius:timetableCardRadius,todayCourses:todayCourses,userName:userName,visualTheme:visualTheme,capsuleReplica:false}}"/>
  </scroll-view>

  <root-portal wx:if="{{authenticated && petSetupDrawerMounted}}">
    <pet-picker-drawer
      open="{{petSetupDrawerOpen}}"
      theme-class="{{themeClass}}"
      visual-theme-class="{{visualThemeClass}}"
      motion-class="{{motionClass}}"
      selected="{{petSelected}}"
      selected-shape="{{petShape}}"
      selected-color="{{petColor}}"
      enhanced="{{petEnhanced}}"
      reduced-motion="{{petReducedMotion}}"
      bind:shapechange="onPendingPetShapeChange"
      bind:colorchange="onPendingPetColorChange"
      bind:finish="finishPendingPetSetup"
    ></pet-picker-drawer>
  </root-portal>

  <view wx:if="{{authenticated && publicationPanelMounted}}" class="publication-popover-layer {{publicationPanelOpen ? 'publication-popover-layer--open' : ''}}">
    <view class="publication-popover-dismiss" catchtap="closePublicationPanel"></view>
    <view class="publication-popover" style="top: {{publicationPanelTop}}px; height: {{publicationPanelHeight}}px; transform-origin: {{publicationPanelTransformOrigin}};" catchtap="stopPropagation">
      <view class="publication-popover-header">
        <text class="publication-popover-title display-title">消息</text>
        <text class="publication-summary">{{publicationUnreadCount ? publicationUnreadCount + ' 条未读' : '已全部读完'}}</text>
      </view>
      <view class="publication-popover-frame" style="height: {{publicationPanelScrollHeight}}px;">
        <view class="publication-popover-viewport">
          <scroll-view wx:if="{{publications.length}}" class="publication-popover-scroll" type="custom" scroll-y enhanced show-scrollbar="{{false}}">
            <view class="publication-popover-content">
              <view wx:if="{{publications.length}}" class="publication-list">
                <view class="publication-list-card">
                  <view wx:for="{{publications}}" wx:key="id" class="publication-row" data-id="{{item.id}}" catchtap="onPublicationTap">
                    <view class="publication-icon publication-icon--{{item.kind}}"><lucide-icon name="{{item.kind === 'announcement' ? 'megaphone' : 'bell'}}" tone="{{visualTheme === 'minimal' ? (theme === 'dark' ? 'white' : 'ink') : (item.kind === 'announcement' ? 'amber' : 'coral')}}" size="{{31}}"></lucide-icon><view wx:if="{{!item.isRead}}" class="publication-dot"></view></view>
                    <view class="publication-copy"><view class="publication-title-line"><text class="publication-title" overflow="ellipsis" max-lines="1">{{item.title}}</text><text class="publication-time">{{item.timeLabel}}</text></view><text wx:if="{{item.kind === 'announcement'}}" class="publication-preview" overflow="ellipsis" max-lines="1">{{item.previewText}}</text><view wx:else class="publication-body {{item.expanded ? 'publication-body--expanded' : ''}}"><text class="publication-body-preview" overflow="ellipsis" max-lines="1">{{item.previewText}}</text><view class="publication-body-content"><block wx:for="{{item.contentBlocks}}" wx:key="key" wx:for-item="block"><rich-text wx:if="{{block.type === 'rich'}}" nodes="{{block.html}}"></rich-text><view wx:else class="markdown-code-block markdown-code-block--compact" catchtap="stopPropagation"><view class="markdown-code-header"><text class="markdown-code-language" overflow="ellipsis" max-lines="1">{{block.language}}</text><view class="markdown-code-copy" data-code="{{block.code}}" data-copy-key="{{item.id + ':' + block.key}}" catchtap="copyCodeBlock" hover-class="markdown-code-copy--pressed" aria-role="button" aria-label="复制代码"><lucide-icon wx:if="{{copiedCodeKey === item.id + ':' + block.key}}" name="check" tone="{{theme === 'dark' ? 'white' : 'muted'}}" size="{{25}}"></lucide-icon><view wx:else class="markdown-code-copy-icon"><view class="markdown-code-copy-square markdown-code-copy-square--back"></view><view class="markdown-code-copy-square markdown-code-copy-square--front"></view></view></view></view><scroll-view class="markdown-code-scroll" style="height: {{block.compactContentHeightRpx}}rpx;" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}"><view class="markdown-code-lines"><text wx:for="{{block.lines}}" wx:key="key" wx:for-item="line" class="markdown-code-content" selectable user-select>{{line.text}}</text></view></scroll-view></view></block></view></view><text class="publication-type">{{item.kind === 'announcement' ? '公告 · 点击查看全文' : (item.isLong ? (item.expanded ? '收起' : '通知 · 点击展开') : '通知')}}</text></view>
                  </view>
                </view>
              </view>
            </view>
          </scroll-view>
          <view wx:else class="publication-empty"><view class="publication-empty-bell"><lucide-icon name="bell" tone="{{visualTheme === 'minimal' ? (theme === 'dark' ? 'white' : 'ink') : 'muted'}}" size="{{38}}"></lucide-icon></view><text class="publication-empty-title">暂时没有新内容</text></view>
        </view>
        <view class="publication-popover-outline" aria-hidden="true"></view>
      </view>
    </view>
  </view>

  <root-portal wx:if="{{authenticated && announcementModalMounted && activeAnnouncement}}">
    <view class="announcement-modal-layer announcement-modal-layer--{{theme}} {{visualThemeClass}} {{announcementModalOpen ? 'announcement-modal-layer--open' : ''}}">
      <view class="announcement-modal-backdrop" catchtap="closeAnnouncementModal"></view>
      <view class="announcement-modal" catchtap="stopPropagation">
        <view class="announcement-handle"></view>
        <view class="announcement-header"><view class="announcement-heading"><text class="announcement-label">公告</text><text class="announcement-title display-title">{{activeAnnouncement.title}}</text><text class="announcement-time">{{activeAnnouncement.timeLabel}}</text></view><view class="announcement-close pressable" catchtap="closeAnnouncementModal" hover-class="announcement-close--pressed"><lucide-icon name="x" tone="muted" size="{{30}}"></lucide-icon></view></view>
        <scroll-view class="announcement-content" style="height: {{announcementScrollHeight}}px;" type="custom" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="announcement-content-body">
            <view class="announcement-article"><block wx:for="{{activeAnnouncement.contentBlocks}}" wx:key="key" wx:for-item="block"><rich-text wx:if="{{block.type === 'rich'}}" nodes="{{block.html}}"></rich-text><view wx:else class="markdown-code-block" catchtap="stopPropagation"><view class="markdown-code-header"><text class="markdown-code-language" overflow="ellipsis" max-lines="1">{{block.language}}</text><view class="markdown-code-copy" data-code="{{block.code}}" data-copy-key="{{activeAnnouncement.id + ':' + block.key}}" catchtap="copyCodeBlock" hover-class="markdown-code-copy--pressed" aria-role="button" aria-label="复制代码"><lucide-icon wx:if="{{copiedCodeKey === activeAnnouncement.id + ':' + block.key}}" name="check" tone="{{theme === 'dark' ? 'white' : 'muted'}}" size="{{25}}"></lucide-icon><view wx:else class="markdown-code-copy-icon"><view class="markdown-code-copy-square markdown-code-copy-square--back"></view><view class="markdown-code-copy-square markdown-code-copy-square--front"></view></view></view></view><scroll-view class="markdown-code-scroll" style="height: {{block.contentHeightRpx}}rpx;" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}"><view class="markdown-code-lines"><text wx:for="{{block.lines}}" wx:key="key" wx:for-item="line" class="markdown-code-content" selectable user-select>{{line.text}}</text></view></scroll-view></view></block></view>
            <view class="announcement-content-end"></view>
          </view>
        </scroll-view>
        <view class="announcement-footer"><view class="announcement-confirm pressable" catchtap="closeAnnouncementModal" hover-class="announcement-confirm--pressed"><text>知道了</text></view></view>
      </view>
    </view>
  </root-portal>

  <view wx:if="{{!authenticated}}" class="home-auth-guard" aria-hidden="true">
    <view class="home-auth-login-stage">
      <view class="ambient-blob home-auth-login-blob home-auth-login-blob--one"></view>
      <view class="ambient-blob home-auth-login-blob home-auth-login-blob--two"></view>
      <view class="ambient-blob home-auth-login-blob home-auth-login-blob--three"></view>
      <navigation-bar cover="{{false}}" transparent theme="{{theme}}"></navigation-bar>
      <view class="home-auth-login-hero">
        <view class="home-auth-login-heading">
          <text class="home-auth-login-title display-title">Hello!</text>
          <text class="home-auth-login-subtitle">欢迎来到{{appName}}</text>
        </view>
      </view>
    </view>
  </view>


  <include src="./live-glass.wxml"/>
</view>
<screen-watermark></screen-watermark>
