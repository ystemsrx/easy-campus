<view class="page inbox-page {{themeClass}} {{motionClass}}">
  <navigation-bar title="校园消息" subtitle="学校通知与教务安排" back transparent theme="{{theme}}"></navigation-bar>

  <view class="inbox-toolbar page-enter">
    <view class="segmented-control" aria-role="tablist">
      <view class="segment-indicator segment-indicator--{{activeTab}}"></view>
      <view class="segment-item {{activeTab === 0 ? 'segment-item--active' : ''}}" data-index="0" bindtap="onTabTap" hover-class="segment-item--pressed" aria-role="tab" aria-selected="{{activeTab === 0}}"><text>教务消息</text></view>
      <view class="segment-item {{activeTab === 1 ? 'segment-item--active' : ''}}" data-index="1" bindtap="onTabTap" hover-class="segment-item--pressed" aria-role="tab" aria-selected="{{activeTab === 1}}"><text>学校通知</text></view>
    </view>
  </view>

  <swiper class="inbox-swiper" current="{{activeTab}}" duration="420" easing-function="easeOutCubic" bindchange="onSwiperChange" cache-extent="1">
    <swiper-item>
      <scroll-view class="inbox-list" type="list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-default-style="none" refresher-triggered="{{messageRefreshing}}" bindrefresherrefresh="refreshMessages" bindscrolltolower="loadMoreMessages" lower-threshold="180">
        <view class="inbox-content page-content">
          <view class="list-heading">
            <view><text class="list-title">教务消息</text><text class="list-caption">待阅与已阅已合并并按时间排序</text></view>
            <view class="filter-button pressable {{messageType || from || to ? 'filter-button--active' : ''}}" bindtap="openMessageFilter" hover-class="pressing"><lucide-icon name="list-filter" tone="{{messageType || from || to ? 'coral' : 'muted'}}" size="{{25}}"></lucide-icon><text>筛选</text></view>
          </view>

          <view wx:if="{{messageItems.length}}" class="message-list">
            <view wx:for="{{messageItems}}" wx:key="id" class="message-card card stagger-item" style="animation-delay: {{index < 7 ? index * 45 : 0}}ms;">
              <view class="message-head">
                <text class="message-badge message-badge--{{item.tone}}">{{item.label}}</text>
                <text class="message-title" overflow="ellipsis" max-lines="1">{{item.title}}</text>
                <text class="message-time">{{item.createdAt}}</text>
              </view>
              <text wx:if="{{item.teacher}}" class="message-teacher">{{item.teacher}}</text>
              <view wx:if="{{item.type === 'course_rescheduled'}}" class="schedule-chips">
                <view class="schedule-chip schedule-chip--old"><text class="schedule-chip-label">原</text><text>{{item.original.primary}} · {{item.original.location}}</text></view>
                <lucide-icon name="chevron-right" tone="muted" size="{{25}}"></lucide-icon>
                <view class="schedule-chip schedule-chip--new message-badge--{{item.tone}}"><text class="schedule-chip-label">新</text><text>{{item.current.primary}} · {{item.current.location}}</text></view>
              </view>
              <view wx:elif="{{item.type === 'makeup_class'}}" class="schedule-chips"><view class="schedule-chip schedule-chip--new message-badge--{{item.tone}}"><text class="schedule-chip-label">补</text><text>{{item.current.primary}} · {{item.current.location}}</text></view></view>
              <view wx:elif="{{item.type === 'course_cancelled'}}" class="schedule-chips"><view class="schedule-chip schedule-chip--old"><text class="schedule-chip-label">原</text><text>{{item.original.primary}} · {{item.original.location}}</text></view></view>
              <text wx:else class="message-content">{{item.content}}</text>
            </view>
            <view wx:if="{{messageLoadingMore}}" class="load-more"><text>正在载入更多…</text></view>
            <text wx:elif="{{messagePage >= messageTotalPages}}" class="end-caption">以上是全部教务消息</text>
          </view>
          <loading-view wx:elif="{{messageLoading}}" label="正在读取教务消息"></loading-view>
          <empty-state wx:elif="{{messageError}}" icon="circle-alert" icon-tone="danger" title="消息加载失败" description="{{messageError}}" action-text="重新加载" bindaction="refreshMessages"></empty-state>
          <empty-state wx:elif="{{messageLoaded}}" icon="message-circle-more" title="没有符合条件的消息" description="更换筛选条件，或下拉刷新后再看看" action-text="调整筛选" bindaction="openMessageFilter"></empty-state>
        </view>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <scroll-view class="inbox-list" type="list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-default-style="none" refresher-triggered="{{noticeRefreshing}}" bindrefresherrefresh="refreshNotices" bindscrolltolower="loadMoreNotices" lower-threshold="180">
        <view class="inbox-content page-content">
          <view class="search-field notice-search {{noticeSearchFocused ? 'search-field--focus' : ''}}">
            <lucide-icon name="search" tone="muted" size="{{28}}"></lucide-icon>
            <input class="search-input" value="{{noticeQuery}}" placeholder="搜索通知标题" placeholder-class="notice-placeholder" bindinput="onNoticeQueryInput" bindfocus="onNoticeSearchFocus" bindblur="onNoticeSearchBlur" bindconfirm="searchNotices" confirm-type="search" aria-label="搜索通知标题" />
            <view wx:if="{{noticeQuery}}" class="search-clear" bindtap="clearNoticeQuery"><lucide-icon name="x" tone="muted" size="{{24}}"></lucide-icon></view>
          </view>
          <view class="notice-source"><view class="source-dot"></view><text>先显示最近缓存，随后静默更新</text></view>

          <view wx:if="{{noticeItems.length}}" class="notice-list">
            <view wx:for="{{noticeItems}}" wx:key="link" class="notice-item card pressable stagger-item" style="animation-delay: {{index < 7 ? index * 45 : 0}}ms;" data-id="{{item.id}}" data-link="{{item.link}}" data-title="{{item.title}}" data-published-at="{{item.publishedAt}}" bindtap="openNotice" hover-class="pressing" aria-role="link">
              <view class="notice-icon"><lucide-icon name="megaphone" tone="coral" size="{{34}}"></lucide-icon></view>
              <view class="notice-copy">
                <view class="notice-title-row"><text class="notice-title" overflow="ellipsis" max-lines="2">{{item.title}}</text><text class="notice-time">{{item.displayTime}}</text></view>
                <text class="notice-preview">点击查看已整理的通知正文</text>
                <text class="notice-tag">教务通知</text>
              </view>
            </view>
            <view wx:if="{{noticeLoadingMore}}" class="load-more"><text>正在载入更多…</text></view>
            <text wx:elif="{{noticePage >= noticeTotalPages}}" class="end-caption">以上是全部学校通知</text>
          </view>
          <loading-view wx:elif="{{noticeLoading}}" label="正在读取学校通知"></loading-view>
          <empty-state wx:elif="{{noticeError}}" icon="circle-alert" icon-tone="danger" title="通知加载失败" description="{{noticeError}}" action-text="重新加载" bindaction="refreshNotices"></empty-state>
          <empty-state wx:elif="{{noticeLoaded}}" icon="megaphone" title="没有找到通知" description="尝试更换关键词，或清空搜索条件" action-text="清空搜索" bindaction="clearNoticeQuery"></empty-state>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <bottom-sheet visible="{{messageFilterVisible}}" title="筛选消息" theme="{{theme}}" bindclose="closeMessageFilter">
    <view class="filter-section">
      <text class="filter-section-title">消息类型</text>
      <view class="type-grid">
        <view wx:for="{{messageTypeOptions}}" wx:key="value" class="type-option {{draftType === item.value ? 'type-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectDraftType" hover-class="type-option--pressed"><text>{{item.label}}</text></view>
      </view>
    </view>
    <view class="filter-section">
      <text class="filter-section-title">时间范围</text>
      <view class="date-range">
        <picker class="date-picker" mode="date" value="{{draftFrom || '2020-01-01'}}" start="2000-01-01" end="2101-12-31" bindchange="onDraftFromChange"><view class="date-value"><text class="date-label">开始</text><text class="date-text {{!draftFrom ? 'date-text--placeholder' : ''}}">{{draftFrom || '不限'}}</text></view></picker>
        <text class="date-separator">—</text>
        <picker class="date-picker" mode="date" value="{{draftTo || '2030-12-31'}}" start="2000-01-01" end="2101-12-31" bindchange="onDraftToChange"><view class="date-value"><text class="date-label">结束</text><text class="date-text {{!draftTo ? 'date-text--placeholder' : ''}}">{{draftTo || '不限'}}</text></view></picker>
      </view>
    </view>
    <view slot="footer" class="filter-actions"><button class="secondary-button reset-button" hover-class="button-pressed" bindtap="resetMessageFilter">重置</button><button class="primary-button apply-button" hover-class="button-pressed" bindtap="applyMessageFilter">查看结果</button></view>
  </bottom-sheet>
</view>
