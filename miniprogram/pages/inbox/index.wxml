<view class="page inbox-page {{themeClass}} {{motionClass}}" bindtap="onPageTap">
  <navigation-bar title="校园通知" back transparent theme="{{theme}}"></navigation-bar>

  <view class="inbox-toolbar page-enter">
    <view class="segmented-control" aria-role="tablist">
      <view class="segment-indicator segment-indicator--{{activeTab}}"></view>
      <view class="segment-item {{activeTab === 0 ? 'segment-item--active' : ''}}" data-index="0" bindtap="onTabTap" hover-class="segment-item--pressed" aria-role="tab" aria-selected="{{activeTab === 0}}"><text>教务消息</text></view>
      <view class="segment-item {{activeTab === 1 ? 'segment-item--active' : ''}}" data-index="1" bindtap="onTabTap" hover-class="segment-item--pressed" aria-role="tab" aria-selected="{{activeTab === 1}}"><text>学校通知</text></view>
    </view>
  </view>

  <swiper class="inbox-swiper" current="{{activeTab}}" duration="420" easing-function="easeOutCubic" bindchange="onSwiperChange" cache-extent="1">
    <swiper-item>
      <scroll-view class="inbox-list" type="list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-default-style="{{theme === 'dark' ? 'white' : 'black'}}" refresher-threshold="68" refresher-triggered="{{messageRefreshing}}" bindrefresherrefresh="refreshMessages">
        <view class="inbox-content page-content">
          <view class="list-heading">
            <view class="list-heading-copy"><text class="list-title">教务消息</text></view>
            <view class="message-filter-anchor">
              <view id="message-filter-button" class="filter-button pressable" catchtap="openMessageFilter" hover-class="pressing"><lucide-icon name="list-filter" tone="muted" size="{{25}}"></lucide-icon><text>筛选</text><view wx:if="{{messageFilterCount}}" class="filter-count"><text>{{messageFilterCount}}</text></view></view>
              <view wx:if="{{messageFilterMounted}}" class="message-filter-popover {{messageFilterOpen ? 'message-filter-popover--open' : ''}}" catchtap="keepMessageFilterOpen">
                <view class="message-filter-heading"><text>消息类型</text></view>
                <view class="message-type-list">
                  <block wx:for="{{messageTypeOptions}}" wx:key="label">
                    <view class="message-type-option" data-index="{{index}}" catchtap="selectMessageType" hover-class="message-type-option--pressed" hover-start-time="0" aria-role="checkbox" aria-checked="{{item.selected}}"><text>{{item.label}}</text><view class="message-type-check"><lucide-icon wx:if="{{item.selected}}" name="check" tone="{{theme === 'dark' ? 'white' : 'ink'}}" size="{{20}}"></lucide-icon></view></view>
                    <view wx:if="{{index < messageTypeOptions.length - 1}}" class="message-type-separator"></view>
                  </block>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{messageItems.length}}" class="message-list">
            <view wx:for="{{messageItems}}" wx:key="id" class="message-card card stagger-item" style="animation-delay: {{index < 7 ? index * 45 : 0}}ms;">
              <view class="message-meta-row">
                <text class="message-badge message-badge--{{item.tone}}">{{item.label}}</text>
                <text class="message-time">{{item.createdAt}}</text>
              </view>
              <view class="message-course-row">
                <text class="message-title" overflow="ellipsis" max-lines="1">{{item.title}}</text>
                <text wx:if="{{item.teacher}}" class="message-teacher" overflow="ellipsis" max-lines="1">（{{item.teacher}}）</text>
              </view>
              <view wx:if="{{item.type === 'course_rescheduled'}}" class="schedule-flow schedule-flow--rescheduled">
                <view class="schedule-panel schedule-panel--old">
                  <view class="schedule-panel-head"><text class="schedule-state schedule-state--old">原安排</text><view class="schedule-location"><lucide-icon name="map-pin" tone="muted" size="{{18}}"></lucide-icon><text overflow="ellipsis" max-lines="1">{{item.original.location}}</text></view></view>
                  <text class="schedule-comparison-time tnum">{{item.original.primary}}</text>
                </view>
                <view class="reschedule-connector">
                  <view class="reschedule-arrow"><lucide-icon name="chevron-right" tone="amber" size="{{19}}"></lucide-icon></view>
                </view>
                <view class="schedule-panel schedule-panel--new">
                  <view class="schedule-panel-head"><text class="schedule-state schedule-state--new">新安排</text><view class="schedule-location schedule-location--new"><lucide-icon name="map-pin" tone="amber" size="{{18}}"></lucide-icon><text overflow="ellipsis" max-lines="1">{{item.current.location}}</text></view></view>
                  <text class="schedule-comparison-time schedule-comparison-time--new tnum">{{item.current.primary}}</text>
                </view>
              </view>
              <view wx:elif="{{item.type === 'makeup_class'}}" class="schedule-flow">
                <view class="schedule-panel schedule-panel--makeup">
                  <view class="schedule-panel-head"><text class="schedule-state schedule-state--makeup">补课安排</text><view class="schedule-inline"><view class="schedule-location"><lucide-icon name="map-pin" tone="sage" size="{{19}}"></lucide-icon><text overflow="ellipsis" max-lines="1">{{item.current.location}}</text></view><text class="schedule-time-label">{{item.current.primary}}</text></view></view>
                </view>
              </view>
              <view wx:elif="{{item.type === 'course_cancelled'}}" class="schedule-flow">
                <view class="schedule-panel schedule-panel--cancelled">
                  <view class="schedule-panel-head"><text class="schedule-state schedule-state--cancelled">停课安排</text><view class="schedule-inline"><view class="schedule-location"><lucide-icon name="map-pin" tone="coral" size="{{19}}"></lucide-icon><text overflow="ellipsis" max-lines="1">{{item.original.location}}</text></view><text class="schedule-time-label">{{item.original.primary}}</text></view></view>
                </view>
              </view>
              <text wx:else class="message-content">{{item.content}}</text>
            </view>
          </view>
          <loading-view wx:elif="{{messageLoading}}" label="正在读取教务消息"></loading-view>
          <empty-state wx:elif="{{messageError}}" icon="circle-alert" icon-tone="danger" title="消息加载失败" description="{{messageError}}" action-text="重新加载" bindaction="refreshMessages"></empty-state>
          <empty-state wx:elif="{{messageLoaded}}" icon="message-circle-more" title="没有符合条件的消息" description="更换筛选条件，或下拉刷新后再看看" action-text="调整筛选" bindaction="openMessageFilter"></empty-state>
        </view>
        <view class="inbox-bottom-space"></view>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <scroll-view class="inbox-list" type="list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-default-style="{{theme === 'dark' ? 'white' : 'black'}}" refresher-threshold="68" refresher-triggered="{{noticeRefreshing}}" bindrefresherrefresh="refreshNotices">
        <view class="inbox-content page-content">
          <view class="search-field notice-search {{noticeSearchFocused ? 'search-field--focus' : ''}}">
            <lucide-icon name="search" tone="muted" size="{{28}}"></lucide-icon>
            <input class="search-input" value="{{noticeQuery}}" placeholder="搜索通知" placeholder-class="notice-placeholder" bindinput="onNoticeQueryInput" bindfocus="onNoticeSearchFocus" bindblur="onNoticeSearchBlur" bindconfirm="searchNotices" confirm-type="search" aria-label="搜索通知" />
            <view wx:if="{{noticeQuery}}" class="search-clear" bindtap="clearNoticeQuery"><lucide-icon name="x" tone="muted" size="{{24}}"></lucide-icon></view>
          </view>

          <view wx:if="{{noticeItems.length}}" class="notice-list">
            <view wx:for="{{noticeItems}}" wx:key="link" class="notice-item card pressable stagger-item" style="animation-delay: {{index < 7 ? index * 45 : 0}}ms;" data-id="{{item.id}}" data-link="{{item.link}}" data-title="{{item.title}}" data-published-at="{{item.publishedAt}}" bindtap="openNotice" hover-class="pressing" aria-role="link">
              <view class="notice-icon"><lucide-icon name="megaphone" tone="coral" size="{{34}}"></lucide-icon></view>
              <view class="notice-copy">
                <view class="notice-title-row"><text class="notice-title" overflow="ellipsis" max-lines="2">{{item.title}}</text><view class="notice-meta"><text class="notice-time">{{item.displayTime}}</text><text class="notice-tag">教务通知</text></view></view>
              </view>
            </view>
          </view>
          <loading-view wx:elif="{{noticeLoading}}" label="正在读取学校通知"></loading-view>
          <empty-state wx:elif="{{noticeError}}" icon="circle-alert" icon-tone="danger" title="通知加载失败" description="{{noticeError}}" action-text="重新加载" bindaction="refreshNotices"></empty-state>
          <empty-state wx:elif="{{noticeLoaded}}" icon="megaphone" title="没有找到通知" description="尝试更换关键词，或清空搜索条件" action-text="清空搜索" bindaction="clearNoticeQuery"></empty-state>
        </view>
        <view class="inbox-bottom-space"></view>
      </scroll-view>
    </swiper-item>
  </swiper>

</view>
