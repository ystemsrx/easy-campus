.inbox-toolbar { padding: 24rpx 48rpx 10rpx; background-color: var(--color-bg); }
.segmented-control { position: relative; display: flex; flex-direction: row; padding: 7rpx; border-radius: 999rpx; background: rgba(43, 38, 32, 0.05); }
.segment-indicator { position: absolute; top: 7rpx; bottom: 7rpx; left: 7rpx; width: calc((100% - 14rpx) / 2); border-radius: 999rpx; background: #fff; box-shadow: var(--shadow-card); transform: translateX(0); transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1); }
.segment-indicator--1 { transform: translateX(100%); }
.segment-item { position: relative; z-index: 1; display: flex; flex: 1; align-items: center; justify-content: center; min-height: 68rpx; color: #8b8b94; font-size: 25rpx; font-weight: 750; transition: color 220ms ease, transform 120ms ease; }
.segment-item--active { color: #16161a; }
.segment-item--pressed { transform: scale(0.95); }
.inbox-swiper { width: 100%; height: calc(100% - 112rpx); }
.inbox-list { width: 100%; height: 100%; background-color: var(--color-bg); }
.inbox-content { padding-top: 22rpx; }

.list-heading { display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; margin: 4rpx 2rpx 24rpx; }
.list-title { display: block; color: var(--color-text); font-size: 38rpx; font-weight: 750; }
.list-caption { display: block; margin-top: 5rpx; color: var(--color-text-tertiary); font-size: 22rpx; }
.filter-button { display: flex; flex-direction: row; align-items: center; gap: 10rpx; padding: 13rpx 22rpx; border-radius: 999rpx; color: #8b8578; background: #fff; box-shadow: var(--shadow-card); font-size: 22rpx; font-weight: 700; }
.filter-button--active { color: #b85c38; background: #f9eae2; }
.message-list,
.notice-list { display: flex; flex-direction: column; gap: 18rpx; }
.message-card { padding: 28rpx; }
.message-meta-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 18rpx; }
.message-badge { flex: none; padding: 6rpx 16rpx; border-radius: 999rpx; color: #8b8b94; background: #f1f1f3; font-size: 20rpx; font-weight: 800; }
.message-badge--blue { color: #a66f1f; background: #f8eedd; }
.message-badge--green { color: #5f7350; background: #edf1e6; }
.message-badge--orange { color: #c0452d; background: #f9e7e0; }
.message-course-row { display: flex; flex-direction: row; align-items: baseline; gap: 7rpx; min-width: 0; margin-top: 14rpx; }
.message-title { flex: 0 1 auto; min-width: 0; color: var(--color-text); font-size: 29rpx; font-weight: 750; }
.message-time { flex: none; max-width: 145rpx; color: #b5b0a3; font-size: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.message-teacher { flex: none; max-width: 250rpx; color: var(--color-text-tertiary); font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.schedule-flow { margin-top: 20rpx; }
.schedule-panel { padding: 20rpx 22rpx; border: 1rpx solid rgba(43, 38, 32, 0.04); border-radius: 30rpx; background: #f6f3ec; }
.schedule-panel--new { border-color: rgba(166, 111, 31, 0.14); background: #fdf7e9; }
.schedule-panel--makeup { border-color: rgba(95, 115, 80, 0.14); background: #f2f6ee; }
.schedule-panel--cancelled { border-color: rgba(192, 69, 45, 0.12); background: #fdf1ec; }
.schedule-panel-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; min-width: 0; }
.schedule-state { flex: none; font-size: 18rpx; font-weight: 800; }
.schedule-state--old { color: #8b8578; }
.schedule-state--new { color: #a66f1f; }
.schedule-state--makeup { color: #5f7350; }
.schedule-state--cancelled { color: #c0452d; }
.schedule-time-label { flex: none; padding: 7rpx 14rpx; border-radius: 999rpx; color: #3a352d; background: rgba(255, 255, 255, 0.76); font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.schedule-location { display: flex; flex-direction: row; align-items: center; gap: 8rpx; min-width: 0; margin-top: 12rpx; color: #8b8578; font-size: 20rpx; }
.schedule-location > text { flex: 1; min-width: 0; }
.schedule-location--new { color: #8b6d38; }
.reschedule-connector { display: flex; flex-direction: row; align-items: center; gap: 11rpx; padding: 8rpx 18rpx; }
.reschedule-connector-line { flex: 1; height: 1rpx; background: rgba(166, 111, 31, 0.15); }
.reschedule-connector-label { display: flex; flex: none; flex-direction: row; align-items: center; gap: 5rpx; color: #a66f1f; font-size: 17rpx; font-weight: 750; }
.reschedule-arrow { display: flex; transform: rotate(90deg); }
.message-content { display: block; margin-top: 18rpx; color: #8b8578; font-size: 23rpx; line-height: 1.65; }

.notice-search { gap: 18rpx; margin-bottom: 18rpx; }
.notice-placeholder { color: #b5b0a3; }
.search-clear { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; color: #9a9aa3; background: rgba(43, 38, 32, 0.05); font-size: 30rpx; }
.notice-source { display: flex; flex-direction: row; align-items: center; gap: 9rpx; margin: 0 5rpx 24rpx; color: #a39e92; font-size: 20rpx; }
.source-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #7d8f6e; }
.notice-item { display: flex; flex-direction: row; align-items: flex-start; gap: 22rpx; padding: 28rpx; }
.notice-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 28rpx; color: #b85c38; background: #f9eae2; }
.notice-copy { flex: 1; min-width: 0; }
.notice-title-row { display: flex; flex-direction: row; align-items: baseline; gap: 16rpx; }
.notice-title { flex: 1; min-width: 0; color: var(--color-text); font-size: 26rpx; font-weight: 750; line-height: 1.45; }
.notice-time { flex: none; max-width: 135rpx; color: #b5b0a3; font-size: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice-preview { display: block; margin-top: 7rpx; color: #8b8578; font-size: 22rpx; }
.notice-tag { display: inline-flex; margin-top: 12rpx; padding: 5rpx 13rpx; border-radius: 999rpx; color: #a39e92; background: #f6f3ec; font-size: 18rpx; font-weight: 700; }
.load-more,
.end-caption { display: block; padding: 26rpx; color: #b5b0a3; font-size: 21rpx; text-align: center; }

.filter-section { margin-top: 26rpx; }
.filter-section:first-child { margin-top: 8rpx; }
.filter-section-title { display: block; margin: 0 4rpx 14rpx; color: #9a9aa3; font-size: 23rpx; font-weight: 750; }
.type-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.type-option { display: flex; align-items: center; justify-content: center; min-height: 70rpx; border-radius: 999rpx; color: #8b8b94; background: rgba(43, 38, 32, 0.045); font-size: 23rpx; font-weight: 700; transition: transform 120ms ease, color 220ms ease, background-color 220ms ease; }
.type-option { width: calc((100% - 24rpx) / 3); }
.type-option--active { color: #fff; background: linear-gradient(135deg, #d97757, #eba97f); }
.type-option--pressed { transform: scale(0.95); }
.date-range { display: flex; flex-direction: row; align-items: center; gap: 14rpx; }
.date-picker { flex: 1; min-width: 0; }
.date-value { display: flex; flex-direction: column; justify-content: center; min-height: 88rpx; padding: 13rpx 22rpx; border-radius: 28rpx; background: rgba(43, 38, 32, 0.045); }
.date-label { color: #a39e92; font-size: 18rpx; }
.date-text { margin-top: 1rpx; color: var(--color-text); font-size: 23rpx; font-weight: 650; }
.date-text--placeholder { color: #b5b0a3; }
.date-separator { color: #c9c5b8; }
.filter-actions { display: flex; flex-direction: row; gap: 16rpx; }
.filter-actions .secondary-button { flex: 2; }
.filter-actions .primary-button { flex: 3; }

.theme-dark .segment-indicator { background: #3a3730; }
.theme-dark .segment-item--active { color: #f7f3e9; }
.theme-dark .schedule-panel { border-color: rgba(255, 255, 255, 0.05); background: #2d2a24; }
.theme-dark .schedule-panel--new { border-color: rgba(229, 184, 110, 0.18); background: rgba(166, 111, 31, 0.16); }
.theme-dark .schedule-panel--makeup { border-color: rgba(172, 190, 151, 0.16); background: rgba(95, 115, 80, 0.16); }
.theme-dark .schedule-panel--cancelled { border-color: rgba(217, 119, 87, 0.17); background: rgba(192, 69, 45, 0.14); }
.theme-dark .schedule-time-label { color: #f7f3e9; background: rgba(255, 255, 255, 0.07); }
