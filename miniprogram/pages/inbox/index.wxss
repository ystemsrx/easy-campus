.inbox-page { display: flex; flex-direction: column; overflow: hidden; }
.inbox-toolbar { flex: none; padding: 24rpx 48rpx 10rpx; background-color: var(--color-bg); }
.segmented-control { position: relative; display: flex; flex-direction: row; padding: 7rpx; border-radius: 999rpx; background: rgba(43, 38, 32, 0.05); }
.segment-indicator { position: absolute; top: 7rpx; bottom: 7rpx; left: 7rpx; width: calc((100% - 14rpx) / 2); border-radius: 999rpx; background: #fff; box-shadow: var(--shadow-card); transform: translateX(0); transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1); }
.segment-indicator--1 { transform: translateX(100%); }
.segment-item { position: relative; z-index: 1; display: flex; flex: 1; align-items: center; justify-content: center; min-height: 68rpx; color: #8b8b94; font-size: 25rpx; font-weight: 750; transition: color 220ms ease, transform 120ms ease; }
.segment-item--active { color: #16161a; }
.segment-item--pressed { transform: scale(0.95); }
.inbox-swiper { flex: 1; width: 100%; min-height: 0; }
.inbox-list { width: 100%; height: 100%; background-color: var(--color-bg); }
.inbox-content { min-height: 100%; padding-top: 22rpx; }
.inbox-bottom-space { width: 100%; height: calc(104rpx + env(safe-area-inset-bottom)); }

.list-heading { position: relative; z-index: 20; display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin: 4rpx 2rpx 24rpx; overflow: visible; }
.list-heading-copy { flex: 1; min-width: 0; }
.list-title { display: block; color: var(--color-text); font-size: 38rpx; font-weight: 750; }
.message-filter-anchor { position: relative; flex: none; overflow: visible; }
.filter-button { box-sizing: border-box; position: relative; display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; gap: 11rpx; min-width: 140rpx; padding: 13rpx 26rpx; border-radius: 999rpx; color: #8b8578; background: #fff; box-shadow: var(--shadow-card); font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.filter-button > text { flex: none; white-space: nowrap; }
.filter-count { position: absolute; top: -10rpx; right: -8rpx; display: flex; align-items: center; justify-content: center; min-width: 31rpx; height: 31rpx; padding: 0 7rpx; border: 3rpx solid var(--color-bg); border-radius: 999rpx; color: #fff; background: #e94d3d; font-size: 17rpx; font-weight: 850; line-height: 1; }
.message-list,
.notice-list { display: flex; flex-direction: column; gap: 18rpx; }
.message-card { padding: 28rpx; }
.message-meta-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 18rpx; }
.message-badge { flex: none; padding: 6rpx 16rpx; border-radius: 999rpx; color: #8b8b94; background: #f1f1f3; font-size: 20rpx; font-weight: 800; }
.message-badge--blue { color: #a66f1f; background: #f8eedd; }
.message-badge--green { color: #5f7350; background: #edf1e6; }
.message-badge--orange { color: #c0452d; background: #f9e7e0; }
.message-course-row { display: flex; flex-direction: row; align-items: baseline; gap: 7rpx; min-width: 0; margin-top: 14rpx; }
.message-title { flex: 0 1 auto; min-width: 0; color: var(--color-text); font-size: 29rpx; font-weight: 750; }
.message-time { flex: none; max-width: 145rpx; color: #b5b0a3; font-size: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.message-teacher { flex: none; max-width: 250rpx; color: var(--color-text-tertiary); font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.schedule-flow { margin-top: 20rpx; }
.schedule-flow--rescheduled { display: flex; flex-direction: row; align-items: stretch; gap: 8rpx; }
.schedule-panel { padding: 20rpx 22rpx; border: 1rpx solid rgba(43, 38, 32, 0.04); border-radius: 30rpx; background: #f6f3ec; }
.schedule-flow--rescheduled .schedule-panel { flex: 1; min-width: 0; padding: 18rpx 16rpx; border-radius: 26rpx; }
.schedule-panel--new { border-color: rgba(166, 111, 31, 0.14); background: #fdf7e9; }
.schedule-panel--makeup { border-color: rgba(95, 115, 80, 0.14); background: #f2f6ee; }
.schedule-panel--cancelled { border-color: rgba(192, 69, 45, 0.12); background: #fdf1ec; }
.schedule-panel-head { display: flex; flex-direction: row; align-items: center; gap: 14rpx; min-width: 0; }
.schedule-state { flex: none; font-size: 18rpx; font-weight: 800; }
.schedule-state--old { color: #8b8578; }
.schedule-state--new { color: #a66f1f; }
.schedule-state--makeup { color: #5f7350; }
.schedule-state--cancelled { color: #c0452d; }
.schedule-inline { display: flex; flex: 1; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; min-width: 0; white-space: nowrap; }
.schedule-time-label { flex: none; padding: 7rpx 14rpx; border-radius: 999rpx; color: #3a352d; background: rgba(255, 255, 255, 0.76); font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.schedule-location { display: flex; flex: 1; flex-direction: row; align-items: center; justify-content: flex-end; gap: 7rpx; min-width: 0; color: #8b8578; font-size: 19rpx; white-space: nowrap; }
.schedule-location > text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.schedule-location--new { color: #8b6d38; }
.schedule-flow--rescheduled .schedule-panel-head { gap: 8rpx; }
.schedule-flow--rescheduled .schedule-location { justify-content: flex-end; gap: 4rpx; font-size: 17rpx; }
.schedule-comparison-time { display: block; margin-top: 12rpx; overflow: hidden; color: #6f695e; font-size: 17rpx; font-weight: 720; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.schedule-comparison-time--new { color: #8b6d38; }
.reschedule-connector { display: flex; flex: none; align-items: center; justify-content: center; width: 34rpx; }
.reschedule-arrow { display: flex; flex: none; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; border-radius: 50%; background: #f8eedd; }
.message-content { display: block; margin-top: 18rpx; color: #8b8578; font-size: 23rpx; line-height: 1.65; }

.notice-search { gap: 18rpx; margin-bottom: 18rpx; }
.notice-placeholder { color: #b5b0a3; }
.search-clear { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; color: #9a9aa3; background: rgba(43, 38, 32, 0.05); font-size: 30rpx; }
.notice-item { display: flex; flex-direction: row; align-items: flex-start; gap: 22rpx; padding: 28rpx; }
.notice-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 28rpx; color: #b85c38; background: #f9eae2; }
.notice-copy { flex: 1; min-width: 0; }
.notice-title-row { display: flex; flex-direction: row; align-items: baseline; gap: 16rpx; }
.notice-title { flex: 1; min-width: 0; color: var(--color-text); font-size: 26rpx; font-weight: 750; line-height: 1.45; }
.notice-meta { display: flex; flex: none; flex-direction: column; align-items: flex-end; gap: 9rpx; }
.notice-time { flex: none; max-width: 135rpx; color: #b5b0a3; font-size: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice-tag { display: inline-flex; padding: 5rpx 13rpx; border-radius: 999rpx; color: #a39e92; background: #f6f3ec; font-size: 18rpx; font-weight: 700; white-space: nowrap; }
.load-more,
.end-caption { display: block; padding: 26rpx; color: #b5b0a3; font-size: 21rpx; text-align: center; }

.message-filter-popover { box-sizing: border-box; position: absolute; z-index: 40; top: calc(100% + 14rpx); right: 0; width: 132rpx; padding: 20rpx 19rpx 14rpx; border: 1rpx solid rgba(43, 38, 32, 0.055); border-radius: 28rpx; background: rgba(255, 255, 255, 0.98); box-shadow: 0 24rpx 74rpx rgba(57, 46, 34, 0.18); opacity: 0; transform: translateY(-12rpx) scale(0.96); transform-origin: top right; transition: opacity 220ms ease, transform 340ms cubic-bezier(0.22, 1, 0.36, 1); }
.message-filter-popover--open { opacity: 1; transform: translateY(0) scale(1); }
.message-filter-heading { display: flex; flex-direction: row; align-items: center; width: 92rpx; margin: 1rpx 0 12rpx; }
.message-filter-heading > text:first-child { color: var(--color-text); font-size: 23rpx; font-weight: 780; white-space: nowrap; }
.message-type-list { display: flex; flex-direction: column; }
.message-type-option { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: space-between; width: 92rpx; min-height: 62rpx; padding: 0; color: var(--color-text); font-size: 23rpx; font-weight: 680; line-height: 1; transition: opacity 120ms ease, transform 120ms ease; }
.message-type-option > text { flex: none; white-space: nowrap; }
.message-type-check { display: flex; flex: none; align-items: center; justify-content: center; width: 24rpx; height: 24rpx; }
.message-type-option--pressed { opacity: 0.48; transform: scale(0.985); }
.message-type-separator { align-self: center; width: 92rpx; height: 2rpx; border-radius: 999rpx; background: rgba(43, 38, 32, 0.12); }

.theme-dark .segment-indicator { background: #3a3730; }
.theme-dark .segment-item--active { color: #f7f3e9; }
.theme-dark .schedule-panel { border-color: rgba(255, 255, 255, 0.05); background: #2d2a24; }
.theme-dark .schedule-panel--new { border-color: rgba(229, 184, 110, 0.18); background: rgba(166, 111, 31, 0.16); }
.theme-dark .schedule-panel--makeup { border-color: rgba(172, 190, 151, 0.16); background: rgba(95, 115, 80, 0.16); }
.theme-dark .schedule-panel--cancelled { border-color: rgba(217, 119, 87, 0.17); background: rgba(192, 69, 45, 0.14); }
.theme-dark .schedule-time-label { color: #f7f3e9; background: rgba(255, 255, 255, 0.07); }
.theme-dark .schedule-comparison-time { color: #d2ccc0; }
.theme-dark .schedule-comparison-time--new { color: #e5b86e; }
.theme-dark .reschedule-arrow { background: rgba(166, 111, 31, 0.2); }
.theme-dark .filter-button { background: #2d2a24; }
.theme-dark .message-filter-popover { border-color: rgba(255, 255, 255, 0.07); background: rgba(45, 42, 36, 0.98); box-shadow: 0 28rpx 82rpx rgba(0, 0, 0, 0.42); }
.theme-dark .message-type-separator { background: rgba(255, 255, 255, 0.14); }

.motion-reduced .message-filter-popover,
.motion-reduced .message-type-option { transition-duration: 1ms; }
