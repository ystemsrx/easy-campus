.grades-content { padding-top: 20rpx; }
.nav-refresh { box-sizing: border-box; display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; min-width: 76rpx; max-width: 76rpx; height: 76rpx; min-height: 76rpx; max-height: 76rpx; padding: 0; overflow: hidden; border-radius: 999rpx; color: #2b2620; background: #fff; box-shadow: 0 2rpx 4rpx rgba(20, 20, 30, 0.04), 0 14rpx 40rpx -12rpx rgba(20, 20, 30, 0.14); transition: transform 120ms ease-out, opacity 120ms ease-out; }
.nav-button-pressed { transform: scale(0.93); opacity: 0.82; }
.nav-refresh--loading { opacity: 1; }
.nav-refresh-spinner { display: block; flex: none; width: 34rpx; min-width: 34rpx; height: 34rpx; min-height: 34rpx; border-radius: 999rpx; animation-name: grade-refresh-spin; animation-duration: 720ms; animation-timing-function: linear; animation-iteration-count: infinite; }
.semester-scroll { position: relative; z-index: 2; display: block; flex: none; width: calc(100% + 80rpx); height: 96rpx; margin-left: -40rpx; }
.semester-row { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; gap: 14rpx; height: 96rpx; padding: 8rpx 40rpx 18rpx; }
.semester-chip { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; height: 60rpx; padding: 0 25rpx; border-radius: 999rpx; color: #8b8b94; background: #fff; box-shadow: var(--shadow-card); font-size: 22rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.semester-chip > text { display: block; line-height: 30rpx; }
.semester-chip--active { color: #fff; background: linear-gradient(135deg, #c98a2d, #e5b86e); }

.grade-overview { position: relative; margin-top: 18rpx; padding: 38rpx 38rpx 30rpx; overflow: hidden; border-radius: 56rpx; color: #fff; background: linear-gradient(140deg, #c98a2d, #e5b86e); box-shadow: var(--shadow-pop); }
.grade-blob { background: rgba(255, 255, 255, 0.15); }
.grade-blob--one { top: -94rpx; left: -74rpx; width: 300rpx; height: 270rpx; }
.grade-blob--two { right: -60rpx; bottom: -105rpx; width: 250rpx; height: 220rpx; background: rgba(0, 0, 0, 0.06); animation-delay: -4s; }
.grade-overview-main { position: relative; display: flex; flex-direction: row; align-items: center; gap: 40rpx; }
.average-ring { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 204rpx; height: 204rpx; border-radius: 50%; }
.average-ring-image { position: absolute; top: 0; left: 0; width: 204rpx; height: 204rpx; }
.average-inner { position: relative; display: flex; align-items: center; justify-content: center; width: 150rpx; height: 150rpx; }
.average-value { display: block; max-width: 146rpx; font-size: 52rpx; font-weight: 800; line-height: 1; text-align: center; }
.overview-stats { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.overview-stat { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; gap: 16rpx; min-height: 54rpx; padding: 8rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.16); }
.overview-stat:last-child { border-bottom: 0; }
.overview-stat text:first-child { flex: none; color: rgba(255, 255, 255, 0.8); font-size: 23rpx; }
.overview-stat text:last-child { min-width: 0; font-size: 33rpx; font-weight: 800; text-align: right; }
.overview-foot { position: relative; display: flex; flex-direction: row; justify-content: flex-start; margin-top: 22rpx; color: rgba(255, 255, 255, 0.72); font-size: 20rpx; }

.grade-tools { display: flex; flex-direction: row; gap: 14rpx; margin-top: 28rpx; }
.grade-search { flex: 1; min-width: 0; gap: 18rpx; border-radius: 999rpx; }
.grade-placeholder { color: #b5b0a3; }
.grade-clear { display: flex; flex: none; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 50%; color: #9a9aa3; background: rgba(43, 38, 32, 0.05); }
.grade-filter-button { display: flex; flex: none; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 50%; color: #8b8578; background: #fff; box-shadow: var(--shadow-card); }
.result-heading { display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; margin: 48rpx 2rpx 22rpx; }
.result-title { display: block; color: var(--color-text); font-size: 38rpx; font-weight: 750; }
.result-count { display: block; margin-top: 5rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.result-sort { flex: none; color: #a49f94; font-size: 21rpx; white-space: nowrap; }

.grade-list { display: flex; flex-direction: column; gap: 18rpx; }
.grade-card-motion { width: 100%; }
.grade-card { display: flex; flex-direction: row; align-items: center; gap: 16rpx; width: 100%; padding: 24rpx; }
.score-tile { display: flex; flex: none; box-sizing: border-box; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 34rpx; color: #b85c38; background: linear-gradient(135deg, #f9eae2, #f2d7ca); }
.score-tile--great { color: #75629a; background: linear-gradient(135deg, #f1edf8, #e4dcf0); }
.score-tile--good { color: #5f7350; background: linear-gradient(135deg, #edf1e6, #dde6d1); }
.score-tile--average { color: #4f769a; background: linear-gradient(135deg, #e9f1f7, #d5e5f0); }
.score-tile--warning { color: #a66f1f; background: linear-gradient(135deg, #f8eedd, #f0dfbd); }
.score-tile--danger { color: #a55357; background: linear-gradient(135deg, #f7e9e8, #efd6d5); }
.score-tile--muted { color: #8b8b94; background: #f1f1f3; }
.score-value { max-width: 100%; font-size: 34rpx; font-weight: 800; line-height: 1.12; text-align: center; }
.score-tile--compact { padding: 10rpx; }
.score-tile--compact .score-value { font-size: 23rpx; }
.course-copy { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; min-height: 104rpx; }
.course-name { display: block; min-width: 0; color: var(--color-text); font-size: 27rpx; font-weight: 750; line-height: 1.32; }
.component-preview { display: flex; flex-direction: row; flex-wrap: nowrap; gap: 7rpx; max-width: 100%; margin-top: 7rpx; overflow: hidden; }
.component-preview text { display: block; flex: none; max-width: 150rpx; padding: 5rpx 10rpx; overflow: hidden; border-radius: 999rpx; color: #8b8578; background: #f6f3ec; font-size: 17rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.grade-remark { display: flex; flex-direction: row; align-items: center; gap: 8rpx; min-width: 0; margin-top: 7rpx; color: #c0452d; font-size: 19rpx; }
.grade-remark view { flex: none; width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.grade-remark text { min-width: 0; }
.course-tags { display: flex; flex: none; flex-direction: column; align-items: flex-end; justify-content: center; gap: 7rpx; }
.course-tag { flex: none; padding: 5rpx 11rpx; border-radius: 999rpx; color: #8b8b94; background: rgba(43, 38, 32, 0.05); font-size: 17rpx; font-weight: 700; white-space: nowrap; }
.course-tag--gpa { color: #9a671f; background: #f8eedd; }
.course-chevron { flex: none; }
.grade-load-more,
.grade-end { display: block; padding: 26rpx; color: #b5b0a3; font-size: 21rpx; text-align: center; }

.theme-dark .nav-refresh,
.theme-dark .semester-chip,
.theme-dark .grade-filter-button { background: #2d2a24; }
.theme-dark .grade-clear,
.theme-dark .course-tag { background: rgba(255, 255, 255, 0.07); }
.theme-dark .course-tag--gpa { color: #e5b86e; background: rgba(201, 138, 45, 0.16); }
.theme-dark .component-preview text { color: #bdb6a8; background: rgba(255, 255, 255, 0.06); }
.theme-dark .score-tile--muted { color: #b0aaa0; background: rgba(255, 255, 255, 0.08); }
.motion-reduced .nav-refresh-spinner { animation-name: none; }

@keyframes grade-refresh-spin { to { transform: rotate(360deg); } }
