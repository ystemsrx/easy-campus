<view class="page shuttle-page {{themeClass}} {{visualThemeClass}} {{motionClass}} {{liquidGlassClass}}" style="height: {{windowHeight}}px;">
  <rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}" reduced-motion="{{motionClass === 'motion-reduced'}}"></rate-limit-toast>
  <map id="campus-shuttle-map" class="campus-map" style="top: {{mapTop}}px; height: {{mapHeight}}px;"
    latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" min-scale="12" max-scale="19"
    polyline="{{polylines}}" circles="{{circles}}" show-location="{{false}}" enable-scroll="{{true}}" enable-zoom="{{true}}"
    enable-rotate="{{false}}" enable-overlooking="{{false}}" enable-poi="{{true}}" enable-building="{{false}}" show-scale="{{true}}"
    bindtap="onMapTap" bindpoitap="onMapTap" bindregionchange="onRegionChange" bindmarkertap="onMarkerTap" bindupdated="onMapUpdated"></map>
  <canvas type="2d" id="route-trace-canvas" class="route-trace-canvas" style="top: {{mapTop}}px; height: {{mapHeight}}px; opacity: {{routeAnimating ? 1 : 0}};" disable-scroll="{{false}}"></canvas>

  <view class="map-header" id="map-header">
    <view id="shuttle-navigation"><navigation-bar title="小易地图" back transparent theme="{{theme}}" bindback="onHide"></navigation-bar></view>
    <view class="map-controls">
    <view class="journey-fields">
    <view class="search-entry origin-entry" bindtap="openBoardingSearch" aria-role="button" aria-label="选择起点"><lucide-icon name="locate-fixed" size="27" tone="muted"></lucide-icon><text class="search-copy">{{originName}}</text><view wx:if="{{manualOrigin || originName !== '我的位置'}}" class="search-clear" catchtap="useNearestBoard" aria-label="清除出发点"><lucide-icon name="x" size="25" tone="muted"></lucide-icon></view></view>
    <view class="search-entry" bindtap="openDestinationSearch" hover-class="pressed" aria-role="button" aria-label="搜索目的地">
      <lucide-icon name="search" size="30" tone="muted"></lucide-icon>
      <text class="search-copy">{{destinationName || '想去哪'}}</text>
      <view wx:if="{{destinationName}}" class="search-clear" catchtap="clearDestination" aria-label="清除目的地"><lucide-icon name="x" size="25" tone="muted"></lucide-icon></view>
      <view wx:else class="search-arrow"><lucide-icon name="arrow-up-right" size="25" tone="{{theme === 'dark' ? 'white' : 'ink'}}"></lucide-icon></view>
    </view>
    </view>
    <view class="common-row">
      <view class="common-add {{commonOpen ? 'common-add--open' : ''}}" bindtap="openCommonSearch" hover-class="pressed" aria-role="button" aria-label="{{commonMounted ? '取消添加' : '添加常用地点'}}"><lucide-icon name="plus" size="32" tone="{{theme === 'dark' ? 'white' : 'ink'}}"></lucide-icon></view>
      <view wx:if="{{commonMounted}}" class="common-editor {{commonOpen ? 'common-editor--open' : ''}}" style="width: {{commonOpen ? windowWidth - 80 : 0}}px;">
        <input class="common-input" placeholder="添加地点" value="{{searchQuery}}" bindinput="onSearchInput" bindkeyboardheightchange="onSearchKeyboard" confirm-type="search" focus="{{commonFocus}}" adjust-position="{{false}}" maxlength="60" aria-label="搜索常用地点" />
      </view>
      <scroll-view wx:else type="list" class="common-scroll" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
        <view class="common-places">
          <view wx:for="{{commonPlaces}}" wx:key="key" class="common-place {{commonEnteringKey === item.key ? 'common-place--enter' : ''}} {{commonPlaceKey === item.key ? 'common-place--active' : ''}}" data-key="{{item.key}}" bindtap="selectCommonPlace" bindlongpress="removeCommonPlace" hover-class="pressed"><text>{{item.shortName}}</text></view>
        </view>
      </scroll-view>
    </view>
    </view>
    <view wx:if="{{commonMounted}}" class="common-options {{commonOpen ? 'common-options--open' : ''}}">
      <scroll-view type="list" class="common-results" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{commonListHeight}}px;">
        <view class="common-options-content">
          <view wx:for="{{searchResults}}" wx:key="id" class="common-option" data-id="{{item.id}}" bindtap="choosePlace" hover-class="pressed"><text class="common-option-title">{{item.shortName}}</text><text class="common-option-detail">{{item.name}}</text></view>
          <view wx:if="{{!searchResults.length}}" class="search-empty">{{routes.length ? '没有找到，试试其他名称' : locating ? '地点加载中' : '地点暂不可用，请稍后重试'}}</view>
        </view>
        <view class="common-bottom-space"></view>
      </scroll-view>
    </view>
  </view>
  <view wx:if="{{commonMounted}}" class="common-dismiss" bindtap="closeCommonSearch"></view>

  <view wx:if="{{hasOrigin && connection !== 'live'}}" class="map-live-state" style="top: {{headerHeight + 8}}px;">
    <view class="live-dot {{connection === 'live' && !stale ? 'live-dot--online' : ''}}"></view><text>{{statusLabel}}</text>
  </view>
  <view wx:if="{{farFromCampus}}" class="campus-distance-note" style="top: {{headerHeight + 31}}px;">距离校区较远，已为你展示校园</view>

  <view class="edge-layer" style="top: {{mapTop}}px; height: {{mapHeight}}px;">
    <view wx:for="{{edgeHints}}" wx:key="id" class="edge-hint" style="left: {{item.x}}px; top: {{item.y}}px;" data-id="{{item.id}}" bindtap="focusVehicle" aria-label="查看{{item.label}}号校车"><text class="edge-number">{{item.label}}</text><view class="edge-arrow" style="transform: rotate({{item.angle}}deg);"></view></view>
  </view>

  <view wx:if="{{pickMounted}}" class="map-pick {{pickOpen ? 'map-pick--open' : ''}}" style="left: {{pickX}}px; top: {{pickY}}px;">
    <image class="map-pick-pin" src="/features/assets/shuttle/pin.png" mode="aspectFit"></image>
    <view class="map-pick-bubble" catchtap="confirmMapPick" aria-role="button" aria-label="{{pickOrigin ? '从这出发' : '到这去'}}"><lucide-icon name="navigation" size="28" tone="white"></lucide-icon><text>{{pickOrigin ? '从这出发' : '到这去'}}</text></view>
  </view>
  <view class="map-tools" style="bottom: {{sheetOpen && (hasOrigin || destinationName) ? sheetHeight + 22 : hasOrigin ? safeBottom + 24 : safeBottom + 200}}px;">
    <view wx:if="{{!sheetOpen && (hasOrigin || destinationName)}}" class="map-tool" bindtap="openTripSheet" aria-label="打开路线"><lucide-icon name="navigation" size="30" tone="muted"></lucide-icon></view>
    <view class="map-tool" bindtap="showOverview" hover-class="pressed" aria-role="button" aria-label="总览线路"><lucide-icon name="map" size="30" tone="muted"></lucide-icon></view>
    <view class="map-tool {{following ? 'map-tool--active' : ''}}" bindtap="locateUser" hover-class="pressed" aria-role="button" aria-label="回到我的位置"><lucide-icon name="locate-fixed" size="31" tone="{{following ? 'white' : (theme === 'dark' ? 'white' : 'ink')}}"></lucide-icon></view>
  </view>

  <view wx:if="{{sheetMounted && (hasOrigin || destinationName)}}" class="trip-sheet motion-sheet {{sheetOpen ? 'motion-sheet--active' : ''}} {{sheetDragging ? 'trip-sheet--dragging' : ''}}" id="trip-sheet" style="height: {{sheetHeight}}px; padding-bottom: {{safeBottom}}px;">
    <view class="sheet-drag-zone" bindtouchstart="onSheetTouchStart" catchtouchmove="onSheetTouchMove" bindtouchend="onSheetTouchEnd" bindtouchcancel="onSheetTouchEnd" bindtap="toggleSheet" aria-role="button" aria-label="展开或收起校车信息"><view class="sheet-handle"></view></view>
    <view class="sheet-heading">
      <text class="sheet-title">{{journey === 'arrived' ? '已到达' : destinationName || '附近的校车'}}</text>
      <text class="sheet-summary">{{journey !== 'idle' ? (journey === 'riding' ? '乘车中' : journey === 'waiting' ? '候车中' : journey === 'walking' ? '步行中' : '') : destinationName ? plans.length + ' 条路线' : vehicles.length + ' 辆'}}</text>
      <view class="round-close" bindtap="closeTripSheet" aria-role="button" aria-label="关闭路线"><lucide-icon name="x" size="27" tone="muted"></lucide-icon></view>
    </view>
    <view class="sheet-scroll-wrap"><scroll-view type="list" class="sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="sheet-body">
        <view wx:if="{{!walking && journey === 'idle'}}" class="boarding-card" bindtap="openBoardingSearch" hover-class="pressed">
          <view class="boarding-symbol"><lucide-icon name="map-pin" size="31" tone="{{theme === 'dark' ? 'white' : 'ink'}}"></lucide-icon></view>
          <view class="boarding-copy"><text class="boarding-name">{{boardName || '选择候车点'}}</text><text class="boarding-detail">{{boardDetail}}</text></view>
          <view wx:if="{{boardName}}" class="favorite-button" catchtap="toggleFavorite" aria-label="收藏候车点"><lucide-icon name="star" size="30" tone="{{boardFavorite ? 'amber' : 'muted'}}"></lucide-icon></view>
          <lucide-icon name="chevron-right" size="26" tone="muted"></lucide-icon>
        </view>
        <view wx:if="{{!hasOrigin}}" class="manual-location-action">
          <button wx:if="{{gateAction === 'settings'}}" class="secondary-action" open-type="openSetting" bindopensetting="onLocationSettings">定位并查看实时校车</button>
          <button wx:elif="{{gateAction === 'system'}}" class="secondary-action" bindtap="openSystemLocationSettings">开启手机定位</button>
          <button wx:else class="secondary-action" loading="{{locating}}" disabled="{{locating}}" bindtap="retryActivation">定位并查看实时校车</button>
        </view>
        <view wx:if="{{destinationName && plans.length && journey === 'idle'}}" class="plan-list">
          <view wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bindtap="choosePlan" class="plan-card {{selectedPlanId === item.id ? 'plan-card--selected' : ''}}" hover-class="pressed">
            <view class="plan-card-top"><view class="line-tag" style="background: {{item.color}};">{{item.routeName}}</view><text class="plan-stop-count">{{item.timeLabel}}</text><view class="favorite-button" data-id="{{item.id}}" catchtap="togglePlanFavorite" aria-label="收藏出行方案"><lucide-icon name="star" size="28" tone="{{item.favorite ? 'amber' : 'muted'}}"></lucide-icon></view><lucide-icon wx:if="{{selectedPlanId === item.id}}" name="check" size="24" tone="{{theme === 'dark' ? 'white' : 'ink'}}"></lucide-icon></view>
            <view class="plan-detail-row"><view class="plan-stations"><text>{{item.boardName}}</text><lucide-icon name="arrow-right" size="21" tone="muted"></lucide-icon><text>{{item.alightName}}</text></view><text class="plan-walk">{{item.walkLabel}}</text></view>
          </view>
        </view>
        <view wx:if="{{destinationName && !plans.length && journey === 'idle'}}" class="sheet-empty"><text>{{!hasOrigin && !boardName ? '选择从哪里出发' : '暂未找到合适的乘车方案'}}</text><text class="empty-detail">{{!hasOrigin && !boardName ? '选择候车点后查看路线' : '试试更换候车点或目的地'}}</text></view>
        <view wx:if="{{crossingLabel}}" class="crossing-label">{{crossingLabel}}<text bindtap="clearCrossing">显示全部</text></view>
        <view wx:if="{{vehicleRows.length && journey === 'idle'}}" class="vehicle-list">
          <view wx:for="{{vehicleRows}}" wx:key="id" data-id="{{item.id}}" bindtap="selectVehicle" class="vehicle-row {{selectedVehicleId === item.id ? 'vehicle-row--selected' : ''}}" hover-class="pressed">
            <view class="vehicle-icon" style="background: {{item.color}};"><text>{{item.number}}</text></view>
            <view class="vehicle-copy"><text class="vehicle-name">{{item.routeName}}</text><text class="vehicle-detail">{{item.detail}}</text></view>
            <view class="vehicle-arrival"><text class="arrival-value {{item.imminent ? 'arrival-value--soon' : ''}}">{{item.eta}}</text><text class="arrival-distance">{{item.distanceLabel}}</text></view>
          </view>
        </view>
        <view wx:if="{{authorized && hasOrigin && !manualOrigin && selectedPlanId && journey === 'idle'}}" class="primary-action" bindtap="startJourney" hover-class="pressed"><lucide-icon name="navigation" size="29" tone="white"></lucide-icon><text>开始出发</text></view>
        <view wx:if="{{authorized && !manualOrigin && journey !== 'idle' && journeyProgress}}" class="journey-timeline" aria-label="{{journeyProgress.next}}">
          <scroll-view type="custom" class="journey-timeline-scroll" scroll-x enable-flex scroll-left="{{journeyScroll}}" scroll-with-animation="{{motionClass !== 'motion-reduced'}}" show-scrollbar="{{false}}">
            <view class="journey-timeline-track" style="width: {{journeyProgress.width}}px;">
              <view wx:for="{{journeyProgress.segments}}" wx:key="id" class="journey-segment" style="left: {{item.x}}px; width: {{item.width}}px;">
                <view class="journey-rail {{item.walk ? 'journey-rail--walk' : ''}}"></view>
                <view class="journey-fill" style="transform: scaleX({{item.fill}});"><view class="journey-rail journey-rail--done {{item.walk ? 'journey-rail--walk' : ''}}"></view></view>
              </view>
              <view wx:for="{{journeyProgress.nodes}}" wx:key="id" class="journey-node {{item.major ? 'journey-node--major' : ''}} {{item.reached ? 'journey-node--done' : ''}} {{item.transfer ? 'journey-node--transfer' : ''}}" style="left: {{item.x}}px;" aria-label="{{item.name}}{{item.transfer ? '，同站换乘' : ''}}">
                <view class="journey-node-dot"><lucide-icon wx:if="{{item.transfer}}" name="refresh-cw" size="20" tone="{{item.reached ? 'amber' : 'muted'}}"></lucide-icon></view>
                <text wx:if="{{item.major}}" class="journey-node-name journey-node-name--{{item.edge}}">{{item.name}}</text>
              </view>
            </view>
          </scroll-view>
          <text class="journey-next">{{journeyProgress.next}}</text>
        </view>
        <view wx:if="{{journey === 'arrived'}}" class="secondary-action" bindtap="clearDestination"><text>开始新的出行</text></view>
        <view wx:if="{{journey === 'waiting' || journey === 'riding' || journey === 'walking'}}" class="cancel-trip-wrap"><view class="cancel-trip" bindtap="cancelJourney" hover-class="pressed" aria-role="button">结束行程</view></view>
      </view>
      <view class="sheet-bottom-space {{journey !== 'idle' ? 'sheet-bottom-space--journey' : ''}}"></view>
    </scroll-view></view>
  </view>

  <view wx:if="{{searchMounted}}" class="search-layer motion-layer {{searchOpen ? 'motion-layer--active' : ''}}">
    <view class="search-backdrop motion-scrim {{searchOpen ? 'motion-scrim--active' : ''}}" bindtap="closeSearch" catchtouchmove="noop"></view>
    <view class="search-panel motion-sheet {{searchOpen ? 'motion-sheet--active' : ''}}" style="bottom: 0; height: {{searchPanelHeight}}px;">
      <view class="search-handle"></view>
      <view class="search-panel-heading"><text>{{searchMode === 'board' ? '从哪里出发' : '想去哪里'}}</text><view class="round-close" bindtap="closeSearch" aria-role="button" aria-label="关闭地点选择"><lucide-icon name="x" size="27" tone="muted"></lucide-icon></view></view>
      <view class="search-fixed">
        <view class="search-field"><lucide-icon name="search" size="30" tone="muted"></lucide-icon><input class="place-search-input" placeholder="搜索地点" value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search" adjust-position="{{false}}" maxlength="60" /></view>
        <view class="search-shortcuts"><view class="search-shortcut" bindtap="useMyLocation"><lucide-icon name="locate-fixed" size="27" tone="muted"></lucide-icon><text>使用我的位置</text></view><view class="search-shortcut" bindtap="chooseOnMap"><lucide-icon name="map-pin" size="27" tone="muted"></lucide-icon><text>在地图上选择</text></view></view>
      </view>
      <view class="search-results-wrap"><view class="search-results">
        <view class="search-results-content">
          <block wx:if="{{commonPlaces.length && !searchQuery}}"><text class="place-section-title">常用地点</text><view class="saved-places"><view wx:for="{{commonPlaces}}" wx:key="key" class="common-place" data-key="{{item.key}}" bindtap="chooseSavedPlace"><text>{{item.shortName}}</text></view></view></block>
        <block wx:if="{{searchStopRows.length}}">
          <text class="place-section-title">候车点</text>
          <view wx:for="{{searchStopRows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="id" class="place-pair">
            <view wx:for="{{row.places}}" wx:for-item="place" wx:key="id" class="place-tile" data-id="{{place.id}}" bindtap="choosePlace" hover-class="pressed">
              <view class="place-tile-top"><text class="place-tile-title">{{place.shortName}}</text><text class="place-distance">{{place.distanceLabel}}</text></view>
              <text class="place-tile-detail">{{place.name}}</text>
            </view>
          </view>
        </block>
        <block wx:if="{{searchPlaceRows.length}}">
          <text class="place-section-title">校园地点</text>
          <view wx:for="{{searchPlaceRows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="id" class="place-pair">
            <view wx:for="{{row.places}}" wx:for-item="place" wx:key="id" class="place-tile" data-id="{{place.id}}" bindtap="choosePlace" hover-class="pressed">
              <view class="place-tile-top"><text class="place-tile-title">{{place.shortName}}</text><text class="place-distance">{{place.distanceLabel}}</text></view>
              <text class="place-tile-detail">{{place.name}}</text>
            </view>
          </view>
        </block>
        <view wx:if="{{!searchResults.length}}" class="search-empty">{{routes.length ? '没有找到，试试其他名称' : locating ? '地点加载中' : '地点暂不可用，请稍后重试'}}</view>
        </view>
        <view class="search-bottom-space" style="height: {{safeBottom + 52}}px;"></view>
      </view></view>
    </view>
  </view>

  <view wx:if="{{!hasOrigin && !destinationName && !locating}}" class="permission-gate" style="padding-bottom: {{safeBottom + 20}}px;">
    <text class="gate-title">选择出发位置</text><text class="gate-detail">使用定位或选择候车点</text>
    <view class="gate-actions">
      <button wx:if="{{gateAction === 'settings'}}" class="gate-button" open-type="openSetting" bindopensetting="onLocationSettings">去设置</button>
      <button wx:elif="{{gateAction === 'system'}}" class="gate-button" bindtap="openSystemLocationSettings">打开定位</button>
      <button wx:else class="gate-button" loading="{{locating}}" disabled="{{locating}}" bindtap="retryActivation">{{locating ? '准备中' : '允许定位'}}</button>
      <view class="secondary-action gate-manual-button" bindtap="openBoardingSearch" aria-role="button">手动选择</view>
    </view>
  </view>
</view>
<screen-watermark></screen-watermark>
