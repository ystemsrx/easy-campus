.personalization-page {
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
}

.personalization-content {
  flex: 1;
  min-height: 0;
  padding-top: 28rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.personalization-card {
  overflow: hidden;
}

.appearance-setting {
  padding: 28rpx 34rpx 30rpx;
  border-bottom: 1rpx solid var(--color-separator);
}

.personalization-title {
  display: block;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 700;
}

.appearance-control {
  position: relative;
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
  padding: 7rpx;
  border-radius: 999rpx;
  background: rgba(43, 38, 32, 0.045);
}

.appearance-indicator {
  position: absolute;
  top: 7rpx;
  bottom: 7rpx;
  left: 7rpx;
  width: calc((100% - 14rpx) / 3);
  border-radius: 999rpx;
  background: #fff;
  box-shadow: var(--shadow-card);
  transform: translateX(0);
  transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
}

.appearance-indicator--dark {
  transform: translateX(100%);
}

.appearance-indicator--system {
  transform: translateX(200%);
}

.appearance-option {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  color: #8b8b94;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.appearance-option--active {
  color: #16161a;
}

.personalization-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 116rpx;
  padding: 24rpx 34rpx;
}

.personalization-row--divided {
  border-bottom: 1rpx solid var(--color-separator);
}

.personalization-copy {
  flex: 1;
  min-width: 0;
}

.personalization-caption {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  line-height: 1.45;
}

.personalization-switch {
  flex: none;
  transform: scale(0.82);
  transform-origin: right center;
}

.theme-dark .appearance-control {
  background: rgba(255, 255, 255, 0.06);
}

.theme-dark .appearance-indicator {
  background: #3a3730;
}

.theme-dark .appearance-option--active {
  color: #f7f3e9;
}
