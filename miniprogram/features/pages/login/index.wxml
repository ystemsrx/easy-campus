<rate-limit-toast id="rate-limit-toast"></rate-limit-toast>
<view class="page login-page {{themeClass}} {{motionClass}} {{loginHandoffClass}}">
  <view wx:if="{{errorMessage}}" class="login-toast login-toast--{{errorToastPhase}}" aria-role="alert">
    <text class="login-toast-copy">{{errorMessage}}</text>
  </view>
  <scroll-view class="page-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{loginScrollAnchor}}" scroll-with-animation="{{false}}">
    <view id="login-stage" class="login-stage">
      <view class="login-background" aria-hidden="true">
        <view class="ambient-blob login-blob login-blob--one"></view>
        <view class="ambient-blob login-blob login-blob--two"></view>
        <view class="ambient-blob login-blob login-blob--three"></view>
      </view>
      <view class="login-navigation">
        <navigation-bar cover="{{false}}" transparent theme="{{theme}}"></navigation-bar>
      </view>

      <view class="login-hero">
        <view class="login-heading">
          <text class="login-title display-title">Hello!</text>
          <text class="login-subtitle">欢迎来到{{appName}}</text>
        </view>
      </view>

      <view class="login-panel">
        <view class="login-panel-extension" aria-hidden="true"></view>
        <view class="mascot-stage {{mascotPositionClass}} {{mascotMotionClass}}" style="{{mascotPositionStyle}}" aria-hidden="true">
          <image wx:if="{{mascotSrc}}" class="mascot-image" src="{{mascotSrc}}" mode="aspectFit"></image>
        </view>

        <form class="login-form" bindsubmit="onSubmit">
          <view class="field {{accountFocused ? 'field--focus' : ''}}">
            <view class="field-icon"><lucide-icon name="user-round" tone="muted" size="{{36}}"></lucide-icon></view>
            <input
              class="field-input"
              value="{{account}}"
              type="text"
              maxlength="64"
              placeholder="学号"
              placeholder-class="field-placeholder"
              bindinput="onAccountInput"
              bindfocus="onAccountFocus"
              bindblur="onAccountBlur"
              confirm-type="next"
              aria-label="学号"
            />
          </view>

          <view class="field {{passwordFocused ? 'field--focus' : ''}}">
            <view class="field-icon"><lucide-icon name="lock-keyhole" tone="muted" size="{{36}}"></lucide-icon></view>
            <input
              class="field-input field-input--password"
              value="{{password}}"
              password="{{!passwordVisible}}"
              maxlength="255"
              placeholder="办事大厅密码"
              placeholder-class="field-placeholder"
              bindinput="onPasswordInput"
              bindfocus="onPasswordFocus"
              bindblur="onPasswordBlur"
              bindconfirm="onSubmit"
              confirm-type="done"
              aria-label="办事大厅密码"
            />
            <view class="password-toggle pressable" bindtap="togglePassword" hover-class="pressing" aria-role="button" aria-label="{{passwordVisible ? '隐藏密码' : '显示密码'}}">
              <lucide-icon name="{{passwordVisible ? 'eye-off' : 'eye'}}" tone="muted" size="{{32}}"></lucide-icon>
            </view>
          </view>

          <view class="agreement-row" bindtap="toggleAgreement" hover-class="agreement-row--pressed" aria-role="checkbox" aria-checked="{{agreementAccepted}}">
            <view class="agreement-checkbox {{agreementAccepted ? 'agreement-checkbox--checked' : ''}}">
              <lucide-icon wx:if="{{agreementAccepted}}" name="check" tone="white" size="{{24}}"></lucide-icon>
            </view>
            <text class="agreement-copy">登录即代表同意<text class="agreement-link">《用户协议》</text><text class="agreement-link">《隐私政策》</text></text>
          </view>

          <button class="login-button {{loading ? 'login-button--loading' : ''}}" form-type="submit" disabled="{{loading}}" hover-class="login-button--pressed">
            <view wx:if="{{loading}}" class="login-spinner"></view>
            <text>{{loading ? '正在进入…' : '登录'}}</text>
          </button>

          <view class="login-clawd-mark-row" aria-hidden="true">
            <image class="login-clawd-mark" src="/features/assets/login/clawd-mark.svg" mode="aspectFit" draggable="{{false}}"></image>
          </view>
        </form>
      </view>
    </view>
  </scroll-view>
</view>
