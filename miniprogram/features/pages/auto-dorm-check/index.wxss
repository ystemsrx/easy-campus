.auto-dorm-check-page {
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
}

.auto-dorm-check-content {
  padding-top: 28rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.auto-dorm-check-sections {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.auto-dorm-check-card {
  overflow: hidden;
}

.auto-dorm-check-detail-card {
  padding: 28rpx 34rpx;
}

.auto-dorm-check-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 116rpx;
  padding: 24rpx 34rpx;
}

.auto-dorm-check-copy {
  flex: 1;
  min-width: 0;
}

.auto-dorm-check-title {
  display: block;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 700;
}

.auto-dorm-check-detail-title {
  display: block;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
}

.auto-dorm-check-status-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.auto-dorm-check-status {
  display: flex;
  flex: none;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 10rpx;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
}

.auto-dorm-check-target {
  display: flex;
  flex: none;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: baseline;
  gap: 12rpx;
  white-space: nowrap;
}

.auto-dorm-check-target-label {
  color: var(--color-text-tertiary);
  font-size: 20rpx;
  font-weight: 500;
}

.auto-dorm-check-target-value {
  color: var(--color-text-secondary);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22rpx;
  font-weight: 650;
}

.auto-dorm-check-status-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.auto-dorm-check-status-dot--success {
  background: #69a25c;
}

.auto-dorm-check-status-dot--warning {
  background: #e5b86e;
}

.auto-dorm-check-status-dot--danger {
  background: #c2767a;
}

.auto-dorm-check-status-dot--muted {
  background: #b5b0a3;
}

.auto-dorm-check-location {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  margin-top: 16rpx;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
}

.auto-dorm-check-location lucide-icon {
  flex: none;
}

.auto-dorm-check-location text {
  min-width: 0;
}

.auto-dorm-check-location-empty {
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.auto-dorm-check-location-tip {
  display: block;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-separator);
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  line-height: 1.65;
}

.auto-dorm-check-package-card {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 18rpx;
  min-height: 128rpx;
  padding: 24rpx 28rpx;
  transform: scale(1);
  transition: background-color 140ms ease,
    transform 140ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 140ms ease;
}

.auto-dorm-check-package-card--pressed {
  transform: scale(0.975);
  opacity: 0.86;
}

.auto-dorm-check-package-card--opening {
  background-color: var(--color-bg-subtle);
  transform: scale(0.985);
}

.auto-dorm-check-package-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background-color: var(--color-primary-soft);
}

.auto-dorm-check-package-copy {
  flex: 1;
  min-width: 0;
}

.auto-dorm-check-package-title {
  display: block;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.3;
  white-space: nowrap;
}

.auto-dorm-check-package-balance {
  display: block;
  min-width: 0;
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.35;
}

.auto-dorm-check-package-pause {
  display: block;
  margin-top: 4rpx;
  color: var(--color-warning);
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.35;
}

.auto-dorm-check-agreement-footer {
  padding: 8rpx 4rpx 0;
}

.auto-dorm-check-agreement-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  min-height: 52rpx;
  padding: 4rpx 2rpx;
  transition: opacity 140ms ease;
}

.auto-dorm-check-agreement-row--pressed {
  opacity: 0.68;
}

.auto-dorm-check-agreement-checkbox {
  display: flex;
  flex: none;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid var(--color-text-tertiary);
  border-radius: 50%;
  background-color: var(--color-text-tertiary);
  transform: scale(1);
  transition: background-color 160ms ease,
    transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
}

.auto-dorm-check-agreement-copy {
  display: flex;
  flex: 1;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  min-width: 0;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.55;
  white-space: nowrap;
}

.auto-dorm-check-agreement-copy > text {
  display: block;
  flex: none;
  white-space: nowrap;
}

.auto-dorm-check-agreement-checkbox--checked {
  border-color: #7d8f6e;
  background-color: #7d8f6e;
  transform: scale(1.04);
}

.auto-dorm-check-agreement-row--accepted .auto-dorm-check-agreement-copy {
  color: #718562;
}

.auto-dorm-check-agreement-link {
  color: #7d8f6e;
  transition: opacity 140ms ease;
}

.auto-dorm-check-agreement-link--opening {
  opacity: 0.55;
}

.auto-dorm-check-caption {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-tertiary);
  font-size: 21rpx;
  line-height: 1.45;
  white-space: nowrap;
}

.auto-dorm-check-switch {
  position: relative;
  display: flex;
  flex: none;
  box-sizing: border-box;
  align-items: center;
  width: 88rpx;
  height: 52rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(111, 108, 99, 0.24);
  transform: scale(1);
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
}

.auto-dorm-check-switch--checked {
  background: #7d8f6e;
}

.auto-dorm-check-switch--checking {
  background: transparent;
}

.auto-dorm-check-switch--disabled {
  opacity: 0.45;
}

.auto-dorm-check-switch--pressed {
  transform: scale(0.97);
}

.auto-dorm-check-switch-thumb {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 3rpx 10rpx rgba(37, 40, 34, 0.2);
  overflow: hidden;
  transform: translateX(0);
  transition: transform 180ms cubic-bezier(0.77, 0, 0.175, 1);
}

.auto-dorm-check-switch--checked .auto-dorm-check-switch-thumb {
  transform: translateX(36rpx);
}

.auto-dorm-check-switch-spinner {
  display: block;
  flex: none;
  width: 24rpx;
  min-width: 24rpx;
  height: 24rpx;
  min-height: 24rpx;
  border-radius: 999rpx;
  animation-name: auto-dorm-check-spin;
  animation-duration: 720ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.auto-dorm-check-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 1400;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: calc(100% - 80rpx);
  min-height: 66rpx;
  padding: 0 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  color: #fff;
  background: rgba(10, 12, 16, 0.62);
  box-shadow: 0 16rpx 46rpx rgba(0, 16, 42, 0.18);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -42%) scale(0.96);
  transition: opacity 150ms cubic-bezier(0.23, 1, 0.32, 1),
    transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
}

.auto-dorm-check-toast--visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  transition-duration: 200ms;
}

.auto-dorm-check-toast text {
  font-size: 25rpx;
  font-weight: 680;
  white-space: nowrap;
}

.auto-dorm-check-error {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 34rpx;
  border-top: 1rpx solid var(--color-separator);
  color: #c0452d;
  background: #f9e7e0;
  font-size: 21rpx;
}

.theme-dark .auto-dorm-check-error {
  color: #f1aaa0;
  background: rgba(192, 69, 45, 0.14);
}

.theme-dark .auto-dorm-check-switch {
  background: rgba(255, 255, 255, 0.2);
}

.theme-dark .auto-dorm-check-switch--checked {
  background: #788a6a;
}

.theme-dark .auto-dorm-check-switch--checking {
  background: transparent;
}

.auto-dorm-check-page.theme-style-minimal .auto-dorm-check-package-icon {
  border: 0;
  border-radius: var(--radius-icon);
  background: transparent;
}

.motion-reduced .auto-dorm-check-switch,
.motion-reduced .auto-dorm-check-switch-thumb,
.motion-reduced .auto-dorm-check-toast,
.motion-reduced .auto-dorm-check-package-card,
.motion-reduced .auto-dorm-check-agreement-row,
.motion-reduced .auto-dorm-check-agreement-checkbox,
.motion-reduced .auto-dorm-check-agreement-link {
  transition-duration: 1ms;
}

.motion-reduced .auto-dorm-check-switch-spinner {
  animation-name: none;
}


.motion-reduced .auto-dorm-check-toast,
.motion-reduced .auto-dorm-check-toast--visible {
  transform: translate(-50%, -50%);
}

@keyframes auto-dorm-check-spin {
  to {
    transform: rotate(360deg);
  }
}
