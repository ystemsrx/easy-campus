.detail-content { padding-top: 20rpx; }
.detail-hero { position: relative; padding: 38rpx; overflow: hidden; border-radius: 56rpx; color: #fff; background: linear-gradient(145deg, #c98a2d, #e5b86e); box-shadow: var(--shadow-pop); }
.detail-hero--great,
.detail-hero--good { background: linear-gradient(145deg, #7d8f6e, #acbe97); }
.detail-hero--text { background: linear-gradient(145deg, #d97757, #eba97f); }
.detail-hero--muted { background: linear-gradient(145deg, #85817a, #aaa59c); }
.detail-blob { background: rgba(255, 255, 255, 0.14); }
.detail-blob--one { top: -100rpx; right: -80rpx; width: 330rpx; height: 300rpx; }
.detail-blob--two { bottom: -125rpx; left: -65rpx; width: 250rpx; height: 220rpx; background: rgba(0, 0, 0, 0.07); animation-delay: -4s; }
.detail-eyebrow { position: relative; display: block; color: rgba(255, 255, 255, 0.72); font-size: 21rpx; font-weight: 750; letter-spacing: 2rpx; }
.detail-course-name { position: relative; display: block; margin-top: 8rpx; font-size: 47rpx; font-weight: 700; line-height: 1.3; }
.detail-course-meta { position: relative; display: block; margin-top: 7rpx; color: rgba(255, 255, 255, 0.78); font-size: 22rpx; }
.detail-score-row { position: relative; display: flex; flex-direction: row; align-items: flex-end; gap: 42rpx; margin-top: 34rpx; }
.detail-score-value { display: block; max-width: 300rpx; font-size: 86rpx; font-weight: 800; line-height: 0.95; }
.detail-score-label { display: block; margin-top: 8rpx; color: rgba(255, 255, 255, 0.72); font-size: 20rpx; }
.detail-mini-stat { padding-bottom: 5rpx; }
.detail-mini-stat text:first-child { display: block; font-size: 37rpx; font-weight: 800; line-height: 1; }
.detail-mini-stat text:last-child { display: block; margin-top: 8rpx; color: rgba(255, 255, 255, 0.72); font-size: 19rpx; }

.detail-remark { display: flex; flex-direction: row; align-items: flex-start; gap: 18rpx; margin-top: 22rpx; padding: 24rpx 28rpx; border-radius: 36rpx; color: #c0452d; background: #f9e7e0; }
.detail-remark-symbol { display: flex; flex: none; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: #f9e7e0; }
.detail-remark-title { display: block; font-size: 23rpx; font-weight: 750; }
.detail-remark-value { display: block; margin-top: 3rpx; font-size: 22rpx; line-height: 1.55; }

.components-card { padding: 32rpx; }
.composition-strip { display: flex; flex-direction: row; height: 20rpx; margin-bottom: 16rpx; overflow: hidden; border-radius: 999rpx; }
.composition-segment { flex: none; background: #d97757; }
.composition-segment--great { background: #7d8f6e; }
.composition-segment--good { background: #acbe97; }
.composition-segment--warning { background: #e5b86e; }
.composition-segment--text { background: #c2767a; }
.composition-segment--muted { background: #c9c5b8; }
.component-row { padding: 24rpx 0; }
.component-row--divided { border-bottom: 1rpx solid var(--color-separator); }
.component-head { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; gap: 24rpx; }
.component-copy { display: flex; flex: 1; flex-direction: row; align-items: center; gap: 12rpx; min-width: 0; }
.component-dot { flex: none; width: 14rpx; height: 14rpx; border-radius: 50%; background: #d97757; }
.component-dot--great { background: #7d8f6e; }
.component-dot--good { background: #acbe97; }
.component-dot--warning { background: #e5b86e; }
.component-dot--text { background: #c2767a; }
.component-dot--muted { background: #c9c5b8; }
.component-name { color: var(--color-text); font-size: 25rpx; font-weight: 700; }
.component-weight { color: #b5b0a3; font-size: 19rpx; }
.component-score { flex: none; color: #b85c38; font-size: 30rpx; font-weight: 800; }
.component-score--great,
.component-score--good { color: #5f7350; }
.component-score--warning { color: #a66f1f; }
.component-score--text { color: #a55357; max-width: 170rpx; text-align: right; }
.component-score--compact { font-size: 23rpx; }
.component-score--muted { color: #9a9aa3; }
.progress-track { height: 10rpx; margin-top: 14rpx; overflow: hidden; border-radius: 999rpx; background: rgba(43, 38, 32, 0.05); }
.progress-fill { height: 100%; border-radius: 999rpx; background: #d97757; }
.progress-fill--great { background: #7d8f6e; }
.progress-fill--good { background: #acbe97; }
.progress-fill--warning { background: #e5b86e; }

.class-distribution-card { padding: 32rpx; }
.class-distribution-state { display: flex; align-items: center; justify-content: center; gap: 14rpx; min-height: 300rpx; color: var(--color-text-tertiary); font-size: 23rpx; }
.class-distribution-state--retry { flex-direction: column; }
.class-distribution-state--pressed { opacity: 0.66; }
.class-distribution-retry { color: #a66f1f; font-weight: 750; }
.class-distribution-spinner { width: 30rpx; height: 30rpx; border: 4rpx solid var(--color-separator); border-top-color: #c98a2d; border-radius: 999rpx; animation-name: class-distribution-spin; animation-duration: 800ms; animation-timing-function: linear; animation-iteration-count: infinite; }
.motion-reduced .class-distribution-spinner { animation-name: none; }
.class-distribution-chart-wrap { width: 100%; }
.class-axis-unit { display: block; height: 24rpx; color: var(--color-text-tertiary); font-size: 17rpx; font-weight: 700; line-height: 24rpx; }
.class-chart-layout { display: flex; flex-direction: row; align-items: flex-start; gap: 12rpx; width: 100%; margin-top: 12rpx; }
.class-y-axis { display: flex; flex: none; flex-direction: column; align-items: flex-end; justify-content: space-between; width: 48rpx; height: 220rpx; }
.class-axis-tick { display: flex; flex: none; align-items: center; justify-content: flex-end; width: 100%; height: 1rpx; }
.class-axis-label { color: var(--color-text-tertiary); font-size: 15rpx; line-height: 18rpx; white-space: nowrap; }
.class-chart-scroll { flex: 1; min-width: 0; height: 260rpx; }
.class-chart { position: relative; height: 260rpx; }
.class-chart-grid { position: absolute; z-index: 0; top: 0; right: 0; left: 0; display: flex; flex-direction: column; justify-content: space-between; height: 220rpx; }
.class-grid-line { flex: none; width: 100%; height: 1rpx; background-color: var(--color-separator); opacity: 0.72; }
.class-chart-columns { position: relative; z-index: 1; display: flex; flex-direction: row; align-items: flex-start; justify-content: space-around; gap: 8rpx; width: 100%; height: 260rpx; }
.class-chart-column { display: flex; flex: none; flex-direction: column; align-items: center; height: 260rpx; }
.class-chart-track { display: flex; flex: none; align-items: flex-end; width: 100%; height: 220rpx; min-height: 0; }
.class-chart-fill { width: 100%; border-radius: 9rpx 9rpx 3rpx 3rpx; background-color: #659bca; transition: height 650ms cubic-bezier(0.22, 1, 0.36, 1); }
.class-score-label { flex: none; min-height: 20rpx; margin-top: 9rpx; color: var(--color-text-tertiary); font-size: 14rpx; line-height: 20rpx; white-space: nowrap; }
.class-x-axis-title { display: block; margin-top: 4rpx; margin-left: 60rpx; color: var(--color-text-tertiary); font-size: 17rpx; font-weight: 700; text-align: center; }

@keyframes class-distribution-spin { to { transform: rotate(360deg); } }

.detail-info-card { overflow: hidden; }
.detail-info-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 32rpx; min-height: 92rpx; padding: 22rpx 34rpx; }
.detail-info-row--divided { border-bottom: 1rpx solid var(--color-separator); }
.detail-info-label { flex: none; color: var(--color-text-tertiary); font-size: 24rpx; }
.detail-info-value { flex: 1; min-width: 0; color: var(--color-text); font-size: 25rpx; font-weight: 650; text-align: right; }
