<rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}"></rate-limit-toast>
<view class="page grade-detail-page {{themeClass}} {{visualThemeClass}} {{motionClass}}">
  <scroll-view class="page-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
    <navigation-bar title="{{detailTitle}}" back="{{true}}" inset-back="{{true}}" transparent="{{true}}" theme="{{theme}}"></navigation-bar>
    <view wx:if="{{course}}" class="detail-content page-content page-enter">
      <view class="detail-hero detail-hero--{{scoreTone}}">
        <view class="ambient-blob detail-blob detail-blob--one"></view><view class="ambient-blob detail-blob detail-blob--two"></view>
        <text class="detail-eyebrow">{{course.academicYear}} · {{termLabel}} · {{course.credits === null ? '学分未提供' : creditsLabel + ' 学分'}}</text>
        <text class="detail-course-name display-title">{{course.courseName}}</text>
        <text class="detail-course-meta">{{course.courseCode}} · {{course.department || '开课单位未提供'}}</text>
        <view class="detail-score-row">
          <view><text class="detail-score-value" overflow="ellipsis" max-lines="2">{{displayScore}}</text><text class="detail-score-label">总评成绩</text></view>
          <view class="detail-mini-stat"><text>{{gradePointLabel}}</text><text>绩点</text></view>
          <view class="detail-mini-stat"><text>{{creditsLabel}}</text><text>学分</text></view>
        </view>
      </view>

      <view wx:if="{{course.gradeRemark}}" class="detail-remark"><view class="detail-remark-symbol"><lucide-icon name="circle-alert" tone="danger" size="{{29}}"></lucide-icon></view><view><text class="detail-remark-title">成绩备注</text><text class="detail-remark-value">{{course.gradeRemark}}</text></view></view>

      <block wx:if="{{showComponentsSection}}">
        <view class="section-header"><view><text class="section-title">成绩组成</text></view></view>
        <view wx:if="{{components.length}}" class="components-card card">
          <view class="composition-strip"><view wx:for="{{components}}" wx:key="name" class="composition-segment composition-segment--{{item.tone}}" style="width: {{item.width}}%;"></view></view>
          <view wx:for="{{components}}" wx:key="name" class="component-row {{index < components.length - 1 ? 'component-row--divided' : ''}}">
            <view class="component-head"><view class="component-copy"><view class="component-dot component-dot--{{item.tone}}"></view><text class="component-name">{{item.name}}</text><text class="component-weight">{{item.weight}}</text></view><text class="component-score component-score--{{item.tone}} {{item.compactScore ? 'component-score--compact' : ''}}">{{item.score}}</text></view>
            <view wx:if="{{!item.isText && item.progress > 0}}" class="progress-track"><view class="progress-fill progress-fill--{{item.tone}}" style="width: {{item.progress}}%;"></view></view>
          </view>
        </view>
        <empty-state wx:else compact icon="chart-no-axes-column-increasing" icon-tone="amber" title="暂无分项成绩" description="当前课程只提供总评成绩"></empty-state>
      </block>

      <view class="section-header class-distribution-header"><view class="class-distribution-heading"><text class="section-title">班级分布</text><text wx:if="{{classDistributionClassName}}" class="class-distribution-class-name" overflow="ellipsis" max-lines="1">（{{classDistributionClassName}}）</text></view></view>
      <view class="class-distribution-card card">
        <view wx:if="{{classDistributionStatus === 'loading'}}" class="class-distribution-state">
          <view class="class-distribution-spinner"></view>
          <text>读取中</text>
        </view>
        <view wx:elif="{{classDistributionStatus === 'ready'}}" class="class-distribution-chart-wrap">
          <text class="class-axis-unit">人数</text>
          <view class="class-chart-layout">
            <view class="class-y-axis">
              <view wx:for="{{classDistributionAxisTicks}}" wx:key="value" class="class-axis-tick"><text class="class-axis-label tnum">{{item.label}}</text></view>
            </view>
            <scroll-view class="class-chart-scroll" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
              <view class="class-chart" style="width: {{classDistributionChartWidth}}rpx;">
                <view class="class-chart-grid" aria-hidden="true">
                  <view wx:for="{{classDistributionAxisTicks}}" wx:key="value" class="class-grid-line"></view>
                </view>
                <view class="class-chart-columns">
                  <view wx:for="{{classDistributionBars}}" wx:key="score" class="class-chart-column" style="width: {{classDistributionBarWidth}}rpx;">
                    <view class="class-chart-track"><view class="class-chart-fill" style="height: {{item.height}}%;"></view></view>
                    <text class="class-score-label tnum">{{item.showScoreLabel ? item.scoreLabel : ''}}</text>
                  </view>
                </view>
              </view>
            </scroll-view>
          </view>
          <text class="class-x-axis-title">分数</text>
        </view>
        <view wx:elif="{{classDistributionStatus === 'error'}}" class="class-distribution-state class-distribution-state--retry" role="button" bindtap="retryClassDistribution" hover-class="class-distribution-state--pressed">
          <text>加载失败</text><text class="class-distribution-retry">重试</text>
        </view>
        <view wx:else class="class-distribution-state"><text>数据不足</text></view>
      </view>

      <view class="section-header"><view><text class="section-title">课程信息</text></view></view>
      <view class="detail-info-card card"><view wx:for="{{detailRows}}" wx:key="label" class="detail-info-row {{index < detailRows.length - 1 ? 'detail-info-row--divided' : ''}}"><text class="detail-info-label">{{item.label}}</text><text class="detail-info-value" overflow="ellipsis" max-lines="3">{{item.value}}</text></view></view>
    </view>
  </scroll-view>
</view>
