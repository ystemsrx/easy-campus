.exams-content { padding-top: 20rpx; }
.nav-refresh { box-sizing: border-box; display: flex; flex: none; align-items: center; justify-content: center; width: 76rpx; min-width: 76rpx; max-width: 76rpx; height: 76rpx; min-height: 76rpx; max-height: 76rpx; padding: 0; overflow: hidden; border-radius: 999rpx; color: #2b2620; background: #fff; box-shadow: 0 2rpx 4rpx rgba(20, 20, 30, 0.04), 0 14rpx 40rpx -12rpx rgba(20, 20, 30, 0.14); transition: transform 120ms ease-out, opacity 120ms ease-out; }
.nav-button-pressed { transform: scale(0.93); opacity: 0.82; }
.nav-refresh--loading { opacity: 1; }
.nav-refresh-spinner { display: block; flex: none; width: 34rpx; min-width: 34rpx; height: 34rpx; min-height: 34rpx; border-radius: 999rpx; animation-name: exam-refresh-spin; animation-duration: 720ms; animation-timing-function: linear; animation-iteration-count: infinite; }

.semester-scroll { position: relative; z-index: 2; display: block; flex: none; width: calc(100% + 80rpx); height: 96rpx; margin-left: -40rpx; }
.semester-row { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; gap: 14rpx; height: 96rpx; padding: 8rpx 40rpx 18rpx; }
.semester-chip { display: flex; flex: none; align-items: center; justify-content: center; box-sizing: border-box; height: 60rpx; padding: 0 25rpx; border-radius: 999rpx; color: #8b8b94; background: #fff; box-shadow: var(--shadow-card); font-size: 22rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.semester-chip > text { display: block; line-height: 30rpx; }
.semester-chip--active { color: #fff; background: linear-gradient(135deg, #c2767a, #dfa6a0); }

.exam-hero { position: relative; min-height: 286rpx; margin-top: 18rpx; padding: 38rpx; overflow: hidden; border-radius: 56rpx; color: #fff; background: linear-gradient(145deg, #c2767a, #dfa6a0); box-shadow: var(--shadow-pop); }
.exam-blob { background: rgba(255, 255, 255, 0.15); }
.exam-blob--one { top: -90rpx; right: -70rpx; width: 300rpx; height: 270rpx; }
.exam-blob--two { bottom: -115rpx; left: -65rpx; width: 240rpx; height: 215rpx; background: rgba(0, 0, 0, 0.06); animation-delay: -4s; }
.exam-hero-kicker { position: relative; display: block; color: rgba(255, 255, 255, 0.72); font-size: 20rpx; font-weight: 750; letter-spacing: 4rpx; }
.exam-hero-title { position: relative; display: block; max-width: 510rpx; margin-top: 12rpx; font-size: 45rpx; font-weight: 700; line-height: 1.3; }
.exam-hero-stats { position: relative; display: flex; flex-direction: row; width: 420rpx; margin-top: 24rpx; overflow: hidden; border: 1rpx solid rgba(255, 255, 255, 0.18); border-radius: 28rpx; background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px); }
.exam-hero-stat { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-width: 0; padding: 14rpx 8rpx; }
.exam-hero-stat + .exam-hero-stat { border-left: 1rpx solid rgba(255, 255, 255, 0.16); }
.exam-hero-stat-value { display: block; font-size: 31rpx; font-weight: 800; line-height: 1; white-space: nowrap; }
.exam-hero-stat-label { display: block; margin-top: 5rpx; color: rgba(255, 255, 255, 0.72); font-size: 17rpx; font-weight: 650; white-space: nowrap; }
.exam-symbol { position: absolute; right: 35rpx; bottom: 36rpx; display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 28rpx; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); }

.result-heading { display: flex; flex-direction: row; align-items: center; margin: 48rpx 2rpx 22rpx; }
.result-title { display: block; color: var(--color-text); font-size: 38rpx; font-weight: 750; }
.exam-list-viewport { width: 100%; overflow: hidden; }
.exam-list { display: flex; flex-direction: column; gap: 18rpx; }
.exam-list--from-left-a,
.exam-list--from-left-b,
.exam-list--from-right-a,
.exam-list--from-right-b { animation-duration: 320ms; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); animation-fill-mode: both; }
.exam-list--from-left-a { animation-name: exam-list-from-left-a; }
.exam-list--from-left-b { animation-name: exam-list-from-left-b; }
.exam-list--from-right-a { animation-name: exam-list-from-right-a; }
.exam-list--from-right-b { animation-name: exam-list-from-right-b; }
.exam-card { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; gap: 18rpx; width: 100%; min-height: 104rpx; padding: 24rpx; }
.exam-countdown { box-sizing: border-box; display: flex; flex: none; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 32rpx; color: #a55357; background: #f7e9e8; text-align: center; }
.exam-countdown--current,
.exam-countdown--urgent { color: #a55357; background: #f7e9e8; }
.exam-countdown--soon { color: #a86439; background: #f9eae2; }
.exam-countdown--week { color: #936a27; background: #f8eedd; }
.exam-countdown--later { color: #5f7350; background: #edf1e6; }
.exam-countdown--past { color: #a39e92; background: #efede6; }
.exam-countdown--pending { color: #8b8b94; background: #f1f1f3; }
.exam-countdown-value { display: block; max-width: 92rpx; font-size: 34rpx; font-weight: 820; line-height: 1; text-align: center; }
.exam-countdown-current { box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; width: 100%; height: 100%; padding: 19rpx 20rpx; font-size: 26rpx; font-weight: 850; line-height: 1; }
.exam-countdown-current > view { display: flex; flex-direction: row; justify-content: space-between; width: 100%; }
.exam-countdown-current text { display: block; flex: none; line-height: 1; text-align: center; }
.exam-copy { flex: 1; min-width: 0; }
.exam-name { display: block; color: var(--color-text); font-size: 27rpx; font-weight: 750; line-height: 1.38; }
.exam-course-marker { color: var(--color-text-tertiary); font-size: 19rpx; font-weight: 600; }
.exam-location { display: flex; flex-direction: row; align-items: center; gap: 8rpx; min-width: 0; margin-top: 7rpx; color: var(--color-text-tertiary); font-size: 20rpx; }
.exam-location > text { flex: 1; min-width: 0; }
.exam-schedule { display: flex; flex: none; flex-direction: column; align-items: flex-end; max-width: 170rpx; }
.exam-date-label { display: block; flex: none; color: var(--color-text); font-size: 20rpx; font-weight: 750; text-align: right; white-space: nowrap; }
.exam-time-label { display: block; flex: none; max-width: 170rpx; margin-top: 5rpx; color: var(--color-text-tertiary); font-size: 17rpx; font-weight: 650; overflow: hidden; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.exam-load-more,
.exam-end { display: block; padding: 26rpx; color: #b5b0a3; font-size: 21rpx; text-align: center; }

.exam-detail-scroll { display: block; width: 100%; height: 58vh; }
.exam-detail-content { width: 100%; }
.exam-detail-card { overflow: hidden; }
.exam-detail-row { display: flex; flex-direction: row; justify-content: space-between; gap: 30rpx; padding: 23rpx 28rpx; }
.exam-detail-row--divided { border-bottom: 1rpx solid var(--color-separator); }
.exam-detail-row text:first-child { flex: none; color: #9a9aa3; font-size: 22rpx; }
.exam-detail-row text:last-child { flex: 1; color: var(--color-text); font-size: 23rpx; font-weight: 650; text-align: right; }
.exam-note { margin-top: 20rpx; padding: 24rpx 28rpx; border-radius: 34rpx; color: #a66f1f; background: #f8eedd; }
.exam-note text:first-child { display: block; font-size: 22rpx; font-weight: 750; }
.exam-note text:last-child { display: block; margin-top: 5rpx; font-size: 22rpx; line-height: 1.6; }
.exam-detail-spacer { height: 24rpx; }

.theme-dark .nav-refresh,
.theme-dark .semester-chip { background: #2d2a24; }

.exams-page.theme-style-minimal .exam-countdown,
.exams-page.theme-style-minimal .exam-countdown--current,
.exams-page.theme-style-minimal .exam-countdown--urgent,
.exams-page.theme-style-minimal .exam-countdown--soon,
.exams-page.theme-style-minimal .exam-countdown--week,
.exams-page.theme-style-minimal .exam-countdown--later,
.exams-page.theme-style-minimal .exam-countdown--past,
.exams-page.theme-style-minimal .exam-countdown--pending {
  border: var(--border-control);
  border-color: var(--color-text);
  border-radius: var(--radius-control);
  color: var(--color-text);
  background: transparent;
}

.motion-reduced .nav-refresh-spinner { animation-name: none; }
.motion-reduced .exam-list { animation-duration: 1ms; }

@keyframes exam-refresh-spin { to { transform: rotate(360deg); } }
@keyframes exam-list-from-left-a { from { transform: translateX(-64rpx); } to { transform: translateX(0); } }
@keyframes exam-list-from-left-b { from { transform: translateX(-64rpx); } to { transform: translateX(0); } }
@keyframes exam-list-from-right-a { from { transform: translateX(64rpx); } to { transform: translateX(0); } }
@keyframes exam-list-from-right-b { from { transform: translateX(64rpx); } to { transform: translateX(0); } }
