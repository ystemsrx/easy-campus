<rate-limit-toast id="rate-limit-toast"></rate-limit-toast>
<view class="page exams-page {{themeClass}} {{motionClass}}">
  <scroll-view class="page-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="loadMore" lower-threshold="180">
    <navigation-bar title="考试安排" back extra-left transparent theme="{{theme}}">
      <view slot="after-left" class="nav-refresh pressable {{refreshing ? 'nav-refresh--loading' : ''}}" bindtap="onRefresh" hover-class="nav-button-pressed" aria-role="button" aria-label="刷新考试安排">
        <lucide-icon name="refresh-cw" tone="{{theme === 'dark' ? 'white' : 'ink'}}" size="{{30}}"></lucide-icon>
      </view>
    </navigation-bar>

    <view class="exams-content page-content page-enter">
      <scroll-view wx:if="{{semesters.length}}" class="semester-scroll" type="list" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
        <view class="semester-row">
          <view wx:for="{{semesters}}" wx:key="id" class="semester-chip pressable {{semesterId === item.id ? 'semester-chip--active' : ''}}" data-id="{{item.id}}" bindtap="selectSemesterQuick" hover-class="pressing"><text>{{item.selectorLabel}}</text></view>
        </view>
      </scroll-view>

      <view class="exam-hero stagger-item stagger-1">
        <view class="ambient-blob exam-blob exam-blob--one"></view><view class="ambient-blob exam-blob exam-blob--two"></view>
        <text class="exam-hero-kicker">EXAM SCHEDULE</text>
        <text class="exam-hero-title display-title">{{filterLabel}}</text>
        <view class="exam-hero-stats">
          <view class="exam-hero-stat"><text class="exam-hero-stat-value tnum">{{statusSummary.total}}</text><text class="exam-hero-stat-label">总数</text></view>
          <view class="exam-hero-stat"><text class="exam-hero-stat-value tnum">{{statusSummary.pending}}</text><text class="exam-hero-stat-label">待考</text></view>
          <view class="exam-hero-stat"><text class="exam-hero-stat-value tnum">{{statusSummary.past}}</text><text class="exam-hero-stat-label">已过</text></view>
        </view>
        <view class="exam-symbol"><lucide-icon name="clipboard-check" tone="white" size="{{58}}"></lucide-icon></view>
      </view>

      <view class="result-heading"><text class="result-title">考试日程</text></view>
      <loading-view wx:if="{{loading}}" label="正在读取考试安排"></loading-view>
      <view wx:elif="{{examItems.length}}" class="exam-list">
        <view wx:for="{{examItems}}" wx:key="id" class="exam-card card pressable stagger-item" style="animation-delay: {{index < 8 ? index * 45 : 0}}ms;" data-id="{{item.id}}" bindtap="openExam" hover-class="pressing">
          <view class="exam-countdown exam-countdown--{{item.countdownTone}}">
            <view wx:if="{{item.countdownTone === 'current'}}" class="exam-countdown-current" aria-label="逢考必过"><view><text>逢</text><text>考</text></view><view><text>必</text><text>过</text></view></view>
            <text wx:else class="exam-countdown-value tnum">{{item.countdownLabel}}</text>
          </view>
          <view class="exam-copy">
            <text class="exam-name" overflow="ellipsis" max-lines="2">{{item.course.name}}<text wx:if="{{item.retakeMarker}}" class="exam-course-marker">（重修）</text><text wx:if="{{item.makeupDeferredMarker}}" class="exam-course-marker">（补缓考）</text></text>
            <view class="exam-location"><lucide-icon name="map-pin" tone="muted" size="{{19}}"></lucide-icon><text overflow="ellipsis" max-lines="1">{{item.locationLabel}}</text></view>
          </view>
          <view class="exam-schedule"><text class="exam-date-label tnum">{{item.dateLabel}}</text><text class="exam-time-label tnum">{{item.timeLabel}}</text></view>
        </view>
        <view wx:if="{{loadingMore}}" class="exam-load-more"><text>正在载入更多…</text></view><text wx:elif="{{page >= totalPages}}" class="exam-end">以上是全部考试安排</text>
      </view>
      <empty-state wx:elif="{{!errorMessage}}" icon="clipboard-check" icon-tone="rose" title="本学期暂无考试" description="可切换其他学期查看"></empty-state>
      <empty-state wx:else icon="circle-alert" icon-tone="danger" title="考试信息加载失败" description="{{errorMessage}}" action-text="重新加载" bindaction="onRefresh"></empty-state>
    </view>
  </scroll-view>

  <bottom-sheet visible="{{selectedExamVisible}}" title="{{selectedExamTitle}}" theme="{{theme}}" scrollable="{{false}}" bindclose="closeExam">
    <scroll-view wx:if="{{selectedExam}}" class="exam-detail-scroll" type="custom" style="{{selectedExamDetailHeight > 0 ? 'height:' + selectedExamDetailHeight + 'px;' : ''}}" scroll-y enhanced show-scrollbar="{{false}}"><view id="exam-detail-content" class="exam-detail-content"><view class="exam-detail-card card"><view wx:for="{{selectedExam.rows}}" wx:key="label" class="exam-detail-row {{index < selectedExam.rows.length - 1 ? 'exam-detail-row--divided' : ''}}"><text>{{item.label}}</text><text overflow="ellipsis" max-lines="4">{{item.value}}</text></view></view><view wx:if="{{selectedExam.note}}" class="exam-note"><text>备注</text><text>{{selectedExam.note}}</text></view><view class="exam-detail-spacer"></view></view></scroll-view>
  </bottom-sheet>
  <refresh-confirmation id="refresh-confirmation" reduced-motion="{{motionClass === 'motion-reduced'}}"></refresh-confirmation>
</view>
