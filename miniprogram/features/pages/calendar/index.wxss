.nav-refresh {
  box-sizing: border-box;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  max-height: 76rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 999rpx;
  color: #2b2620;
  background: #fff;
  box-shadow:
    0 2rpx 4rpx rgba(20, 20, 30, 0.04),
    0 14rpx 40rpx -12rpx rgba(20, 20, 30, 0.14);
  transition:
    transform 120ms ease-out,
    opacity 120ms ease-out;
}

.nav-button-pressed {
  transform: scale(0.93);
  opacity: 0.82;
}

.nav-refresh--loading {
  opacity: 1;
}

.nav-refresh-spinner {
  display: block;
  flex: none;
  width: 34rpx;
  min-width: 34rpx;
  height: 34rpx;
  min-height: 34rpx;
  border-radius: 999rpx;
  animation-name: calendar-refresh-spin;
  animation-duration: 720ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.calendar-content {
  padding-top: 20rpx;
}

.theme-dark .nav-refresh {
  background: #2d2a24;
}

.motion-reduced .nav-refresh-spinner {
  animation-name: none;
}

@keyframes calendar-refresh-spin {
  to {
    transform: rotate(360deg);
  }
}

.calendar-hero {
  position: relative;
  min-height: 228rpx;
  padding: 38rpx;
  overflow: hidden;
  border-radius: 56rpx;
  color: #fff;
  background: linear-gradient(145deg, #7d8f6e, #acbe97);
  box-shadow: var(--shadow-pop);
}

.calendar-blob {
  background: rgba(255, 255, 255, 0.15);
}

.calendar-blob--one {
  top: -90rpx;
  right: -70rpx;
  width: 300rpx;
  height: 270rpx;
}

.calendar-blob--two {
  bottom: -115rpx;
  left: -65rpx;
  width: 240rpx;
  height: 215rpx;
  background: rgba(0, 0, 0, 0.06);
  animation-delay: -4s;
}

.calendar-kicker {
  position: relative;
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 4rpx;
}

.calendar-title {
  position: relative;
  display: block;
  max-width: 500rpx;
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.3;
}

.calendar-symbol {
  position: absolute;
  right: 35rpx;
  bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(8px);
}

.year-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 22rpx 26rpx;
}

.year-switch-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: #edf1e6;
}

.year-switch-copy {
  flex: 1;
  min-width: 0;
}

.year-switch-copy text:first-child {
  display: block;
  color: #a39e92;
  font-size: 19rpx;
}

.year-switch-copy text:last-child {
  display: block;
  margin-top: 2rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.year-switch-action {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  min-width: 88rpx;
  color: #5f7350;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

.year-switch-action text {
  flex: none;
  white-space: nowrap;
}

.calendar-image-card {
  margin-top: 24rpx;
  padding: 18rpx;
}

.image-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  min-height: 58rpx;
  padding: 0 2rpx 14rpx;
}

.image-action {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 118rpx;
  min-height: 54rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #5f7350;
  background: #edf1e6;
  font-size: 20rpx;
  font-weight: 720;
  white-space: nowrap;
}

.image-action text {
  flex: none;
  white-space: nowrap;
}

.calendar-image-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background: #f1eee6;
  transition:
    transform 140ms ease-out,
    opacity 140ms ease-out;
}

.image-pressing {
  transform: scale(0.99);
  opacity: 0.86;
}

.calendar-image {
  display: block;
  width: 100%;
}

.year-picker-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 52rpx 40rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 260ms ease;
}

.year-picker-layer--open {
  opacity: 1;
  pointer-events: auto;
}

.year-picker-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(34, 31, 27, 0.34);
  backdrop-filter: blur(5px);
}

.year-picker-menu {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 72vh;
  max-height: 720rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 42rpx;
  color: var(--color-text);
  background-color: var(--color-material-heavy);
  box-shadow: 0 42rpx 130rpx rgba(25, 23, 20, 0.28);
  opacity: 0;
  transform: translateY(24rpx) scale(0.96);
  transform-origin: center top;
  transition:
    opacity 260ms ease,
    transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  backdrop-filter: blur(26px) saturate(1.45);
}

.year-picker-layer--open .year-picker-menu {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.year-picker-header {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  padding: 0 4rpx 10rpx 12rpx;
}

.year-picker-header > text {
  font-size: 30rpx;
  font-weight: 780;
  letter-spacing: -0.5rpx;
}

.year-picker-close {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background-color: var(--color-bg-subtle);
}

.calendar-year-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.calendar-year-options {
  width: 100%;
  height: 100%;
}

.calendar-year-list {
  width: 100%;
  padding-bottom: 8rpx;
}

.calendar-year-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 82rpx;
  padding: 18rpx 24rpx;
  border-radius: 27rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  font-weight: 680;
  transition:
    transform 120ms ease-out,
    color 220ms ease,
    background-color 220ms ease;
}

.calendar-year-option > text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-year-option--active {
  color: #5f7350;
  background: #edf1e6;
  font-weight: 780;
}

.calendar-year-option--pressed {
  transform: scale(0.98);
}

.theme-dark .year-switch-icon,
.theme-dark .image-action,
.theme-dark .calendar-year-option--active {
  background: #293127;
}

.theme-dark .year-switch-action,
.theme-dark .image-action,
.theme-dark .calendar-year-option--active {
  color: #acbe97;
}

.motion-reduced .year-picker-layer,
.motion-reduced .year-picker-menu {
  transition-duration: 1ms;
}
