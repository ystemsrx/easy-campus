<rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}"></rate-limit-toast>
<view class="page calendar-page {{themeClass}} {{visualThemeClass}} {{motionClass}}">
  <scroll-view
    class="page-scroll"
    type="list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <navigation-bar title="教学日历" back extra-left transparent theme="{{theme}}">
      <view slot="after-left" class="nav-refresh pressable {{refreshing ? 'nav-refresh--loading' : ''}}" bindtap="onRefresh" hover-class="nav-button-pressed" aria-role="button" aria-label="{{refreshing ? '正在刷新教学日历' : '刷新教学日历'}}" aria-disabled="{{refreshing}}">
        <image wx:if="{{refreshing}}" class="nav-refresh-spinner" src="{{theme === 'dark' ? '/assets/icons/refresh-spinner-white.svg' : '/assets/icons/refresh-spinner-ink.svg'}}" mode="aspectFit" draggable="{{false}}"></image>
        <lucide-icon wx:else name="refresh-cw" tone="{{theme === 'dark' ? 'white' : 'ink'}}" size="{{30}}"></lucide-icon>
      </view>
    </navigation-bar>
    <view class="calendar-content page-content page-enter">
      <view class="calendar-hero stagger-item stagger-1">
        <view class="ambient-blob calendar-blob calendar-blob--one"></view>
        <view class="ambient-blob calendar-blob calendar-blob--two"></view>
        <text class="calendar-kicker">ACADEMIC CALENDAR</text>
        <text class="calendar-title display-title">{{yearLabel}}</text>
        <view class="calendar-symbol"><lucide-icon name="calendar-range" tone="white" size="{{59}}"></lucide-icon></view>
      </view>

      <view
        class="year-switch card pressable stagger-item stagger-2"
        bindtap="openYearPicker"
        hover-class="pressing"
        aria-role="button"
        aria-label="切换学年，当前 {{yearLabel}}"
      >
        <view class="year-switch-icon"><lucide-icon name="calendar-range" tone="sage" size="{{31}}"></lucide-icon></view>
        <view class="year-switch-copy"><text>当前学年</text><text>{{yearLabel}}</text></view>
        <view class="year-switch-action"><text>切换</text><lucide-icon name="chevron-right" tone="sage" size="{{23}}"></lucide-icon></view>
      </view>

      <loading-view wx:if="{{loading || imageLoading}}" label="正在下载校历"></loading-view>
      <view wx:elif="{{imagePath}}" class="calendar-image-card card stagger-item stagger-3">
        <view class="image-toolbar">
          <view class="image-action pressable" bindtap="saveImage" hover-class="pressing" aria-role="button" aria-label="保存校历到相册">
            <lucide-icon name="download" tone="sage" size="{{21}}"></lucide-icon>
            <text>保存</text>
          </view>
        </view>
        <view class="calendar-image-wrap pressable" bindtap="previewImage" hover-class="image-pressing" aria-role="button" aria-label="全屏查看 {{yearLabel}} 教学日历">
          <image
            class="calendar-image"
            src="{{imagePath}}"
            mode="widthFix"
            fade-in="{{motionClass !== 'motion-reduced'}}"
            show-menu-by-longpress
            aria-label="{{yearLabel}}教学日历"
          ></image>
        </view>
      </view>
      <empty-state wx:elif="{{errorMessage}}" icon="circle-alert" icon-tone="danger" title="校历加载失败" description="{{errorMessage}}" action-text="重新加载" bindaction="onRefresh"></empty-state>
    </view>
  </scroll-view>

  <view wx:if="{{yearPickerMounted}}" class="year-picker-layer {{yearPickerOpen ? 'year-picker-layer--open' : ''}}">
    <view class="year-picker-backdrop" catchtap="closeYearPicker"></view>
    <view class="year-picker-menu" catchtap="stopPropagation" aria-role="dialog" aria-label="选择学年">
      <view class="year-picker-header">
        <text>选择学年</text>
        <view class="year-picker-close pressable" bindtap="closeYearPicker" hover-class="pressing" aria-role="button" aria-label="关闭">
          <lucide-icon name="x" tone="muted" size="{{24}}"></lucide-icon>
        </view>
      </view>
      <view class="calendar-year-scroll">
        <scroll-view class="calendar-year-options" type="custom" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="calendar-year-list">
            <view
              wx:for="{{yearOptions}}"
              wx:key="value"
              class="calendar-year-option pressable {{academicYear === item.value ? 'calendar-year-option--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectYear"
              hover-class="calendar-year-option--pressed"
              aria-role="button"
              aria-label="切换至 {{item.label}} 学年"
            >
              <text>{{item.label}} 学年</text>
              <lucide-icon wx:if="{{academicYear === item.value}}" name="check" tone="sage" size="{{23}}"></lucide-icon>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <refresh-confirmation id="refresh-confirmation" theme="{{theme}}" visual-theme="{{visualTheme}}" reduced-motion="{{motionClass === 'motion-reduced'}}"></refresh-confirmation>
</view>
<screen-watermark></screen-watermark>
