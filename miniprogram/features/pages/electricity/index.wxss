.electricity-content { padding-top: 12rpx; }

.electricity-page empty-state { display: block; margin-top: 26rpx; }
.query-card { margin-top: 12rpx; padding: 34rpx; border-radius: 52rpx; }
.query-title { display: block; margin-bottom: 30rpx; color: var(--color-text); font-family: Georgia, "Times New Roman", "Songti SC", SimSun, serif; font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.field-label { display: block; color: var(--color-text-tertiary); font-size: 22rpx; font-weight: 750; }
.field-label--spaced { margin-top: 30rpx; }
.selector-field,
.room-field { display: flex; flex-direction: row; align-items: center; gap: 18rpx; min-height: 96rpx; margin-top: 12rpx; padding: 14rpx 20rpx; border-radius: 31rpx; background-color: var(--color-bg-subtle); }
.selector-field--disabled { opacity: 0.62; }
.field-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 21rpx; }
.field-icon--building { background: #f9eae2; }
.field-icon--room { background: #f8eedd; }
.selector-copy { flex: 1; min-width: 0; }
.selector-copy > text:first-child { display: block; color: var(--color-text); font-size: 26rpx; font-weight: 720; white-space: nowrap; }
.selector-copy > text.selector-placeholder { color: #aaa69c; font-weight: 600; }
.room-input { flex: 1; height: 68rpx; border: 0; color: var(--color-text); font-size: 30rpx; font-weight: 720; }
.room-placeholder { color: #aaa69c; font-weight: 550; }
.room-limit { flex: none; color: #aaa69c; font-size: 18rpx; }
.electricity-query-button { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12rpx; width: 100%; min-height: 94rpx; margin-top: 34rpx; border: 0; border-radius: 999rpx; color: #fff; background: linear-gradient(135deg, #c98a2d, #e5b86e); box-shadow: 0 17rpx 42rpx rgba(166, 111, 31, 0.23); font-size: 28rpx; font-weight: 750; transition: transform 140ms ease, opacity 140ms ease; }
.electricity-query-button::after { display: none; }
.electricity-query-button--disabled { opacity: 0.48; box-shadow: none; }
.electricity-query-button--pressed { transform: scale(0.97); opacity: 0.86; }
.inline-error { display: flex; flex-direction: row; align-items: flex-start; gap: 10rpx; margin-top: 18rpx; padding: 16rpx 19rpx; border-radius: 24rpx; color: var(--color-danger); background-color: var(--color-danger-soft); font-size: 20rpx; line-height: 1.45; }
.binding-cancel { width: 100%; margin-top: 12rpx; border: 0; color: var(--color-text-tertiary); background: transparent; font-size: 22rpx; }
.binding-cancel::after { display: none; }

.result-heading { flex-wrap: nowrap; margin-top: 48rpx; margin-bottom: 18rpx; }
.result-copy { flex: 1; min-width: 0; }
.result-copy .section-title { white-space: nowrap; }
.result-copy .section-caption { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-actions { display: flex; flex: none; flex-direction: row; align-items: center; gap: 10rpx; }
.result-action { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; gap: 7rpx; min-height: 58rpx; padding: 0 17rpx; border: 1rpx solid var(--color-separator); border-radius: 999rpx; color: var(--color-text-secondary); background-color: var(--color-surface); font-size: 20rpx; font-weight: 700; white-space: nowrap; }
.result-action text { white-space: nowrap; }
.result-action--icon { box-sizing: border-box; width: 58rpx; padding: 0; }
.result-action--disabled { pointer-events: none; opacity: 0.48; }
.result-refresh-spinner { width: 25rpx; height: 25rpx; border-radius: 50%; animation-name: electricity-refresh-spin; animation-duration: 850ms; animation-timing-function: linear; animation-iteration-count: infinite; }
.motion-reduced .result-refresh-spinner { animation-name: none; }
@keyframes electricity-refresh-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.service-warning { display: flex; flex-direction: row; align-items: center; gap: 10rpx; margin-bottom: 16rpx; padding: 15rpx 18rpx; border-radius: 24rpx; color: var(--color-danger); background-color: var(--color-danger-soft); font-size: 19rpx; line-height: 1.45; }
.balance-card { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: 190rpx; padding: 34rpx 36rpx; overflow: hidden; border-radius: 52rpx; color: #fff; background: linear-gradient(145deg, #7d8f6e, #acbe97); box-shadow: var(--shadow-pop); }
.balance-card--negative { background: linear-gradient(145deg, #c26757, #df9683); }
.balance-copy { flex: 1; min-width: 0; }
.balance-copy > text { display: block; color: rgba(255, 255, 255, 0.76); font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; white-space: nowrap; }
.balance-copy > view { display: flex; flex-direction: row; flex-wrap: nowrap; align-items: baseline; gap: 10rpx; margin-top: 5rpx; white-space: nowrap; }
.balance-value { flex: none; font-size: 66rpx; font-weight: 800; line-height: 1.1; letter-spacing: -2rpx; white-space: nowrap; }
.balance-unit { flex: none; font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.balance-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border: 3rpx solid rgba(255, 255, 255, 0.58); border-radius: 28rpx; background: rgba(255, 255, 255, 0.15); }
.usage-grid { display: flex; flex-direction: row; gap: 18rpx; margin-top: 18rpx; }
.usage-card { display: flex; flex: 1; flex-basis: 0; flex-direction: column; min-width: 0; min-height: 190rpx; padding: 25rpx; }
.usage-icon { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 19rpx; }
.usage-icon--power { background: #f8eedd; }
.usage-icon--fee { background: #f9eae2; }
.usage-label { display: block; margin-top: 16rpx; color: var(--color-text-tertiary); font-size: 20rpx; font-weight: 650; }
.usage-card > view:last-child { display: flex; flex-direction: row; align-items: baseline; gap: 7rpx; margin-top: 1rpx; }
.usage-value { color: var(--color-text); font-size: 39rpx; font-weight: 800; line-height: 1.2; }
.usage-unit { color: var(--color-text-secondary); font-size: 20rpx; font-weight: 650; }
.date-card { margin-top: 18rpx; padding: 6rpx 28rpx; }
.date-row { display: flex; flex-direction: row; align-items: center; gap: 20rpx; min-height: 106rpx; padding: 18rpx 0; }
.date-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 20rpx; background: #edf1e6; }
.date-icon--settled { background: #f8eedd; }
.date-row > view:last-child { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 20rpx; min-width: 0; }
.date-row > view:last-child text:first-child { color: var(--color-text-secondary); font-size: 22rpx; }
.date-row > view:last-child text:last-child { flex: none; color: var(--color-text); font-size: 25rpx; font-weight: 750; }
.date-divider { height: 1rpx; margin-left: 78rpx; background-color: var(--color-separator); }

.building-search { display: flex; flex: none; flex-direction: row; align-items: center; gap: 12rpx; min-height: 78rpx; margin: 4rpx 0 18rpx; padding: 0 22rpx; border: 0; border-radius: 28rpx; background: rgba(43, 38, 32, 0.055); box-shadow: none; transition: background-color 180ms ease, box-shadow 180ms ease; }
.building-search--focused { background: rgba(255, 255, 255, 0.92); box-shadow: 0 0 0 4rpx rgba(217, 119, 87, 0.12); }
.building-search input { flex: 1; height: 76rpx; border: 0; color: currentColor; font-size: 25rpx; }
.building-search-placeholder { color: #aaa69c; }
.building-picker-scroll { flex: 1; width: 100%; height: 0; min-height: 0; }
.building-row { display: flex; flex-direction: row; gap: 12rpx; width: 100%; margin-bottom: 12rpx; }
.building-option { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 8rpx; box-sizing: border-box; width: calc(50% - 6rpx); min-width: 0; min-height: 82rpx; padding: 15rpx 20rpx; border: 1rpx solid transparent; border-radius: 27rpx; color: var(--color-text-secondary); background: rgba(43, 38, 32, 0.04); transition: transform 120ms ease, background-color 200ms ease; }
.building-option--active { color: #b85c38; background: #f9eae2; }
.building-option--pressed { transform: scale(0.985); }
.building-option > text { flex: 1; min-width: 0; overflow: hidden; font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.building-empty { width: 100%; padding: 60rpx 20rpx; color: #aaa69c; font-size: 22rpx; text-align: center; }
.binding-limit-toast { position: fixed; top: 50%; left: 50%; z-index: 1400; display: flex; align-items: center; justify-content: center; min-width: 280rpx; min-height: 66rpx; padding: 0 32rpx; border: 1rpx solid rgba(255, 255, 255, 0.12); border-radius: 999rpx; color: #fff; background: rgba(10, 12, 16, 0.56); box-shadow: 0 16rpx 46rpx rgba(0, 16, 42, 0.18); opacity: 0; pointer-events: none; transform: translate(-50%, -50%) scale(0.9); backdrop-filter: blur(16px) saturate(1.15); transition: opacity 220ms ease, transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
.binding-limit-toast text { font-size: 25rpx; font-weight: 680; white-space: nowrap; }
.binding-limit-toast--visible { opacity: 1; transform: translate(-50%, -50%) scale(1); }
.theme-dark .building-search { background: rgba(255, 255, 255, 0.07); }
.theme-dark .building-search--focused { background: rgba(255, 255, 255, 0.1); }
.theme-dark .building-option { background: rgba(255, 255, 255, 0.055); }
.theme-dark .building-option--active { background: #3e2b23; }
.motion-reduced .binding-limit-toast { transform: translate(-50%, -50%); transition: opacity 160ms ease; }
.motion-reduced .binding-limit-toast--visible { transform: translate(-50%, -50%); }
