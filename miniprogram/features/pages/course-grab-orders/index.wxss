@import "../course-grab/index.wxss";

.grab-refund-action {
  display: flex;
  flex: none;
  justify-content: flex-end;
}
.grab-refund-action .grab-text-button {
  width: auto;
  margin: 0;
}

.nav-refresh {
  box-sizing: border-box;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  max-height: 76rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 999rpx;
  color: #2b2620;
  background: #fff;
  box-shadow:
    0 2rpx 4rpx rgba(20, 20, 30, 0.04),
    0 14rpx 40rpx -12rpx rgba(20, 20, 30, 0.14);
  transition:
    transform 120ms ease-out,
    opacity 120ms ease-out;
}
.nav-button-pressed {
  transform: scale(0.94);
  opacity: 0.86;
}
.nav-refresh-spinner {
  display: block;
  flex: none;
  width: 34rpx;
  min-width: 34rpx;
  height: 34rpx;
  min-height: 34rpx;
  border-radius: 999rpx;
  animation-name: order-refresh-spin;
  animation-duration: 720ms;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
.theme-dark .nav-refresh {
  background: #2d2a24;
}
.motion-reduced .nav-refresh-spinner {
  animation-name: none;
}
@keyframes order-refresh-spin {
  to {
    transform: rotate(360deg);
  }
}
