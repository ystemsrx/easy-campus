@import "../../../styles/floating-tabbar.wxss";
.navigation-page { display: flex; flex-direction: column; background-color: var(--color-bg); }
.editor-heading { display: flex; flex: none; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16rpx; padding: 32rpx 36rpx 26rpx; }
.editor-title { min-width: 0; color: #2b2620; font-size: 38rpx; font-weight: 700; }
.theme-dark .editor-title { color: #f7f3e9; }
.editor-reset { flex: none; padding: 16rpx 0 16rpx 16rpx; color: var(--color-text-secondary); font-size: 25rpx; white-space: nowrap; }
.selected-section { flex: none; margin: 0 36rpx; }
.editor-section-heading { display: flex; flex: none; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; color: var(--color-text); font-size: 27rpx; font-weight: 650; }
.editor-capacity { flex: none; padding: 7rpx 16rpx; border-radius: 14rpx; background-color: var(--color-bg-subtle); color: var(--color-text-secondary); font-size: 22rpx; white-space: nowrap; }
.navigation-editor { padding: 10rpx 0 18rpx; border-radius: 36rpx; }
.navigation-editor--over .tabbar-material { box-shadow: 0 10rpx 36rpx rgba(24,21,18,0.16); }
.tabbar-shell.tabbar-shell--editor { position: relative; bottom: 0; padding-bottom: 0; pointer-events: auto; }
.tabbar-shell--editor .tabbar-material { max-width: 100%; overflow: hidden; transition: width 310ms cubic-bezier(0.2,0.8,0.2,1), box-shadow 310ms cubic-bezier(0.2,0.8,0.2,1); }
.editor-nav-card { box-sizing: border-box; position: absolute; left: 10rpx; top: 10rpx; display: flex; flex-direction: row; flex-wrap: nowrap; gap: 10rpx; align-items: center; justify-content: center; height: 80rpx; border-radius: 999rpx; color: var(--tab-text); transition: transform 310ms cubic-bezier(0.2,0.8,0.2,1), width 310ms cubic-bezier(0.2,0.8,0.2,1), opacity 160ms ease; }
.editor-nav-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; }
.editor-nav-label { flex: none; color: var(--tab-text); font-size: 25rpx; font-weight: 650; line-height: 1.2; white-space: nowrap; }
.editor-tip { display: block; margin-top: 18rpx; color: var(--color-text-secondary); text-align: center; font-size: 21rpx; line-height: 32rpx; white-space: nowrap; }
.available-heading { margin: 30rpx 36rpx 18rpx; }
.editor-hint { min-width: 0; color: var(--color-text-tertiary); font-size: 21rpx; font-weight: 400; white-space: nowrap; }
.available-frame { flex: 1; min-height: 0; margin: 0 36rpx; }
.available-scroll { width: 100%; height: 100%; }
.available-track { position: relative; width: 100%; }
.editor-available-card { box-sizing: border-box; position: absolute; top: 0; left: 0; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 22rpx; width: 100%; height: 112rpx; padding: 18rpx 24rpx; border: 2rpx solid var(--color-separator); border-radius: 28rpx; transition: transform 310ms cubic-bezier(0.2,0.8,0.2,1), opacity 160ms ease; }
.editor-page-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 24rpx; background-color: var(--color-bg-subtle); }
.editor-page-copy { flex: 1; min-width: 0; }
.editor-page-name { display: block; color: var(--color-text); font-size: 27rpx; font-weight: 650; white-space: nowrap; }
.editor-page-description { display: block; margin-top: 6rpx; color: var(--color-text-tertiary); font-size: 22rpx; white-space: nowrap; }
.editor-card--source { opacity: 0.16 !important; }
.editor-card--replace { background-color: var(--color-bg-subtle); opacity: 0.35 !important; }
.editor-card--landing { opacity: 0 !important; transition: transform 310ms cubic-bezier(0.2,0.8,0.2,1), width 310ms cubic-bezier(0.2,0.8,0.2,1); }
.available-bottom-space { height: calc(104rpx + env(safe-area-inset-bottom)); }
.editor-button { display: flex; flex: 1; min-width: 0; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: center; gap: 12rpx; min-height: 92rpx; border-radius: 28rpx; font-size: 27rpx; font-weight: 650; white-space: nowrap; transition: transform 140ms ease; }
.editor-button--primary { background-color: var(--color-text); color: var(--color-bg); }
.theme-style-soft .editor-button--primary { background-color: var(--color-success); color: var(--color-on-accent); }
.theme-style-minimal .editor-button--primary { background-color: var(--color-primary); color: var(--color-on-accent); }
.editor-button--secondary { border: 2rpx solid var(--color-separator); background-color: var(--color-bg-elevated); color: var(--color-text); }
.editor-button--disabled { opacity: 0.38; }
.editor-toast { position: fixed; z-index: 1600; left: 36rpx; right: 36rpx; bottom: calc(28rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 84rpx; padding: 14rpx 28rpx; border-radius: 26rpx; background-color: var(--color-text); color: var(--color-bg); box-shadow: var(--shadow-card); font-size: 25rpx; }
.editor-undo { flex: none; padding: 14rpx 4rpx; font-weight: 700; white-space: nowrap; }
.editor-proxy { box-sizing: border-box; position: fixed; z-index: 1700; top: 0; left: 0; overflow: visible; pointer-events: none; }
.proxy-surface, .proxy-surface.card { box-sizing: border-box; position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; }
.proxy-shadow { box-shadow: 0 20rpx 55rpx rgba(24,21,18,0.16); }
.proxy-capsule-surface { background-color: var(--tab-bg); border: 2rpx solid var(--color-separator); }
.proxy-row-surface.card { border: 2rpx solid var(--color-separator); }
.proxy-icon { position: absolute; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; }
.proxy-icon-surface { position: absolute; top: 0; right: 0; bottom: 0; left: 0; border-radius: 22rpx; background-color: var(--color-bg-subtle); }
.proxy-icon lucide-icon { position: relative; z-index: 1; }
.proxy-label { position: absolute; color: var(--color-text); font-weight: 650; line-height: 36rpx; white-space: nowrap; }
.proxy-description { position: absolute; left: 118rpx; color: var(--color-text-tertiary); font-size: 22rpx; line-height: 30rpx; white-space: nowrap; }
.editor-sheet-body { padding: 4rpx 30rpx 24rpx; }
.editor-sheet-actions { display: flex; flex-direction: row; flex-wrap: nowrap; gap: 18rpx; }
.editor-order { display: flex; flex-direction: row; flex-wrap: nowrap; gap: 10rpx; margin-top: 26rpx; }
.editor-order-chip { flex: 1; min-width: 0; padding: 18rpx 2rpx; border-radius: 16rpx; background-color: var(--color-bg-subtle); color: var(--color-text-tertiary); text-align: center; font-size: 23rpx; white-space: nowrap; }
.editor-order-chip--active { color: var(--color-text); font-weight: 650; }
.editor-remove { padding: 32rpx 0; color: var(--color-danger); text-align: center; font-size: 25rpx; }
.editor-sheet-label { display: block; margin-bottom: 24rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.editor-add { margin-bottom: 30rpx; }
.editor-replace-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 16rpx; }
.editor-replace-choice { box-sizing: border-box; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; gap: 18rpx; width: calc((100% - 16rpx) / 2); min-height: 100rpx; padding: 18rpx 24rpx; border: 2rpx solid var(--color-separator); border-radius: 24rpx; color: var(--color-text); font-size: 26rpx; white-space: nowrap; }
.motion-reduced .editor-nav-card, .motion-reduced .editor-available-card, .motion-reduced .editor-proxy, .motion-reduced .proxy-icon, .motion-reduced .proxy-label, .motion-reduced .proxy-description, .motion-reduced .editor-button { transition-duration: 0ms; }
.theme-style-minimal .navigation-editor, .theme-style-minimal .nav-track, .theme-style-minimal .editor-available-card, .theme-style-minimal .editor-button, .theme-style-minimal .editor-replace-choice { border-radius: 6rpx; }
@media (max-height: 700px) {
  .editor-heading { padding-top: 12rpx; padding-bottom: 12rpx; }
  .editor-title { font-size: 34rpx; }
  .editor-section-heading { margin-bottom: 12rpx; }
  .editor-tip { margin-top: 12rpx; }
  .available-heading { margin-top: 20rpx; }
}

.proxy-layer.tabbar-shell { top: 0; bottom: auto; padding: 0; }
.motion-reduced .tabbar-shell--editor .tabbar-material { transition-duration: 0ms; }

.liquid-glass .editor-nav-card .editor-nav-label { color: var(--color-text); }
.theme-style-minimal .editor-nav-card { border-radius: 2rpx; }

.editor-proxy--capsule .proxy-label { color: var(--tab-text); }
.liquid-glass .editor-proxy--capsule .proxy-label { color: var(--color-text); }
