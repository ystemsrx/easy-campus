<rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}"></rate-limit-toast>
<view class="page detail-page {{themeClass}} {{visualThemeClass}} {{motionClass}}">
  <navigation-bar back="{{true}}" transparent="{{true}}" theme="{{theme}}">
    <view slot="center" class="detail-nav-label"><text>COURSE PROFILE</text></view>
  </navigation-bar>

  <view wx:if="{{loading && !detail}}" class="detail-state">
    <loading-view label="正在整理课程档案"></loading-view>
  </view>
  <view wx:elif="{{error && !detail}}" class="detail-state">
    <empty-state icon="circle-alert" icon-tone="danger" title="课程详情加载失败" description="{{error}}" action-text="重新加载" bindaction="retry"></empty-state>
  </view>

  <scroll-view wx:elif="{{detail}}" class="detail-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="detail-content page-enter">
      <view class="detail-heading">
        <view class="detail-meta-row"><text class="course-type course-type--{{detail.type}}">{{detail.typeLabel}}</text><text class="detail-term tnum">{{detail.termsLabel || '历史数据'}}</text></view>
        <text class="detail-kicker">{{detail.typeKicker}}</text>
        <view class="detail-title-row">
          <text class="detail-title display-title">{{detail.displayName}}</text>
          <view class="detail-favorite {{favorite ? 'detail-favorite--active' : ''}}" bindtap="toggleFavorite" hover-class="detail-favorite--pressed" aria-role="button" aria-label="{{favorite ? '取消收藏' : '收藏课程'}}">
            <image class="detail-favorite-image" src="{{favorite ? '/features/assets/course-assistant/heart-coral.svg' : '/features/assets/course-assistant/heart-muted.svg'}}" mode="aspectFit"></image>
          </view>
        </view>
        <view class="detail-course-meta"><text overflow="ellipsis" max-lines="1">{{detail.teacherLabel}}</text><view class="meta-dot"></view><text>{{detail.creditsLabel}}</text><view class="meta-dot"></view><text class="tnum">{{detail.gradeCount}} 份成绩</text></view>
        <view class="detail-rating"><view class="stars-row"><image wx:for="{{detail.stars}}" wx:for-item="star" wx:key="value" class="star-medium" src="{{star.active ? '/features/assets/course-assistant/star-coral.svg' : '/features/assets/course-assistant/star-muted.svg'}}" mode="aspectFit"></image></view><text class="detail-rating-value tnum">{{detail.ratingLabel}}</text><text class="detail-rating-note">综合星级 · 来自修读过本课的同学</text></view>
      </view>

      <view class="score-panel">
        <view class="score-panel-top">
          <view><view class="big-score-row"><text class="big-score tnum">{{detail.averageLabel}}</text><text wx:if="{{detail.averageScore !== null}}" class="big-score-unit">分</text></view><text class="score-caption">历史平均分数</text></view>
          <view class="recommendation"><text class="recommendation-value tnum">{{detail.recommendationLabel}}</text><text class="recommendation-label">学长学姐推荐度</text></view>
        </view>
        <view class="distribution-list">
          <view wx:for="{{detail.distributions}}" wx:key="label" class="distribution-row">
            <text class="distribution-label tnum">{{item.label}}</text>
            <view class="distribution-track"><view class="distribution-fill" style="width: {{item.widthLabel}};"></view></view>
            <text class="distribution-value tnum">{{item.percentage}}%</text>
          </view>
        </view>
      </view>

      <view wx:if="{{detail.historyRows.length}}" class="history-panel">
        <view class="panel-heading"><text class="panel-title display-title">近 8 学期均分走势</text><text class="panel-note">{{detail.historyRangeLabel}}</text></view>
        <view class="history-chart-layout">
          <view class="history-y-axis"><text wx:for="{{detail.historyAxisTicks}}" wx:key="label" class="history-axis-tick tnum" style="top: {{item.y}}rpx;">{{item.label}}</text></view>
          <view class="history-chart">
            <view class="history-axis-line history-axis-line--y"></view><view class="history-axis-line history-axis-line--x"></view>
            <view wx:for="{{detail.historyAxisTicks}}" wx:key="label" class="history-grid-line" style="top: {{item.y}}rpx;"></view>
            <view wx:for="{{detail.historySegments}}" wx:key="left" class="history-segment" style="left: {{item.left}}rpx; top: {{item.top}}rpx; width: {{item.width}}rpx; transform: rotate({{item.angle}}deg);"><view class="history-segment-fill"></view></view>
            <view wx:for="{{detail.historyRows}}" wx:key="label" class="history-point {{item.peak ? 'history-point--peak' : ''}}" style="left: {{item.x}}rpx; top: {{item.y}}rpx;"></view>
            <text wx:for="{{detail.historyRows}}" wx:key="label" class="history-label tnum" style="left: {{item.x}}rpx;">{{item.shortLabel}}</text>
            <text wx:for="{{detail.historyRows}}" wx:key="label" wx:if="{{item.peak}}" class="history-peak-score tnum" style="left: {{item.x}}rpx; top: {{item.scoreY}}rpx;">{{item.scoreLabel}}</text>
          </view>
        </view>
      </view>

      <view class="info-grid">
        <view class="info-cell"><text class="info-label">授课教师</text><text class="info-value" overflow="ellipsis" max-lines="2">{{detail.teacherLabel}}</text></view>
        <view class="info-cell"><text class="info-label">课程学分</text><text class="info-value">{{detail.creditsLabel}}</text></view>
      </view>

      <view wx:if="{{detail.keywords.length}}" class="impression-panel">
        <view class="panel-heading"><text class="panel-title display-title">高频印象</text><text class="panel-note">匿名想法汇总</text></view>
        <view class="impression-list"><text wx:for="{{detail.keywords}}" wx:key="text" class="review-keyword review-keyword--{{item.sentiment}}">{{item.text}} · {{item.count}}</text></view>
      </view>

      <view class="reviews-heading"><text class="reviews-title display-title">学长学姐说</text><text class="reviews-count tnum">{{detail.reviewAccess.requiresContribution ? '解锁后查看' : detail.reviewCount + ' 条公开想法'}}</text></view>
      <view wx:if="{{detail.reviewAccess.requiresContribution}}" class="thoughts-gate"><view class="thoughts-gate-icon"><lucide-icon name="lock-keyhole" tone="coral" size="34"></lucide-icon></view><text class="thoughts-gate-title display-title">发布一条想法后查看</text><text class="thoughts-gate-copy">从“我修过的课”中任选一门匿名分享，即可查看所有课程想法。</text><button class="thoughts-gate-button" bindtap="goContribute">去发布想法</button></view>
      <empty-state wx:elif="{{!detail.reviewRows.length}}" compact icon="message-circle-more" icon-tone="amber" title="暂无数据" description="修过这门课的同学可以留下第一条"></empty-state>
      <view wx:else class="review-list">
        <view wx:for="{{detail.reviewRows}}" wx:key="id" class="review-card {{item.underReview ? 'review-card--reviewing' : ''}}">
          <view class="review-head"><view class="review-avatar"><text>匿</text></view><view class="review-author"><text class="review-author-name">{{item.authorLabel}}</text><text class="review-author-term tnum">{{item.studyLabel}}</text></view><text class="review-grade tnum">{{item.scoreLabel}}</text></view>
          <view wx:if="{{item.underReview}}" class="review-moderation"><lucide-icon name="lock-keyhole" tone="danger" size="25"></lucide-icon><text>审核中，仅自己可见</text></view>
          <view class="review-rating"><view class="stars-row"><image wx:for="{{item.stars}}" wx:for-item="star" wx:key="value" class="star-small" src="{{star.active ? '/features/assets/course-assistant/star-coral.svg' : '/features/assets/course-assistant/star-muted.svg'}}" mode="aspectFit"></image></view><text class="review-rating-number tnum">{{item.rating}}.0</text></view>
          <view wx:if="{{item.keywords.length}}" class="review-keywords"><text wx:for="{{item.keywords}}" wx:key="text" class="review-keyword review-keyword--{{item.sentiment}}">{{item.text}}</text></view>
          <text class="review-body">“{{item.content}}”</text>
          <view class="review-foot"><block wx:if="{{!item.underReview}}"><view class="like-button {{item.liked ? 'like-button--active' : ''}} {{item.likePending ? 'like-button--pending' : ''}}" data-id="{{item.id}}" bindtap="toggleLike" hover-class="like-button--pressed" aria-role="button" aria-label="觉得有用"><image class="like-image" src="{{item.liked ? '/features/assets/course-assistant/thumbs-up-coral.svg' : '/features/assets/course-assistant/thumbs-up-muted.svg'}}" mode="aspectFit"></image><text class="tnum">{{item.likeCount}}</text></view><text class="review-useful">觉得有用就点个赞</text></block><text wx:if="{{item.createdLabel}}" class="review-date tnum">{{item.createdLabel}}</text></view>
        </view>
      </view>

      <view wx:if="{{detail.canReview}}" class="publish-callout"><text class="publish-callout-title display-title">你也修过这门课</text><text class="publish-callout-copy">把真实感受匿名留给后来选课的同学。</text><button class="publish-button" bindtap="goPublish">匿名发表想法</button></view>
      <view wx:elif="{{detail.ownReviewId}}" class="published-note {{detail.ownReviewUnderReview ? 'published-note--reviewing' : ''}}"><lucide-icon name="{{detail.ownReviewUnderReview ? 'lock-keyhole' : 'check'}}" tone="{{detail.ownReviewUnderReview ? 'danger' : 'sage'}}" size="28"></lucide-icon><text>{{detail.ownReviewUnderReview ? '审核中，仅自己可见' : '你已匿名分享过这门课的想法'}}</text></view>
      <view class="detail-bottom-space"></view>
    </view>
  </scroll-view>
</view>
<screen-watermark></screen-watermark>
