.detail-page {
  display: flex;
  flex-direction: column;
  --guide-paper: #f7f5ef;
  --guide-paper-2: #f0eee6;
  --guide-card: #ffffff;
  --guide-ink: #141413;
  --guide-ink-2: #4a4942;
  --guide-muted: #8a877a;
  --guide-line: #e8e5d9;
  --guide-line-soft: #efede3;
  --guide-clay: #d97757;
  --guide-clay-deep: #c15f3c;
  --guide-clay-soft: #f7e9e1;
  --guide-olive: #6e7b52;
  --guide-olive-soft: #ecefe3;
  --guide-blue: #4f75a6;
  --guide-blue-soft: #e8eef7;
  --guide-brick: #b0483a;
  --guide-brick-soft: #f5e4e0;
  background-color: var(--guide-paper);
}

.detail-page.theme-dark {
  --guide-paper: #171613;
  --guide-paper-2: #2d2a24;
  --guide-card: #23211d;
  --guide-ink: #f7f3e9;
  --guide-ink-2: #c6bdad;
  --guide-muted: #8f887c;
  --guide-line: rgba(255, 255, 255, 0.09);
  --guide-line-soft: rgba(255, 255, 255, 0.065);
  --guide-clay: #d97757;
  --guide-clay-deep: #eba97f;
  --guide-clay-soft: #3e2b23;
  --guide-olive: #acbe97;
  --guide-olive-soft: #293127;
  --guide-blue: #8fb4df;
  --guide-blue-soft: #243143;
  --guide-brick: #e78670;
  --guide-brick-soft: #40251f;
}

.detail-nav-label {
  display: flex;
  align-items: center;
  height: 100%;
}

.detail-nav-label text {
  color: #8a877a;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3.3rpx;
  white-space: nowrap;
}

.theme-dark .detail-nav-label text {
  color: #aaa296;
}

.detail-favorite {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 2rpx solid var(--guide-line);
  border-radius: 50%;
  background-color: var(--guide-card);
  transition: transform 120ms ease-out, opacity 180ms ease-out,
    background-color 180ms ease-out;
}

.detail-favorite--active {
  border-color: var(--guide-clay);
  background-color: var(--guide-clay-soft);
}

.detail-favorite--pressed {
  transform: scale(0.91);
}

.detail-favorite-image {
  width: 30rpx;
  height: 30rpx;
}

.detail-state {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 0;
  padding: 40rpx;
}

.detail-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  background-color: var(--guide-paper);
}

.detail-content {
  width: 100%;
  padding: 20rpx 42rpx 0;
}

.detail-heading {
  width: 100%;
}

.detail-meta-row,
.detail-course-meta,
.detail-rating,
.stars-row,
.score-panel-top,
.panel-heading,
.history-row,
.reviews-heading,
.review-head,
.review-rating,
.review-foot,
.published-note {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.detail-meta-row {
  justify-content: space-between;
  gap: 20rpx;
}

.course-type {
  flex: none;
  padding: 7rpx 17rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.1;
  white-space: nowrap;
}

.course-type--general_elective {
  color: var(--guide-clay-deep);
  background-color: var(--guide-clay-soft);
}

.course-type--physical_education {
  color: var(--guide-olive);
  background-color: var(--guide-olive-soft);
}

.detail-term {
  flex: none;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 19rpx;
  white-space: nowrap;
}

.detail-kicker {
  display: block;
  margin-top: 34rpx;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3.1rpx;
}

.detail-title {
  display: block;
  flex: 1;
  min-width: 0;
  color: var(--guide-ink);
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.27;
  letter-spacing: -2rpx;
}

.detail-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
}

.detail-course-meta {
  flex-wrap: nowrap;
  gap: 13rpx;
  margin-top: 22rpx;
  color: var(--guide-ink-2);
  font-size: 22rpx;
}

.detail-course-meta text {
  flex: none;
  white-space: nowrap;
}

.detail-course-meta text:first-child {
  flex: 1;
  min-width: 0;
}

.meta-dot {
  flex: none;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: var(--guide-muted);
}

.detail-rating {
  flex-wrap: nowrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.stars-row {
  flex: none;
  gap: 5rpx;
}

.star-medium {
  flex: none;
  width: 31rpx;
  height: 31rpx;
}

.star-small {
  flex: none;
  width: 24rpx;
  height: 24rpx;
}

.detail-rating-value {
  flex: none;
  color: var(--guide-clay-deep);
  font-family: Georgia, "Times New Roman", "Songti SC", SimSun, serif;
  font-size: 31rpx;
  font-weight: 700;
}

.detail-rating-note {
  flex: 1;
  min-width: 0;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
  line-height: 1.35;
}

.score-panel,
.history-panel,
.impression-panel {
  width: 100%;
  margin-top: 36rpx;
  border: 2rpx solid var(--guide-line);
  border-radius: 40rpx;
  background-color: var(--guide-card);
}

.score-panel {
  padding: 43rpx 38rpx 39rpx;
}

.score-panel-top {
  align-items: flex-end;
  justify-content: space-between;
  gap: 30rpx;
}

.big-score-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: nowrap;
}

.big-score {
  color: var(--guide-clay-deep);
  font-family: Georgia, "Times New Roman", "Songti SC", SimSun, serif;
  font-size: 105rpx;
  font-weight: 900;
  line-height: 0.92;
  letter-spacing: -5rpx;
  white-space: nowrap;
}

.big-score-unit {
  flex: none;
  margin-left: 11rpx;
  color: var(--guide-muted);
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.score-caption {
  display: block;
  margin-top: 15rpx;
  color: var(--guide-muted);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.recommendation {
  flex: none;
  padding-bottom: 5rpx;
  text-align: right;
}

.recommendation-value {
  display: block;
  color: var(--guide-ink);
  font-family: Georgia, "Times New Roman", "Songti SC", SimSun, serif;
  font-size: 43rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.recommendation-label {
  display: block;
  margin-top: 9rpx;
  color: var(--guide-muted);
  font-size: 19rpx;
  white-space: nowrap;
}

.distribution-list {
  margin-top: 34rpx;
}

.distribution-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
}

.distribution-label {
  flex: none;
  width: 75rpx;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
  white-space: nowrap;
}

.distribution-track {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  border-radius: 999rpx;
  background-color: var(--guide-paper-2);
}

.distribution-track {
  height: 14rpx;
  background-color: var(--guide-blue-soft);
}

.distribution-fill {
  height: 100%;
  border-radius: 999rpx;
  background-color: var(--guide-blue);
  transition: width 650ms cubic-bezier(0.22, 1, 0.36, 1);
}

.distribution-value {
  flex: none;
  width: 66rpx;
  color: var(--guide-ink-2);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
  text-align: right;
  white-space: nowrap;
}

.history-panel,
.impression-panel {
  padding: 34rpx 38rpx;
}

.panel-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  color: var(--guide-ink);
  font-size: 30rpx;
  font-weight: 750;
}

.panel-note {
  flex: none;
  max-width: 340rpx;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 17rpx;
  text-align: right;
}

.history-chart-layout {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  margin-top: 28rpx;
}

.history-y-axis {
  position: relative;
  flex: none;
  width: 54rpx;
  height: 180rpx;
}

.history-axis-tick {
  position: absolute;
  right: 0;
  width: 100%;
  margin-top: -9rpx;
  color: var(--guide-muted);
  font-size: 15rpx;
  line-height: 20rpx;
  text-align: right;
  white-space: nowrap;
}

.history-chart {
  position: relative;
  flex: none;
  width: 500rpx;
  height: 216rpx;
}

.history-grid-line {
  position: absolute;
  right: 0;
  left: 0;
  height: 1rpx;
  background-color: var(--guide-line);
  opacity: 0.72;
}

.history-axis-line {
  position: absolute;
  z-index: 1;
  background-color: var(--guide-muted);
  opacity: 0.58;
}

.history-axis-line--y {
  top: 0;
  bottom: 36rpx;
  left: 0;
  width: 1rpx;
}

.history-axis-line--x {
  right: 0;
  bottom: 36rpx;
  left: 0;
  height: 1rpx;
}

.history-segment {
  position: absolute;
  z-index: 1;
  height: 4rpx;
  transform-origin: left center;
}

.history-segment-fill {
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background-color: var(--guide-clay-deep);
}

.history-point {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border: 3rpx solid var(--guide-clay-deep);
  border-radius: 50%;
  background-color: var(--guide-card);
}

.history-point--peak {
  width: 16rpx;
  height: 16rpx;
  margin: -8rpx 0 0 -8rpx;
  background-color: var(--guide-clay-deep);
  box-shadow: 0 0 0 7rpx var(--guide-clay-soft);
}

.history-label,
.history-peak-score {
  position: absolute;
  z-index: 3;
  width: 64rpx;
  margin-left: -32rpx;
  text-align: center;
  white-space: nowrap;
}

.history-label {
  top: 189rpx;
  color: var(--guide-muted);
  font-size: 16rpx;
}

.history-peak-score {
  color: var(--guide-clay-deep);
  font-size: 20rpx;
  font-weight: 700;
}

.info-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  margin-top: 30rpx;
}

.info-cell {
  display: flex;
  flex: none;
  flex-direction: column;
  justify-content: center;
  width: calc(50% - 8rpx);
  min-height: 124rpx;
  padding: 24rpx 27rpx;
  border: 2rpx solid var(--guide-line);
  border-radius: 29rpx;
  background-color: var(--guide-card);
}

.info-cell--wide {
  width: 100%;
}

.info-label {
  display: block;
  color: var(--guide-muted);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.info-value {
  display: block;
  margin-top: 8rpx;
  color: var(--guide-ink);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.42;
}

.impression-list,
.review-keywords {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
}

.impression-list {
  margin-top: 24rpx;
}

.review-keyword {
  flex: none;
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 550;
  white-space: nowrap;
}

.review-keyword--positive {
  color: var(--guide-olive);
  background-color: var(--guide-olive-soft);
}

.review-keyword--neutral {
  color: var(--guide-blue);
  background-color: var(--guide-blue-soft);
}

.review-keyword--negative {
  color: var(--guide-brick);
  background-color: var(--guide-brick-soft);
}

.reviews-heading {
  align-items: baseline;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 50rpx;
}

.reviews-title {
  color: var(--guide-ink);
  font-size: 38rpx;
  font-weight: 750;
}

.reviews-count {
  flex: none;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 17rpx;
}

.thoughts-gate {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 38rpx 32rpx 32rpx;
  border: 2rpx solid rgba(217, 119, 87, 0.2);
  border-radius: 32rpx;
  background-color: var(--guide-clay-soft);
  text-align: center;
}

.thoughts-gate-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  background-color: var(--guide-card);
}

.thoughts-gate-title {
  margin-top: 18rpx;
  color: var(--guide-ink);
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.35;
}

.thoughts-gate-copy {
  max-width: 500rpx;
  margin-top: 9rpx;
  color: var(--guide-muted);
  font-size: 21rpx;
  line-height: 1.65;
}

.thoughts-gate-button {
  min-width: 230rpx;
  min-height: 74rpx;
  margin: 24rpx 0 0;
  padding: 14rpx 30rpx;
  border: 0;
  border-radius: 999rpx;
  color: #fffaf6;
  background-color: var(--guide-clay);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.thoughts-gate-button::after {
  display: none;
}

.review-list {
  margin-top: 12rpx;
}

.review-card {
  padding: 30rpx 0 32rpx;
  border-bottom: 2rpx solid var(--guide-line-soft);
}

.review-head {
  gap: 17rpx;
}

.review-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  color: #fff;
  background-color: var(--guide-clay);
}

.review-avatar text {
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
}

.review-author {
  flex: 1;
  min-width: 0;
}

.review-author-name {
  display: block;
  color: var(--guide-ink);
  font-size: 23rpx;
  font-weight: 650;
}

.review-author-term {
  display: block;
  margin-top: 3rpx;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 17rpx;
}

.review-grade {
  flex: none;
  padding: 6rpx 15rpx;
  border-radius: 9rpx;
  color: var(--guide-olive);
  background-color: var(--guide-olive-soft);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 17rpx;
  white-space: nowrap;
}

.review-rating {
  gap: 14rpx;
  margin-top: 20rpx;
}

.review-rating-number {
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 17rpx;
}

.review-keywords {
  margin-top: 17rpx;
}

.review-body {
  display: block;
  margin-top: 19rpx;
  color: var(--guide-ink-2);
  font-size: 25rpx;
  line-height: 1.82;
}

.review-foot {
  gap: 16rpx;
  margin-top: 19rpx;
}

.like-button {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  gap: 9rpx;
  min-width: 60rpx;
  color: var(--guide-muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 19rpx;
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

.like-button--active {
  color: var(--guide-clay-deep);
}

.like-button--pending {
  opacity: 0.45;
}

.like-button--pressed {
  transform: scale(0.92);
}

.like-image {
  width: 27rpx;
  height: 27rpx;
}

.review-useful,
.review-date {
  color: var(--guide-muted);
  font-size: 18rpx;
}

.review-date {
  flex: none;
  margin-left: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  white-space: nowrap;
}

.publish-callout {
  margin-top: 42rpx;
  padding: 37rpx;
  border-radius: 38rpx;
  background-color: var(--guide-ink);
}

.publish-callout-title {
  display: block;
  color: var(--guide-paper);
  font-size: 34rpx;
  font-weight: 750;
}

.publish-callout-copy {
  display: block;
  margin-top: 9rpx;
  color: var(--guide-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.publish-button {
  width: 100%;
  height: 91rpx;
  margin-top: 27rpx;
  border: none;
  border-radius: 26rpx;
  color: #fff8f2;
  background-color: var(--guide-clay);
  font-family: Georgia, "Times New Roman", "Songti SC", SimSun, serif;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 91rpx;
  letter-spacing: 2rpx;
}

.published-note {
  justify-content: center;
  gap: 12rpx;
  margin-top: 38rpx;
  padding: 25rpx;
  border-radius: 26rpx;
  color: var(--guide-olive);
  background-color: var(--guide-olive-soft); 
  font-size: 21rpx;
}

.detail-bottom-space {
  width: 100%;
  height: calc(84rpx + env(safe-area-inset-bottom));
}

.motion-reduced .distribution-fill,
.motion-reduced .detail-favorite,
.motion-reduced .like-button {
  transition: none;
}

@media (max-width: 350px) {
  .detail-content {
    padding-right: 30rpx;
    padding-left: 30rpx;
  }

  .detail-title {
    font-size: 52rpx;
  }

  .big-score {
    font-size: 92rpx;
  }

  .score-panel {
    padding-right: 29rpx;
    padding-left: 29rpx;
  }

  .recommendation-value {
    font-size: 38rpx;
  }

  .review-useful {
    display: none;
  }
}
