<import src="./publish-content.wxml"/>
<import src="./browse-content.wxml"/>
<rate-limit-toast id="rate-limit-toast" theme="{{theme}}" visual-theme="{{visualTheme}}" reduced-motion="{{motionClass === 'motion-reduced'}}"></rate-limit-toast>
<view class="page page--quick-entry assistant-page {{themeClass}} {{visualThemeClass}} {{motionClass}} {{liquidGlassClass}}">
  <navigation-bar back="{{true}}" transparent="{{true}}" theme="{{theme}}"></navigation-bar>

  <view wx:if="{{statusLoading}}" class="assistant-state page-content">
    <loading-view label="正在打开选课助手" reduced-motion="{{motionClass === 'motion-reduced'}}"></loading-view>
  </view>

  <view wx:elif="{{statusError}}" class="assistant-state page-content">
    <empty-state icon="circle-alert" icon-tone="danger" title="选课助手加载失败" description="{{statusError}}" action-text="重新加载" bindaction="retryStatus"></empty-state>
  </view>

  <view wx:else class="assistant-shell">
    <scroll-view id="capsule-scroll-source" wx:if="{{activeTab === 'browse'}}" class="assistant-scroll" data-tab="browse" scroll-top="{{browseScrollTop}}" type="list" scroll-y enhanced show-scrollbar="{{false}}" lower-threshold="160" bindscroll="onCourseScroll" worklet:onscrollupdate="onGlassBackdropScroll" bindscrolltolower="loadMoreCatalog">
      <template is="course-browse-content" data="{{catalogError:catalogError,catalogLoading:catalogLoading,catalogLoadingMore:catalogLoadingMore,catalogSortLabel:catalogSortLabel,courseType:courseType,courses:courses,favoritesError:favoritesError,favoritesLoading:favoritesLoading,favoritesOnly:favoritesOnly,filterOpen:filterOpen,filterPanelHeight:filterPanelHeight,liquidGlass:liquidGlass,motionClass:motionClass,positiveFilterKeywords:positiveFilterKeywords,reviewAccess:reviewAccess,searchQuery:searchQuery,selectedKeyword:selectedKeyword,selectorDragIndex:selectorDragIndex,selectorDragStyle:selectorDragStyle,selectorDragging:selectorDragging,sortMenuOpen:sortMenuOpen,summary:summary,capsuleReplica:false}}"/>
    </scroll-view>

    <scroll-view id="capsule-scroll-source" wx:else class="assistant-scroll" data-tab="publish" scroll-top="{{publishScrollTop}}" type="list" scroll-y enhanced show-scrollbar="{{false}}" bindscroll="onCourseScroll" worklet:onscrollupdate="onGlassBackdropScroll">
      <template is="course-publish-content" data="{{demoAccount:demoAccount,mineError:mineError,mineLoading:mineLoading,motionClass:motionClass,myReviews:myReviews,takenCourses:takenCourses,capsuleReplica:false}}"/>
    </scroll-view>

    <view wx:if="{{!reviewVisible}}" class="tabbar-shell assistant-tabbar {{themeClass}} {{visualThemeClass}} {{motionClass}} {{liquidGlassClass}}">
      <view class="tabbar-material" bindtouchstart="onBottomSelectorTouchStart" catchtouchmove="onBottomSelectorTouchMove" bindtouchend="onBottomSelectorTouchEnd" bindtouchcancel="onBottomSelectorTouchCancel">
        <capsule-rim-anchor class="tabbar-optics" enabled="{{liquidGlass}}" source="course-assistant"/>
        <view class="tabbar-indicator tabbar-indicator--{{activeTab === 'publish' ? 1 : 0}} {{bottomSelector.selectorDragging ? 'glass-selector--dragging' : ''}}" style="{{bottomSelector.selectorDragStyle}}"></view>
        <view class="tabbar-item {{(bottomSelector.selectorDragging ? bottomSelector.selectorDragIndex === 0 : activeTab === 'browse') ? 'tabbar-item--active' : ''}}" data-tab="browse" bindtap="onBottomTabTap" hover-class="tabbar-item--pressed" aria-role="tab" aria-selected="{{activeTab === 'browse'}}">
          <lucide-icon name="search" tone="{{liquidGlass ? (themeClass === 'theme-dark' ? 'white' : 'ink') : (bottomSelector.selectorDragging ? bottomSelector.selectorDragIndex === 0 : activeTab === 'browse') ? 'white' : 'muted'}}" size="36"></lucide-icon><text class="tabbar-label">浏览课程</text>
        </view>
        <view class="tabbar-item {{(bottomSelector.selectorDragging ? bottomSelector.selectorDragIndex === 1 : activeTab === 'publish') ? 'tabbar-item--active' : ''}}" data-tab="publish" bindtap="onBottomTabTap" hover-class="tabbar-item--pressed" aria-role="tab" aria-selected="{{activeTab === 'publish'}}">
          <image class="tab-pen" src="{{liquidGlass ? (themeClass === 'theme-dark' ? '/features/assets/course-assistant/pen-line-white.svg' : '/features/assets/course-assistant/pen-line-ink.svg') : (bottomSelector.selectorDragging ? bottomSelector.selectorDragIndex === 1 : activeTab === 'publish') ? '/features/assets/course-assistant/pen-line-white.svg' : '/features/assets/course-assistant/pen-line-muted.svg'}}" mode="aspectFit"></image><text class="tabbar-label">发布想法</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{sortMenuMounted}}" class="course-sort-layer {{sortMenuOpen ? 'course-sort-layer--open' : ''}}" catchtouchmove="noop">
    <view class="course-sort-dismiss" catchtap="closeSortMenu"></view>
    <view class="course-sort-popover" style="top: {{sortMenuTop}}px; right: {{sortMenuRight}}px;" catchtap="noop"><view class="course-sort-option {{catalogSort === 'average_score' ? 'course-sort-option--active' : ''}}" data-sort="average_score" catchtap="selectCatalogSort" hover-class="none"><view class="course-sort-option-copy"><text class="course-sort-option-title">历史均分</text><text class="course-sort-option-note">从高到低</text></view><lucide-icon wx:if="{{catalogSort === 'average_score'}}" name="check" tone="coral" size="23"></lucide-icon></view><view class="course-sort-option {{catalogSort === 'rating' ? 'course-sort-option--active' : ''}} {{reviewAccess.ownReviewCount === 0 ? 'course-sort-option--locked' : ''}}" data-sort="rating" catchtap="selectCatalogSort" hover-class="none"><view class="course-sort-option-copy"><text class="course-sort-option-title">学生评价</text><text class="course-sort-option-note">从高到低</text></view><lucide-icon wx:if="{{reviewAccess.ownReviewCount === 0}}" name="lock-keyhole" tone="muted" size="22"></lucide-icon><lucide-icon wx:elif="{{catalogSort === 'rating'}}" name="check" tone="coral" size="23"></lucide-icon></view></view>
  </view>

  <bottom-sheet visible="{{reviewVisible}}" scrollable="{{false}}" title="{{selectedGrade ? selectedGrade.displayName : '发表课程想法'}}" theme="{{theme}}" expanded="{{true}}" expanded-height="86" safe-area="{{false}}" close-on-mask="{{!reviewSubmitting}}" bindclose="closeReview" reduced-motion="{{motionClass === 'motion-reduced'}}">
    <view slot="subtitle" class="review-sheet-subtitle"><text wx:if="{{selectedGrade}}" class="course-type course-type--{{selectedGrade.type}}">{{selectedGrade.typeLabel}}</text><text wx:if="{{selectedGrade}}" class="review-sheet-meta">{{selectedGrade.termLabel}} · 成绩 {{selectedGrade.scoreLabel}}</text></view>
    <view class="review-scroll-shell">
    <scroll-view class="review-scroll" type="list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="review-form">
      <view class="review-block"><view class="review-label"><text class="review-label-title display-title">总体评分 <text class="required-mark">*</text></text><text class="review-label-note">5 星制</text></view><view class="rating-stars"><view wx:for="{{ratingStars}}" wx:key="value" class="rating-star-button" data-rating="{{item.value}}" bindtap="selectRating"><image class="rating-star" src="{{item.active ? '/features/assets/course-assistant/star-coral.svg' : '/features/assets/course-assistant/star-muted.svg'}}" mode="aspectFit"></image></view></view><text class="rating-hint">{{ratingHint}}</text></view>
      <view class="review-block"><view class="review-label"><text class="review-label-title display-title">印象关键词 <text wx:if="{{demoAccount}}" class="required-mark">*</text></text><text class="review-label-note">{{demoAccount ? '选 1～5 个' : '可多选 · 最多 5 个'}}</text></view>
        <view class="keyword-group"><view class="keyword-group-head"><view class="keyword-dot keyword-dot--positive"></view><text>正向 · 想安利</text></view><view class="keyword-row"><view wx:for="{{keywordOptions}}" wx:key="text" wx:if="{{item.sentiment === 'positive'}}" class="keyword-option keyword-option--positive {{item.active ? 'keyword-option--active' : ''}}" data-keyword="{{item.text}}" bindtap="toggleReviewKeyword"><text>{{item.text}}</text></view></view></view>
        <view class="keyword-group"><view class="keyword-group-head"><view class="keyword-dot keyword-dot--neutral"></view><text>中性 · 看个人</text></view><view class="keyword-row"><view wx:for="{{keywordOptions}}" wx:key="text" wx:if="{{item.sentiment === 'neutral'}}" class="keyword-option keyword-option--neutral {{item.active ? 'keyword-option--active' : ''}}" data-keyword="{{item.text}}" bindtap="toggleReviewKeyword"><text>{{item.text}}</text></view></view></view>
        <view class="keyword-group"><view class="keyword-group-head"><view class="keyword-dot keyword-dot--negative"></view><text>负向 · 提个醒</text></view><view class="keyword-row"><view wx:for="{{keywordOptions}}" wx:key="text" wx:if="{{item.sentiment === 'negative'}}" class="keyword-option keyword-option--negative {{item.active ? 'keyword-option--active' : ''}}" data-keyword="{{item.text}}" bindtap="toggleReviewKeyword"><text>{{item.text}}</text></view></view></view>
      </view>
      <view wx:if="{{!demoAccount}}" class="review-block"><view class="review-label"><text class="review-label-title display-title">真心话 <text class="required-mark">*</text></text><text class="review-label-note">至少 8 个字</text></view><textarea class="review-textarea" disabled="{{reviewSubmitting}}" cursor-spacing="24" value="{{reviewText}}" maxlength="200" placeholder="例：期末考核是开卷论文，老师不考勤但内容很值得听……" placeholder-class="review-placeholder" auto-height="{{false}}" bindinput="onReviewTextInput"></textarea><text class="character-count tnum">{{reviewCharacterCount}}/200</text></view>
    </view>
    <view class="review-scroll-bottom"></view>
    </scroll-view>
    </view>
    <view slot="footer" class="review-footer">
    <button class="review-submit {{!reviewCanSubmit || reviewSubmitting ? 'review-submit--disabled' : ''}}" disabled="{{!reviewCanSubmit || reviewSubmitting}}" loading="{{reviewSubmitting}}" bindtap="submitReview">匿名发布</button>
    </view>
  </bottom-sheet>


  <include src="./live-glass.wxml"/>
</view>
<screen-watermark></screen-watermark>
