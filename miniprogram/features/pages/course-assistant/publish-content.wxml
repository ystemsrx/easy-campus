<template name="course-publish-content">
<view class="assistant-content publish-content">
  <view class="masthead">
    <view class="masthead-meta"><text class="kicker">WRITE A REVIEW</text><text class="semester-badge">匿名发布</text></view>
    <text class="masthead-title display-title">写想法<text class="title-dot">。</text></text>
    <text class="masthead-subtitle">只选择你修过的课。你的只言片语，会成为后来者的路标。</text>
  </view>

  <view class="course-section-head publish-section-head"><text class="course-section-title display-title">我修过的课</text><text class="course-section-note">{{takenCourses.length}} 门</text></view>
  <loading-view wx:if="{{mineLoading && !takenCourses.length}}" label="正在整理可评价课程" reduced-motion="{{motionClass === 'motion-reduced'}}"></loading-view>
  <empty-state wx:elif="{{mineError && !takenCourses.length}}" icon="circle-alert" icon-tone="danger" title="课程加载失败" description="{{mineError}}" action-text="重新加载" bindaction="retryMine"></empty-state>
  <empty-state wx:elif="{{!takenCourses.length}}" icon="book-open" icon-tone="amber" title="暂无可评价课程" description="仅通识选修课和体育课会显示在这里"></empty-state>
  <view wx:else class="taken-list">
    <block wx:for="{{takenCourses}}" wx:key="courseKey"><view class="taken-item {{item.reviewUnderReview ? 'taken-item--reviewing' : (item.reviewed ? 'taken-item--done' : '')}}" data-key="{{item.courseKey}}" bindtouchstart="onCourseTouchStart" bindtouchmove="onCourseTouchMove" bindtouchend="onCourseTouchEnd" bindtouchcancel="onCourseTouchCancel" bindtap="openReview" hover-class="{{item.reviewed ? '' : 'taken-item--pressed'}}">
      <view class="taken-copy"><view class="taken-name-row"><text class="taken-name" overflow="ellipsis" max-lines="1">{{item.displayName}}</text><text wx:if="{{item.reviewed}}" class="done-badge {{item.reviewUnderReview ? 'done-badge--reviewing' : ''}}">{{item.reviewUnderReview ? '审核中' : '已发布'}}</text></view><text class="taken-meta tnum">{{item.metaLabel}}</text></view>
      <lucide-icon name="{{item.reviewUnderReview ? 'lock-keyhole' : (item.reviewed ? 'check' : 'chevron-right')}}" tone="{{item.reviewUnderReview ? 'danger' : (item.reviewed ? 'sage' : 'muted')}}" size="27"></lucide-icon>
    </view></block>
  </view>

  <block wx:if="{{myReviews.length}}">
    <view class="course-section-head my-reviews-head"><text class="course-section-title display-title">我发布过的想法</text><text class="course-section-note">已匿名</text></view>
    <view class="my-review-list">
    <block wx:for="{{myReviews}}" wx:key="id"><view class="my-review-card {{item.underReview ? 'my-review-card--reviewing' : ''}}" data-key="{{item.courseKey}}" bindtouchstart="onCourseTouchStart" bindtouchmove="onCourseTouchMove" bindtouchend="onCourseTouchEnd" bindtouchcancel="onCourseTouchCancel" bindtap="openCourse">
        <text class="my-review-name">{{item.displayName || '课程想法'}}</text>
        <view wx:if="{{item.underReview}}" class="my-review-moderation"><lucide-icon name="lock-keyhole" tone="danger" size="25"></lucide-icon><text>审核中，仅自己可见</text></view>
        <view class="my-review-meta"><view class="stars-row"><image wx:for="{{item.stars}}" wx:for-item="star" wx:key="value" class="star-small" src="{{star.active ? '/features/assets/course-assistant/star-coral.svg' : '/features/assets/course-assistant/star-muted.svg'}}" mode="aspectFit"></image></view><text wx:for="{{item.visibleKeywords}}" wx:key="text" class="review-keyword review-keyword--{{item.sentiment}}">{{item.text}}</text><text wx:if="{{item.remainingKeywordCount}}" class="review-keyword review-keyword--more">+{{item.remainingKeywordCount}}</text></view>
        <text wx:if="{{!demoAccount && item.content}}" class="my-review-body" max-lines="3">“{{item.content}}”</text>
      </view></block>
    </view>
  </block>
  <view class="assistant-bottom-space"></view>
</view>
</template>
