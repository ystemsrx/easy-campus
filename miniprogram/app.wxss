page,
view,
scroll-view,
swiper,
swiper-item,
text,
button,
input,
picker,
image,
rich-text {
  box-sizing: border-box;
}

page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #16161a;
  background: #f7f5ef;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  --color-bg: #f7f5ef;
  --color-bg-elevated: #ffffff;
  --color-bg-subtle: #f1eee6;
  --color-material: rgba(255, 255, 255, 0.76);
  --color-material-heavy: rgba(255, 255, 255, 0.94);
  --color-text: #16161a;
  --color-text-secondary: #6b6558;
  --color-text-tertiary: #9a9aa3;
  --color-separator: rgba(43, 38, 32, 0.065);
  --color-primary: #b85c38;
  --color-primary-soft: #f9eae2;
  --color-success: #5f7350;
  --color-success-soft: #edf1e6;
  --color-warning: #a66f1f;
  --color-warning-soft: #f8eedd;
  --color-danger: #c0452d;
  --color-danger-soft: #f9e7e0;
  --world-coral-from: #d97757;
  --world-coral-to: #eba97f;
  --world-amber-from: #c98a2d;
  --world-amber-to: #e5b86e;
  --world-sage-from: #7d8f6e;
  --world-sage-to: #acbe97;
  --world-rose-from: #c2767a;
  --world-rose-to: #dfa6a0;
  --shadow-card: 0 2rpx 4rpx rgba(20, 20, 30, 0.035),
    0 20rpx 64rpx -16rpx rgba(20, 20, 30, 0.11);
  --shadow-pop: 0 8rpx 24rpx rgba(20, 20, 30, 0.08),
    0 40rpx 108rpx -24rpx rgba(20, 20, 30, 0.22);

  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--color-text);
  background-color: var(--color-bg);
  transition: color 220ms ease, background-color 280ms ease;
}

.page.theme-dark {
  --color-bg: #171613;
  --color-bg-elevated: #23211d;
  --color-bg-subtle: #2d2a24;
  --color-material: rgba(35, 33, 29, 0.86);
  --color-material-heavy: rgba(35, 33, 29, 0.96);
  --color-text: #f7f3e9;
  --color-text-secondary: #c6bdad;
  --color-text-tertiary: #8f887c;
  --color-separator: rgba(255, 255, 255, 0.075);
  --color-primary: #eba97f;
  --color-primary-soft: #3e2b23;
  --color-success: #acbe97;
  --color-success-soft: #293127;
  --color-warning: #e5b86e;
  --color-warning-soft: #3a3020;
  --color-danger: #e78670;
  --color-danger-soft: #40251f;
  --shadow-card: 0 18rpx 56rpx rgba(0, 0, 0, 0.2);
  --shadow-pop: 0 32rpx 96rpx rgba(0, 0, 0, 0.38);
}

