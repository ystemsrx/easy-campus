page,
view,
scroll-view,
swiper,
swiper-item,
text,
button,
input,
picker,
image,
rich-text {
  box-sizing: border-box;
}

page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #16161a;
  background: #f7f5ef;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  --color-bg: #f7f5ef;
  --color-bg-elevated: #ffffff;
  --color-bg-subtle: #f1eee6;
  --color-material: rgba(255, 255, 255, 0.76);
  --color-material-heavy: rgba(255, 255, 255, 0.94);
  --color-text: #16161a;
  --color-text-secondary: #6b6558;
  --color-text-tertiary: #9a9aa3;
  --color-separator: rgba(43, 38, 32, 0.065);
  --color-primary: #b85c38;
  --color-primary-soft: #f9eae2;
  --color-success: #5f7350;
  --color-success-soft: #edf1e6;
  --color-warning: #a66f1f;
  --color-warning-soft: #f8eedd;
  --color-danger: #c0452d;
  --color-danger-soft: #f9e7e0;
  --world-coral-from: #d97757;
  --world-coral-to: #eba97f;
  --world-amber-from: #c98a2d;
  --world-amber-to: #e5b86e;
  --world-sage-from: #7d8f6e;
  --world-sage-to: #acbe97;
  --world-rose-from: #c2767a;
  --world-rose-to: #dfa6a0;
  --shadow-card: 0 2rpx 4rpx rgba(20, 20, 30, 0.035),
    0 20rpx 64rpx -16rpx rgba(20, 20, 30, 0.11);
  --shadow-pop: 0 8rpx 24rpx rgba(20, 20, 30, 0.08),
    0 40rpx 108rpx -24rpx rgba(20, 20, 30, 0.22);

  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--color-text);
  background-color: var(--color-bg);
  transition: color 220ms ease, background-color 280ms ease;
}

.page.theme-dark {
  --color-bg: #171613;
  --color-bg-elevated: #23211d;
  --color-bg-subtle: #2d2a24;
  --color-material: rgba(35, 33, 29, 0.86);
  --color-material-heavy: rgba(35, 33, 29, 0.96);
  --color-text: #f7f3e9;
  --color-text-secondary: #c6bdad;
  --color-text-tertiary: #8f887c;
  --color-separator: rgba(255, 255, 255, 0.075);
  --color-primary: #eba97f;
  --color-primary-soft: #3e2b23;
  --color-success: #acbe97;
  --color-success-soft: #293127;
  --color-warning: #e5b86e;
  --color-warning-soft: #3a3020;
  --color-danger: #e78670;
  --color-danger-soft: #40251f;
  --shadow-card: 0 18rpx 56rpx rgba(0, 0, 0, 0.2);
  --shadow-pop: 0 32rpx 96rpx rgba(0, 0, 0, 0.38);
}

.page-scroll {
  width: 100%;
  height: 100%;
  background-color: var(--color-bg);
}

.page-content {
  width: 100%;
  padding: 24rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
}

.page-content--tab {
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
}

.display,
.display-title {
  font-family: Georgia, "Times New Roman", "Songti SC", "Noto Serif SC",
    SimSun, serif;
  letter-spacing: -1rpx;
}

.tnum { letter-spacing: 0; }

.page-enter {
  animation-name: page-rise;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  animation-fill-mode: both;
}

.stagger-item {
  animation-name: item-rise;
  animation-duration: 460ms;
  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  animation-fill-mode: both;
}

.stagger-1 { animation-delay: 40ms; }
.stagger-2 { animation-delay: 90ms; }
.stagger-3 { animation-delay: 140ms; }
.stagger-4 { animation-delay: 190ms; }

.motion-reduced .page-enter,
.motion-reduced .stagger-item,
.motion-reduced .inline-error,
.motion-reduced .skeleton-shimmer {
  animation-duration: 1ms;
  animation-delay: 0ms;
}

.motion-reduced .loading-orb,
.motion-reduced .status-core,
.motion-reduced .mini-spinner,
.motion-reduced .grade-spinner,
.motion-reduced .rooms-spinner,
.motion-reduced .exam-spinner,
.motion-reduced .ambient-blob {
  animation-name: none;
}

.motion-reduced .pressable,
.motion-reduced .smooth-transition {
  transition-duration: 1ms;
}

.card,
.material-card {
  position: relative;
  overflow: hidden;
  border: 0;
  border-radius: 44rpx;
  background-color: var(--color-bg-elevated);
  box-shadow: var(--shadow-card);
}

.material-card {
  background-color: var(--color-material);
  backdrop-filter: blur(20px) saturate(1.5);
}

.pressable {
  transform: scale(1);
  opacity: 1;
  transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 150ms ease, background-color 220ms ease;
}

.pressing {
  transform: scale(0.965);
  opacity: 0.84;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin: 54rpx 2rpx 22rpx;
}

.section-title {
  display: block;
  color: var(--color-text);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.8rpx;
}

.section-caption {
  display: block;
  margin-top: 7rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  line-height: 1.4;
}

.section-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 3rpx;
  min-height: 52rpx;
  padding: 8rpx 0 7rpx 22rpx;
  color: var(--color-text-tertiary);
  font-size: 25rpx;
  font-weight: 600;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 94rpx;
  margin: 0;
  padding: 22rpx 32rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 150ms ease;
}

.primary-button::after,
.secondary-button::after,
.danger-button::after {
  display: none;
}

.primary-button {
  color: #fff;
  background: linear-gradient(135deg, #d97757, #eba97f);
  box-shadow: 0 18rpx 44rpx rgba(185, 92, 56, 0.25);
}

.primary-button--disabled {
  opacity: 0.55;
  box-shadow: none;
}

.secondary-button {
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
}

.danger-button {
  color: var(--color-danger);
  background-color: var(--color-danger-soft);
}

.button-pressed {
  transform: scale(0.97);
  opacity: 0.86;
}

.chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 12rpx 25rpx;
  border: 0;
  border-radius: 999rpx;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-elevated);
  box-shadow: var(--shadow-card);
  font-size: 25rpx;
  font-weight: 650;
}

.chip--active {
  color: #fff;
  background: linear-gradient(135deg, #d97757, #eba97f);
}

.search-field {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 82rpx;
  padding: 0 25rpx;
  border: 0;
  border-radius: 32rpx;
  background-color: var(--color-bg-elevated);
  box-shadow: var(--shadow-card);
  transition: background-color 180ms ease, box-shadow 180ms ease;
}

.search-field--focus {
  box-shadow: 0 0 0 5rpx rgba(217, 119, 87, 0.12), var(--shadow-card);
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: var(--color-text);
  font-size: 28rpx;
}

.muted { color: var(--color-text-secondary); }
.tertiary { color: var(--color-text-tertiary); }

.divider {
  width: 100%;
  height: 1rpx;
  background-color: var(--color-separator);
}

.ambient-blob {
  position: absolute;
  border-radius: 44% 56% 62% 38% / 44% 40% 60% 56%;
  pointer-events: none;
  animation-name: blob-drift;
  animation-duration: 9s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

@keyframes page-rise {
  from { opacity: 0; transform: translateY(26rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes item-rise {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes blob-drift {
  0%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); }
  50% { transform: translate(18rpx, -20rpx) scale(1.08) rotate(5deg); }
}

@keyframes soft-pulse {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.82; }
}
