page,
view,
scroll-view,
swiper,
swiper-item,
text,
button,
input,
picker,
image {
  box-sizing: border-box;
}

rich-text {
  box-sizing: border-box;
}

page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #172033;
  background: #f4f6fa;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  --color-bg: #f4f6fa;
  --color-bg-elevated: #ffffff;
  --color-bg-subtle: #edf1f7;
  --color-material: rgba(255, 255, 255, 0.82);
  --color-material-heavy: rgba(255, 255, 255, 0.94);
  --color-text: #172033;
  --color-text-secondary: #657086;
  --color-text-tertiary: #9aa2b1;
  --color-separator: rgba(23, 32, 51, 0.08);
  --color-primary: #1677ff;
  --color-primary-soft: #e7f1ff;
  --color-success: #21a56e;
  --color-success-soft: #e8f7f0;
  --color-warning: #d98516;
  --color-warning-soft: #fff3df;
  --color-danger: #e64b5d;
  --color-danger-soft: #ffebee;
  --shadow-card: 0 18rpx 50rpx rgba(42, 57, 84, 0.09);
  --shadow-float: 0 24rpx 72rpx rgba(28, 40, 67, 0.16);

  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: var(--color-text);
  background-color: var(--color-bg);
  transition: background-color 280ms ease, color 220ms ease;
}

.page.theme-dark {
  --color-bg: #0e1118;
  --color-bg-elevated: #181d27;
  --color-bg-subtle: #222936;
  --color-material: rgba(24, 29, 39, 0.86);
  --color-material-heavy: rgba(24, 29, 39, 0.96);
  --color-text: #f5f7fb;
  --color-text-secondary: #a9b2c2;
  --color-text-tertiary: #737d8f;
  --color-separator: rgba(255, 255, 255, 0.08);
  --color-primary: #4d9aff;
  --color-primary-soft: #172b48;
  --color-success: #53ca94;
  --color-success-soft: #173528;
  --color-warning: #f0ad50;
  --color-warning-soft: #3a2d18;
  --color-danger: #ff7080;
  --color-danger-soft: #421f27;
  --shadow-card: 0 18rpx 50rpx rgba(0, 0, 0, 0.22);
  --shadow-float: 0 24rpx 72rpx rgba(0, 0, 0, 0.38);
}

.page-scroll {
  width: 100%;
  height: 100%;
  background-color: var(--color-bg);
}

.page-content {
  width: 100%;
  padding: 24rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-content--tab {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-enter {
  animation-name: page-materialize;
  animation-duration: 380ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-fill-mode: both;
}

.motion-reduced .page-enter,
.motion-reduced .stagger-item,
.motion-reduced .inline-error,
.motion-reduced .skeleton-shimmer {
  animation-duration: 1ms;
  animation-delay: 0ms;
}

.motion-reduced .loading-orb,
.motion-reduced .status-core,
.motion-reduced .mini-spinner,
.motion-reduced .grade-spinner,
.motion-reduced .rooms-spinner,
.motion-reduced .exam-spinner {
  animation-name: none;
}

.motion-reduced .pressable,
.motion-reduced .smooth-transition {
  transition-duration: 1ms;
}

.card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--color-separator);
  border-radius: 32rpx;
  background-color: var(--color-bg-elevated);
  box-shadow: var(--shadow-card);
}

.material-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 32rpx;
  background-color: var(--color-material);
  box-shadow: var(--shadow-card);
  backdrop-filter: blur(24px);
}

.theme-dark .material-card {
  border-color: rgba(255, 255, 255, 0.06);
}

.pressable {
  transform: scale(1);
  opacity: 1;
  transition: transform 120ms ease-out, opacity 120ms ease-out,
    background-color 180ms ease;
}

.pressing {
  transform: scale(0.975);
  opacity: 0.8;
}

.section-header {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin: 44rpx 4rpx 20rpx;
}

.section-title {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.section-caption {
  margin-top: 6rpx;
  color: var(--color-text-tertiary);
  font-size: 23rpx;
  line-height: 1.4;
}

.section-action {
  min-height: 56rpx;
  padding: 10rpx 2rpx 8rpx 22rpx;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 22rpx 32rpx;
  border: 0;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.2;
  letter-spacing: 0;
  transition: transform 120ms ease-out, opacity 120ms ease-out,
    background-color 180ms ease;
}

.primary-button::after,
.secondary-button::after,
.danger-button::after {
  display: none;
}

.primary-button {
  color: #ffffff;
  background: #1677ff;
  box-shadow: 0 16rpx 34rpx rgba(22, 119, 255, 0.25);
}

.primary-button--disabled {
  color: rgba(255, 255, 255, 0.75);
  background: #8abaff;
  box-shadow: none;
}

.secondary-button {
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
}

.danger-button {
  color: var(--color-danger);
  background-color: var(--color-danger-soft);
}

.button-pressed {
  transform: scale(0.972);
  opacity: 0.88;
}

.chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 999rpx;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-elevated);
  font-size: 25rpx;
  font-weight: 550;
  transition: transform 120ms ease-out, color 180ms ease,
    background-color 180ms ease;
}

.chip--active {
  border-color: rgba(22, 119, 255, 0.22);
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
}

.search-field {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 82rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: 24rpx;
  background-color: var(--color-bg-elevated);
  transition: background-color 180ms ease,
    box-shadow 180ms ease;
}

.search-field--focus {
  border-color: rgba(22, 119, 255, 0.38);
  box-shadow: 0 0 0 6rpx rgba(22, 119, 255, 0.08);
}

.search-glyph {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 18rpx;
  border: 4rpx solid var(--color-text-tertiary);
  border-radius: 50%;
}

.search-glyph::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 13rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background-color: var(--color-text-tertiary);
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: var(--color-text);
  font-size: 28rpx;
}

.muted {
  color: var(--color-text-secondary);
}

.tertiary {
  color: var(--color-text-tertiary);
}

.divider {
  width: 100%;
  height: 1rpx;
  background-color: var(--color-separator);
}

.stagger-item {
  animation-name: rise-in;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  animation-fill-mode: both;
}

.stagger-1 {
  animation-delay: 35ms;
}

.stagger-2 {
  animation-delay: 70ms;
}

.stagger-3 {
  animation-delay: 105ms;
}

.stagger-4 {
  animation-delay: 140ms;
}

@keyframes page-materialize {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.995);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes soft-pulse {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 0.8;
  }
}
