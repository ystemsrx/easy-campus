/* Optical workbench: clear center with narrow opposing light/dark rims.
 * Skyline has no backdrop displacement; keep reflections confined to the edge. */
.liquid-glass .tabbar-material {
  border: 1rpx solid rgba(255, 255, 255, 0.42) !important;
  background-color: transparent !important;
  background-image: linear-gradient(170deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 14%, rgba(255, 255, 255, 0) 86%, rgba(255, 255, 255, 0.16) 100%);
  box-shadow: inset 0 1rpx 1rpx rgba(255, 255, 255, 0.72), inset 1rpx 0 2rpx rgba(255, 255, 255, 0.3), inset 0 -1rpx 2rpx rgba(35, 45, 30, 0.22), 0 2rpx 4rpx -1rpx rgba(38, 57, 28, 0.12), 0 14rpx 28rpx -12rpx rgba(36, 53, 23, 0.17) !important;
}
.liquid-glass.theme-dark .tabbar-material {
  border-color: rgba(255, 255, 255, 0.2) !important;
  background-image: linear-gradient(170deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0) 14%, rgba(255, 255, 255, 0) 86%, rgba(255, 255, 255, 0.07) 100%);
  box-shadow: inset 0 1rpx 1rpx rgba(255, 255, 255, 0.34), inset 1rpx 0 2rpx rgba(255, 255, 255, 0.12), inset 0 -1rpx 2rpx rgba(0, 0, 0, 0.38), 0 2rpx 4rpx -1rpx rgba(0, 0, 0, 0.2), 0 14rpx 28rpx -12rpx rgba(0, 0, 0, 0.28) !important;
}
.liquid-glass .tabbar-indicator {
  border: 1rpx solid rgba(255, 255, 255, 0.58) !important;
  background-color: transparent !important;
  background-image: linear-gradient(150deg, rgba(255, 255, 255, 0.38) 0%, rgba(255, 255, 255, 0) 17%, rgba(255, 255, 255, 0) 82%, rgba(255, 255, 255, 0.24) 100%) !important;
  box-shadow: inset 1rpx 1rpx 1rpx rgba(255, 255, 255, 0.86), inset -1rpx -1rpx 2rpx rgba(35, 45, 30, 0.3), 0 3rpx 5rpx -2rpx rgba(38, 57, 28, 0.16) !important;
}
.liquid-glass.theme-dark .tabbar-indicator {
  border-color: rgba(255, 255, 255, 0.28) !important;
  background-image: linear-gradient(150deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 17%, rgba(255, 255, 255, 0) 82%, rgba(255, 255, 255, 0.12) 100%) !important;
  box-shadow: inset 1rpx 1rpx 1rpx rgba(255, 255, 255, 0.48), inset -1rpx -1rpx 2rpx rgba(0, 0, 0, 0.44), 0 3rpx 5rpx -2rpx rgba(0, 0, 0, 0.28) !important;
}
.liquid-glass .glass-selector--dragging { transition-duration: 0ms !important; }

/* Timetable photography needs a softer rim than the plain settings surface. */
.liquid-glass.timetable-page {
  --glass-edge: rgba(255, 255, 255, 0.25);
  --glass-sheen: linear-gradient(155deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.025) 28%, rgba(255, 255, 255, 0.01) 64%, rgba(255, 255, 255, 0.14) 100%);
  --glass-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.32), inset 0 -1rpx 3rpx rgba(30, 45, 50, 0.12), 0 4rpx 10rpx -3rpx rgba(20, 40, 50, 0.14);
}
.liquid-glass.timetable-page.theme-dark {
  --glass-edge: rgba(255, 255, 255, 0.16);
  --glass-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2), inset 0 -1rpx 3rpx rgba(0, 0, 0, 0.2), 0 4rpx 10rpx -3rpx rgba(0, 0, 0, 0.22);
}
.liquid-glass.timetable-page .header-week,
.liquid-glass.timetable-page .header-week text { color: #ffffff !important; }
.liquid-glass.timetable-page .header-week { background-color: rgba(15, 35, 54, 0.22) !important; }
.liquid-glass.timetable-page .week-option-date,
.liquid-glass.timetable-page .week-option--current .week-option-date,
.liquid-glass.timetable-page .week-option--active .week-option-date { color: #9f9a90 !important; }
.liquid-glass.timetable-page .week-option--active {
  border-color: rgba(80, 103, 64, 0.25) !important;
}
.liquid-glass.timetable-page.theme-dark .week-option--active {
  border-color: rgba(193, 215, 172, 0.25) !important;
}
