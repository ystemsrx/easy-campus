/* Native clear-glass fallback for liquid_glass_demo.html's Bloom control.
 * Skyline cannot sample the backdrop through an SVG displacement filter.
 * Keep the center transparent and reproduce its illuminated rim and shadow.
 */
.liquid-glass {
  --glass-ink: #292e25;
  --glass-accent: #506740;
  --glass-edge: rgba(255, 255, 255, 0.82);
  --glass-sheen: linear-gradient(155deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.06) 28%, rgba(255, 255, 255, 0.02) 64%, rgba(255, 255, 255, 0.38) 100%);
  --glass-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.9), inset 0 -2rpx 3rpx rgba(58, 73, 47, 0.18), inset 2rpx 0 3rpx rgba(255, 255, 255, 0.55), 0 4rpx 8rpx -2rpx rgba(38, 57, 28, 0.14), 0 14rpx 28rpx -12rpx rgba(36, 53, 23, 0.19);
  --glass-tint: rgba(255, 255, 255, 0.08);
  --glass-track: rgba(132, 148, 116, 0.12);
}
.liquid-glass.theme-dark {
  --glass-ink: #f1f5eb;
  --glass-accent: #c1d7ac;
  --glass-edge: rgba(243, 255, 229, 0.3);
  --glass-sheen: linear-gradient(155deg, rgba(246, 255, 238, 0.22) 0%, rgba(233, 255, 216, 0.025) 28%, rgba(10, 20, 6, 0.06) 64%, rgba(237, 255, 224, 0.12) 100%);
  --glass-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.38), inset 0 -2rpx 3rpx rgba(0, 0, 0, 0.32), inset 2rpx 0 3rpx rgba(255, 255, 255, 0.14), 0 4rpx 8rpx -2rpx rgba(0, 0, 0, 0.24), 0 14rpx 28rpx -12rpx rgba(0, 0, 0, 0.34);
  --glass-tint: rgba(40, 49, 33, 0.14);
  --glass-track: rgba(174, 195, 153, 0.1);
}

