{
  "pages": ["pages/home/index", "pages/schedule/index", "pages/profile/index"],
  "subPackages": [
    {
      "name": "features",
      "root": "features",
      "pages": [
        "pages/login/index",
        "pages/pet-setup/index",
        "pages/inbox/index",
        "pages/grades/index",
        "pages/pass-rates/index",
        "pages/grade-detail/index",
        "pages/rooms/index",
        "pages/exams/index",
        "pages/calendar/index",
        "pages/electricity/index",
        "pages/timetable/index",
        "pages/browser/index"
      ]
    }
  ],
  "usingComponents": {
    "lucide-icon": "/components/lucide-icon/lucide-icon",
    "navigation-bar": "/components/navigation-bar/navigation-bar",
    "bottom-sheet": "/components/bottom-sheet/bottom-sheet",
    "empty-state": "/components/empty-state/empty-state",
    "loading-view": "/components/loading-view/loading-view",
    "refresh-confirmation": "/components/refresh-confirmation/refresh-confirmation",
    "rate-limit-toast": "/components/rate-limit-toast/rate-limit-toast",
    "geometric-pet": "/components/geometric-pet/geometric-pet"
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom",
    "backgroundColor": "#f7f5ef",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#8b8b94",
    "selectedColor": "#ffffff",
    "backgroundColor": "#f7f5ef",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "概览"
      },
      {
        "pagePath": "pages/schedule/index",
        "text": "日程"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "renderer": "skyline",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "networkTimeout": {
    "request": 70000,
    "downloadFile": 70000
  }
}
