<view wx:if="{{!hidden}}" class="tabbar-shell {{themeClass}} {{visualThemeClass}} {{motionClass}}">
  <view class="tabbar-material">
    <view class="tabbar-indicator tabbar-indicator--{{selected}}"></view>
    <view
      wx:for="{{items}}"
      wx:key="pagePath"
      class="tabbar-item {{selected === index ? 'tabbar-item--active' : ''}}"
      data-index="{{index}}"
      bindtap="onSelect"
      hover-class="tabbar-item--pressed"
      hover-stay-time="90"
      aria-role="tab"
      aria-selected="{{selected === index}}"
      aria-label="{{item.text}}"
    >
      <lucide-icon
        name="{{item.icon}}"
        tone="{{selected === index ? (themeClass === 'theme-dark' ? 'ink' : 'white') : 'muted'}}"
        size="{{36}}"
      ></lucide-icon>
      <text class="tabbar-label">{{item.text}}</text>
    </view>
  </view>
</view>
