<view class="tabbar-shell {{themeClass}} {{motionClass}}">
  <view class="tabbar-material">
    <view class="tabbar-indicator tabbar-indicator--{{selected}}"></view>
    <view
      wx:for="{{items}}"
      wx:key="pagePath"
      class="tabbar-item {{selected === index ? 'tabbar-item--active' : ''}}"
      data-index="{{index}}"
      bindtap="onSelect"
      hover-class="tabbar-item--pressed"
      hover-stay-time="90"
      aria-role="tab"
      aria-selected="{{selected === index}}"
      aria-label="{{item.text}}"
    >
      <view class="tabbar-glyph tabbar-glyph--{{item.glyph}}">
        <view wx:if="{{item.glyph === 'home'}}" class="home-roof"></view>
        <view wx:if="{{item.glyph === 'home'}}" class="home-body"></view>
        <view wx:if="{{item.glyph === 'inbox'}}" class="inbox-body"></view>
        <view wx:if="{{item.glyph === 'inbox'}}" class="inbox-line"></view>
        <view wx:if="{{item.glyph === 'profile'}}" class="profile-head"></view>
        <view wx:if="{{item.glyph === 'profile'}}" class="profile-body"></view>
      </view>
      <text class="tabbar-label">{{item.text}}</text>
    </view>
  </view>
</view>
