<view wx:if="{{!hidden}}" class="tabbar-shell {{dismissed ? 'tabbar-shell--dismissed' : ''}} {{items.length === 4 ? 'tabbar-shell--four' : ''}} {{themeClass}} {{visualThemeClass}} {{motionClass}} {{liquidGlassClass}}" aria-hidden="{{dismissed}}">
  <view class="tabbar-material" bindtouchstart="onSelectorTouchStart" catchtouchmove="{{liquidGlass ? 'onSelectorTouchMove' : ''}}" bindtouchend="onSelectorTouchEnd" bindtouchcancel="onSelectorTouchCancel">
    <capsule-rim-anchor wx:if="{{!embedded}}" class="tabbar-optics" enabled="{{liquidGlass}}" source="{{source}}"/>
    <view wx:if="{{selected >= 0}}" class="tabbar-indicator tabbar-indicator--{{selected}} {{selectorDragging ? 'glass-selector--dragging' : ''}}" style="width: calc((100% - 20rpx) / {{items.length}}); {{selectorDragStyle}}"></view>
    <view
      wx:for="{{items}}"
      wx:key="pagePath"
      class="tabbar-item {{(selectorDragging ? selectorDragIndex : selected) === index ? 'tabbar-item--active' : ''}}"
      data-index="{{index}}"
      bindtap="onSelect"
      hover-class="tabbar-item--pressed"
      hover-stay-time="90"
      aria-role="tab"
      aria-selected="{{selected === index}}"
      aria-label="{{item.text}}"
    >
      <lucide-icon
        name="{{item.icon}}"
        tone="{{liquidGlass ? (themeClass === 'theme-dark' ? 'white' : 'ink') : selected === index ? (themeClass === 'theme-dark' ? 'ink' : 'white') : 'muted'}}"
        size="{{36}}"
      ></lucide-icon>
      <text class="tabbar-label">{{item.text}}</text>
    </view>
  </view>
</view>
