.tabbar-shell {
  --tab-bg: rgba(255, 255, 255, 0.78);
  --tab-text: #8b8b94;
  --tab-active: #ffffff;
  --tab-pill: #2b2620;

  position: fixed;
  right: 0;
  bottom: 28rpx;
  left: 0;
  z-index: 900;
  display: flex;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
  pointer-events: none;
}

.tabbar-shell.theme-dark {
  --tab-bg: rgba(45, 42, 36, 0.86);
  --tab-text: #a69f93;
  --tab-active: #171613;
  --tab-pill: #f7f3e9;
}

.tabbar-material {
  position: relative;
  display: flex;
  flex-direction: row;
  width: 528rpx;
  height: 100rpx;
  padding: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  background-color: var(--tab-bg);
  box-shadow: 0 4rpx 16rpx rgba(20, 20, 30, 0.06),
    0 30rpx 80rpx -16rpx rgba(20, 20, 30, 0.22);
  backdrop-filter: blur(22px) saturate(1.6);
  pointer-events: auto;
}

.tabbar-indicator {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  width: calc((100% - 20rpx) / 3);
  border-radius: 999rpx;
  background-color: var(--tab-pill);
  transform: translateX(0);
  transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
}

.tabbar-indicator--1 { transform: translateX(100%); }
.tabbar-indicator--2 { transform: translateX(200%); }

.tabbar-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--tab-text);
  transform: scale(1);
  transition: color 260ms ease, transform 110ms ease-out;
}

.tabbar-item--active { color: var(--tab-active); }
.tabbar-item--pressed { transform: scale(0.94); }

.motion-reduced .tabbar-indicator,
.motion-reduced .tabbar-item { transition-duration: 1ms; }

.tabbar-label {
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.2;
}
