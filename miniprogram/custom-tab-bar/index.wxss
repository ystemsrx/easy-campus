.tabbar-shell {
  --tab-bg: rgba(255, 255, 255, 0.84);
  --tab-text: #8b93a3;
  --tab-active: #1677ff;
  --tab-pill: rgba(22, 119, 255, 0.11);
  --tab-border: rgba(24, 34, 52, 0.08);

  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar-shell.theme-dark {
  --tab-bg: rgba(24, 29, 39, 0.88);
  --tab-text: #7d8798;
  --tab-active: #5aa0ff;
  --tab-pill: rgba(77, 154, 255, 0.16);
  --tab-border: rgba(255, 255, 255, 0.08);
}

.tabbar-material {
  position: relative;
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 104rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 1rpx solid var(--tab-border);
  border-radius: 34rpx;
  background-color: var(--tab-bg);
  box-shadow: 0 18rpx 54rpx rgba(26, 39, 67, 0.17);
  backdrop-filter: blur(24px);
  pointer-events: auto;
}

.tabbar-indicator {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  border-radius: 27rpx;
  background-color: var(--tab-pill);
  transform: translateX(0);
  transition: transform 340ms cubic-bezier(0.2, 0.85, 0.2, 1);
}

.tabbar-indicator--1 {
  transform: translateX(100%);
}

.tabbar-indicator--2 {
  transform: translateX(200%);
}

.tabbar-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--tab-text);
  transform: scale(1);
  transition: color 180ms ease, transform 100ms ease-out;
}

.tabbar-item--active {
  color: var(--tab-active);
}

.tabbar-item--pressed {
  transform: scale(0.93);
}

.motion-reduced .tabbar-indicator,
.motion-reduced .tabbar-item {
  transition-duration: 1ms;
}

.tabbar-glyph {
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.home-roof {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 23rpx;
  height: 23rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  border-radius: 5rpx 0 0;
  transform: rotate(45deg);
}

.home-body {
  position: absolute;
  right: 7rpx;
  bottom: 3rpx;
  left: 7rpx;
  height: 21rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 6rpx 6rpx;
}

.inbox-body {
  position: absolute;
  top: 6rpx;
  right: 3rpx;
  bottom: 5rpx;
  left: 3rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}

.inbox-line {
  position: absolute;
  right: 9rpx;
  bottom: 12rpx;
  left: 9rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.profile-head {
  position: absolute;
  top: 2rpx;
  left: 13rpx;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.profile-body {
  position: absolute;
  right: 5rpx;
  bottom: 2rpx;
  left: 5rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.tabbar-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.4rpx;
}
