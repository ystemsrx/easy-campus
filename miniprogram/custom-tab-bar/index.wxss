@import "../styles/floating-tabbar.wxss";
@import "../styles/liquid-glass.wxss";

.tabbar-shell { transform: translateY(0); opacity: 1; transition: transform 320ms cubic-bezier(0.4,0,0.2,1), opacity 260ms ease; }
.tabbar-shell--dismissed { transform: translateY(calc(100% + 32rpx)); opacity: 0; }
.tabbar-shell--dismissed .tabbar-material { pointer-events: none; }
.tabbar-shell.motion-reduced { transition-duration: 0ms; }
